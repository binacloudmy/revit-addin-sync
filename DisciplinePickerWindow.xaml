<Window x:Class="RevitWebAppSync.DisciplinePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Discipline Type"
        Height="480" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="What type of discipline file are you uploading?"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#333333"
                   Margin="0,0,0,10"/>

        <TextBlock x:Name="SubHeaderText"
                   Grid.Row="1"
                   Foreground="#666666"
                   TextWrapping="Wrap"
                   Margin="0,0,0,15"/>

        <!-- Disciplines List -->
        <Border Grid.Row="2"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                Background="White">
            <ListBox x:Name="DisciplinesListBox"
                     BorderThickness="0"
                     SelectionMode="Single"
                     MouseDoubleClick="DisciplinesListBox_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="10,8">
                            <Border Width="12" Height="12"
                                    CornerRadius="6"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding SwatchColor}"/>
                                </Border.Background>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           FontSize="14"/>
                                <TextBlock Text="{Binding Code}"
                                           FontSize="11"
                                           Foreground="#999999"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Error Message -->
        <TextBlock x:Name="ErrorMessage"
                   Grid.Row="3"
                   Foreground="Red"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Margin="0,10,0,0"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Width="80"
                    Height="35"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"/>
            <Button x:Name="MainFileButton"
                    Content="General Model"
                    Width="130"
                    Height="35"
                    Margin="0,0,10,0"
                    Click="MainFileButton_Click"
                    ToolTip="Upload as MainFile — the coordinated/federated model, not a single discipline."/>
            <Button x:Name="SelectButton"
                    Content="Select"
                    Width="80"
                    Height="35"
                    Background="#4CAF50"
                    Foreground="White"
                    FontWeight="SemiBold"
                    IsEnabled="False"
                    Click="SelectButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
