<Window x:Class="RevitWebAppSync.SyncOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sync to BINA"
        Height="560" Width="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Sync to BINA"
                   FontSize="20" FontWeight="Bold" Foreground="#333333"
                   Margin="0,0,0,4"/>

        <TextBlock Grid.Row="1" x:Name="FileNameText"
                   Text="model.rvt"
                   Foreground="#666666" Margin="0,0,0,14" TextTrimming="CharacterEllipsis"/>

        <!-- Where this version has to go. Shown every sync so a stale stored
             project can never file a model under the wrong job silently. -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="Project" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,4"/>
            <ComboBox x:Name="ProjectCombo" Height="30"
                      DisplayMemberPath="Name"
                      SelectionChanged="ProjectCombo_SelectionChanged"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock Text="Folder" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,4"/>
            <ComboBox x:Name="FolderCombo" Height="30" DisplayMemberPath="Name"/>
            <TextBlock x:Name="FolderHint"
                       Foreground="#B54708" FontSize="11" Margin="0,4,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,12">
            <TextBlock Text="Discipline" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,4"/>
            <ComboBox x:Name="DisciplineCombo" Height="30" DisplayMemberPath="Label"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,0,0,12">
            <TextBlock Text="What changed? (optional)" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,4"/>
            <TextBox x:Name="CommentBox" Height="64" MaxLength="500"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <!-- Server state: what BINA already holds for this model. -->
        <Border Grid.Row="6" x:Name="HeadPanel"
                Background="White" BorderBrush="#CCCCCC" BorderThickness="1"
                Padding="12" Visibility="Collapsed" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock x:Name="HeadTitle" FontWeight="SemiBold" Foreground="#333333"/>
                <TextBlock x:Name="HeadDetail" Foreground="#666666" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="7" x:Name="StatusText"
                   Foreground="#666666" Margin="0,10,0,0" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Width="100" Height="32"
                    Margin="0,0,10,0" Click="CancelButton_Click" IsCancel="True"/>
            <Button x:Name="SyncButton" Content="Sync" Width="120" Height="32"
                    Click="SyncButton_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
