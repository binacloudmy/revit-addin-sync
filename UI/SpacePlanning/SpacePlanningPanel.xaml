<Page x:Class="RevitWebAppSync.UI.SpacePlanning.SpacePlanningPanel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource Cp.Bg}"
      FontFamily="{DynamicResource Cp.Font}">

    <Grid UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
          TextOptions.TextRenderingMode="ClearType">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="*"/>      <!-- body -->
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="14,14,14,12"
                BorderBrush="{DynamicResource Cp.Line}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8"
                        Background="#e0e7ff" VerticalAlignment="Center">
                    <Path Width="16" Height="16" Stretch="Uniform" Fill="#4338ca"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M3,3 h8 v8 h-8 z M13,3 h8 v5 h-8 z M13,10 h8 v11 h-8 z M3,13 h8 v8 h-8 z"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Space Planning" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Cp.Ink}"/>
                    <TextBlock x:Name="Subtitle" FontSize="11" Margin="0,1,0,0"
                               Foreground="{DynamicResource Cp.Muted}"
                               Text="LOD 100 massing from a brief — UBBL / JKR derived"/>
                </StackPanel>

                <Button x:Name="ThemeBtn" Grid.Column="2" Width="28" Height="28" Cursor="Hand"
                        Background="Transparent" BorderThickness="0" ToolTip="Toggle light / dark">
                    <Path x:Name="ThemeGlyph" Width="15" Height="15" Stretch="Uniform"
                          Stroke="{DynamicResource Cp.Muted}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M12,3 a9,9 0 1 0 9,9 7,7 0 0 1 -9,-9 z"/>
                </Button>
            </Grid>
        </Border>

        <ContentControl x:Name="BodyHost" Grid.Row="1"/>
    </Grid>
</Page>
