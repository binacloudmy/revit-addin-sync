<UserControl x:Class="RevitWebAppSync.UI.SpacePlanning.Screens.PlanningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:RevitWebAppSync.UI.Copilot.Controls"
             xmlns:sp="clr-namespace:RevitWebAppSync.UI.SpacePlanning.Controls"
             FontFamily="{DynamicResource Cp.Font}">
    <UserControl.Resources>
        <!-- Same shape as Cp.Card, but the hover fill uses the theme-aware Cp.Hover
             token instead of Cp.Card's hardcoded light #f7f9fb — otherwise every
             card flashes near-white when hovered in the Slate-dark theme. Selection
             state is set per-card in code-behind (accent border + tinted fill + a
             check glyph, so it never relies on colour alone). -->
        <Style x:Key="PlanCard" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Cp.Menu}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Cp.Line}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Cp.Font}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="11,10,12,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Cp.Hover}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Cp.Hair2}"/>
                            </Trigger>
                            <!-- Keyboard focus must stay visible (accessibility). -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Cp.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: back to chat + what we interpreted -->
        <ctl:ToolHeader Grid.Row="0" x:Name="Header"
                        TitleText="Massing / Space Planning"
                        GlyphKey="layers" TileBgHex="#e0e7ff" TileFgHex="#4338ca"
                        BackCommand="{Binding BackHomeCommand}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,12,14,14">
            <StackPanel>

                <!-- Orienting numbers: target GFA + how many schemes passed -->
                <Border x:Name="StatsCard" Background="{DynamicResource Cp.Sunken}"
                        BorderBrush="{DynamicResource Cp.Line}" BorderThickness="1"
                        CornerRadius="10" Padding="12,10" Margin="0,0,0,16">
                    <StackPanel x:Name="StatsHost"/>
                </Border>

                <!-- (a) Schedule of Accommodation -->
                <TextBlock Text="SCHEDULE OF ACCOMMODATION" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource Cp.Faint}" Margin="2,0,0,8"/>
                <StackPanel x:Name="SoaHost" Margin="0,0,0,6"/>
                <StackPanel x:Name="NotesHost" Margin="0,0,0,18"/>

                <!-- (b) Passing schemes -->
                <TextBlock x:Name="SchemesLabel" Text="SCHEMES" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource Cp.Faint}" Margin="2,0,0,8"/>
                <StackPanel x:Name="SchemesHost" Margin="0,0,0,6"/>

                <!-- (c) Rejected — collapsed by default (progressive disclosure) -->
                <StackPanel x:Name="RejectedBlock" Margin="0,6,0,18">
                    <ToggleButton x:Name="RejectedToggle" Cursor="Hand" Background="Transparent"
                                  BorderThickness="0" Padding="2,4" HorizontalAlignment="Left">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                            </ControlTemplate>
                        </ToggleButton.Template>
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="RejectedCaret" Width="10" Height="10" Stretch="Uniform"
                                  Stroke="{DynamicResource Cp.Muted}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  VerticalAlignment="Center" Margin="0,0,7,0" Data="M9,6 l6,6 -6,6"/>
                            <TextBlock x:Name="RejectedSummary" FontSize="11.5" FontWeight="Medium"
                                       Foreground="{DynamicResource Cp.Muted}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <StackPanel x:Name="RejectedHost" Margin="0,6,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <!-- (e) Level toggle, sitting with the canvas it controls -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PreviewLabel" Grid.Column="0" Text="PREVIEW" FontSize="10.5"
                               FontWeight="SemiBold" Foreground="{DynamicResource Cp.Faint}"
                               VerticalAlignment="Center"/>
                    <Border Grid.Column="1" x:Name="LevelToggleWrap" CornerRadius="8" Padding="2"
                            Background="{DynamicResource Cp.Sunken}"
                            BorderBrush="{DynamicResource Cp.Line}" BorderThickness="1">
                        <StackPanel x:Name="LevelToggleHost" Orientation="Horizontal"/>
                    </Border>
                </Grid>

                <!-- (d) Draw-only floor plan. NOTHING here touches the document. -->
                <sp:MassingPlanCanvas x:Name="Plan" Height="300" Margin="0,0,0,10"
                                       Scheme="{Binding SelectedScheme}"
                                       Level="{Binding SelectedLevel}"/>

                <TextBlock Text="Preview only — nothing is written to your model until you press Build."
                           FontSize="11" Foreground="{DynamicResource Cp.Faint}" TextWrapping="Wrap"
                           Margin="2,0,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- (f) Actions. One primary CTA; the group caveat (§6) is stated up front. -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource Cp.Line}" BorderThickness="0,1,0,0" Padding="12,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Path Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource Cp.Muted}"
                          StrokeThickness="1.6" Margin="2,1,7,0" VerticalAlignment="Top"
                          StrokeStartLineCap="Round"
                          Data="M12,16 v-4 M12,8 v0.01 M12,3 a9,9 0 1 0 0.01,0 z"/>
                    <TextBlock x:Name="BuildNote" FontSize="11" Foreground="{DynamicResource Cp.Muted}"
                               TextWrapping="Wrap" MaxWidth="360"
                               Text="Build places the scheme as one named Model Group — delete the group to undo it."/>
                </StackPanel>
                <!-- No global Preview/Build here. Per the design, both actions live on
                     each scheme row, so there is never a question of WHICH scheme the
                     button applies to. This bar keeps only the standing caveat. -->
                <TextBlock x:Name="BuildStatus" FontSize="11.5" FontWeight="Medium"
                           Foreground="{DynamicResource Cp.Muted}" Visibility="Collapsed"
                           Text="Building… placing the scheme in one transaction."/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
