<Window x:Class="RevitWebAppSync.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About BINA Sync"
        Height="320" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <!-- Full ;component pack URI: Revit hosts the CLR, a bare one crashes. -->
            <Image Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center"
                   Source="pack://application:,,,/RevitWebAppSync;component/Resources/binazone-logo.png"/>
            <TextBlock Text="BINA Sync"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#333333"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   x:Name="VersionText"
                   FontSize="14"
                   Foreground="#555555"
                   Margin="0,12,0,0"/>

        <TextBlock Grid.Row="2"
                   x:Name="DetailsText"
                   FontSize="12"
                   Foreground="#777777"
                   Margin="0,4,0,0"/>

        <TextBlock Grid.Row="3"
                   x:Name="NotesText"
                   FontSize="12"
                   Foreground="#777777"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0"/>

        <StackPanel Grid.Row="4" Margin="0,12,0,12">
            <ProgressBar x:Name="Progress"
                         Height="14"
                         Minimum="0" Maximum="1"
                         Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText"
                       FontSize="12"
                       Foreground="#555555"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <Button Grid.Row="5"
                x:Name="ActionButton"
                Content="Check for updates"
                Height="38"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="White"
                Background="#2563EB"
                BorderThickness="0"
                Cursor="Hand"
                Click="ActionButton_Click">
            <!-- Own template: the stock button chrome swaps in a pale blue on
                 hover, which leaves the white label unreadable. -->
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="#1D4ED8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Face" Property="Background" Value="#93B4F5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
