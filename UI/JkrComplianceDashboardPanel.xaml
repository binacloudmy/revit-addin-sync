<Page x:Class="RevitWebAppSync.UI.JkrComplianceDashboardPanel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:jkr="clr-namespace:RevitWebAppSync.UI.Jkr"
      xmlns:ctl="clr-namespace:RevitWebAppSync.UI.Jkr.Controls"
      Background="#F7F6F3" FontFamily="Segoe UI" Focusable="True">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Jkr/Tokens.xaml"/>
                <ResourceDictionary Source="Jkr/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <jkr:BoolToVisibilityConverter x:Key="B2V"/>
            <jkr:NonEmptyStringToVisibilityConverter x:Key="StrVis"/>
            <jkr:CountGtZeroConverter x:Key="GtZero"/>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="26"/>    <!-- Title bar -->
            <RowDefinition Height="Auto"/>  <!-- Hero -->
            <RowDefinition Height="Auto"/>  <!-- Category nav -->
            <RowDefinition Height="Auto"/>  <!-- Tabs -->
            <RowDefinition Height="*"/>     <!-- Issues list -->
            <RowDefinition Height="Auto"/>  <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ═══════════ 0. Title bar ═══════════ -->
        <Border Grid.Row="0" Background="{StaticResource NavyAlt}">
            <Grid>
                <TextBlock Text="BINA JKR Compliance" Foreground="White"
                           FontSize="11" FontWeight="Medium" VerticalAlignment="Center"
                           Margin="10,0,0,0" FontFamily="{StaticResource Font.Sans}"/>
                <Button x:Name="CloseBtn" HorizontalAlignment="Right" Width="26" Height="26"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Foreground="#B9CBDD" Click="CloseBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}">
                                <TextBlock Text="×" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#26FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ═══════════ 1. Hero header (navy) ═══════════ -->
        <Border Grid.Row="1" Background="{StaticResource Navy}" Padding="16,12,16,14">
            <StackPanel>
                <!-- Row A: logo + title -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="6" Background="{StaticResource Jkr.LogoGradient}">
                            <TextBlock Text="JKR" Foreground="White" FontWeight="Black" FontSize="10.5"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="{StaticResource Font.Sans}"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="JKR BIM Compliance" Foreground="{StaticResource Peach}"
                                       FontSize="13.5" FontWeight="SemiBold"
                                       FontFamily="{StaticResource Font.Sans}"/>
                            <TextBlock x:Name="FilenameText" Text="(no model)"
                                       Foreground="{StaticResource NavySubtle}"
                                       FontSize="10.5" Margin="0,1,0,0"
                                       FontFamily="{StaticResource Font.Mono}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="250"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Row A2: LOD + Re-scan on their own line -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- LOD level selector -->
                    <Border Grid.Column="0" Background="#26FFFFFF" CornerRadius="6" Padding="8,4,4,4"
                            VerticalAlignment="Center" ToolTip="Level of Development target">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="LOD" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,8,0"
                                       FontFamily="{StaticResource Font.Sans}"/>
                            <ComboBox x:Name="LodCombo" Width="72" Height="26" FontSize="14"
                                      Foreground="#0F1A33" Background="White" BorderThickness="0"
                                      FontWeight="Bold"
                                      VerticalContentAlignment="Center"
                                      Padding="8,0,4,0"
                                      ItemsSource="{Binding LodLevels}"
                                      SelectedItem="{Binding SelectedLodLevel, Mode=TwoWay}"
                                      FontFamily="{StaticResource Font.Mono}"/>
                        </StackPanel>
                    </Border>

                    <!-- Re-scan button -->
                    <Button Grid.Column="2" x:Name="RescanBtn" Style="{StaticResource Btn.Ghost}"
                            Click="Rescan_Click" VerticalAlignment="Center" ToolTip="Re-scan (R)">
                        <StackPanel Orientation="Horizontal">
                            <Grid x:Name="RescanIconRoot" Margin="0,0,5,0">
                                <jkr:IconGlyph Glyph="rotate" Size="12" Foreground="White"/>
                            </Grid>
                            <TextBlock x:Name="RescanLabel" Text="Re-scan" FontSize="11"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Row B: progress ring + session stats + pill stats -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ctl:ProgressRing x:Name="Ring" Grid.Column="0" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ResolvedCountText" Text="0" Foreground="White"
                                       FontSize="22" FontWeight="Bold"
                                       FontFamily="{StaticResource Font.Sans}"/>
                            <TextBlock x:Name="OfTotalText" Text=" of 0 resolved"
                                       Foreground="{StaticResource NavySubtle}"
                                       FontSize="12" VerticalAlignment="Bottom" Margin="4,0,0,3"
                                       FontFamily="{StaticResource Font.Sans}"/>
                        </StackPanel>
                        <TextBlock x:Name="SessionLine" Text="—" Foreground="{StaticResource NavySubtle}"
                                   FontSize="10.5" Margin="0,3,0,0"
                                   FontFamily="{StaticResource Font.Sans}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <ctl:PillStat x:Name="HiPill" Label="High" Fg="{StaticResource PillHi}" Bg="{StaticResource PillHiBg}" Margin="0,0,5,0"/>
                            <ctl:PillStat x:Name="MdPill" Label="Med"  Fg="{StaticResource PillMd}" Bg="{StaticResource PillMdBg}" Margin="0,0,5,0"/>
                            <ctl:PillStat x:Name="LoPill" Label="Low"  Fg="{StaticResource PillLo}" Bg="{StaticResource PillLoBg}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Row C: action buttons -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
                    <Button x:Name="AcceptAllBtn" Style="{StaticResource Btn.Ghost}"
                            Click="AcceptAll_Click" Margin="0,0,6,0" ToolTip="Accept all Medium + Low issues">
                        <StackPanel Orientation="Horizontal">
                            <jkr:IconGlyph Glyph="check" Size="11" Foreground="{StaticResource NavySubtle}" Margin="0,0,5,0"/>
                            <TextBlock Text="Accept All" FontSize="10.5"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="FixAllBtn" Style="{StaticResource Btn.Ghost}"
                            Click="FixAll_Click" ToolTip="Fix all auto-fixable issues">
                        <StackPanel Orientation="Horizontal">
                            <jkr:IconGlyph Glyph="bolt" Size="11" Foreground="{StaticResource Peach}" Margin="0,0,5,0"/>
                            <TextBlock Text="Fix All" FontSize="10.5" Foreground="{StaticResource Peach}"/>
                            <Border x:Name="FixCountBadge" Background="{StaticResource Peach}" CornerRadius="8"
                                    Padding="5,1,5,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="FixCountText" Text="0" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource Navy}"/>
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Fix All progress bar -->
                <Border x:Name="FixProgressPanel" Visibility="Collapsed" Margin="0,10,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="FixProgressLabel" Text="Fixing issues..." FontSize="10.5"
                                       Foreground="{StaticResource NavySubtle}" VerticalAlignment="Center"
                                       FontFamily="{StaticResource Font.Sans}"/>
                            <TextBlock x:Name="FixProgressCount" Grid.Column="1" Text="0/0" FontSize="10.5"
                                       Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"
                                       FontFamily="{StaticResource Font.Mono}"/>
                        </Grid>
                        <Border Background="#33FFFFFF" CornerRadius="3" Height="4" Margin="0,5,0,0">
                            <Border x:Name="FixProgressBar" Background="{StaticResource Peach}"
                                    CornerRadius="3" HorizontalAlignment="Left" Width="0"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ═══════════ 2. Category nav (search + pills) ═══════════ -->
        <Border Grid.Row="2" Background="{StaticResource Surface.Panel}"
                BorderBrush="{StaticResource Surface.Line}" BorderThickness="0,0,0,1"
                Padding="12,10,12,10">
            <StackPanel>
                <!-- Search -->
                <Border x:Name="SearchBox" Background="{StaticResource Surface.Bg}"
                        BorderBrush="{StaticResource Surface.Line}" BorderThickness="1"
                        CornerRadius="6" Padding="9,0,9,0" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <jkr:IconGlyph Glyph="search" Size="13" Foreground="{StaticResource Ink4}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="SearchInput" Grid.Column="1" Style="{StaticResource Tb.Search}"
                                 TextChanged="Search_TextChanged"/>
                        <TextBlock Grid.Column="1" Text="Search issues…" Foreground="{StaticResource Ink4}"
                                   FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"
                                   FontFamily="{StaticResource Font.Sans}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Column="2" x:Name="SearchClear" Text="×" Foreground="{StaticResource Ink4}"
                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" Cursor="Hand"
                                   MouseLeftButtonUp="SearchClear_Click"
                                   Visibility="Collapsed"/>
                        <Border Grid.Column="3" Background="{StaticResource Surface.Line2}" CornerRadius="3"
                                Padding="5,1,5,1" VerticalAlignment="Center">
                            <TextBlock Text="/" FontSize="9.5" Foreground="{StaticResource Ink4}"
                                       FontFamily="{StaticResource Font.Mono}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Category pills (horizontal scroll) -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              CanContentScroll="False" PanningMode="HorizontalOnly">
                    <ItemsControl x:Name="CategoriesItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ctl:CategoryPill Margin="0,0,5,2" Picked="Pill_Picked"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- ═══════════ 3. Tabs ═══════════ -->
        <Border Grid.Row="3" Background="{StaticResource Surface.Panel}"
                BorderBrush="{StaticResource Surface.Line}" BorderThickness="0,0,0,1"
                Padding="12,8,12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ToggleButton x:Name="TabOpen" Grid.Column="0" Style="{StaticResource Btn.Tab}"
                              IsChecked="True" Click="TabOpen_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Open" Margin="0,0,5,0"/>
                        <Border x:Name="TabOpenPill" Background="{StaticResource BrandTint}" CornerRadius="8" Padding="6,1,6,1">
                            <TextBlock x:Name="TabOpenCount" Text="0" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource BrandDark}"/>
                        </Border>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="TabAccepted" Grid.Column="1" Style="{StaticResource Btn.Tab}"
                              IsChecked="False" Click="TabAccepted_Click" Margin="2,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Accepted" Margin="0,0,5,0"/>
                        <Border x:Name="TabAcceptedPill" Background="{StaticResource Surface.Line2}" CornerRadius="8" Padding="6,1,6,1">
                            <TextBlock x:Name="TabAcceptedCount" Text="0" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource Ink3}"/>
                        </Border>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="TabResolved" Grid.Column="2" Style="{StaticResource Btn.Tab}"
                              IsChecked="False" Click="TabResolved_Click" Margin="2,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Resolved" Margin="0,0,5,0"/>
                        <Border x:Name="TabResolvedPill" Background="{StaticResource Surface.Line2}" CornerRadius="8" Padding="6,1,6,1">
                            <TextBlock x:Name="TabResolvedCount" Text="0" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource Ink3}"/>
                        </Border>
                    </StackPanel>
                </ToggleButton>
                <TextBlock Grid.Column="4" x:Name="FilteredCountText" Text="0 shown"
                           FontSize="10" Foreground="{StaticResource Ink4}"
                           VerticalAlignment="Bottom" Margin="0,0,4,6"
                           FontFamily="{StaticResource Font.Sans}"/>
            </Grid>
        </Border>

        <!-- ═══════════ 4. Issue list ═══════════ -->
        <Grid Grid.Row="4" Background="{StaticResource Surface.Panel}">
            <ScrollViewer x:Name="IssuesScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="IssuesItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ctl:IssueRow RowClicked="Row_Clicked" Action="Row_Action"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state -->
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <jkr:IconGlyph x:Name="EmptyIcon" Glyph="check" Size="36" Foreground="{StaticResource Ink4}"
                               Opacity="0.25" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyMessage" Text="All clear — no open issues."
                           Foreground="{StaticResource Ink3}" FontSize="12" Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           FontFamily="{StaticResource Font.Sans}"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════ 5. Footer ═══════════ -->
        <Border Grid.Row="5" Background="{StaticResource Surface.Panel}"
                BorderBrush="{StaticResource Surface.Line}" BorderThickness="0,1,0,0"
                Padding="12,7,12,7">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <ctl:KbdHint Key="↵" Label="open" Margin="0,0,10,0"/>
                    <ctl:KbdHint Key="J/K" Label="nav" Margin="0,0,10,0"/>
                    <ctl:KbdHint Key="F" Label="fix" Margin="0,0,10,0"/>
                    <ctl:KbdHint Key="A" Label="accept"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ResetBtn" Style="{StaticResource Btn.Sec}" Click="Reset_Click" Margin="0,0,6,0"
                            ToolTip="Reset all decisions back to Open">
                        <StackPanel Orientation="Horizontal">
                            <jkr:IconGlyph Glyph="undo" Size="12" Margin="0,0,5,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="Reset" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ExportBtn" Style="{StaticResource Btn.Sec}" Click="Export_Click">
                        <StackPanel Orientation="Horizontal">
                            <jkr:IconGlyph Glyph="download" Size="12" Margin="0,0,5,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="Export" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ Toast overlay ═══════════ -->
        <Border x:Name="Toast" Grid.Row="4" VerticalAlignment="Bottom"
                Margin="12,0,12,12" CornerRadius="6" Padding="12,9,12,9"
                Background="{StaticResource Ink}"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="4" Opacity="0.2"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <jkr:IconGlyph Grid.Column="0" Glyph="check" Size="13" StrokeThickness="2"
                               Foreground="{StaticResource Ok}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" x:Name="ToastMsg" Foreground="White" FontSize="11.5"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           FontFamily="{StaticResource Font.Sans}"/>
                <Button Grid.Column="2" x:Name="UndoBtn" Style="{StaticResource Btn.Link}" Click="Undo_Click">
                    <TextBlock Text="Undo" Foreground="{StaticResource Peach}" FontSize="11" FontWeight="SemiBold"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
