<Window x:Class="RevitWebAppSync.UI.CloudSignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BINA — Sign in"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F5F5F5">

    <!-- Email + password, then the emailed code when the account has 2FA. The
         requests run off the UI thread, so Revit keeps painting and the
         drafter can back out at any point. -->
    <StackPanel Margin="24">
        <TextBlock x:Name="HeadingText"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="#333333"/>

        <TextBlock x:Name="StatusText"
                   FontSize="12"
                   Foreground="#555555"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"/>

        <StackPanel x:Name="CredentialsPanel" Margin="0,16,0,0">
            <TextBlock Text="Email"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#333333"/>
            <TextBox x:Name="EmailBox"
                     Height="32"
                     Padding="8,0"
                     FontSize="13"
                     VerticalContentAlignment="Center"
                     Margin="0,4,0,0"/>

            <TextBlock Text="Password"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#333333"
                       Margin="0,12,0,0"/>
            <PasswordBox x:Name="PasswordInput"
                         Height="32"
                         Padding="8,0"
                         FontSize="13"
                         VerticalContentAlignment="Center"
                         Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel x:Name="CodePanel" Margin="0,16,0,0" Visibility="Collapsed">
            <TextBlock Text="Verification code"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#333333"/>
            <TextBox x:Name="CodeBox"
                     Height="36"
                     Padding="8,0"
                     FontSize="18"
                     MaxLength="6"
                     VerticalContentAlignment="Center"
                     Margin="0,4,0,0"/>

            <TextBlock FontSize="12" Margin="0,10,0,0">
                <Hyperlink x:Name="ResendLink" Click="Resend_Click">Resend code</Hyperlink>
                <Run Text="   "/>
                <Hyperlink x:Name="BackLink" Click="Back_Click">Use a different account</Hyperlink>
            </TextBlock>
        </StackPanel>

        <TextBlock x:Name="ErrorText"
                   FontSize="12"
                   Foreground="#B3261E"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Margin="0,12,0,0"/>

        <TextBlock x:Name="HostText"
                   FontSize="11"
                   Foreground="#777777"
                   Margin="0,12,0,0"/>

        <!-- Hidden, not Collapsed, so the window does not jump while a request runs. -->
        <ProgressBar x:Name="BusyBar"
                     Height="6"
                     Visibility="Hidden"
                     Margin="0,12,0,0"/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    IsCancel="True"
                    Width="96"
                    Height="32"
                    FontSize="13"
                    Margin="0,0,8,0"
                    Click="Cancel_Click"/>
            <Button x:Name="SubmitButton"
                    Content="Sign in"
                    IsDefault="True"
                    Width="96"
                    Height="32"
                    FontSize="13"
                    Click="Submit_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
