<UserControl x:Class="RevitWebAppSync.UI.CadToBim.Check.CheckPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chk="clr-namespace:RevitWebAppSync.UI.CadToBim.Check"
             xmlns:ctl="clr-namespace:RevitWebAppSync.UI.Copilot.Controls"
             Background="{DynamicResource Cb.Pane}" Foreground="{DynamicResource Cb.Fg}"
             FontFamily="Segoe UI" FontSize="12" MinWidth="520" PreviewKeyDown="OnPaneKey">
    <!-- AI-638: CAD to BIM pane, Check phase (v6 canvas screens 2-7: W02..W07). Revit draws the pane
         title bar and the Properties / CAD to BIM tabs; this is the body below them. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevitWebAppSync;component/UI/CadToBim/Check/CheckStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ctl:BoolToVisibilityConverter x:Key="Vis"/>
            <ctl:NotEmptyToVisibilityConverter x:Key="HasText"/>

            <!-- one-line row (.mrow): mark · text · source badge (hover = evidence) -->
            <DataTemplate x:Key="Row" DataType="{x:Type chk:CheckRow}">
                <Border BorderBrush="{DynamicResource Cb.Line2}" BorderThickness="0,0,0,1" Padding="6,0" MinHeight="30"
                        Background="Transparent" MouseLeftButtonUp="OnRowClick" KeyDown="OnRowKey" Focusable="{Binding IsActionable}"
                        AutomationProperties.Name="{Binding Evidence}">
                    <StackPanel>
                        <DockPanel MinHeight="30">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Caret}" Width="14" Foreground="{DynamicResource Cb.Fg3}" VerticalAlignment="Center"
                                       Visibility="{Binding HasDetail, Converter={StaticResource Vis}}"/>
                            <TextBlock x:Name="mark" DockPanel.Dock="Left" Width="14" Margin="0,0,8,0" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"
                                       AutomationProperties.Name="{Binding MarkName}"/>
                            <Border x:Name="sw" DockPanel.Dock="Left" Style="{StaticResource Cbs.Sw}" Tag="{Binding Mark}" Margin="0,0,8,0" Visibility="Collapsed"
                                    AutomationProperties.Name="{Binding MarkName}"/>
                            <ContentControl DockPanel.Dock="Right" Style="{StaticResource Cbs.Src}" Content="{Binding BadgeText}" Tag="{Binding Tone}"
                                            ToolTip="{Binding Evidence}" Margin="8,0,0,0"
                                            AutomationProperties.Name="{Binding BadgeName}" Visibility="{Binding HasBadge, Converter={StaticResource Vis}}"/>
                            <ComboBox x:Name="pick" DockPanel.Dock="Right" Width="110" Height="20" FontSize="11.5" Margin="8,0,0,0" Visibility="Collapsed"
                                      ItemsSource="{Binding DataContext.Levels, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedItem="{Binding Map.PickedLevel, Mode=OneWay}" SelectionChanged="OnLevelPicked"/>
                            <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12" LineHeight="16"
                                       ToolTip="{Binding Evidence}"><Run Text="{Binding Text, Mode=OneWay}"/><Run Text="{Binding Bold, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{Binding Post, Mode=OneWay}"/></TextBlock>
                        </DockPanel>
                        <TextBlock Text="{Binding Detail}" Margin="28,0,0,8" FontSize="11.5" LineHeight="16" TextWrapping="Wrap"
                                   Visibility="{Binding Expanded, Converter={StaticResource Vis}}"/>
                    </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Mark}" Value="ok">
                        <Setter TargetName="mark" Property="Text" Value="✓"/>
                        <Setter TargetName="mark" Property="Foreground" Value="{DynamicResource Cb.GT}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Mark}" Value="warn">
                        <Setter TargetName="mark" Property="Text" Value="⚠"/>
                        <Setter TargetName="mark" Property="Foreground" Value="{DynamicResource Cb.AT}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Mark}" Value="">
                        <Setter TargetName="mark" Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Mark}" Value="swatch-g"><Setter TargetName="sw" Property="Visibility" Value="Visible"/><Setter TargetName="mark" Property="Visibility" Value="Collapsed"/></DataTrigger>
                    <DataTrigger Binding="{Binding Mark}" Value="swatch-a"><Setter TargetName="sw" Property="Visibility" Value="Visible"/><Setter TargetName="mark" Property="Visibility" Value="Collapsed"/></DataTrigger>
                    <DataTrigger Binding="{Binding Mark}" Value="swatch-n"><Setter TargetName="sw" Property="Visibility" Value="Visible"/><Setter TargetName="mark" Property="Visibility" Value="Collapsed"/></DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding DataContext.EditingMapping, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                            <Condition Binding="{Binding IsPlan}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <Setter TargetName="pick" Property="Visibility" Value="Visible"/>
                    </MultiDataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <Style x:Key="Step" TargetType="Border">
                <Setter Property="Height" Value="22"/><Setter Property="Padding" Value="10,0"/><Setter Property="CornerRadius" Value="11"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="TextElement.FontSize" Value="11"/><Setter Property="TextElement.FontWeight" Value="SemiBold"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Cb.Fg3}"/>
                <Style.Triggers>
                    <Trigger Property="Tag" Value="on"><Setter Property="Background" Value="{DynamicResource Cb.Pri}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource Cb.PriFg}"/></Trigger>
                    <Trigger Property="Tag" Value="done"><Setter Property="Background" Value="{DynamicResource Cb.GS}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource Cb.GT}"/></Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="RowList" TargetType="ItemsControl">
                <Setter Property="ItemTemplate" Value="{StaticResource Row}"/>
                <Setter Property="Focusable" Value="False"/>
            </Style>

            <!-- ═══ 2 · Pre-flight (W02) ═══ -->
            <DataTemplate x:Key="Preflight">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource Cbs.BtnP}" Content="Next: consultant" Click="OnNext"/>
                    <StackPanel>
                        <Border Style="{StaticResource Cbs.Card}" Padding="11,9" Margin="0,0,0,9">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Cbs.Sec}" Text="READ" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✓ " Foreground="{DynamicResource Cb.GT}" FontWeight="Bold"/><TextBlock Text="Opened"/>
                                    <TextBlock Text="  →  " Foreground="{DynamicResource Cb.Fg3}"/>
                                    <TextBlock Text="✓ " Foreground="{DynamicResource Cb.GT}" FontWeight="Bold"/><TextBlock Text="{Binding Engine, StringFormat=Read with {0}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Cbs.Sec}" Text="PRE-FLIGHT" Margin="0,0,0,9"/>
                        <Border Style="{StaticResource Cbs.Card}" Margin="0,0,0,9">
                            <ItemsControl Style="{StaticResource RowList}" ItemsSource="{Binding PreflightRows}"/>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓ " Foreground="{DynamicResource Cb.GT}" FontWeight="Bold"/>
                            <TextBlock Style="{StaticResource Cbs.Dim}" Text="Read once. Edits from now on are instant."/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </DataTemplate>

            <!-- ═══ 3 · Consultant (W03) ═══ -->
            <DataTemplate x:Key="Consultant">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource Cbs.BtnP}" Content="Next: Gate 1" Click="OnNext"
                            Visibility="{Binding ConsultantPending, Converter={StaticResource Vis}}"/>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Cbs.Sec}" Text="CONSULTANT" Margin="0,0,0,9"/>
                        <Border Style="{StaticResource Cbs.Card}" Padding="12">
                            <Grid>
                                <DockPanel Visibility="{Binding ConsultantPending, Converter={StaticResource Vis}}">
                                    <ContentControl DockPanel.Dock="Right" Style="{StaticResource Cbs.Src}" Content="pending" Tag="n" ToolTip="Title-block reader (AI-634)"/>
                                    <TextBlock Style="{StaticResource Cbs.Dim}" Text="Consultant: not read yet (title-block reader)"/>
                                </DockPanel>
                                <StackPanel Visibility="{Binding ConsultantPending, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                                    <DockPanel Margin="0,0,0,9">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Consultant.Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <!-- shortcut: the consultant only comes from the fixture until AI-634 reads the title block (then "Title block", green, + crop) -->
                                                <ContentControl Style="{StaticResource Cbs.Src}" Content="fixture" Tag="n" Margin="0,0,6,0"
                                                                AutomationProperties.Name="Source: fixture, not read from the drawing"/>
                                                <TextBlock Style="{StaticResource Cbs.Dim}" Text="0 saved rules"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                    <Border Background="{DynamicResource Cb.Pane2}" CornerRadius="2" Padding="9,7" Margin="0,0,0,9">
                                        <DockPanel>
                                            <ContentControl DockPanel.Dock="Left" Style="{StaticResource Cbs.Src}" Content="JKR default" Tag="a" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                            <TextBlock Text="{Binding Consultant.Note}" FontSize="11.5" LineHeight="15" TextWrapping="Wrap"/>
                                        </DockPanel>
                                    </Border>
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource Cbs.BtnP}" Height="28" Content="That's right" Click="OnNext"/>
                                        <Button Grid.Column="2" Style="{StaticResource Cbs.Btn}" Height="28" HorizontalContentAlignment="Center" Content="Change"
                                                IsEnabled="False" ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Changing the consultant arrives with the rule store (AI-634)"/>
                                    </Grid>
                                    <TextBlock Text="Changing the consultant arrives with the rule store (AI-634)." FontSize="11"
                                               Foreground="{DynamicResource Cb.Fg3}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding Consultant.Rules}" FontSize="11" Foreground="{DynamicResource Cb.Fg3}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </DataTemplate>

            <!-- ═══ 4 · Gate 1 (W04) ═══ -->
            <DataTemplate x:Key="Gate1">
                <DockPanel>
                    <Grid DockPanel.Dock="Bottom">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button Style="{StaticResource Cbs.BtnP}" Content="Looks right" Click="OnNext"/>
                        <Button Grid.Column="2" Style="{StaticResource Cbs.Btn}" Height="30" HorizontalContentAlignment="Center" Content="Edit mapping" Click="OnEditMapping"
                                ToolTip="Move a plan to another existing level. The pane never creates a level."/>
                    </Grid>
                    <StackPanel>
                        <DockPanel Margin="0,0,0,9">
                            <Border DockPanel.Dock="Left" Style="{StaticResource Cbs.Badge}" Tag="b" Margin="0,0,8,0"><TextBlock Text="Gate 1 of 2"/></Border>
                            <TextBlock DockPanel.Dock="Right" Text="can't skip" FontSize="11" Foreground="{DynamicResource Cb.Fg3}" VerticalAlignment="Center"/>
                            <TextBlock Text="Every box labelled · plans mapped to levels" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Cbs.Dim}" Text="The labels are on the drawing in the view. Click a row to zoom to its box." Margin="0,0,0,9"/>
                        <Border Style="{StaticResource Cbs.Card}" Margin="0,0,0,9">
                            <ItemsControl Style="{StaticResource RowList}" ItemsSource="{Binding Gate1Rows}"/>
                        </Border>
                        <Border Style="{StaticResource Cbs.Card}" Padding="10,8">
                            <TextBlock FontSize="11.5" LineHeight="16" TextWrapping="Wrap"><Run Text="Default is same level." FontWeight="SemiBold"/><Run Text=" A plan only moves to another level when you confirm it."/><LineBreak/><Run Text="The pane never creates a level." Foreground="{DynamicResource Cb.Fg2}"/></TextBlock>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </DataTemplate>

            <!-- ═══ 5 · Gate 2 (W05) + blocked ═══ -->
            <DataTemplate x:Key="Gate2">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource Cbs.BtnP}" Content="{Binding Gate2NextLabel}" Click="OnNext"
                            IsEnabled="{Binding Gate2Blocked, Converter={x:Static chk:CheckPane.Not}}"/>
                    <StackPanel>
                        <DockPanel Margin="0,0,0,9">
                            <Border DockPanel.Dock="Left" Style="{StaticResource Cbs.Badge}" Tag="g" Margin="0,0,5,0"><TextBlock Text="✓ Gate 1"/></Border>
                            <Border DockPanel.Dock="Left" Style="{StaticResource Cbs.Badge}" Tag="b" Margin="0,0,8,0"><TextBlock Text="Gate 2 of 2"/></Border>
                            <TextBlock DockPanel.Dock="Right" Text="can't skip" FontSize="11" Foreground="{DynamicResource Cb.Fg3}" VerticalAlignment="Center"/>
                            <TextBlock Text="Scale, with its source" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Border Style="{StaticResource Cbs.Card}" Margin="0,0,0,9" ClipToBounds="True">
                            <StackPanel>
                                <ItemsControl Style="{StaticResource RowList}" ItemsSource="{Binding Gate2Rows}"/>
                                <Border x:Name="verdict" Background="{DynamicResource Cb.GS}" Padding="10,8">
                                    <TextBlock x:Name="verdictText" Text="{Binding Gate2Verdict}" FontWeight="SemiBold" Foreground="{DynamicResource Cb.GT}"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Cbs.Card}" Background="{DynamicResource Cb.Pane2}" Padding="11,9">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Cbs.Sec}" Text="IF THEY DISAGREE" Margin="0,0,0,5"/>
                                <TextBlock FontSize="11.5" LineHeight="16" TextWrapping="Wrap"><Run Text="You click the two ends of a known dimension in the view and type its value. "/><Run Text="Build stays blocked" FontWeight="SemiBold"/><Run Text=" until the two sources match."/></TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Gate2Tone}" Value="r">
                        <Setter TargetName="verdict" Property="Background" Value="{DynamicResource Cb.RS}"/>
                        <Setter TargetName="verdictText" Property="Foreground" Value="{DynamicResource Cb.RT}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Gate2Tone}" Value="a">
                        <Setter TargetName="verdict" Property="Background" Value="{DynamicResource Cb.AS}"/>
                        <Setter TargetName="verdictText" Property="Foreground" Value="{DynamicResource Cb.AT}"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- ═══ 6 · Questions (W06, dark W06QuestionsDark) ═══ -->
            <DataTemplate x:Key="Questions">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource Cbs.BtnP}" Content="{Binding ContinueLabel}" Click="OnNext" IsEnabled="{Binding CanContinue}"/>
                    <StackPanel>
                        <DockPanel Margin="0,0,0,9">
                            <TextBlock DockPanel.Dock="Right" Text="ranked: uncertainty × items × cost to fix" FontSize="11" Foreground="{DynamicResource Cb.Fg3}"/>
                            <TextBlock Style="{StaticResource Cbs.Sec}"><Run Text="NEEDS YOUR ANSWER · "/><Run Text="{Binding Questions.Count, Mode=OneWay}"/><Run Text=" OF "/><Run Text="{Binding CandidateCount, Mode=OneWay}"/><Run Text=" CANDIDATES"/></TextBlock>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Cards}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type chk:QuestionCard}">
                                    <Border x:Name="card" Style="{StaticResource Cbs.Card}" Padding="10,9" Margin="0,0,0,9" Cursor="Hand" MouseLeftButtonUp="OnCardClick">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="96" Height="64" Margin="0,0,10,0" VerticalAlignment="Top"
                                                    Background="{DynamicResource Cb.DwgBg}" BorderBrush="{DynamicResource Cb.Line}" BorderThickness="1" CornerRadius="2">
                                                <chk:DwgCrop Plan="{Binding Plan}" Margin="4"/>
                                            </Border>
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,5">
                                                    <Border DockPanel.Dock="Left" Style="{StaticResource Cbs.Kbd}" Margin="0,0,6,0"><TextBlock Text="{Binding NumberText}" HorizontalAlignment="Center"/></Border>
                                                    <TextBlock x:Name="done" DockPanel.Dock="Right" Text="✓ answered" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Cb.GT}" Visibility="Collapsed"/>
                                                    <Border x:Name="zoomed" DockPanel.Dock="Right" Style="{StaticResource Cbs.Badge}" Tag="b" Visibility="Collapsed"><TextBlock Text="zoomed in the view"/></Border>
                                                    <TextBlock Text="{Binding Q.Title}" FontWeight="SemiBold" LineHeight="16" TextWrapping="Wrap"/>
                                                </DockPanel>
                                                <TextBlock Style="{StaticResource Cbs.Dim}" Text="{Binding Q.Evidence}" Margin="0,0,0,5"/>
                                                <StackPanel x:Name="answer" Orientation="Horizontal" Visibility="Collapsed">
                                                    <Border Style="{StaticResource Cbs.Badge}" Tag="g" Height="20" Margin="0,0,5,0"><TextBlock Text="{Binding AnsweredText}"/></Border>
                                                    <ContentControl Style="{StaticResource Cbs.Src}" Content="{Binding Q.Source}" Tag="g" AutomationProperties.Name="{Binding SourceName}"
                                                                    Visibility="{Binding ShowSource, Converter={StaticResource Vis}}"/>
                                                </StackPanel>
                                                <ItemsControl x:Name="options" ItemsSource="{Binding Q.Options}" Focusable="False">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource Cbs.Chip}" Content="{Binding}" Margin="0,0,5,5" Click="OnOptionClick"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsAnswered}" Value="True">
                                            <Setter TargetName="card" Property="Background" Value="{DynamicResource Cb.GS}"/>
                                            <Setter TargetName="card" Property="BorderBrush" Value="Transparent"/>
                                            <Setter TargetName="done" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="answer" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="options" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                            <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource Cb.Focus}"/>
                                            <Setter TargetName="card" Property="BorderThickness" Value="2"/>
                                            <Setter TargetName="zoomed" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Cbs.Dim}" Visibility="{Binding Overflow, Converter={x:Static chk:CheckPane.Positive}}"><Run Text="{Binding Overflow, Mode=OneWay}"/><Run Text=" lower-impact ones go to Review as named assumptions."/></TextBlock>
                    </StackPanel>
                </DockPanel>
            </DataTemplate>

            <!-- ═══ 7 · Everything else (W07) ═══ -->
            <DataTemplate x:Key="Rows">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Cbs.Dim}" Margin="0,6,0,0" Text="{Binding BuildBlockLine}"
                               Visibility="{Binding BuildBlockLine, Converter={StaticResource HasText}}"/>
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource Cbs.BtnP}" Height="32" FontSize="12.5" Content="{Binding BuildButtonText}" Click="OnBuild" IsEnabled="{Binding CanBuild}"/>
                    <StackPanel>
                        <Border Background="{DynamicResource Cb.GS}" CornerRadius="3" Padding="10,7" Margin="0,0,0,9">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="✓ " FontWeight="Bold" Foreground="{DynamicResource Cb.GT}"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding AnswerSummary}" FontSize="11" Foreground="{DynamicResource Cb.Fg2}" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                                <TextBlock Text="{Binding AnsweredBanner}" FontWeight="SemiBold" Foreground="{DynamicResource Cb.GT}"/>
                            </DockPanel>
                        </Border>
                        <DockPanel Margin="0,0,0,9">
                            <TextBlock DockPanel.Dock="Right" Text="hover a badge for the evidence" FontSize="11" Foreground="{DynamicResource Cb.Fg3}"/>
                            <TextBlock Style="{StaticResource Cbs.Sec}" Text="EVERYTHING ELSE"/>
                        </DockPanel>
                        <Border Style="{StaticResource Cbs.Card}">
                            <ItemsControl Style="{StaticResource RowList}" ItemsSource="{Binding Rows}"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </DataTemplate>

            <!-- ═══ AI-642 · 8 · Build, pending look (W08). One ExternalEvent builds the level, so the bar is indeterminate (live counts: AI-628) ═══ -->
            <Style x:Key="Live" TargetType="Ellipse">
                <Setter Property="Width" Value="8"/><Setter Property="Height" Value="8"/><Setter Property="Fill" Value="{DynamicResource Cb.Focus}"/>
                <Setter Property="Margin" Value="0,0,7,0"/><Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <DataTemplate x:Key="Building">
                <StackPanel>
                    <Border Style="{StaticResource Cbs.Card}" BorderBrush="{DynamicResource Cb.Focus}" Padding="12,10" Margin="0,0,0,9">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,7">
                                <Ellipse DockPanel.Dock="Left" Style="{StaticResource Live}"/>
                                <TextBlock Text="{Binding ProgressText}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <!-- one ExternalEvent builds the level: no live count to fill this with (AI-628), so the track stays empty -->
                            <Border Height="6" CornerRadius="3" Background="{DynamicResource Cb.Line2}" Margin="0,0,0,7" AutomationProperties.Name="Building"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                <Border Style="{StaticResource Cbs.Badge}" Tag="b" Margin="0,0,5,0"><TextBlock Text="Walls"/></Border>
                                <Border Style="{StaticResource Cbs.Badge}" Margin="0,0,5,0"><TextBlock Text="Doors &amp; windows"/></Border>
                                <Border Style="{StaticResource Cbs.Badge}"><TextBlock Text="Floors &amp; rooms"/></Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Cbs.Btn}" IsEnabled="False" ToolTip="{x:Static chk:BuildText.StopTip}" ToolTipService.ShowOnDisabled="True">
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="10" Height="10" Fill="{DynamicResource Cb.R}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Stop after this level" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{Binding FollowText}" Margin="10,0,0,0" FontSize="11.5" Foreground="{DynamicResource Cb.Fg2}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Cbs.Dim}" FontSize="11" Foreground="{DynamicResource Cb.Fg3}" Text="{Binding UndoLine}"/>
                </StackPanel>
            </DataTemplate>

            <!-- ═══ AI-642 · 9 · Build done, issues collect quietly (W09) ═══ -->
            <DataTemplate x:Key="Built">
                <DockPanel>
                    <Button x:Name="next" DockPanel.Dock="Bottom" Style="{StaticResource Cbs.BtnP}" Content="Next: review" Click="OnNext"/>
                    <Button x:Name="back" DockPanel.Dock="Bottom" Style="{StaticResource Cbs.Btn}" Content="Back to Check" Click="OnBack" HorizontalAlignment="Left" Visibility="Collapsed"/>
                    <StackPanel>
                        <Border x:Name="done" Style="{StaticResource Cbs.Card}" BorderBrush="{DynamicResource Cb.Focus}" Padding="12,10" Margin="0,0,0,9">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,7">
                                    <Ellipse DockPanel.Dock="Left" Style="{StaticResource Live}" Fill="{DynamicResource Cb.G}"/>
                                    <TextBlock Text="{Binding DoneText}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding DoneText}"/>
                                </DockPanel>
                                <Border Height="6" CornerRadius="3" Background="{DynamicResource Cb.Focus}" Margin="0,0,0,7"/>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource Cbs.Badge}" Tag="g" Margin="0,0,5,0"><TextBlock Text="Walls"/></Border>
                                    <Border Style="{StaticResource Cbs.Badge}" Tag="g" Margin="0,0,5,0"><TextBlock Text="Doors &amp; windows"/></Border>
                                    <Border x:Name="rooms" Style="{StaticResource Cbs.Badge}"><TextBlock Text="Floors &amp; rooms"/></Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="failed" Style="{StaticResource Cbs.Card}" Background="{DynamicResource Cb.RS}" BorderBrush="Transparent" Padding="11,9" Margin="0,0,0,9" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="{x:Static chk:BuildText.Rolledback}" FontWeight="SemiBold" Foreground="{DynamicResource Cb.RT}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding RunError}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11.5"/>
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Banners}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type chk:BannerLine}">
                                    <Border Background="{DynamicResource Cb.Pane2}" BorderBrush="{DynamicResource Cb.Line}" BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,9">
                                        <DockPanel>
                                            <TextBlock x:Name="ico" DockPanel.Dock="Left" Text="⚠" Margin="0,0,8,0" Foreground="{DynamicResource Cb.A}" FontWeight="Bold"/>
                                            <TextBlock FontSize="11.5" LineHeight="15" TextWrapping="Wrap"><Run Text="{Binding Lead, Mode=OneWay}"/><Run Text="{Binding Bold, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{Binding Post, Mode=OneWay}"/></TextBlock>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Tone}" Value="r"><Setter TargetName="ico" Property="Foreground" Value="{DynamicResource Cb.R}"/></DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Cbs.Dim}" FontSize="11" Foreground="{DynamicResource Cb.Fg3}" Text="{Binding UndoLine}"/>
                    </StackPanel>
                </DockPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding RoomsBuilt}" Value="True"><Setter TargetName="rooms" Property="Tag" Value="g"/></DataTrigger>
                    <DataTrigger Binding="{Binding RunFailed}" Value="True">
                        <Setter TargetName="done" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="failed" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="next" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="back" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- ═══ AI-642 · 10 · Review (W10, + dark). The needs-you queue (AI-636), source split (AI-627) and view-filter chips (AI-643) are not built yet ═══ -->
            <DataTemplate x:Key="Review">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource Cbs.BtnP}" Content="Next: accept" Click="OnNext"/>
                    <StackPanel>
                        <TextBlock Text="Review" FontSize="20" FontWeight="Bold" LineHeight="24" Margin="0,0,0,9"/>
                        <Border Style="{StaticResource Cbs.Card}" Margin="0,0,0,9">
                            <DockPanel Margin="10,9">
                                <Border DockPanel.Dock="Left" Style="{StaticResource Cbs.Sw}" Width="12" Height="12" Margin="0,2,9,0" VerticalAlignment="Top"/>
                                <StackPanel>
                                    <TextBlock Text="{x:Static chk:BuildText.QueuePending}" FontWeight="SemiBold" FontSize="12.5"/>
                                    <TextBlock Text="{x:Static chk:BuildText.QueuePendingWhy}" FontSize="11" Foreground="{DynamicResource Cb.Fg2}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Cbs.Dim}" Text="{Binding AlsoLine}" Margin="0,0,0,9"/>
                        <WrapPanel Margin="0,0,0,9">
                            <Button Style="{StaticResource Cbs.Chip}" Content="All" IsEnabled="False" Margin="0,0,5,0"/>
                            <Button Style="{StaticResource Cbs.Chip}" Content="Only guesses" IsEnabled="False" Margin="0,0,5,0"/>
                            <Button Style="{StaticResource Cbs.Chip}" Content="Only missing" IsEnabled="False" Margin="0,0,5,0"/>
                            <Button Style="{StaticResource Cbs.Chip}" Content="Your rules" IsEnabled="False" Margin="0,0,5,0"/>
                            <TextBlock Text="{x:Static chk:BuildText.ChipsPending}" FontSize="10.5" Foreground="{DynamicResource Cb.Fg3}" VerticalAlignment="Center"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding TotalsLine}" FontSize="11" Foreground="{DynamicResource Cb.Fg3}" Margin="0,0,0,9"/>
                        <StackPanel Visibility="{Binding IssueRows.Count, Converter={x:Static chk:CheckPane.Positive}}" Margin="0,0,0,9">
                            <TextBlock Style="{StaticResource Cbs.Sec}" Text="FROM THE BUILD" Margin="0,0,0,6"/>
                            <Border Style="{StaticResource Cbs.Card}">
                                <ItemsControl ItemsSource="{Binding IssueRows}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type chk:IssueRow}">
                                            <Border BorderBrush="{DynamicResource Cb.Line2}" BorderThickness="0,0,0,1" Padding="10,6">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource Cbs.Btn}" Height="22" Content="Show" Click="OnShowIssue"
                                                            IsEnabled="{Binding CanShow}" Margin="8,0,0,0" AutomationProperties.Name="Show these elements in the view"/>
                                                    <ContentControl DockPanel.Dock="Right" Style="{StaticResource Cbs.Src}" Content="{Binding Kind}" Tag="{Binding Tone}" Margin="8,0,0,0"/>
                                                    <TextBlock Text="{Binding Text}" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Text}"/>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                        <Border Background="{DynamicResource Cb.AS}" BorderBrush="{DynamicResource Cb.A}" BorderThickness="1" CornerRadius="3" Padding="10,7">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Cbs.Btn}" Height="20" Content="Set real heights" IsEnabled="False"
                                        ToolTip="{x:Static chk:BuildText.HeightsPending}" ToolTipService.ShowOnDisabled="True"/>
                                <TextBlock Text="Heights · amber at best (plan only)" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource Cb.AT}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </DataTemplate>

            <!-- ═══ AI-642 · 12 · Review, honest accept (W12). Accept waits for AI-636; Remove this run for AI-633 ═══ -->
            <DataTemplate x:Key="Accept">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <Button Style="{StaticResource Cbs.Btn}" IsEnabled="False" HorizontalContentAlignment="Center" Background="Transparent"
                                BorderBrush="{DynamicResource Cb.R}" Foreground="{DynamicResource Cb.RT}" Content="Remove this run…"/>
                        <TextBlock Text="{x:Static chk:BuildText.RemovePending}" FontSize="11" Foreground="{DynamicResource Cb.Fg3}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Accept" FontSize="16" FontWeight="Bold" Margin="0,0,0,9"/>
                        <Border Style="{StaticResource Cbs.Card}" Margin="0,0,0,9">
                            <ItemsControl ItemsSource="{Binding AcceptRows}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type chk:AcceptRow}">
                                        <Border BorderBrush="{DynamicResource Cb.Line2}" BorderThickness="0,0,0,1" Padding="10,9">
                                            <DockPanel>
                                                <CheckBox DockPanel.Dock="Left" IsEnabled="False" Margin="0,2,9,0" VerticalAlignment="Top" AutomationProperties.Name="{Binding Bold}"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Bold}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Note}" FontSize="11" Foreground="{DynamicResource Cb.Fg2}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <Button Style="{StaticResource Cbs.BtnP}" Height="32" Content="{x:Static chk:BuildText.AcceptPending}" IsEnabled="False" Margin="0,0,0,9"/>
                        <TextBlock Style="{StaticResource Cbs.Dim}"><Run Text="{x:Static chk:BuildText.AcceptNote}"/><Run Text=" "/><Run Text="{Binding UndoLine, Mode=OneWay}"/></TextBlock>
                        <Button Style="{StaticResource Cbs.Btn}" Content="Back" Click="OnBack" HorizontalAlignment="Left" Margin="0,9,0,0"/>
                    </StackPanel>
                </DockPanel>
            </DataTemplate>

            <!-- empty / loading / error -->
            <DataTemplate x:Key="Empty">
                <TextBlock Style="{StaticResource Cbs.Dim}" TextAlignment="Center" VerticalAlignment="Center" MaxWidth="300"
                           Text="Open a DWG with CAD to BIM on the BINA ribbon. Nothing is built until you confirm."/>
            </DataTemplate>
            <DataTemplate x:Key="Loading">
                <StackPanel>
                    <Border Style="{StaticResource Cbs.Card}" Padding="11,9">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Cbs.Sec}" Text="READ" Margin="0,0,0,6"/>
                            <TextBlock Text="Reading the drawing…"/>
                            <TextBlock Style="{StaticResource Cbs.Dim}" Text="Revit stays usable while this runs." Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="Error">
                <StackPanel>
                    <Border Style="{StaticResource Cbs.Card}" Background="{DynamicResource Cb.RS}" BorderBrush="Transparent" Padding="11,9" Margin="0,0,0,9">
                        <StackPanel>
                            <TextBlock Text="The drawing could not be read" FontWeight="SemiBold" Foreground="{DynamicResource Cb.RT}"/>
                            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11.5"/>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource Cbs.Btn}" Content="Try again" HorizontalAlignment="Left" Click="OnRetry"/>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
        <!-- stepper: 1 Check › 2 Build › 3 Review + consultant chip -->
        <Border DockPanel.Dock="Top" Height="40" Padding="12,0" BorderBrush="{DynamicResource Cb.Line2}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Border DockPanel.Dock="Right" Height="22" Padding="9,0" CornerRadius="11" BorderThickness="1" VerticalAlignment="Center"
                        BorderBrush="{DynamicResource Cb.BtnB}" Background="{DynamicResource Cb.Btn}" ToolTip="Rules are saved to this project, never to JKR">
                    <TextBlock Text="{Binding ConsultantChip}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- AI-642: done = green check, on = primary, off = dim (Phase from Screen) -->
                    <Border Style="{StaticResource Step}" Tag="{Binding StepCheck}"><TextBlock Text="{Binding StepCheckText}" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="›" Foreground="{DynamicResource Cb.Fg3}" VerticalAlignment="Center" Margin="6,0"/>
                    <Border Style="{StaticResource Step}" Tag="{Binding StepBuild}"><TextBlock Text="{Binding StepBuildText}" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="›" Foreground="{DynamicResource Cb.Fg3}" VerticalAlignment="Center" Margin="6,0"/>
                    <Border Style="{StaticResource Step}" Tag="{Binding StepReview}"><TextBlock Text="3 Review" VerticalAlignment="Center"/></Border>
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- file row -->
        <Border DockPanel.Dock="Top" Height="24" Padding="12,0" BorderBrush="{DynamicResource Cb.Line2}" BorderThickness="0,0,0,1"
                Visibility="{Binding FileName, Converter={StaticResource HasText}}">
            <DockPanel>
            <Path DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,6,0" Stretch="None" VerticalAlignment="Center" Data="M4,1.5 H9.5 L12.5,4.5 V14.5 H4 Z M9.5,1.5 V4.5 H12.5"
                  Stroke="{DynamicResource Cb.Fg2}" StrokeThickness="1.3" StrokeLineJoin="Round" AutomationProperties.Name="Drawing file"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource Cbs.Btn}" Height="18" FontSize="11" Padding="6,0" Content="Link again" Click="OnRelink"
                    Visibility="{Binding CanRelink, Converter={StaticResource Vis}}" AutomationProperties.Name="Link the drawing into the view again"/>
            <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Cb.Fg2}" TextTrimming="CharacterEllipsis"><Run Text="{Binding FileName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Cb.Fg}"/><Run Text=" · "/><Run Text="{Binding UnderlayText, Mode=OneWay}"/><Run Text=" · read by "/><Run Text="{Binding Engine, Mode=OneWay}"/></TextBlock>
            </DockPanel>
        </Border>
        <!-- body: one screen at a time, chosen by State.Screen -->
        <ContentControl Content="{Binding}" Margin="14,12" Focusable="False">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="ContentTemplate" Value="{StaticResource Empty}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Screen}" Value="Loading"><Setter Property="ContentTemplate" Value="{StaticResource Loading}"/></DataTrigger>
                        <DataTrigger Binding="{Binding Screen}" Value="Error"><Setter Property="ContentTemplate" Value="{StaticResource Error}"/></DataTrigger>
                        <DataTrigger Binding="{Binding Screen}" Value="Preflight"><Setter Property="ContentTemplate" Value="{StaticResource Preflight}"/></DataTrigger>
                        <DataTrigger Binding="{Binding Screen}" Value="Consultant"><Setter Property="ContentTemplate" Value="{StaticResource Consultant}"/></DataTrigger>
                        <DataTrigger Binding="{Binding Screen}" Value="Gate1"><Setter Property="ContentTemplate" Value="{StaticResource Gate1}"/></DataTrigger>
                        <DataTrigger Binding="{Binding Screen}" Value="Gate2"><Setter Property="ContentTemplate" Value="{StaticResource Gate2}"/></DataTrigger>
                        <DataTrigger Binding="{Binding Screen}" Value="Questions"><Setter Property="ContentTemplate" Value="{StaticResource Questions}"/></DataTrigger>
                        <DataTrigger Binding="{Binding Screen}" Value="Rows"><Setter Property="ContentTemplate" Value="{StaticResource Rows}"/></DataTrigger>
                        <DataTrigger Binding="{Binding Screen}" Value="Building"><Setter Property="ContentTemplate" Value="{StaticResource Building}"/></DataTrigger>
                        <DataTrigger Binding="{Binding Screen}" Value="Built"><Setter Property="ContentTemplate" Value="{StaticResource Built}"/></DataTrigger>
                        <DataTrigger Binding="{Binding Screen}" Value="Review"><Setter Property="ContentTemplate" Value="{StaticResource Review}"/></DataTrigger>
                        <DataTrigger Binding="{Binding Screen}" Value="Accept"><Setter Property="ContentTemplate" Value="{StaticResource Accept}"/></DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </DockPanel>
</UserControl>
