&lt;Window x:Class="RevitWebAppSync.UI.ProjectSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Project" 
        Height="500" 
        Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinHeight="400"
        MinWidth="500"
        Icon="../Resources/sync_icon_16x16.png"&gt;
    
    &lt;Window.Resources&gt;
        &lt;Style TargetType="Button"&gt;
            &lt;Setter Property="Padding" Value="10,5"/&gt;
            &lt;Setter Property="Margin" Value="5"/&gt;
            &lt;Setter Property="MinWidth" Value="80"/&gt;
        &lt;/Style&gt;
        
        &lt;Style TargetType="TextBox"&gt;
            &lt;Setter Property="Padding" Value="5"/&gt;
            &lt;Setter Property="Margin" Value="5"/&gt;
        &lt;/Style&gt;
        
        &lt;Style TargetType="ListBox"&gt;
            &lt;Setter Property="Margin" Value="5"/&gt;
        &lt;/Style&gt;
        
        &lt;Style TargetType="Label"&gt;
            &lt;Setter Property="Margin" Value="5,5,5,2"/&gt;
        &lt;/Style&gt;
    &lt;/Window.Resources&gt;

    &lt;Grid Margin="10"&gt;
        &lt;Grid.RowDefinitions&gt;
            &lt;RowDefinition Height="Auto"/&gt;
            &lt;RowDefinition Height="Auto"/&gt;
            &lt;RowDefinition Height="*"/&gt;
            &lt;RowDefinition Height="Auto"/&gt;
            &lt;RowDefinition Height="Auto"/&gt;
        &lt;/Grid.RowDefinitions&gt;

        &lt;!-- Header Information --&gt;
        &lt;StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,10"&gt;
            &lt;Label Content="Select Project for File Sync" FontWeight="Bold" FontSize="14"/&gt;
            &lt;TextBlock Name="FileInfoText" 
                       Text="File: Loading..." 
                       Foreground="Gray" 
                       TextWrapping="Wrap" 
                       Margin="5,0,5,5"/&gt;
        &lt;/StackPanel&gt;

        &lt;!-- Search Box --&gt;
        &lt;Grid Grid.Row="1" Margin="0,0,0,10"&gt;
            &lt;Grid.ColumnDefinitions&gt;
                &lt;ColumnDefinition Width="Auto"/&gt;
                &lt;ColumnDefinition Width="*"/&gt;
                &lt;ColumnDefinition Width="Auto"/&gt;
            &lt;/Grid.ColumnDefinitions&gt;
            
            &lt;Label Grid.Column="0" Content="Search:"/&gt;
            &lt;TextBox Name="SearchTextBox" 
                     Grid.Column="1" 
                     ToolTip="Search projects by name, number, or client"
                     TextChanged="SearchTextBox_TextChanged"/&gt;
            &lt;Button Name="ClearSearchButton" 
                    Grid.Column="2" 
                    Content="Clear"
                    Click="ClearSearchButton_Click"/&gt;
        &lt;/Grid&gt;

        &lt;!-- Project List --&gt;
        &lt;Grid Grid.Row="2"&gt;
            &lt;Grid.ColumnDefinitions&gt;
                &lt;ColumnDefinition Width="*"/&gt;
                &lt;ColumnDefinition Width="Auto"/&gt;
            &lt;/Grid.ColumnDefinitions&gt;

            &lt;ListBox Name="ProjectListBox" 
                     Grid.Column="0"
                     SelectionMode="Single"
                     SelectionChanged="ProjectListBox_SelectionChanged"
                     MouseDoubleClick="ProjectListBox_MouseDoubleClick"&gt;
                &lt;ListBox.ItemTemplate&gt;
                    &lt;DataTemplate&gt;
                        &lt;StackPanel Orientation="Vertical" Margin="5"&gt;
                            &lt;TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="12"/&gt;
                            &lt;TextBlock Text="{Binding ClientName}" Foreground="Gray" FontSize="10" 
                                      Visibility="{Binding ClientName, Converter={x:Static local:StringToVisibilityConverter.Instance}}"/&gt;
                            &lt;TextBlock Text="{Binding FullAddress}" Foreground="Gray" FontSize="10"
                                      Visibility="{Binding FullAddress, Converter={x:Static local:StringToVisibilityConverter.Instance}}"/&gt;
                            &lt;TextBlock Text="{Binding Status}" Foreground="Blue" FontSize="10"
                                      Visibility="{Binding Status, Converter={x:Static local:StringToVisibilityConverter.Instance}}"/&gt;
                        &lt;/StackPanel&gt;
                    &lt;/DataTemplate&gt;
                &lt;/ListBox.ItemTemplate&gt;
            &lt;/ListBox&gt;

            &lt;ScrollBar Grid.Column="1" 
                       Orientation="Vertical" 
                       Visibility="{Binding ElementName=ProjectListBox, Path=ScrollViewer.ComputedVerticalScrollBarVisibility}"/&gt;
        &lt;/Grid&gt;

        &lt;!-- Selected Project Details --&gt;
        &lt;GroupBox Grid.Row="3" Header="Selected Project Details" Margin="0,10,0,10"&gt;
            &lt;Grid Name="ProjectDetailsGrid" Visibility="Collapsed"&gt;
                &lt;Grid.RowDefinitions&gt;
                    &lt;RowDefinition Height="Auto"/&gt;
                    &lt;RowDefinition Height="Auto"/&gt;
                    &lt;RowDefinition Height="Auto"/&gt;
                &lt;/Grid.RowDefinitions&gt;
                &lt;Grid.ColumnDefinitions&gt;
                    &lt;ColumnDefinition Width="Auto"/&gt;
                    &lt;ColumnDefinition Width="*"/&gt;
                    &lt;ColumnDefinition Width="Auto"/&gt;
                    &lt;ColumnDefinition Width="*"/&gt;
                &lt;/Grid.ColumnDefinitions&gt;

                &lt;Label Grid.Row="0" Grid.Column="0" Content="Project:" FontWeight="Bold"/&gt;
                &lt;TextBlock Name="SelectedProjectNameText" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="5"/&gt;
                
                &lt;Label Grid.Row="0" Grid.Column="2" Content="Number:" FontWeight="Bold"/&gt;
                &lt;TextBlock Name="SelectedProjectNumberText" Grid.Row="0" Grid.Column="3" VerticalAlignment="Center" Margin="5"/&gt;

                &lt;Label Grid.Row="1" Grid.Column="0" Content="Client:" FontWeight="Bold"/&gt;
                &lt;TextBlock Name="SelectedClientText" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="5"/&gt;
                
                &lt;Label Grid.Row="1" Grid.Column="2" Content="Status:" FontWeight="Bold"/&gt;
                &lt;TextBlock Name="SelectedStatusText" Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" Margin="5"/&gt;

                &lt;Label Grid.Row="2" Grid.Column="0" Content="Last Sync:" FontWeight="Bold"/&gt;
                &lt;TextBlock Name="LastSyncText" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="5"/&gt;
                
                &lt;Label Grid.Row="2" Grid.Column="2" Content="Sync Count:" FontWeight="Bold"/&gt;
                &lt;TextBlock Name="SyncCountText" Grid.Row="2" Grid.Column="3" VerticalAlignment="Center" Margin="5"/&gt;
            &lt;/Grid&gt;
            
            &lt;TextBlock Name="NoSelectionText" 
                       Text="No project selected" 
                       Foreground="Gray" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       Margin="10"/&gt;
        &lt;/GroupBox&gt;

        &lt;!-- Buttons --&gt;
        &lt;StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"&gt;
            &lt;Button Name="RefreshButton" 
                    Content="Refresh" 
                    Click="RefreshButton_Click" 
                    ToolTip="Refresh project list from server"/&gt;
            &lt;Button Name="NewProjectButton" 
                    Content="New Project..." 
                    Click="NewProjectButton_Click" 
                    ToolTip="Create a new project"/&gt;
            &lt;Button Name="OkButton" 
                    Content="OK" 
                    IsDefault="True"
                    Click="OkButton_Click" 
                    IsEnabled="False"/&gt;
            &lt;Button Name="CancelButton" 
                    Content="Cancel" 
                    IsCancel="True"
                    Click="CancelButton_Click"/&gt;
        &lt;/StackPanel&gt;

        &lt;!-- Loading Overlay --&gt;
        &lt;Grid Name="LoadingOverlay" 
              Grid.RowSpan="5" 
              Background="#80FFFFFF" 
              Visibility="Collapsed"&gt;
            &lt;StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"&gt;
                &lt;ProgressBar Width="200" Height="20" IsIndeterminate="True" Margin="10"/&gt;
                &lt;TextBlock Name="LoadingText" 
                           Text="Loading projects..." 
                           HorizontalAlignment="Center" 
                           FontWeight="Bold"/&gt;
            &lt;/StackPanel&gt;
        &lt;/Grid&gt;
    &lt;/Grid&gt;
&lt;/Window&gt;