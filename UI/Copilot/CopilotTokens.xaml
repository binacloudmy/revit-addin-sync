<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ═══════════════════════════════════════════════════════════════════
         SHARED tokens — theme-INVARIANT values only.
         Theme-dependent surface/text/line tokens live in
         CopilotTokens.Light.xaml / CopilotTokens.Dark.xaml (same keys),
         swapped at runtime by CopilotTheme.SetTheme(). Everything here is
         the same in light and dark (brand accent, status colors, fonts,
         dimensions, gradients).  ("Slate" design system.)
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- ─────────── BRAND ACCENT (Slate default = blue) ─────────── -->
    <SolidColorBrush x:Key="Cp.Blue"      Color="#2563eb"/>
    <SolidColorBrush x:Key="Cp.BlueHover" Color="#1d4ed8"/>
    <SolidColorBrush x:Key="Cp.BlueSoft"  Color="#eff6ff"/>
    <SolidColorBrush x:Key="Cp.BlueText"  Color="#1e40af"/>

    <!-- Accent gradient (header logo / primary buttons) -->
    <LinearGradientBrush x:Key="Cp.AccentGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0"   Color="#3b8ef7"/>
        <GradientStop Offset="1"   Color="#1d5fe0"/>
    </LinearGradientBrush>

    <!-- ─────────── PURPLE / AI ACCENT-2 ─────────── -->
    <SolidColorBrush x:Key="Cp.Purple"     Color="#7c3aed"/>
    <SolidColorBrush x:Key="Cp.PurpleSoft" Color="#f5f3ff"/>
    <SolidColorBrush x:Key="Cp.PurpleLine" Color="#ddd6fe"/>
    <SolidColorBrush x:Key="Cp.PurpleDeep" Color="#3b1d75"/>

    <!-- ─────────── STATUS ─────────── -->
    <SolidColorBrush x:Key="Cp.Green"     Color="#10b981"/>
    <SolidColorBrush x:Key="Cp.Amber"     Color="#d97706"/>
    <SolidColorBrush x:Key="Cp.Red"       Color="#dc2626"/>

    <!-- ─────────── TIER BADGES ─────────── -->
    <SolidColorBrush x:Key="Cp.Tier1Bg" Color="#dcfce7"/>
    <SolidColorBrush x:Key="Cp.Tier1Fg" Color="#15803d"/>
    <SolidColorBrush x:Key="Cp.Tier2Bg" Color="#f5f3ff"/>
    <SolidColorBrush x:Key="Cp.Tier2Fg" Color="#7c3aed"/>

    <!-- ─────────── STATUS / RESULT SURFACES ─────────── -->
    <SolidColorBrush x:Key="Cp.OkBg"      Color="#dcfce7"/>
    <SolidColorBrush x:Key="Cp.SuccessLn" Color="#bbf7d0"/>
    <SolidColorBrush x:Key="Cp.IssueBg"   Color="#fef2f2"/>
    <SolidColorBrush x:Key="Cp.IssueLn"   Color="#fecaca"/>
    <SolidColorBrush x:Key="Cp.IssueFg"   Color="#b91c1c"/>
    <SolidColorBrush x:Key="Cp.IssueFg2"  Color="#7f1d1d"/>
    <SolidColorBrush x:Key="Cp.AmberBg"   Color="#fffbeb"/>
    <SolidColorBrush x:Key="Cp.AmberLn"   Color="#fde68a"/>
    <SolidColorBrush x:Key="Cp.AmberFg"   Color="#92400e"/>
    <SolidColorBrush x:Key="Cp.CodeBg"    Color="#0c1420"/>
    <SolidColorBrush x:Key="Cp.CodeFg"    Color="#e8eef6"/>

    <!-- Bot avatar gradient (blue → purple) -->
    <LinearGradientBrush x:Key="Cp.BotGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#2563eb"/>
        <GradientStop Offset="1" Color="#7c3aed"/>
    </LinearGradientBrush>

    <!-- ═══════════ BINA LOGO STAR (4-point gradient sparkle) ═══════════ -->
    <!-- SVG userSpaceOnUse gradient (3.5,2.5)→(20.5,21.5) over a 24×24 box,
         normalized to relative coords for WPF. Sheen is a radial highlight. -->
    <LinearGradientBrush x:Key="Cp.StarGrad" StartPoint="0.146,0.104" EndPoint="0.854,0.896">
        <GradientStop Offset="0"    Color="#7dd6ff"/>
        <GradientStop Offset="0.45" Color="#3b8ef7"/>
        <GradientStop Offset="1"    Color="#1d5fe0"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="Cp.StarSheen" GradientOrigin="0.36,0.3" Center="0.36,0.3" RadiusX="0.55" RadiusY="0.55">
        <GradientStop Offset="0"    Color="#E6FFFFFF"/>
        <GradientStop Offset="0.55" Color="#0FFFFFFF"/>
        <GradientStop Offset="1"    Color="#00FFFFFF"/>
    </RadialGradientBrush>

    <!-- ─────────── TOOL ICON-TILE PALETTES ─────────── -->
    <SolidColorBrush x:Key="Cp.Tile.BlueBg"   Color="#dbeafe"/>
    <SolidColorBrush x:Key="Cp.Tile.BlueFg"   Color="#1d4ed8"/>
    <SolidColorBrush x:Key="Cp.Tile.AmberBg"  Color="#fef3c7"/>
    <SolidColorBrush x:Key="Cp.Tile.AmberFg"  Color="#a16207"/>
    <SolidColorBrush x:Key="Cp.Tile.GreenBg"  Color="#dcfce7"/>
    <SolidColorBrush x:Key="Cp.Tile.GreenFg"  Color="#15803d"/>
    <SolidColorBrush x:Key="Cp.Tile.VioletBg" Color="#ede9fe"/>
    <SolidColorBrush x:Key="Cp.Tile.VioletFg" Color="#6d28d9"/>
    <SolidColorBrush x:Key="Cp.Tile.SkyBg"    Color="#e0f2fe"/>
    <SolidColorBrush x:Key="Cp.Tile.SkyFg"    Color="#0369a1"/>
    <SolidColorBrush x:Key="Cp.Tile.RedBg"    Color="#fee2e2"/>
    <SolidColorBrush x:Key="Cp.Tile.RedFg"    Color="#b91c1c"/>
    <SolidColorBrush x:Key="Cp.Tile.IndigoBg" Color="#e0e7ff"/>
    <SolidColorBrush x:Key="Cp.Tile.IndigoFg" Color="#4338ca"/>
    <SolidColorBrush x:Key="Cp.Tile.SlateBg"  Color="#f1f5f9"/>
    <SolidColorBrush x:Key="Cp.Tile.SlateFg"  Color="#475569"/>

    <!-- ─────────── TYPOGRAPHY ─────────── -->
    <!-- Geist preferred; falls back to Segoe UI until woff2/ttf is embedded (Phase B). -->
    <FontFamily x:Key="Cp.Font">Geist, Segoe UI, system-ui, sans-serif</FontFamily>
    <FontFamily x:Key="Cp.FontMono">Geist Mono, Cascadia Mono, Consolas, Courier New, monospace</FontFamily>

    <!-- ─────────── DIMENSIONS ─────────── -->
    <!-- Slate panel = 360px (was 440). -->
    <sys:Double x:Key="Cp.PanelWidth">360</sys:Double>

</ResourceDictionary>
