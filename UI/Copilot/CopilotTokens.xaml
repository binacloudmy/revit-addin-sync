<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ═══════════ LIGHT PALETTE (docs/design/copilot-panel-slate.dc.html, light theme) ═══════════
         The design's CSS variables resolved to hex, mapped onto the existing
         Cp.* keys so every screen picks the theme up without renaming:
           - -bg #ffffff → Cp.Bg              - -text  #131c2b → Cp.Ink
           - -sunken #f3f6f9 → Cp.Sunken       - -text2 #586273 → Cp.Muted
           - -menu #ffffff → Cp.Menu           - -text3 #99a3b3 → Cp.Faint
           - -hair rgba(15,27,45,.08) → Cp.Line
           - -hair2 rgba(15,27,45,.16) → Cp.Hair2
           - -accent #1d4ed8 → Cp.Blue/Cp.Accent
           - -user #eef1f5 → Cp.UserBubble  -->
    <SolidColorBrush x:Key="Cp.Bg"        Color="#ffffff"/>
    <SolidColorBrush x:Key="Cp.Sunken"    Color="#f3f6f9"/>
    <SolidColorBrush x:Key="Cp.Menu"      Color="#ffffff"/>
    <SolidColorBrush x:Key="Cp.PanelBg"   Color="#f7f9fb"/>
    <SolidColorBrush x:Key="Cp.Ink"       Color="#131c2b"/>
    <SolidColorBrush x:Key="Cp.Ink2"      Color="#0b1220"/>
    <SolidColorBrush x:Key="Cp.Text"      Color="#131c2b"/>
    <SolidColorBrush x:Key="Cp.Muted"     Color="#586273"/>
    <SolidColorBrush x:Key="Cp.Faint"     Color="#99a3b3"/>
    <SolidColorBrush x:Key="Cp.Line"      Color="#140F1B2D"/>
    <SolidColorBrush x:Key="Cp.Hair2"     Color="#290F1B2D"/>
    <SolidColorBrush x:Key="Cp.LineSoft"  Color="#0D0F1B2D"/>
    <SolidColorBrush x:Key="Cp.Hover"     Color="#f3f6f9"/>
    <SolidColorBrush x:Key="Cp.UserBubble" Color="#eef1f5"/>

    <SolidColorBrush x:Key="Cp.Blue"      Color="#1d4ed8"/>
    <SolidColorBrush x:Key="Cp.Accent"    Color="#1d4ed8"/>
    <SolidColorBrush x:Key="Cp.BlueHover" Color="#1a44be"/>
    <SolidColorBrush x:Key="Cp.BlueSoft"  Color="#1A1D4ED8"/>
    <SolidColorBrush x:Key="Cp.BlueText"  Color="#1e40af"/>
    <SolidColorBrush x:Key="Cp.AccentContrast" Color="#ffffff"/>
    <SolidColorBrush x:Key="Cp.Green"     Color="#10b981"/>
    <SolidColorBrush x:Key="Cp.Amber"     Color="#d97706"/>
    <SolidColorBrush x:Key="Cp.Red"       Color="#dc2626"/>
    <SolidColorBrush x:Key="Cp.Meter"     Color="#f59e0b"/>

    <!-- ═══════════ SLASH-COMMAND TOOL TYPES ═══════════
         Icon tile / badge tag / legend dot colours by command type + the pin star.
         Theme-aware (see CopilotTheme palette). *Bg keys are the ~13% tinted tag bg. -->
    <!-- Fixed hex (design badgeColor() — SAME in light + dark; do NOT theme-shift,
         or the shade drifts from the mockup). *Bg = exact 13% tint (0x21 alpha). -->
    <SolidColorBrush x:Key="Cp.Tool.Det"   Color="#0d9488"/>
    <SolidColorBrush x:Key="Cp.Tool.Ai"    Color="#7c3aed"/>
    <SolidColorBrush x:Key="Cp.Tool.Rep"   Color="#d97706"/>
    <SolidColorBrush x:Key="Cp.Tool.DetBg" Color="#210d9488"/>
    <SolidColorBrush x:Key="Cp.Tool.AiBg"  Color="#217c3aed"/>
    <SolidColorBrush x:Key="Cp.Tool.RepBg" Color="#21d97706"/>
    <SolidColorBrush x:Key="Cp.Pin"        Color="#f5a623"/>

    <!-- -accent-grad: 135deg, 60% accent mixed toward white → accent -->
    <LinearGradientBrush x:Key="Cp.AccentGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#7795e8"/>
        <GradientStop Offset="1" Color="#1d4ed8"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Cp.AccentGradHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#8aa4ec"/>
        <GradientStop Offset="1" Color="#2c5ce0"/>
    </LinearGradientBrush>

    <!-- ═══════════ AI ACCENT (was purple — the design uses the blue accent) ═══════════ -->
    <SolidColorBrush x:Key="Cp.Purple"     Color="#1d4ed8"/>
    <SolidColorBrush x:Key="Cp.PurpleSoft" Color="#eff6ff"/>
    <SolidColorBrush x:Key="Cp.PurpleLine" Color="#bfdbfe"/>
    <SolidColorBrush x:Key="Cp.PurpleDeep" Color="#1e3a8a"/>

    <!-- ═══════════ TIER BADGES ═══════════ -->
    <SolidColorBrush x:Key="Cp.Tier1Bg" Color="#dcfce7"/>
    <SolidColorBrush x:Key="Cp.Tier1Fg" Color="#15803d"/>
    <SolidColorBrush x:Key="Cp.Tier2Bg" Color="#dbeafe"/>
    <SolidColorBrush x:Key="Cp.Tier2Fg" Color="#1d4ed8"/>

    <!-- ═══════════ STATUS / RESULT ═══════════ -->
    <SolidColorBrush x:Key="Cp.OkBg"      Color="#dcfce7"/>
    <SolidColorBrush x:Key="Cp.SuccessLn" Color="#bbf7d0"/>
    <SolidColorBrush x:Key="Cp.IssueBg"   Color="#fef2f2"/>
    <SolidColorBrush x:Key="Cp.IssueLn"   Color="#fecaca"/>
    <SolidColorBrush x:Key="Cp.IssueFg"   Color="#b91c1c"/>
    <SolidColorBrush x:Key="Cp.IssueFg2"  Color="#7f1d1d"/>
    <SolidColorBrush x:Key="Cp.AmberBg"   Color="#fffbeb"/>
    <SolidColorBrush x:Key="Cp.AmberLn"   Color="#fde68a"/>
    <SolidColorBrush x:Key="Cp.AmberFg"   Color="#92400e"/>
    <SolidColorBrush x:Key="Cp.CodeBg"    Color="#f3f6f9"/>
    <SolidColorBrush x:Key="Cp.CodeFg"    Color="#1e40af"/>
    <SolidColorBrush x:Key="Cp.TabBadgeBg" Color="#eef0f3"/>

    <!-- Logo / bot star gradient (design gstarLogo: #7dd6ff → #3b8ef7 → #1d5fe0) -->
    <LinearGradientBrush x:Key="Cp.BotGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0"    Color="#7dd6ff"/>
        <GradientStop Offset="0.45" Color="#3b8ef7"/>
        <GradientStop Offset="1"    Color="#1d5fe0"/>
    </LinearGradientBrush>

    <!-- Four-point BINA star (design logo path, 24×24 viewbox) -->
    <Geometry x:Key="Cp.StarPath">M12,1.1 C12.45,7.05 16.95,11.55 22.9,12 C16.95,12.45 12.45,16.95 12,22.9 C11.55,16.95 7.05,12.45 1.1,12 C7.05,11.55 11.55,7.05 12,1.1 Z</Geometry>

    <!-- ═══════════ TOOL ICON-TILE PALETTES ═══════════ -->
    <SolidColorBrush x:Key="Cp.Tile.BlueBg"   Color="#dbeafe"/>
    <SolidColorBrush x:Key="Cp.Tile.BlueFg"   Color="#1d4ed8"/>
    <SolidColorBrush x:Key="Cp.Tile.AmberBg"  Color="#fef3c7"/>
    <SolidColorBrush x:Key="Cp.Tile.AmberFg"  Color="#a16207"/>
    <SolidColorBrush x:Key="Cp.Tile.GreenBg"  Color="#dcfce7"/>
    <SolidColorBrush x:Key="Cp.Tile.GreenFg"  Color="#15803d"/>
    <SolidColorBrush x:Key="Cp.Tile.VioletBg" Color="#ede9fe"/>
    <SolidColorBrush x:Key="Cp.Tile.VioletFg" Color="#6d28d9"/>
    <SolidColorBrush x:Key="Cp.Tile.SkyBg"    Color="#e0f2fe"/>
    <SolidColorBrush x:Key="Cp.Tile.SkyFg"    Color="#0369a1"/>
    <SolidColorBrush x:Key="Cp.Tile.RedBg"    Color="#fee2e2"/>
    <SolidColorBrush x:Key="Cp.Tile.RedFg"    Color="#b91c1c"/>
    <SolidColorBrush x:Key="Cp.Tile.IndigoBg" Color="#e0e7ff"/>
    <SolidColorBrush x:Key="Cp.Tile.IndigoFg" Color="#4338ca"/>
    <SolidColorBrush x:Key="Cp.Tile.SlateBg"  Color="#f1f5f9"/>
    <SolidColorBrush x:Key="Cp.Tile.SlateFg"  Color="#475569"/>

    <!-- ═══════════ TYPOGRAPHY ═══════════ -->
    <!-- Geist preferred; falls back to Segoe UI until woff2/ttf is embedded (Task 17). -->
    <FontFamily x:Key="Cp.Font">Geist, Segoe UI, system-ui, sans-serif</FontFamily>
    <FontFamily x:Key="Cp.FontMono">Geist Mono, Cascadia Mono, Consolas, Courier New, monospace</FontFamily>

    <!-- ═══════════ DIMENSIONS ═══════════ -->
    <sys:Double x:Key="Cp.PanelWidth">440</sys:Double>

    <!-- ══════════════════════════════════════════════════════════════════════
         REASONING UI (docs/design/copilot-reasoning/README.md, canonical
         "BINA Copilot Thinking v2.dc.html") — 2026-08-02 spec.
         Separate Cp.Reasoning.*/Cp.System.* namespace, NOT a re-theme of the
         Cp.* palette above: the handoff's colors/type/spacing are FINAL for
         the reasoning timeline, approval card, and result card ONLY. Existing
         Cp.* keys (Cp.Accent, Cp.Font, …) keep every other screen unchanged —
         per the operator's override, this feature keeps the current BINA icon
         and does not restyle the rest of the panel.
         ══════════════════════════════════════════════════════════════════════ -->

    <!-- Ink / text -->
    <SolidColorBrush x:Key="Cp.Reasoning.Ink"          Color="#0b0b0f"/>
    <SolidColorBrush x:Key="Cp.Reasoning.InkHover"     Color="#26262e"/>
    <SolidColorBrush x:Key="Cp.Reasoning.TextPrimary"  Color="#15151b"/>
    <SolidColorBrush x:Key="Cp.Reasoning.TextSecondary" Color="#4a4a55"/>
    <SolidColorBrush x:Key="Cp.Reasoning.Text"         Color="#7a7a86"/>   <!-- reasoning body -->
    <SolidColorBrush x:Key="Cp.Reasoning.TextMuted"    Color="#8b8b95"/>
    <SolidColorBrush x:Key="Cp.Reasoning.TextFaint"    Color="#a5a5ae"/>
    <SolidColorBrush x:Key="Cp.Reasoning.TextFaint2"   Color="#b4b4bd"/>

    <!-- Borders / surfaces -->
    <SolidColorBrush x:Key="Cp.Reasoning.Border"       Color="#e6e6ea"/>
    <SolidColorBrush x:Key="Cp.Reasoning.Border2"      Color="#eaeaee"/>
    <SolidColorBrush x:Key="Cp.Reasoning.Border3"      Color="#ebebef"/>
    <SolidColorBrush x:Key="Cp.Reasoning.BorderSubtle" Color="#f0f0f2"/>
    <SolidColorBrush x:Key="Cp.Reasoning.BorderSubtle2" Color="#f3f3f6"/>
    <SolidColorBrush x:Key="Cp.Reasoning.RailLine"     Color="#eeeef1"/>
    <SolidColorBrush x:Key="Cp.Reasoning.Surface"      Color="#ffffff"/>
    <SolidColorBrush x:Key="Cp.Reasoning.SurfaceSunken" Color="#fcfcfd"/>
    <SolidColorBrush x:Key="Cp.Reasoning.SurfaceSunken2" Color="#f4f4f6"/>
    <SolidColorBrush x:Key="Cp.Reasoning.Hover"        Color="#f5f5f7"/>
    <SolidColorBrush x:Key="Cp.Reasoning.Hover2"       Color="#fafafb"/>
    <SolidColorBrush x:Key="Cp.Reasoning.Badge"        Color="#f1f1f4"/>   <!-- "N steps" mono pill bg -->
    <SolidColorBrush x:Key="Cp.Reasoning.BarTrack"     Color="#f0f0f3"/>   <!-- result card proportion-bar track -->

    <!-- Accent (indigo — the reasoning module's own accent, distinct from
         Cp.Accent's blue used everywhere else) -->
    <SolidColorBrush x:Key="Cp.Reasoning.Accent"       Color="#4f46e5"/>
    <LinearGradientBrush x:Key="Cp.Reasoning.AccentGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0"    Color="#6366f1"/>
        <GradientStop Offset="0.55" Color="#4f46e5"/>
        <GradientStop Offset="1"    Color="#7c3aed"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Cp.Reasoning.Success"      Color="#10b981"/>
    <SolidColorBrush x:Key="Cp.Reasoning.WarnBg"       Color="#fef3c7"/>
    <SolidColorBrush x:Key="Cp.Reasoning.WarnFg"       Color="#a16207"/>

    <!-- Result-card system colours (color_hint -> token; "none"/unmapped falls
         back to Cp.System.None). Fixed hex per the handoff — do NOT theme-shift. -->
    <SolidColorBrush x:Key="Cp.System.Supply"          Color="#2563eb"/>
    <SolidColorBrush x:Key="Cp.System.Return"          Color="#dc2626"/>
    <SolidColorBrush x:Key="Cp.System.Exhaust"         Color="#eab308"/>
    <SolidColorBrush x:Key="Cp.System.None"            Color="#d4d4da"/>

    <!-- Approval card "Needs permission" amber badge -->
    <LinearGradientBrush x:Key="Cp.Reasoning.WarnHeadGrad" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#fffdf8"/>
        <GradientStop Offset="1" Color="#ffffff"/>
    </LinearGradientBrush>

    <!-- Typography — Instrument Sans (UI) + JetBrains Mono (metadata/counts/
         timers/mono labels). Self-hosted per the handoff ("the WebView may be
         offline" — same reasoning applies to a Revit dockable pane with no
         guaranteed internet/font access on a locked-down drafting machine).
         Pack-URI-first with the same OS fallback chain as Cp.Font/Cp.FontMono
         above: until the real .ttf files land in Fonts\ (see Fonts\README.txt),
         WPF can't resolve the pack URI family and silently falls through to
         the fallback names — dropping the files in later "just works" with NO
         further code change, matching the Cp.Font precedent (Task 17). -->
    <FontFamily x:Key="Cp.Reasoning.Font">pack://application:,,,/RevitWebAppSync;component/Fonts/#Instrument Sans, Segoe UI, system-ui, sans-serif</FontFamily>
    <FontFamily x:Key="Cp.Reasoning.FontMono">pack://application:,,,/RevitWebAppSync;component/Fonts/#JetBrains Mono, Cascadia Mono, Consolas, Courier New, monospace</FontFamily>

    <!-- Spacing scale (README: 4/6/8/9/10/11/13/14/16/20/22px) — exposed as
         named doubles for code-behind consumers (ReasoningTimelineView etc.);
         XAML call sites mostly hardcode Margin/Padding thicknesses directly. -->
    <sys:Double x:Key="Cp.Reasoning.Space.xs">4</sys:Double>
    <sys:Double x:Key="Cp.Reasoning.Space.sm">8</sys:Double>
    <sys:Double x:Key="Cp.Reasoning.Space.md">13</sys:Double>
    <sys:Double x:Key="Cp.Reasoning.Space.lg">16</sys:Double>
    <sys:Double x:Key="Cp.Reasoning.Space.xl">20</sys:Double>

    <!-- Radii (README: 3 swatch / 5 / 7 / 8 / 9 buttons / 13-14 cards / 99 pill) -->
    <sys:Double x:Key="Cp.Reasoning.Radius.Swatch">3</sys:Double>
    <sys:Double x:Key="Cp.Reasoning.Radius.Sm">7</sys:Double>
    <sys:Double x:Key="Cp.Reasoning.Radius.Md">9</sys:Double>
    <sys:Double x:Key="Cp.Reasoning.Radius.Card">13</sys:Double>
    <sys:Double x:Key="Cp.Reasoning.Radius.Pill">999</sys:Double>

    <!-- Card / composer shadows (DropShadowEffect — WPF has no multi-layer
         box-shadow, so this approximates the handoff's two-layer card shadow
         with one blurred, low-opacity drop). -->
    <DropShadowEffect x:Key="Cp.Reasoning.CardShadow"
                       Color="#0b0b0f" Opacity="0.14" BlurRadius="20" ShadowDepth="4" Direction="270"/>

</ResourceDictionary>
