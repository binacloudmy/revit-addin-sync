<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ═══════════ LIGHT PALETTE (docs/design/copilot-panel-slate.dc.html, light theme) ═══════════
         The design's CSS variables resolved to hex, mapped onto the existing
         Cp.* keys so every screen picks the theme up without renaming:
           - -bg #ffffff → Cp.Bg              - -text  #131c2b → Cp.Ink
           - -sunken #f3f6f9 → Cp.Sunken       - -text2 #586273 → Cp.Muted
           - -menu #ffffff → Cp.Menu           - -text3 #99a3b3 → Cp.Faint
           - -hair rgba(15,27,45,.08) → Cp.Line
           - -hair2 rgba(15,27,45,.16) → Cp.Hair2
           - -accent #1d4ed8 → Cp.Blue/Cp.Accent
           - -user #eef1f5 → Cp.UserBubble  -->
    <SolidColorBrush x:Key="Cp.Bg"        Color="#ffffff"/>
    <SolidColorBrush x:Key="Cp.Sunken"    Color="#f0f1f7"/>
    <SolidColorBrush x:Key="Cp.Menu"      Color="#ffffff"/>
    <SolidColorBrush x:Key="Cp.PanelBg"   Color="#f7f7f6"/>
    <SolidColorBrush x:Key="Cp.Ink"       Color="#22242a"/>
    <SolidColorBrush x:Key="Cp.Ink2"      Color="#1c1e26"/>
    <SolidColorBrush x:Key="Cp.Text"      Color="#22242a"/>
    <SolidColorBrush x:Key="Cp.Muted"     Color="#5d6170"/>
    <SolidColorBrush x:Key="Cp.Faint"     Color="#9397ab"/>
    <SolidColorBrush x:Key="Cp.Line"      Color="#2122242A"/>
    <SolidColorBrush x:Key="Cp.Hair2"     Color="#3D22242A"/>
    <SolidColorBrush x:Key="Cp.LineSoft"  Color="#1522242A"/>
    <SolidColorBrush x:Key="Cp.Hover"     Color="#0D22242A"/>
    <SolidColorBrush x:Key="Cp.UserBubble" Color="#ffffff"/>

    <SolidColorBrush x:Key="Cp.Blue"      Color="#2a69c6"/>
    <SolidColorBrush x:Key="Cp.Accent"    Color="#2a69c6"/>
    <SolidColorBrush x:Key="Cp.BlueHover" Color="#22549e"/>
    <SolidColorBrush x:Key="Cp.BlueSoft"  Color="#1A2A69C6"/>
    <SolidColorBrush x:Key="Cp.BlueText"  Color="#22549e"/>
    <SolidColorBrush x:Key="Cp.AccentContrast" Color="#ffffff"/>
    <SolidColorBrush x:Key="Cp.Green"     Color="#2f9a72"/>
    <SolidColorBrush x:Key="Cp.Amber"     Color="#d98a2b"/>
    <SolidColorBrush x:Key="Cp.Red"       Color="#d95757"/>
    <SolidColorBrush x:Key="Cp.Meter"     Color="#d98a2b"/>

    <!-- ═══════════ SLASH-COMMAND TOOL TYPES ═══════════
         Icon tile / badge tag / legend dot colours by command type + the pin star.
         Theme-aware (see CopilotTheme palette). *Bg keys are the ~13% tinted tag bg. -->
    <!-- Fixed hex (design badgeColor() — SAME in light + dark; do NOT theme-shift,
         or the shade drifts from the mockup). *Bg = exact 13% tint (0x21 alpha). -->
    <SolidColorBrush x:Key="Cp.Tool.Det"   Color="#0d9488"/>
    <SolidColorBrush x:Key="Cp.Tool.Ai"    Color="#7c3aed"/>
    <SolidColorBrush x:Key="Cp.Tool.Rep"   Color="#d97706"/>
    <SolidColorBrush x:Key="Cp.Tool.DetBg" Color="#210d9488"/>
    <SolidColorBrush x:Key="Cp.Tool.AiBg"  Color="#217c3aed"/>
    <SolidColorBrush x:Key="Cp.Tool.RepBg" Color="#21d97706"/>
    <SolidColorBrush x:Key="Cp.Pin"        Color="#f5a623"/>

    <!-- -accent-grad: 135deg, 60% accent mixed toward white → accent -->
    <LinearGradientBrush x:Key="Cp.AccentGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#3b7ee0"/>
        <GradientStop Offset="1" Color="#2a69c6"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Cp.AccentGradHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#4f8ee6"/>
        <GradientStop Offset="1" Color="#3b7ee0"/>
    </LinearGradientBrush>

    <!-- ═══════════ AI ACCENT (was purple — the design uses the blue accent) ═══════════ -->
    <SolidColorBrush x:Key="Cp.Purple"     Color="#2a69c6"/>
    <SolidColorBrush x:Key="Cp.PurpleSoft" Color="#edf3fd"/>
    <SolidColorBrush x:Key="Cp.PurpleLine" Color="#a9c6f4"/>
    <SolidColorBrush x:Key="Cp.PurpleDeep" Color="#1a3f76"/>

    <!-- ═══════════ TIER BADGES ═══════════ -->
    <SolidColorBrush x:Key="Cp.Tier1Bg" Color="#d2f3e4"/>
    <SolidColorBrush x:Key="Cp.Tier1Fg" Color="#143528"/>
    <SolidColorBrush x:Key="Cp.Tier2Bg" Color="#d9e6fa"/>
    <SolidColorBrush x:Key="Cp.Tier2Fg" Color="#1a3f76"/>

    <!-- ═══════════ STATUS / RESULT ═══════════ -->
    <SolidColorBrush x:Key="Cp.OkBg"      Color="#d2f3e4"/>
    <SolidColorBrush x:Key="Cp.SuccessLn" Color="#a8e6cd"/>
    <SolidColorBrush x:Key="Cp.IssueBg"   Color="#fef2f2"/>
    <SolidColorBrush x:Key="Cp.IssueLn"   Color="#fecaca"/>
    <SolidColorBrush x:Key="Cp.IssueFg"   Color="#b91c1c"/>
    <SolidColorBrush x:Key="Cp.IssueFg2"  Color="#7f1d1d"/>
    <SolidColorBrush x:Key="Cp.AmberBg"   Color="#fffbeb"/>
    <SolidColorBrush x:Key="Cp.AmberLn"   Color="#fde68a"/>
    <SolidColorBrush x:Key="Cp.AmberFg"   Color="#92400e"/>
    <SolidColorBrush x:Key="Cp.CodeBg"    Color="#f0f1f7"/>
    <SolidColorBrush x:Key="Cp.CodeFg"    Color="#22549e"/>
    <SolidColorBrush x:Key="Cp.TabBadgeBg" Color="#f0f1f7"/>

    <!-- Logo / bot star gradient (design gstarLogo: #7dd6ff → #3b8ef7 → #1d5fe0) -->
    <LinearGradientBrush x:Key="Cp.BotGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0"    Color="#7dd6ff"/>
        <GradientStop Offset="0.45" Color="#3b8ef7"/>
        <GradientStop Offset="1"    Color="#1d5fe0"/>
    </LinearGradientBrush>

    <!-- Four-point BINA star (design logo path, 24×24 viewbox) -->
    <Geometry x:Key="Cp.StarPath">M12,1.1 C12.45,7.05 16.95,11.55 22.9,12 C16.95,12.45 12.45,16.95 12,22.9 C11.55,16.95 7.05,12.45 1.1,12 C7.05,11.55 11.55,7.05 12,1.1 Z</Geometry>

    <!-- v6 brand diamond: rotated rounded square filled with blue → jade → gold
         (design logo mark, verbatim stops; 115% end stop clamped to 1). -->
    <LinearGradientBrush x:Key="Cp.LogoGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0"   Color="#3b7ee0"/>
        <GradientStop Offset="0.6" Color="#2fbf9a"/>
        <GradientStop Offset="1"   Color="#e0a53b"/>
    </LinearGradientBrush>

    <!-- ═══════════ JKR COMPLIANCE STATES ═══════════
         The spec's five signals (critical, fail, warning, person decides, pending JKR)
         plus pass / listed / n-a / not checked, each as a text colour and a soft fill.
         Shared here so the JKR pane and any other screen that shows a spec state
         use one palette; fg on bg ≥ 4.5:1. -->
    <SolidColorBrush x:Key="Cp.Jkr.Fail"       Color="#b42f2f"/>
    <SolidColorBrush x:Key="Cp.Jkr.FailBg"     Color="#fdecec"/>
    <SolidColorBrush x:Key="Cp.Jkr.Critical"   Color="#9f1d1d"/>
    <SolidColorBrush x:Key="Cp.Jkr.CriticalBg" Color="#fbd5d5"/>
    <SolidColorBrush x:Key="Cp.Jkr.Pass"       Color="#1f6f4a"/>
    <SolidColorBrush x:Key="Cp.Jkr.PassBg"     Color="#e3f4ea"/>
    <SolidColorBrush x:Key="Cp.Jkr.Warn"       Color="#9a5a0b"/>
    <SolidColorBrush x:Key="Cp.Jkr.WarnBg"     Color="#fdf1dc"/>
    <SolidColorBrush x:Key="Cp.Jkr.Person"     Color="#22549e"/>
    <SolidColorBrush x:Key="Cp.Jkr.PersonBg"   Color="#e8f0fb"/>
    <SolidColorBrush x:Key="Cp.Jkr.Pending"    Color="#8a5a00"/>
    <SolidColorBrush x:Key="Cp.Jkr.PendingBg"  Color="#fff6dd"/>
    <SolidColorBrush x:Key="Cp.Jkr.Listed"     Color="#5d6170"/>
    <SolidColorBrush x:Key="Cp.Jkr.ListedBg"   Color="#eef0f4"/>
    <SolidColorBrush x:Key="Cp.Jkr.Na"         Color="#4b6578"/>
    <SolidColorBrush x:Key="Cp.Jkr.NaBg"       Color="#e9eef2"/>
    <SolidColorBrush x:Key="Cp.Jkr.None"       Color="#5d6170"/>
    <SolidColorBrush x:Key="Cp.Jkr.NoneBg"     Color="#f0f1f7"/>
    <!-- Solid marks (legend dots, tone bars) -->
    <SolidColorBrush x:Key="Cp.Jkr.FailDot"    Color="#d95757"/>
    <SolidColorBrush x:Key="Cp.Jkr.PassDot"    Color="#2f9a72"/>
    <SolidColorBrush x:Key="Cp.Jkr.WarnDot"    Color="#d98a2b"/>
    <SolidColorBrush x:Key="Cp.Jkr.PersonDot"  Color="#2a69c6"/>
    <SolidColorBrush x:Key="Cp.Jkr.ListedDot"  Color="#9397ab"/>
    <SolidColorBrush x:Key="Cp.Jkr.NaDot"      Color="#7f98ab"/>
    <SolidColorBrush x:Key="Cp.Jkr.Track"      Color="#e6e8ef"/>

    <!-- ═══════════ SLATE (fixed dark) ═══════════
         The Copilot palette's dark column (CopilotTheme.Palette, "Slate") as fixed
         keys. CopilotTheme flips the Cp.Bg / Cp.Ink … brushes between light and dark;
         these never flip, so a surface that is always dark (the JKR pane,
         "Direction C") reads the same values whatever the Copilot theme. -->
    <SolidColorBrush x:Key="Cp.Dark.Bg"          Color="#131d2b"/>
    <SolidColorBrush x:Key="Cp.Dark.Sunken"      Color="#0c1420"/>
    <SolidColorBrush x:Key="Cp.Dark.Menu"        Color="#1a2433"/>
    <SolidColorBrush x:Key="Cp.Dark.Ink"         Color="#e8eef6"/>
    <SolidColorBrush x:Key="Cp.Dark.Ink2"        Color="#f4f7fb"/>
    <SolidColorBrush x:Key="Cp.Dark.Muted"       Color="#8a94a6"/>
    <SolidColorBrush x:Key="Cp.Dark.Line"        Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="Cp.Dark.Hair2"       Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="Cp.Dark.LineSoft"    Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="Cp.Dark.Hover"       Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="Cp.Dark.Accent"      Color="#60a5fa"/>
    <SolidColorBrush x:Key="Cp.Dark.BlueSoft"    Color="#2660A5FA"/>
    <SolidColorBrush x:Key="Cp.Dark.BlueLine"    Color="#3360A5FA"/>
    <SolidColorBrush x:Key="Cp.Dark.BlueText"    Color="#9cc3f7"/>
    <SolidColorBrush x:Key="Cp.Dark.CodeFg"      Color="#9cc3f7"/>

    <!-- ═══════════ JKR PANE, DARK ("Direction C") ═══════════
         State and action colours for the always-dark JKR pane. Text colours are
         ≥ 4.5:1 on Cp.Dark.Bg and Cp.Dark.Sunken; fills are low-alpha tints. The
         primary action is amber (Direction C), kept apart from the warning amber by
         lightness: the action is a filled button, a warning is text on a tint. -->
    <SolidColorBrush x:Key="Cp.Jkr.Dark.Faint"      Color="#7f8a9e"/>
    <SolidColorBrush x:Key="Cp.Jkr.Dark.Raised"     Color="#172231"/>
    <SolidColorBrush x:Key="Cp.Jkr.Dark.Action"     Color="#f5b942"/>
    <SolidColorBrush x:Key="Cp.Jkr.Dark.ActionHover" Color="#ffc85c"/>
    <SolidColorBrush x:Key="Cp.Jkr.Dark.OnAction"   Color="#1a1407"/>
    <SolidColorBrush x:Key="Cp.Jkr.Dark.ActionSoft" Color="#29F5B942"/>
    <SolidColorBrush x:Key="Cp.Jkr.Dark.Disabled"   Color="#1e2a3a"/>
    <SolidColorBrush x:Key="Cp.Jkr.Dark.Scrim"      Color="#B3060A12"/>
    <SolidColorBrush x:Key="Cp.Jkr.Dark.Fail"       Color="#ff7a6e"/>
    <SolidColorBrush x:Key="Cp.Jkr.Dark.FailBg"     Color="#33FF6B5E"/>
    <SolidColorBrush x:Key="Cp.Jkr.Dark.FailLine"   Color="#59FF6B5E"/>
    <SolidColorBrush x:Key="Cp.Jkr.Dark.FailDot"    Color="#ff6b5e"/>
    <SolidColorBrush x:Key="Cp.Jkr.Dark.Critical"   Color="#ffb4ab"/>
    <SolidColorBrush x:Key="Cp.Jkr.Dark.CriticalBg" Color="#4DFF6B5E"/>
    <SolidColorBrush x:Key="Cp.Jkr.Dark.Pass"       Color="#4fd38f"/>
    <SolidColorBrush x:Key="Cp.Jkr.Dark.PassBg"     Color="#264FD38F"/>
    <SolidColorBrush x:Key="Cp.Jkr.Dark.PassDot"    Color="#4fd38f"/>
    <SolidColorBrush x:Key="Cp.Jkr.Dark.Warn"       Color="#f5b942"/>
    <SolidColorBrush x:Key="Cp.Jkr.Dark.WarnBg"     Color="#24F5B942"/>
    <SolidColorBrush x:Key="Cp.Jkr.Dark.WarnLine"   Color="#59F5B942"/>
    <SolidColorBrush x:Key="Cp.Jkr.Dark.WarnDot"    Color="#f5b942"/>
    <SolidColorBrush x:Key="Cp.Jkr.Dark.Person"     Color="#8db8ff"/>
    <SolidColorBrush x:Key="Cp.Jkr.Dark.PersonBg"   Color="#2E7FB0FF"/>
    <SolidColorBrush x:Key="Cp.Jkr.Dark.PersonDot"  Color="#7fb0ff"/>
    <SolidColorBrush x:Key="Cp.Jkr.Dark.Pending"    Color="#f5b942"/>
    <SolidColorBrush x:Key="Cp.Jkr.Dark.PendingBg"  Color="#1AF5B942"/>
    <SolidColorBrush x:Key="Cp.Jkr.Dark.Listed"     Color="#a7b0bf"/>
    <SolidColorBrush x:Key="Cp.Jkr.Dark.ListedBg"   Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="Cp.Jkr.Dark.ListedDot"  Color="#8a94a6"/>
    <SolidColorBrush x:Key="Cp.Jkr.Dark.Na"         Color="#9fbcd0"/>
    <SolidColorBrush x:Key="Cp.Jkr.Dark.NaBg"       Color="#268FB0C4"/>
    <SolidColorBrush x:Key="Cp.Jkr.Dark.NaDot"      Color="#8fb0c4"/>
    <SolidColorBrush x:Key="Cp.Jkr.Dark.Track"      Color="#22303f"/>
    <SolidColorBrush x:Key="Cp.Jkr.Dark.InkHover"   Color="#ffffff"/>

    <!-- ═══════════ TOOL ICON-TILE PALETTES ═══════════ -->
    <SolidColorBrush x:Key="Cp.Tile.BlueBg"   Color="#dbeafe"/>
    <SolidColorBrush x:Key="Cp.Tile.BlueFg"   Color="#1d4ed8"/>
    <SolidColorBrush x:Key="Cp.Tile.AmberBg"  Color="#fef3c7"/>
    <SolidColorBrush x:Key="Cp.Tile.AmberFg"  Color="#a16207"/>
    <SolidColorBrush x:Key="Cp.Tile.GreenBg"  Color="#dcfce7"/>
    <SolidColorBrush x:Key="Cp.Tile.GreenFg"  Color="#15803d"/>
    <SolidColorBrush x:Key="Cp.Tile.VioletBg" Color="#ede9fe"/>
    <SolidColorBrush x:Key="Cp.Tile.VioletFg" Color="#6d28d9"/>
    <SolidColorBrush x:Key="Cp.Tile.SkyBg"    Color="#e0f2fe"/>
    <SolidColorBrush x:Key="Cp.Tile.SkyFg"    Color="#0369a1"/>
    <SolidColorBrush x:Key="Cp.Tile.RedBg"    Color="#fee2e2"/>
    <SolidColorBrush x:Key="Cp.Tile.RedFg"    Color="#b91c1c"/>
    <SolidColorBrush x:Key="Cp.Tile.IndigoBg" Color="#e0e7ff"/>
    <SolidColorBrush x:Key="Cp.Tile.IndigoFg" Color="#4338ca"/>
    <SolidColorBrush x:Key="Cp.Tile.SlateBg"  Color="#f1f5f9"/>
    <SolidColorBrush x:Key="Cp.Tile.SlateFg"  Color="#475569"/>

    <!-- ═══════════ TYPOGRAPHY ═══════════ -->
    <!-- Geist preferred; falls back to Segoe UI until woff2/ttf is embedded (Task 17). -->
    <FontFamily x:Key="Cp.Font">pack://application:,,,/RevitWebAppSync;component/Fonts/#Inter, Segoe UI, system-ui, sans-serif</FontFamily>
    <FontFamily x:Key="Cp.FontMono">Geist Mono, Cascadia Mono, Consolas, Courier New, monospace</FontFamily>

    <!-- ═══════════ DIMENSIONS ═══════════ -->
    <sys:Double x:Key="Cp.PanelWidth">440</sys:Double>

    <!-- ══════════════════════════════════════════════════════════════════════
         REASONING UI (docs/design/copilot-reasoning/README.md, canonical
         "BINA Copilot Thinking v2.dc.html") — 2026-08-02 spec.
         Separate Cp.Reasoning.*/Cp.System.* namespace, NOT a re-theme of the
         Cp.* palette above: the handoff's colors/type/spacing are FINAL for
         the reasoning timeline, approval card, and result card ONLY. Existing
         Cp.* keys (Cp.Accent, Cp.Font, …) keep every other screen unchanged —
         per the operator's override, this feature keeps the current BINA icon
         and does not restyle the rest of the panel.
         ══════════════════════════════════════════════════════════════════════ -->

    <!-- Ink / text -->
    <SolidColorBrush x:Key="Cp.Reasoning.Ink"          Color="#1c1e26"/>
    <SolidColorBrush x:Key="Cp.Reasoning.InkHover"     Color="#2c2f3a"/>
    <SolidColorBrush x:Key="Cp.Reasoning.TextPrimary"  Color="#22242a"/>
    <SolidColorBrush x:Key="Cp.Reasoning.TextSecondary" Color="#4a4e5c"/>
    <SolidColorBrush x:Key="Cp.Reasoning.Text"         Color="#75798c"/>   <!-- reasoning body -->
    <SolidColorBrush x:Key="Cp.Reasoning.TextMuted"    Color="#75798c"/>
    <SolidColorBrush x:Key="Cp.Reasoning.TextRowCount" Color="#5d6170"/>   <!-- result card row count (task 16 polish; distinct from TextMuted per handoff) -->
    <SolidColorBrush x:Key="Cp.Reasoning.TextFaint"    Color="#9397ab"/>
    <SolidColorBrush x:Key="Cp.Reasoning.TextFaint2"   Color="#9397ab"/>

    <!-- Borders / surfaces -->
    <SolidColorBrush x:Key="Cp.Reasoning.Border"       Color="#2122242A"/>
    <SolidColorBrush x:Key="Cp.Reasoning.Border2"      Color="#2122242A"/>
    <SolidColorBrush x:Key="Cp.Reasoning.Border3"      Color="#2122242A"/>
    <SolidColorBrush x:Key="Cp.Reasoning.BorderSubtle" Color="#1522242A"/>
    <SolidColorBrush x:Key="Cp.Reasoning.BorderSubtle2" Color="#1522242A"/>
    <SolidColorBrush x:Key="Cp.Reasoning.RailLine"     Color="#2122242A"/>
    <SolidColorBrush x:Key="Cp.Reasoning.Surface"      Color="#ffffff"/>
    <SolidColorBrush x:Key="Cp.Reasoning.SurfaceSunken" Color="#73FFFFFF"/>
    <SolidColorBrush x:Key="Cp.Reasoning.SurfaceSunken2" Color="#f0f1f7"/>
    <SolidColorBrush x:Key="Cp.Reasoning.Hover"        Color="#0D22242A"/>
    <SolidColorBrush x:Key="Cp.Reasoning.Hover2"       Color="#0722242A"/>
    <SolidColorBrush x:Key="Cp.Reasoning.Badge"        Color="#f0f1f7"/>   <!-- "N steps" mono pill bg -->
    <SolidColorBrush x:Key="Cp.Reasoning.BarTrack"     Color="#d9dce9"/>   <!-- result card proportion-bar track -->

    <!-- Accent (indigo — the reasoning module's own accent, distinct from
         Cp.Accent's blue used everywhere else) -->
    <SolidColorBrush x:Key="Cp.Reasoning.Accent"       Color="#2a69c6"/>
    <LinearGradientBrush x:Key="Cp.Reasoning.AccentGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0"    Color="#3b7ee0"/>
        <GradientStop Offset="0.55" Color="#2a69c6"/>
        <GradientStop Offset="1"    Color="#22549e"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Cp.Reasoning.Success"      Color="#2f9a72"/>
    <SolidColorBrush x:Key="Cp.Reasoning.WarnBg"       Color="#f7e8d2"/>
    <SolidColorBrush x:Key="Cp.Reasoning.WarnFg"       Color="#8a5a1e"/>

    <!-- Result-card system colours (color_hint -> token; "none"/unmapped falls
         back to Cp.System.None). Fixed hex per the handoff — do NOT theme-shift. -->
    <SolidColorBrush x:Key="Cp.System.Supply"          Color="#2563eb"/>
    <SolidColorBrush x:Key="Cp.System.Return"          Color="#dc2626"/>
    <SolidColorBrush x:Key="Cp.System.Exhaust"         Color="#eab308"/>
    <SolidColorBrush x:Key="Cp.System.None"            Color="#d4d4da"/>

    <!-- Approval card "Needs permission" amber badge -->
    <LinearGradientBrush x:Key="Cp.Reasoning.WarnHeadGrad" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#fffdf8"/>
        <GradientStop Offset="1" Color="#ffffff"/>
    </LinearGradientBrush>

    <!-- Typography — Instrument Sans (UI) + JetBrains Mono (metadata/counts/
         timers/mono labels). Self-hosted per the handoff ("the WebView may be
         offline" — same reasoning applies to a Revit dockable pane with no
         guaranteed internet/font access on a locked-down drafting machine).
         Pack-URI-first with the same OS fallback chain as Cp.Font/Cp.FontMono
         above: until the real .ttf files land in Fonts\ (see Fonts\README.txt),
         WPF can't resolve the pack URI family and silently falls through to
         the fallback names — dropping the files in later "just works" with NO
         further code change, matching the Cp.Font precedent (Task 17). -->
    <FontFamily x:Key="Cp.Reasoning.Font">pack://application:,,,/RevitWebAppSync;component/Fonts/#Inter, Segoe UI, system-ui, sans-serif</FontFamily>
    <FontFamily x:Key="Cp.Reasoning.FontMono">pack://application:,,,/RevitWebAppSync;component/Fonts/#JetBrains Mono, Cascadia Mono, Consolas, Courier New, monospace</FontFamily>

    <!-- Spacing scale (README: 4/6/8/9/10/11/13/14/16/20/22px) — exposed as
         named doubles for code-behind consumers (ReasoningTimelineView etc.);
         XAML call sites mostly hardcode Margin/Padding thicknesses directly. -->
    <sys:Double x:Key="Cp.Reasoning.Space.xs">4</sys:Double>
    <sys:Double x:Key="Cp.Reasoning.Space.sm">8</sys:Double>
    <sys:Double x:Key="Cp.Reasoning.Space.md">13</sys:Double>
    <sys:Double x:Key="Cp.Reasoning.Space.lg">16</sys:Double>
    <sys:Double x:Key="Cp.Reasoning.Space.xl">20</sys:Double>

    <!-- Radii (README: 3 swatch / 5 / 7 / 8 / 9 buttons / 13-14 cards / 99 pill) -->
    <sys:Double x:Key="Cp.Reasoning.Radius.Swatch">3</sys:Double>
    <sys:Double x:Key="Cp.Reasoning.Radius.Sm">7</sys:Double>
    <sys:Double x:Key="Cp.Reasoning.Radius.Md">9</sys:Double>
    <sys:Double x:Key="Cp.Reasoning.Radius.Card">13</sys:Double>
    <sys:Double x:Key="Cp.Reasoning.Radius.Pill">999</sys:Double>

    <!-- Card / composer shadows (DropShadowEffect — WPF has no multi-layer
         box-shadow, so this approximates the handoff's two-layer card shadow
         with one blurred, low-opacity drop). -->
    <DropShadowEffect x:Key="Cp.Reasoning.CardShadow"
                       Color="#0b0b0f" Opacity="0.14" BlurRadius="20" ShadowDepth="4" Direction="270"/>

</ResourceDictionary>
