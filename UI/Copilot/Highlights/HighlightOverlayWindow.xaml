<Window x:Class="RevitWebAppSync.UI.Copilot.Highlights.HighlightOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cp="clr-namespace:RevitWebAppSync.UI.Copilot.Controls"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize" IsTabStop="False" Focusable="False"
        FontFamily="Geist, Segoe UI, sans-serif">
    <!-- Root has no background → empty areas are click-through to Revit underneath.
         Only the key (or the hidden pill) and the legacy chip take input. -->
    <Grid Background="{x:Null}">
        <Canvas x:Name="MarkerCanvas" IsHitTestVisible="False"/>

        <!-- Legacy "N highlighted in model" chip (top-center), kept for the Highlights collection. -->
        <Border x:Name="Chip" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,16,0,0" Visibility="Collapsed"
                CornerRadius="999" Background="{cp:CpToken Cp.Overlay.Pill}" Padding="12,8,14,8">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Fill="{cp:CpToken Cp.Overlay.Dot}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="ChipText" Foreground="White" FontSize="12.5" VerticalAlignment="Center"/>
                <Button x:Name="ClearBtn" Content="Clear" Cursor="Hand" Margin="10,0,0,0" IsHitTestVisible="True"
                        Foreground="White" FontSize="11" Background="{cp:CpToken Cp.Overlay.Btn}" BorderThickness="0" Padding="10,3,10,3">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="999" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>

        <!-- The result key (or, hidden, the pill), placed by code in the first corner with no mark under it. -->
        <Canvas x:Name="KeyLayer"/>
    </Grid>
</Window>
