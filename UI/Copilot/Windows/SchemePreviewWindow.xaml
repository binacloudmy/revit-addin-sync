<Window x:Class="RevitWebAppSync.UI.Copilot.Windows.SchemePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:RevitWebAppSync.UI.Copilot.Controls"
        Title="Scheme Preview"
        Width="560" Height="400" MinWidth="320" MinHeight="120"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        WindowStartupLocation="Manual" SnapsToDevicePixels="True"
        Background="Transparent" AllowsTransparency="True"
        FontFamily="{DynamicResource Cp.Font}">
    <!-- Floating, NON-modal by design: the pane must stay interactive while this
         is open (hovering a scheme redraws the preview), and Revit itself must
         not be blocked — a preview that freezes the host would be worse than no
         preview. Owned by the Revit main window so it always floats above it
         and closes with it. -->
    <Border Background="{DynamicResource Cp.Bg}" BorderBrush="{DynamicResource Cp.Hair2}"
            BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.22" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- title bar -->
                <RowDefinition Height="Auto"/>   <!-- toolbar: levels + legends -->
                <RowDefinition Height="*"/>      <!-- plan -->
            </Grid.RowDefinitions>

            <!-- ── Title bar: drag to move, double-click to dock/float ────── -->
            <Border x:Name="TitleBar" Grid.Row="0" Height="26" CornerRadius="5,5,0,0"
                    Background="{DynamicResource Cp.Menu}"
                    BorderBrush="{DynamicResource Cp.Line}" BorderThickness="0,0,0,1">
                <Grid Margin="9,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sparkle mark (same glyph as the design) -->
                    <Path Grid.Column="0" Width="12" Height="12" Stretch="Uniform"
                          Fill="#6366f1" VerticalAlignment="Center" Margin="0,0,8,0"
                          Data="M12 2.5l2.1 5.6 5.6 2.1-5.6 2.1-2.1 5.6-2.1-5.6-5.6-2.1 5.6-2.1z"/>

                    <TextBlock Grid.Column="1" Text="Scheme Preview" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Cp.Ink}" VerticalAlignment="Center"/>

                    <TextBlock x:Name="SubTitle" Grid.Column="2" FontSize="11" Margin="8,0,8,0"
                               Foreground="{DynamicResource Cp.Muted}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>

                    <!-- data-nodrag equivalents: these set e.Handled so a click
                         on them never starts a window drag. -->
                    <Border x:Name="DockChip" Grid.Column="3" CornerRadius="3" Padding="6,1" Cursor="Hand"
                            BorderBrush="{DynamicResource Cp.Hair2}" BorderThickness="1"
                            VerticalAlignment="Center" Margin="0,0,4,0">
                        <TextBlock x:Name="DockLabel" FontSize="10.5" Text="Dock"
                                   Foreground="{DynamicResource Cp.Muted}"/>
                    </Border>

                    <TextBlock x:Name="CollapseGlyph" Grid.Column="4" Text="&#x2013;" FontSize="12" Cursor="Hand"
                               Foreground="{DynamicResource Cp.Muted}" VerticalAlignment="Center"
                               Padding="5,0" ToolTip="Collapse"/>

                    <TextBlock x:Name="CloseGlyph" Grid.Column="5" Text="&#x2715;" FontSize="11.5" Cursor="Hand"
                               Foreground="{DynamicResource Cp.Muted}" VerticalAlignment="Center"
                               Padding="4,0" ToolTip="Close preview"/>
                </Grid>
            </Border>

            <!-- ── Toolbar: level tabs + legends (built in code-behind) ────── -->
            <Border x:Name="ToolbarWrap" Grid.Row="1" Background="{DynamicResource Cp.Sunken}"
                    BorderBrush="{DynamicResource Cp.Line}" BorderThickness="0,0,0,1" Padding="10,5">
                <WrapPanel x:Name="Toolbar" Orientation="Horizontal" ItemHeight="20"/>
            </Border>

            <!-- ── The plan. Draw-only: this window never touches the model. ── -->
            <!-- Cp.Card is a Button STYLE, not a brush — binding it to Background
                 throws at arrange time. Surface tokens are Cp.Bg/Menu/Sunken. -->
            <Grid x:Name="PlanWrap" Grid.Row="2" Background="{DynamicResource Cp.Bg}">
                <ctl:MassingPlanCanvas x:Name="Plan" ShowLegend="False" Margin="2"/>
                <TextBlock x:Name="Watermark" Text="Schematic preview — not a Revit view"
                           FontSize="10.5" Foreground="{DynamicResource Cp.Faint}"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Margin="0,0,16,6" IsHitTestVisible="False"/>
            </Grid>
        </Grid>
    </Border>
</Window>
