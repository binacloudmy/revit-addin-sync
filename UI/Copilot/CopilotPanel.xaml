<Page x:Class="RevitWebAppSync.UI.Copilot.CopilotPanel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ctl="clr-namespace:RevitWebAppSync.UI.Copilot.Controls"
      Background="{DynamicResource Cp.PanelBg}"
      FontFamily="{DynamicResource Cp.Font}">

    <Page.Resources>
        <ctl:HexToBrushConverter x:Key="Hex"/>
        <ctl:BoolToVisibilityConverter x:Key="BoolVis"/>
        <ctl:NotEmptyToVisibilityConverter x:Key="NotEmptyVis"/>
        <ctl:EnumEqualsConverter x:Key="EnumEq"/>
    </Page.Resources>

    <Grid UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>   <!-- content -->
            <ColumnDefinition Width="46"/>  <!-- rail (design: right-side icon rail) -->
        </Grid.ColumnDefinitions>

        <!-- ═══ Content column ═══ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- breadcrumb -->
                <RowDefinition Height="*"/>     <!-- body -->
            </Grid.RowDefinitions>

            <!-- Breadcrumb (tool-form / tool-review) -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource Cp.LineSoft}" BorderThickness="0,0,0,1" Padding="16,7"
                    Visibility="{Binding ShowBreadcrumb, Converter={StaticResource BoolVis}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding BackCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Padding="0" Foreground="{DynamicResource Cp.Faint}" FontSize="11.5"
                            Content="{Binding BreadcrumbRoot, Mode=OneWay}"/>
                    <Path Width="11" Height="11" Margin="5,0,5,0" Stretch="Uniform" Stroke="{DynamicResource Cp.Faint}" StrokeThickness="1.6"
                          VerticalAlignment="Center" Data="M9,6 l6,6 -6,6"/>
                    <TextBlock Text="{Binding CurrentTool.Title, Mode=OneWay}" FontSize="11.5" Foreground="{DynamicResource Cp.Text}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Body -->
            <ContentControl Grid.Row="1" x:Name="BodyHost"/>
        </Grid>

        <!-- ═══ Right icon rail (design: 46px, surface bg, hairline left border;
             logo · + new chat · nav icons · ⟷ · search · gear). Theme toggle and
             the kebab menu are house extras kept below the design pair so Rate /
             Report / WhatsApp / version stay reachable. ═══ -->
        <Border Grid.Column="1" Background="{DynamicResource Cp.Bg}"
                BorderBrush="{DynamicResource Cp.Line}" BorderThickness="1,0,0,0"
                Padding="0,9,0,8">
            <DockPanel LastChildFill="False">
                <!-- Top group -->
                <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center">
                    <!-- Binazone logo mark (design: 22px binazone-logo.png in the
                         28px rail slot). Full ;component pack URI — Revit hosts
                         the CLR, bare pack URIs crash. -->
                    <Grid Width="28" Height="28" Margin="0,0,0,5" ToolTip="Bina AI Copilot">
                        <Image Width="22" Height="22" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="pack://application:,,,/RevitWebAppSync;component/Resources/binazone-logo.png"/>
                    </Grid>

                    <!-- New chat: 30×30, radius 9, accent outline (design). -->
                    <Button x:Name="NewChatBtn" Width="30" Height="30" Cursor="Hand" Margin="0,0,0,6"
                            Background="Transparent" FocusVisualStyle="{x:Null}"
                            Command="{Binding ClearChatCommand}" ToolTip="New chat">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9"
                                        BorderBrush="#592A69C6" BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#1A2A69C6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Path Width="13" Height="13" Stretch="Uniform" Stroke="{DynamicResource Cp.Accent}" StrokeThickness="1.9"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M12,5 v14 M5,12 h14"/>
                    </Button>

                    <!-- Nav: Chat / History / Model (icon-only, 17px). -->
                    <ToggleButton Style="{DynamicResource Cp.RailButton}" Command="{Binding GoTabCommand}" CommandParameter="Chat"
                                  IsChecked="{Binding Tab, Mode=OneWay, Converter={StaticResource EnumEq}, ConverterParameter=Chat}"
                                  ToolTip="Chat">
                        <Path Width="17" Height="17" Stretch="Uniform" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              Data="M12,3 a9,9 0 0 1 9,9 a9,9 0 0 1 -9,9 c-1.6,0 -3.1,-0.4 -4.4,-1.1 L3,21 l1.1,-4.6 C3.4,15.1 3,13.6 3,12 a9,9 0 0 1 9,-9 Z M8,12 h0.01 M12,12 h0.01 M16,12 h0.01"/>
                    </ToggleButton>
                    <ToggleButton Style="{DynamicResource Cp.RailButton}" Command="{Binding GoTabCommand}" CommandParameter="History"
                                  IsChecked="{Binding Tab, Mode=OneWay, Converter={StaticResource EnumEq}, ConverterParameter=History}"
                                  ToolTip="History">
                        <Path Width="17" Height="17" Stretch="Uniform" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              Data="M3.5,12 a8.5,8.5 0 1 0 2.5,-6 L3.5,8.5 M3.5,3.5 v5 h5 M12,7.5 V12 l3,2"/>
                    </ToggleButton>
                    <ToggleButton Style="{DynamicResource Cp.RailButton}" Command="{Binding GoTabCommand}" CommandParameter="Model"
                                  IsChecked="{Binding Tab, Mode=OneWay, Converter={StaticResource EnumEq}, ConverterParameter=Model}"
                                  ToolTip="Model">
                        <Path Width="17" Height="17" Stretch="Uniform" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              Data="M12,3 l8,4.5 v9 L12,21 l-8,-4.5 v-9 Z M12,12 l8,-4.5 M12,12 v9 M12,12 L4,7.5"/>
                    </ToggleButton>
                </StackPanel>

                <!-- Bottom group: search · gear (design), then theme · kebab (house). -->
                <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center">
                    <Button x:Name="SearchBtn" Style="{DynamicResource Cp.RailAction}" Click="OnOpenSearch" ToolTip="Search · Ctrl+K">
                        <Path Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.9"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M3,10 a7,7 0 1 0 14,0 a7,7 0 1 0 -14,0 M21,21 l-5.2,-5.2"/>
                    </Button>
                    <ToggleButton x:Name="GearBtn" Style="{DynamicResource Cp.RailButton}" Command="{Binding GoTabCommand}" CommandParameter="Settings"
                                  IsChecked="{Binding Tab, Mode=OneWay, Converter={StaticResource EnumEq}, ConverterParameter=Settings}"
                                  ToolTip="Settings">
                        <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.7"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              Data="M12,8.5 a3.5,3.5 0 1 0 0,7 a3.5,3.5 0 1 0 0,-7 M19.4,15 a1.65,1.65 0 0 0 0.33,1.82 l0.06,0.06 a2,2 0 1 1 -2.83,2.83 l-0.06,-0.06 a1.65,1.65 0 0 0 -1.82,-0.33 a1.65,1.65 0 0 0 -1,1.51 V21 a2,2 0 1 1 -4,0 v-0.09 a1.65,1.65 0 0 0 -1.08,-1.51 a1.65,1.65 0 0 0 -1.82,0.33 l-0.06,0.06 a2,2 0 1 1 -2.83,-2.83 l0.06,-0.06 a1.65,1.65 0 0 0 0.33,-1.82 a1.65,1.65 0 0 0 -1.51,-1 H3 a2,2 0 1 1 0,-4 h0.09 a1.65,1.65 0 0 0 1.51,-1.08 a1.65,1.65 0 0 0 -0.33,-1.82 l-0.06,-0.06 a2,2 0 1 1 2.83,-2.83 l0.06,0.06 a1.65,1.65 0 0 0 1.82,0.33 h0 a1.65,1.65 0 0 0 1,-1.51 V3 a2,2 0 1 1 4,0 v0.09 a1.65,1.65 0 0 0 1,1.51 h0 a1.65,1.65 0 0 0 1.82,-0.33 l0.06,-0.06 a2,2 0 1 1 2.83,2.83 l-0.06,0.06 a1.65,1.65 0 0 0 -0.33,1.82 v0 a1.65,1.65 0 0 0 1.51,1 H21 a2,2 0 1 1 0,4 h-0.09 a1.65,1.65 0 0 0 -1.51,1 z"/>
                    </ToggleButton>
                    <Border Height="1" Width="22" Background="{DynamicResource Cp.Line}" Margin="0,3,0,6"/>
                    <Button x:Name="ThemeBtn" Style="{DynamicResource Cp.RailAction}" Click="OnToggleTheme" ToolTip="Toggle theme">
                        <Path x:Name="ThemeIcon" Width="15" Height="15" Stretch="Uniform" Fill="Transparent"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M21,12.8 A9,9 0 1 1 11.2,3 A7,7 0 0 0 21,12.8 Z"/>
                    </Button>
                    <Button x:Name="MenuBtn" Style="{DynamicResource Cp.RailAction}" Margin="0" Click="OnOpenMenu" ToolTip="Menu">
                        <Path Width="16" Height="16" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M11,5 A1,1 0 1 0 13,5 A1,1 0 1 0 11,5 Z M11,12 A1,1 0 1 0 13,12 A1,1 0 1 0 11,12 Z M11,19 A1,1 0 1 0 13,19 A1,1 0 1 0 11,19 Z"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Kebab dropdown: Rate Copilot / Report a bug — opens leftward from the
             rail-bottom kebab. -->
        <Popup x:Name="MenuPopup" PlacementTarget="{Binding ElementName=MenuBtn}" Placement="Left"
               HorizontalOffset="4" VerticalOffset="-120" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <!-- Layered: soft shadow on a sibling behind, so the text card
                 itself is never rasterized (crisp text, clean edges). -->
            <Grid Margin="10" UseLayoutRounding="True"
                  TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
                <Border Background="{DynamicResource Cp.Menu}" CornerRadius="12" MinWidth="188">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.14" Color="#000000"/>
                    </Border.Effect>
                </Border>
                <Border Background="{DynamicResource Cp.Menu}" BorderBrush="{DynamicResource Cp.Line}" BorderThickness="1"
                    CornerRadius="12" Padding="5" MinWidth="188">
                <StackPanel>
                    <Button Style="{DynamicResource Cp.MenuItem}" Click="OnRate">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"
                                  Fill="Transparent" Stroke="{DynamicResource Cp.Muted}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M12,2 l3.1,6.3 6.9,1 -5,4.9 1.2,6.8 L12,17.8 5.8,21 7,14.2 2,9.3 l6.9,-1 Z"/>
                            <TextBlock Text="Rate Copilot" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource Cp.MenuItem}" Click="OnReportBug">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"
                                  Fill="Transparent" Stroke="{DynamicResource Cp.Muted}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M8,2.5 9.5,5 M16,2.5 14.5,5 M6,6 h12 v7 a6,6 0 0 1 -12,0 Z M3,11 h3 M18,11 h3 M3,16 h3.2 M17.8,16 H21 M12,6 v13"/>
                            <TextBlock Text="Report a bug" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource Cp.MenuItem}" Click="OnWhatsApp">
                        <StackPanel Orientation="Horizontal">
                            <!-- WhatsApp: official brand mark (green #25D366 bubble, white
                                 phone) — full colour, unlike the monochrome outline icons
                                 above. Converted from the design file's SVG. Three layers:
                                 a transparent 24-box for size parity with the other icons, a
                                 white bubble behind, then the green bubble on top whose phone
                                 sub-path is a nonzero-fill (F1) hole that reveals the white. -->
                            <Image Width="15" Height="15" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Image.Source>
                                    <DrawingImage>
                                        <DrawingImage.Drawing>
                                            <DrawingGroup>
                                                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
                                                <GeometryDrawing Brush="White"
                                                    Geometry="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.71.45 3.38 1.3 4.85L2 22l5.38-1.41a9.9 9.9 0 0 0 4.66 1.19h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.87 9.87 0 0 0 12.04 2Z"/>
                                                <GeometryDrawing Brush="#25D366"
                                                    Geometry="F1 M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.71.45 3.38 1.3 4.85L2 22l5.38-1.41a9.9 9.9 0 0 0 4.66 1.19h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.87 9.87 0 0 0 12.04 2Zm5.8 14.14c-.24.68-1.4 1.3-1.93 1.38-.5.08-1.11.11-1.79-.11a16.6 16.6 0 0 1-1.6-.6c-2.83-1.23-4.67-4.08-4.81-4.27-.14-.19-1.15-1.53-1.15-2.92 0-1.39.73-2.07.99-2.35.26-.28.57-.35.76-.35h.55c.17 0 .41-.03.63.48.24.57.81 1.97.88 2.11.07.14.12.31.02.5-.09.19-.14.31-.28.47-.14.17-.29.37-.42.5-.14.14-.28.29-.12.57.16.28.71 1.18 1.53 1.91 1.05.94 1.94 1.23 2.22 1.37.28.14.44.12.6-.07.17-.19.7-.81.89-1.09.19-.28.38-.23.63-.14.26.09 1.64.78 1.92.92.28.14.47.21.53.33.07.12.07.68-.17 1.36Z"/>
                                            </DrawingGroup>
                                        </DrawingImage.Drawing>
                                    </DrawingImage>
                                </Image.Source>
                            </Image>
                            <TextBlock Text="Get help on WhatsApp" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Hairline divider + version line. Non-interactive:
                         IsHitTestVisible/Focusable off, so no hover, no
                         focus, cursor stays default. Text is set in code
                         from AppInfo (never hardcoded). -->
                    <Border Height="1" Background="{DynamicResource Cp.Line}" Margin="5,6,5,0"/>
                    <TextBlock x:Name="VersionLine" Margin="12,8,12,3" FontSize="10.5"
                               Foreground="{DynamicResource Cp.Faint}"
                               IsHitTestVisible="False" Focusable="False"/>
                </StackPanel>
                </Border>
            </Grid>
        </Popup>

        <!-- ═══ Indexing overlay ═══
             Covers the whole pane (both columns) while the model mirror is being
             seeded. The opaque background is hit-test visible, so it disables
             every control underneath until indexing completes. -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" Background="#F7FFFFFF"
                Visibility="{Binding IsIndexing, Converter={StaticResource BoolVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding IndexTitle, Mode=OneWay}" HorizontalAlignment="Center"
                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Cp.Ink}"/>
                <!-- Progress bar built from plain Borders — NO Storyboard / animation
                     (WPF storyboards inside a Revit dockable pane crash Revit). The
                     fill width is driven directly by IndexProgressBarWidth (0–220). -->
                <Border Width="220" Height="8" CornerRadius="4" Background="{DynamicResource Cp.Line}"
                        Margin="0,14,0,0" HorizontalAlignment="Center" ClipToBounds="True">
                    <Border HorizontalAlignment="Left" CornerRadius="4"
                            Background="{DynamicResource Cp.AccentGrad}"
                            Width="{Binding IndexProgressBarWidth}"/>
                </Border>
                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="12"
                           FontWeight="SemiBold" Foreground="{DynamicResource Cp.Accent}"
                           Text="{Binding IndexProgress, StringFormat={}{0}%}"/>
                <TextBlock Text="{Binding IndexSubtitle, Mode=OneWay}"
                           Margin="0,8,0,0" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="240"
                           FontSize="11" Foreground="{DynamicResource Cp.Muted}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ═══ Bottom-sheet overlay (Rate / Report) ═══
             Covers both columns. A tap on the scrim dismisses. The sheet itself is
             built + slid up from code-behind (SheetHost), so no XAML Storyboard
             runs inside the Revit dockable pane. Collapsed until a sheet opens. -->
        <Grid x:Name="SheetLayer" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Collapsed">
            <Border x:Name="SheetScrim" Background="#66000000" MouseLeftButtonDown="OnScrimClick"/>
            <ContentControl x:Name="SheetHost" VerticalAlignment="Bottom"/>
        </Grid>
    </Grid>
</Page>
