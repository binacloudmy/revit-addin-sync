<UserControl x:Class="RevitWebAppSync.UI.Copilot.Controls.ToolHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:RevitWebAppSync.UI.Copilot.Controls"
             FontFamily="{DynamicResource Cp.Font}">
    <Border BorderBrush="{DynamicResource Cp.Line}" BorderThickness="0,0,0,1" Padding="14,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BackBtn" Grid.Column="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                    Padding="0,0,6,0" VerticalAlignment="Top" Margin="-4,0,0,0">
                <Path Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource Cp.Muted}" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M15,6 l-6,6 6,6"/>
            </Button>

            <ctl:IconTile x:Name="Tile" Grid.Column="1" TileSize="30" GlyphSize="15" VerticalAlignment="Top"/>

            <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="Title" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Cp.Ink}" VerticalAlignment="Center"/>
                    <ctl:TierBadge x:Name="Badge" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="Subtitle" FontSize="11.5" Foreground="{DynamicResource Cp.Muted}" Margin="0,1,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
