<UserControl x:Class="RevitWebAppSync.UI.Copilot.Controls.ToolCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:RevitWebAppSync.UI.Copilot.Controls">
    <Button x:Name="Root" Style="{DynamicResource Cp.Card}" Margin="0,0,0,6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- vetted left stripe (3px green) overlays the card's left edge -->
            <Border x:Name="Stripe" Grid.Column="0" Width="3" Background="#16a34a"
                    HorizontalAlignment="Left" Margin="-11,-11,0,-11" Visibility="Collapsed"/>

            <ctl:IconTile x:Name="Tile" Grid.Column="0" TileSize="30" GlyphSize="15" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="Title" FontSize="12.8" FontWeight="SemiBold" Foreground="#0b0d12"
                               FontFamily="{DynamicResource Cp.Font}" VerticalAlignment="Center"/>
                    <Path x:Name="PinGlyph" Width="11" Height="11" Margin="6,0,0,0" Stretch="Uniform"
                          Fill="#a16207" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <Border x:Name="SavedPill" CornerRadius="999" Background="#eff6ff" Padding="6,1,6,1"
                            Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="Saved" FontSize="11" Foreground="#1e40af" FontFamily="{DynamicResource Cp.Font}"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="Desc" FontSize="11.5" Foreground="#6b7280" TextWrapping="Wrap"
                           Margin="0,2,0,0" FontFamily="{DynamicResource Cp.Font}"/>
            </StackPanel>

            <Path x:Name="Trailing" Grid.Column="2" Width="13" Height="13" Stretch="Uniform"
                  Stroke="#9ca3af" StrokeThickness="1.8" VerticalAlignment="Center" Margin="8,0,0,0"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        </Grid>
    </Button>
</UserControl>
