<UserControl x:Class="RevitWebAppSync.UI.Copilot.Controls.TierBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Left" VerticalAlignment="Center">
    <Border x:Name="Pill" CornerRadius="999" SnapsToDevicePixels="True">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Path x:Name="Glyph" Width="9" Height="9" Stretch="Uniform" Margin="0,0,3,0"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            <TextBlock x:Name="Label" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>
