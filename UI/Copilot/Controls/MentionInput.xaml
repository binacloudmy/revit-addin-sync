<UserControl x:Class="RevitWebAppSync.UI.Copilot.Controls.MentionInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource Cp.Font}">
    <Grid>
        <TextBox x:Name="Editor" BorderThickness="0" Background="Transparent" FontSize="13"
                 Foreground="{DynamicResource Cp.Ink}" CaretBrush="{DynamicResource Cp.Ink}"
                 VerticalContentAlignment="Top"
                 TextWrapping="Wrap" MaxHeight="80" AcceptsReturn="True" AllowDrop="True"
                 VerticalScrollBarVisibility="Auto"/>
        <TextBlock x:Name="Placeholder" IsHitTestVisible="False" Foreground="{DynamicResource Cp.Faint}"
                   FontSize="13" VerticalAlignment="Top" Margin="2,0,0,0"/>
        <Popup x:Name="Picker" PlacementTarget="{Binding ElementName=Editor}" Placement="Top"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{DynamicResource Cp.Menu}" BorderBrush="{DynamicResource Cp.Line}" BorderThickness="1"
                    CornerRadius="12" Padding="6" MinWidth="240"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.5" Color="#000000"/>
                </Border.Effect>
                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PickerHost"/>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
