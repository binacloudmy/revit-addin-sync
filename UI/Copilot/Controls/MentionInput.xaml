<UserControl x:Class="RevitWebAppSync.UI.Copilot.Controls.MentionInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource Cp.Font}">
    <Grid>
        <TextBox x:Name="Editor" BorderThickness="0" Background="Transparent" FontSize="13"
                 Foreground="{DynamicResource Cp.Ink}" VerticalContentAlignment="Center"
                 TextWrapping="Wrap" MaxHeight="80" AcceptsReturn="False" AllowDrop="True"/>
        <TextBlock x:Name="Placeholder" IsHitTestVisible="False" Foreground="{DynamicResource Cp.Faint}"
                   FontSize="13" VerticalAlignment="Center" Margin="2,0,0,0"/>
        <Popup x:Name="Picker" PlacementTarget="{Binding ElementName=Editor}" Placement="Top"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="White" BorderBrush="{DynamicResource Cp.Line}" BorderThickness="1"
                    CornerRadius="10" Padding="4" MinWidth="240"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.16" Color="#000000"/>
                </Border.Effect>
                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PickerHost"/>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
