<UserControl x:Class="RevitWebAppSync.UI.Copilot.Controls.PromptBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:RevitWebAppSync.UI.Copilot.Controls"
             FontFamily="{DynamicResource Cp.Font}">
    <Border BorderBrush="{DynamicResource Cp.Line}" BorderThickness="0,1,0,0" Background="White" Padding="12">
        <StackPanel>
            <!-- pending pasted screenshots (thumbnail chips with an × to remove) -->
            <StackPanel x:Name="ThumbStrip" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,8"/>
            <Border BorderBrush="{DynamicResource Cp.Line}" BorderThickness="1" CornerRadius="12" Padding="12,8,10,8">
                <DockPanel LastChildFill="True">
                    <!-- AI pill -->
                    <Border DockPanel.Dock="Right" CornerRadius="999" Background="{DynamicResource Cp.PurpleSoft}"
                            Padding="6,2" Margin="6,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="AI" FontSize="10" Foreground="{DynamicResource Cp.Purple}"/>
                    </Border>
                    <!-- attach file button (pink) — temporarily disabled; drag-drop still works
                    <Button x:Name="AttachBtn" DockPanel.Dock="Right" Width="26" Height="26" Cursor="Hand"
                            Background="{DynamicResource Cp.BotGradient}" BorderThickness="0" VerticalAlignment="Center"
                            Margin="0,0,4,0" ToolTip="Attach a file (.txt, .csv, .md, .log, .json, .xml)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Path Width="12" Height="12" Stretch="Uniform" Fill="White"
                              Data="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
                    </Button>
                    -->
                    <!-- send / stop (icon swaps to a stop square while a reply streams) -->
                    <Button x:Name="SendBtn" DockPanel.Dock="Right" Width="26" Height="26" Cursor="Hand"
                            Background="{DynamicResource Cp.Ink}" BorderThickness="0" VerticalAlignment="Center"
                            ToolTip="Send" Margin="0,0,4,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Path x:Name="SendIcon" Width="11" Height="11" Stretch="Uniform" Fill="White"
                              Data="M6,4 l14,8 -14,8 V4 z"/>
                    </Button>
                    <ctl:MentionInput x:Name="Input" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            <TextBlock x:Name="PlaceholderHint" HorizontalAlignment="Center" Margin="0,6,0,0"
                       FontSize="10.5" Foreground="{DynamicResource Cp.Faint}"
                       Text="Type @ to reference a level, category, view, or selection"/>
        </StackPanel>
    </Border>
</UserControl>
