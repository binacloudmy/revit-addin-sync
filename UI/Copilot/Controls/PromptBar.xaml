<UserControl x:Class="RevitWebAppSync.UI.Copilot.Controls.PromptBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:RevitWebAppSync.UI.Copilot.Controls"
             FontFamily="{DynamicResource Cp.Font}">
    <Border Background="{DynamicResource Cp.PanelBg}" Padding="14,8,14,12">
        <StackPanel>
            <!-- pending pasted screenshots (thumbnail chips with an × to remove) -->
            <StackPanel x:Name="ThumbStrip" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,8"/>
            <!-- pending slash command (accent chip with an × to clear) -->
            <StackPanel x:Name="CommandStrip" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,8"/>
            <!-- v6 composer: floating white card on the paper ground — 1px
                 divider border, radius 14, soft shadow. Two rows: input, then
                 the action row (attach, @, /, Reasoning chip, Action Mode chip,
                 flex spacer, send). -->
            <Border x:Name="ComposerBox" Background="{DynamicResource Cp.Bg}"
                    BorderBrush="{DynamicResource Cp.Line}" BorderThickness="1"
                    CornerRadius="14" Padding="13,11,10,9">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="14" ShadowDepth="3" Direction="270"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Row 1: input alone. -->
                    <ctl:MentionInput x:Name="Input" VerticalAlignment="Center"/>

                    <!-- Row 2: action row. LastChildFill="False" + explicit
                         Left/Right docks (not a single fill child) is what
                         produces the artifact's "icon cluster ⟷ flex spacer ⟷
                         send button" layout — DockPanel leaves whatever space
                         is left between the two docked groups blank, which
                         reads as the flex spacer with no extra element needed. -->
                    <DockPanel LastChildFill="False" Margin="0,10,0,0">
                        <!-- attach file button -->
                        <Button x:Name="AttachBtn" DockPanel.Dock="Left" Width="26" Height="26" Cursor="Hand"
                                Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                FocusVisualStyle="{x:Null}"
                                ToolTip="Attach a file (.txt, .csv, .md, .log, .json, .xml)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Cp.Hover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Path Width="14" Height="14" Stretch="Uniform" Fill="Transparent"
                                  Stroke="{DynamicResource Cp.Muted}" StrokeThickness="1.9"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
                        </Button>
                        <!-- @ mention button -->
                        <Button x:Name="AtBtn" DockPanel.Dock="Left" Width="26" Height="26" Cursor="Hand"
                                Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                FocusVisualStyle="{x:Null}" Margin="2,0,0,0"
                                ToolTip="Reference a level, category, view, or selection">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Cp.Hover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Path Width="16" Height="16" Stretch="Uniform" Fill="Transparent"
                                  Stroke="{DynamicResource Cp.Muted}" StrokeThickness="1.9"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M16,8 v5 a3,3 0 0 0 6,0 v-1 a10,10 0 1 0 -4,8 M12,8 a4,4 0 1 0 0,8 a4,4 0 1 0 0,-8"/>
                        </Button>
                        <!-- "/" tools button (v6): opens the same slash palette
                             typing "/" opens. -->
                        <Button x:Name="SlashBtn" DockPanel.Dock="Left" Width="26" Height="26" Cursor="Hand"
                                Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                FocusVisualStyle="{x:Null}" Margin="2,0,0,0" Click="OnSlashBtnClick"
                                ToolTip="Tools (/)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Cp.Hover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Path Width="15" Height="15" Stretch="Uniform" Fill="Transparent"
                                  Stroke="{DynamicResource Cp.Muted}" StrokeThickness="1.9"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M4,17 l6,-5 -6,-5 M12,19 h8"/>
                        </Button>
                        <!-- Reasoning toggle chip (2026-08-02 copilot-reasoning-ui
                             spec): controls whether `reasoning` SSE frames are
                             shown for the next turn. Persisted via
                             CopilotPrefs.ReasoningEnabled. -->
                        <Button x:Name="ReasoningBtn" DockPanel.Dock="Left" Cursor="Hand"
                                Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                FocusVisualStyle="{x:Null}" Margin="4,0,0,0"
                                ToolTip="Toggle the reasoning timeline for the next turn">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <!-- 2026-08-27 composer refresh: quiet text toggle (dot + label,
                                         hover pad only) — the bordered ring made it read as a
                                         different control class from the "Ask first" chip next to it. -->
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="9,4,9,4">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Cp.Hover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="ReasoningDot" Width="5" Height="5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Reasoning" FontSize="11.5" Foreground="{DynamicResource Cp.Muted}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Action Mode chip (2026-08-02 addendum): "Ask first"
                             (amber, default) / "Auto" (green) — opens
                             ActionModePopup below. Persisted via
                             CopilotPrefs.AutoApproveWrites. -->
                        <Button x:Name="ActionModeBtn" DockPanel.Dock="Left" Cursor="Hand"
                                Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                FocusVisualStyle="{x:Null}" Margin="2,0,0,0"
                                ToolTip="Choose how write actions are approved">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="9,4,9,4">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Cp.Hover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="ActionModeDot" Width="5" Height="5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ActionModeLabel" Text="Ask first" FontSize="11.5" Foreground="{DynamicResource Cp.Muted}" VerticalAlignment="Center"/>
                                <Path Width="7" Height="7" Stretch="Uniform" Margin="4,0,0,0" VerticalAlignment="Center"
                                      StrokeThickness="1.6" Stroke="{DynamicResource Cp.Faint}"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M1,5 L4,1.5 L7,5"/>
                            </StackPanel>
                        </Button>
                        <!-- send / stop: 32×32 CIRCLE (2026-08-27 refresh, was a radius-9
                             square), accent ring + accent arrow-up; dimmed until armed;
                             stop square while a reply streams. Fill/border colours
                             are driven from UpdateSendVisual in code-behind. -->
                        <Button x:Name="SendBtn" DockPanel.Dock="Right" Width="32" Height="32" Cursor="Hand"
                                Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                FocusVisualStyle="{x:Null}" ToolTip="Send">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="16"
                                            BorderThickness="1.5" BorderBrush="{TemplateBinding BorderBrush}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Cp.BlueSoft}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Path x:Name="SendIcon" Width="14" Height="14" Stretch="Uniform"
                                  Fill="Transparent" Stroke="{DynamicResource Cp.Faint}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M12,19 V5 M5,12 l7,-7 7,7"/>
                        </Button>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Action Mode popover — upward, closes on outside click (StaysOpen
                 False + PlacementTarget) or Esc (code-behind). Same card chrome as
                 the reasoning-UI cards: Cp.Reasoning.* radius/border/shadow tokens. -->
            <Popup x:Name="ActionModePopup" PlacementTarget="{Binding ElementName=ActionModeBtn}"
                   Placement="Top" VerticalOffset="-8" StaysOpen="False"
                   AllowsTransparency="True" PopupAnimation="Fade">
                <Border x:Name="ActionModeCard" Background="{DynamicResource Cp.Reasoning.Surface}"
                        BorderBrush="{DynamicResource Cp.Reasoning.Border3}" BorderThickness="1"
                        CornerRadius="13" Padding="4" MinWidth="248" Margin="8,8,8,8"
                        Focusable="True" KeyDown="OnActionModePopupKeyDown">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.14" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="ACTION MODE" FontFamily="{DynamicResource Cp.Reasoning.FontMono}"
                                   FontSize="10" Foreground="{DynamicResource Cp.Reasoning.TextFaint}"
                                   Margin="9,7,9,6"/>
                        <Button x:Name="AskFirstOption" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" HorizontalContentAlignment="Stretch" Padding="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="9" Padding="9,7,9,7">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Cp.Reasoning.Hover2}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="7" Height="7" Fill="#eab308"
                                         VerticalAlignment="Top" Margin="0,4,9,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Ask first" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Cp.Reasoning.TextPrimary}"/>
                                    <TextBlock Text="Approve each write before it runs." FontSize="11"
                                               TextWrapping="Wrap" Margin="0,1,0,0"
                                               Foreground="{DynamicResource Cp.Reasoning.Text}"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Border Height="1" Background="{DynamicResource Cp.Reasoning.BorderSubtle2}" Margin="9,4,9,4"/>
                        <Button x:Name="AutoOption" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" HorizontalContentAlignment="Stretch" Padding="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="9" Padding="9,7,9,7">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Cp.Reasoning.Hover2}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="7" Height="7" Fill="#10b981"
                                         VerticalAlignment="Top" Margin="0,4,9,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Auto" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Cp.Reasoning.TextPrimary}"/>
                                    <TextBlock Text="Writes run straight away. Still undoable." FontSize="11"
                                               TextWrapping="Wrap" Margin="0,1,0,0"
                                               Foreground="{DynamicResource Cp.Reasoning.Text}"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <TextBlock Text="Deletions and workset changes always ask, even in Auto."
                                   FontSize="10.5" TextWrapping="Wrap" Margin="9,8,9,8"
                                   Foreground="{DynamicResource Cp.Reasoning.TextFaint}"/>
                    </StackPanel>
                </Border>
            </Popup>
            <!-- Footer: hint (left, truncates) + plan-name button (right). Design's
                 "footer" placement: the plan name is the ambient usage affordance,
                 with a severity dot (amber ≥80, red ≥95, hidden below 80) to its
                 left; clicking it opens the popover ABOVE the composer. Bound via
                 BindUsage(). -->
            <Grid Margin="0,8,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Single line; truncates with ellipsis on narrow widths so it
                     always yields to the plan button on the right. -->
                <!-- Locked (signed out): replaces the tools hint with why the
                     composer will not send. Toggled by OnLockedChanged. -->
                <TextBlock x:Name="LockedHint" Grid.Column="0" VerticalAlignment="Center" Visibility="Collapsed"
                           TextTrimming="CharacterEllipsis" Margin="2,0,8,0"
                           FontSize="10" Foreground="{DynamicResource Cp.Muted}"
                           Text="Sign in to BINA AI to send — use the card above, or Bina tab → Login to AI"/>
                <TextBlock x:Name="PlaceholderHint" Grid.Column="0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="2,0,8,0"
                           FontSize="10" Foreground="{DynamicResource Cp.Faint}">
                    <Run Text="Type "/><Run Text="/" FontWeight="Bold" Foreground="{DynamicResource Cp.Muted}"/><Run Text=" for tools · "/><Run Text="@" FontWeight="Bold" Foreground="{DynamicResource Cp.Muted}"/><Run Text=" to reference a level, view or selection"/>
                </TextBlock>
                <!-- Collapsed until BindUsage runs. PromptBar is also hosted outside
                     ChatView (ResultView), where nothing binds usage — an unbound
                     button is an invisible click target opening a blank card. -->
                <Button x:Name="PlanBtn" Grid.Column="1" Cursor="Hand" Padding="6,2,6,2"
                        Visibility="Collapsed"
                        Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}"
                        ToolTip="Plan usage">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Cp.Hover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="PlanDot" Width="6" Height="6" Margin="0,0,5,0"
                                 VerticalAlignment="Center" Visibility="Collapsed"/>
                        <TextBlock x:Name="PlanLabel" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Cp.Muted}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Usage popover, anchored to the COMPOSER (not the plan button) and
                 sized to its width, matching the design's
                 left:0;right:0;bottom:calc(100% + 8px). HorizontalOffset cancels the
                 8px shadow margin so the card's left edge lines up with the composer. -->
            <!-- Offsets cancel the card's shadow margins so it sits 8px above the
                 composer with its left edge aligned: +12 against the 20px bottom
                 margin, -8 against the 8px left. -->
            <Popup x:Name="UsagePopup" PlacementTarget="{Binding ElementName=ComposerBox}" Placement="Top"
                   VerticalOffset="12" HorizontalOffset="-8" StaysOpen="False"
                   AllowsTransparency="True" PopupAnimation="Fade">
                <Border Width="{Binding ActualWidth, ElementName=ComposerBox}"
                        Background="{DynamicResource Cp.Menu}" BorderBrush="{DynamicResource Cp.Line}"
                        BorderThickness="1" CornerRadius="13" Padding="15,15,15,14" Margin="8,8,20,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.14" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Plan name + tier pill -->
                        <!-- Two columns rather than a magic right-margin on the name:
                             the pill takes what it needs and the name trims to fit,
                             so a longer backend plan string can't overlap it. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PopPlan" Grid.Column="0" FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource Cp.Ink}" HorizontalAlignment="Left"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                            <Border x:Name="PopTierBadge" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    CornerRadius="5" Padding="6,2,6,2" Background="{DynamicResource Cp.BlueSoft}">
                                <TextBlock x:Name="PopTier" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource Cp.BlueText}"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="Plan usage" FontSize="10.5" Foreground="{DynamicResource Cp.Faint}" Margin="0,2,0,0"/>

                        <Grid Margin="0,13,0,7">
                            <TextBlock Text="Usage" FontSize="11" Foreground="{DynamicResource Cp.Muted}" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="PopPctUsed" FontSize="11.5" FontWeight="Bold"
                                       Foreground="{DynamicResource Cp.Ink}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Height="6" CornerRadius="2" Background="{DynamicResource Cp.Line}" ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="PopFillCol" Width="88*"/>
                                    <ColumnDefinition x:Name="PopRestCol" Width="12*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="PopFill" Grid.Column="0" CornerRadius="2"/>
                            </Grid>
                        </Border>

                        <!-- Below the warn threshold the quota just resets; at/above it
                             the reset is cold comfort, so the CTA takes its place. -->
                        <StackPanel x:Name="PopResetRow" Orientation="Horizontal" Margin="0,10,0,0">
                            <Path Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"
                                  Fill="Transparent" Stroke="{DynamicResource Cp.Faint}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M12,21 A9,9 0 1 1 12,3 A9,9 0 1 1 12,21 Z M12,7 V12 L15.5,14"/>
                            <TextBlock x:Name="PopResets" FontSize="10.5" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Cp.Faint}"/>
                        </StackPanel>

                        <Button x:Name="PopUpgradeBtn" Height="32" Margin="0,13,0,0" Cursor="Hand"
                                Background="{DynamicResource Cp.AccentGrad}" BorderThickness="0"
                                FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Cp.AccentGradHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <Path Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"
                                      Fill="Transparent" Stroke="{DynamicResource Cp.AccentContrast}" StrokeThickness="2.1"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M13,2 4.5,13.5 H11 l-1,8.5 8.5,-11.5 H12 Z"/>
                                <TextBlock Text="Upgrade plan" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Cp.AccentContrast}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>
        </StackPanel>
    </Border>
</UserControl>
