<UserControl x:Class="RevitWebAppSync.UI.Copilot.Controls.PromptBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:RevitWebAppSync.UI.Copilot.Controls"
             FontFamily="{DynamicResource Cp.Font}">
    <UserControl.Resources>
        <ctl:BoolToVisibilityConverter x:Key="BoolVis"/>
        <ctl:PctToStarLengthConverter x:Key="PctStar"/>
        <!-- Meter fill colour follows the usage band: accent &lt;80, amber 80–94,
             red ≥95. DynamicResource so it also tracks the light/dark theme. -->
        <Style x:Key="Cp.MeterFill" TargetType="Border">
            <!-- Small radius, not 99: a pill radius on a 4–6px bar makes the end-caps
                 full semicircles that taper to points, so the middle looks bulged. -->
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Background" Value="{DynamicResource Cp.Accent}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding MeterLevel}" Value="warn">
                    <Setter Property="Background" Value="{DynamicResource Cp.Amber}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MeterLevel}" Value="critical">
                    <Setter Property="Background" Value="{DynamicResource Cp.Red}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border BorderBrush="{DynamicResource Cp.Line}" BorderThickness="0,1,0,0"
            Background="{DynamicResource Cp.Bg}" Padding="14,12,14,11">
        <StackPanel>
            <!-- pending pasted screenshots (thumbnail chips with an × to remove) -->
            <StackPanel x:Name="ThumbStrip" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,8"/>

            <!-- 80% one-time note (dismissible). Amber-tinted, sits above the input. -->
            <Border Margin="0,0,0,8" CornerRadius="9" Padding="11,7,7,7"
                    Background="{DynamicResource Cp.AmberBg}" BorderBrush="{DynamicResource Cp.AmberLn}" BorderThickness="1"
                    Visibility="{Binding ShowWarn80, Converter={StaticResource BoolVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Warn80Text}" TextWrapping="Wrap"
                               FontSize="11.5" Foreground="{DynamicResource Cp.AmberFg}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Width="22" Height="22" Cursor="Hand" Click="OnDismissWarn80"
                            Background="Transparent" BorderThickness="0" ToolTip="Dismiss">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Path Width="10" Height="10" Stretch="Uniform" StrokeThickness="1.7"
                              Stroke="{DynamicResource Cp.AmberFg}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M5,5 L15,15 M15,5 L5,15"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 95% banner (non-dismissible). Red-tinted, "Running low…", tap to upgrade. -->
            <Border Margin="0,0,0,8" CornerRadius="9" Padding="11,7,11,7" Cursor="Hand"
                    Background="{DynamicResource Cp.IssueBg}" BorderBrush="{DynamicResource Cp.IssueLn}" BorderThickness="1"
                    MouseLeftButtonDown="OnBannerUpgrade"
                    Visibility="{Binding ShowWarn95, Converter={StaticResource BoolVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Warn95Text}" TextWrapping="Wrap"
                               FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource Cp.IssueFg}" VerticalAlignment="Center"/>
                    <Path Grid.Column="1" Width="12" Height="12" Margin="8,0,0,0" Stretch="Uniform" StrokeThickness="1.8"
                          Stroke="{DynamicResource Cp.IssueFg}" VerticalAlignment="Center"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M9,6 l6,6 -6,6"/>
                </Grid>
            </Border>

            <!-- Slate composer: sunken rounded container, borderless input,
                 ghost attach button, accent-gradient send/stop button. -->
            <Border Background="{DynamicResource Cp.Sunken}" CornerRadius="14" Padding="13,8,8,8">
                <DockPanel LastChildFill="True">
                    <!-- send / stop: circular; gray while idle, accent gradient once
                         there is text; stop square while a reply streams -->
                    <Button x:Name="SendBtn" DockPanel.Dock="Right" Width="32" Height="32" Cursor="Hand"
                            Background="Transparent" BorderThickness="0" VerticalAlignment="Bottom"
                            ToolTip="Send">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="16">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Path x:Name="SendIcon" Width="14" Height="14" Stretch="Uniform"
                              Fill="{DynamicResource Cp.Faint}"
                              Data="M12,4 L19,11.5 L14.4,11.5 L14.4,19 L9.6,19 L9.6,11.5 L5,11.5 Z"/>
                    </Button>
                    <!-- @ mention button -->
                    <Button x:Name="AtBtn" DockPanel.Dock="Right" Width="30" Height="30" Cursor="Hand"
                            Background="Transparent" BorderThickness="0" VerticalAlignment="Bottom"
                            Margin="0,0,4,1" ToolTip="Reference a level, category, view, or selection">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Cp.Hover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Path Width="16" Height="16" Stretch="Uniform" Fill="Transparent"
                              Stroke="{DynamicResource Cp.Muted}" StrokeThickness="1.9"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M16,8 v5 a3,3 0 0 0 6,0 v-1 a10,10 0 1 0 -4,8 M12,8 a4,4 0 1 0 0,8 a4,4 0 1 0 0,-8"/>
                    </Button>
                    <!-- attach file button -->
                    <Button x:Name="AttachBtn" DockPanel.Dock="Right" Width="30" Height="30" Cursor="Hand"
                            Background="Transparent" BorderThickness="0" VerticalAlignment="Bottom"
                            Margin="0,0,2,1" ToolTip="Attach a file (.txt, .csv, .md, .log, .json, .xml)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Cp.Hover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Path Width="14" Height="14" Stretch="Uniform" Fill="Transparent"
                              Stroke="{DynamicResource Cp.Muted}" StrokeThickness="1.9"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
                    </Button>
                    <ctl:MentionInput x:Name="Input" VerticalAlignment="Center" Margin="0,0,8,0"/>
                </DockPanel>
            </Border>
            <!-- Footer usage meter (plan name · progress track · pct). Live from
                 the VM; click toggles the usage popover. Chat view only. -->
            <Border x:Name="MeterRow" Margin="0,9,0,0" Padding="4,3,4,3" CornerRadius="7" Cursor="Hand"
                    Background="Transparent" MouseLeftButtonUp="OnMeterClick" ToolTip="Plan usage"
                    Visibility="{Binding ShowUsageMeter, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding PlanName}" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Cp.Muted}" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Height="4" CornerRadius="2" Margin="9,0,9,0"
                            Background="{DynamicResource Cp.Line}" VerticalAlignment="Center" ClipToBounds="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding UsagePct, Converter={StaticResource PctStar}}"/>
                                <ColumnDefinition Width="{Binding UsagePct, Converter={StaticResource PctStar}, ConverterParameter=Rest}"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Cp.MeterFill}"/>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Column="2" Text="{Binding UsagePctText}" FontSize="10.5" FontWeight="Bold"
                               Foreground="{DynamicResource Cp.Muted}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Usage popover: click-toggle, opaque card, grows upward from 8px above
                 the footer, menuPop scale-in on open (see code-behind). -->
            <Popup x:Name="UsagePopup" PlacementTarget="{Binding ElementName=MeterRow}" Placement="Top"
                   VerticalOffset="-8" StaysOpen="False" AllowsTransparency="True" PopupAnimation="None"
                   Opened="OnUsagePopupOpened" Closed="OnUsagePopupClosed">
                <!-- Transparent outer padding leaves room for the drop shadow so it isn't clipped. -->
                <Border Padding="10,10,10,12" Background="Transparent">
                    <Border x:Name="UsageCard" Focusable="True" PreviewKeyDown="OnUsageCardKeyDown"
                            Background="{DynamicResource Cp.Menu}" BorderBrush="{DynamicResource Cp.Line}" BorderThickness="1"
                            CornerRadius="13" Padding="15,14,15,15" Width="272" RenderTransformOrigin="0.5,1">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.22" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel>
                        <TextBlock Text="{Binding PlanName}" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource Cp.Ink}"/>
                        <TextBlock Text="Plan usage" FontSize="11" Foreground="{DynamicResource Cp.Muted}" Margin="0,1,0,0"/>
                        <Grid Margin="0,13,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Usage" FontSize="12" Foreground="{DynamicResource Cp.Text}"/>
                            <TextBlock Grid.Column="1" Text="{Binding UsageUsedText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Cp.Ink}"/>
                        </Grid>
                        <Border Height="6" CornerRadius="2" Background="{DynamicResource Cp.Line}" ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding UsagePct, Converter={StaticResource PctStar}}"/>
                                    <ColumnDefinition Width="{Binding UsagePct, Converter={StaticResource PctStar}, ConverterParameter=Rest}"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Cp.MeterFill}"/>
                            </Grid>
                        </Border>

                        <!-- Admin: Upgrade CTA -->
                        <Button x:Name="PopoverUpgradeBtn" Margin="0,15,0,0" Height="32" Cursor="Hand" Click="OnPopoverUpgrade"
                                Foreground="{DynamicResource Cp.AccentContrast}" BorderThickness="0"
                                Visibility="{Binding IsUsageAdmin, Converter={StaticResource BoolVis}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{DynamicResource Cp.AccentGrad}" CornerRadius="9">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Cp.AccentGradHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <Path Width="12" Height="12" Margin="0,0,7,0" Stretch="Uniform" VerticalAlignment="Center"
                                      Fill="{DynamicResource Cp.AccentContrast}" Data="M13,2 L4,14 h6 l-1,8 9,-12 h-6 Z"/>
                                <TextBlock Text="Upgrade plan" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Member: managed-by-admin note + notify -->
                        <StackPanel Margin="0,14,0,0" Visibility="{Binding IsUsageAdmin, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Cp.Muted}">
                                <Run Text="Your plan is managed by "/><Run Text="{Binding AdminContact, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Cp.Text}"/><Run Text="."/>
                            </TextBlock>
                            <Button Margin="0,11,0,0" Height="40" Cursor="Hand" Click="OnNotifyAdmin"
                                    Background="Transparent" Foreground="{DynamicResource Cp.Ink}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="Transparent" BorderBrush="{DynamicResource Cp.Line}" BorderThickness="1" CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Cp.Hover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="Notify admin to upgrade" FontSize="12.5" FontWeight="SemiBold"/>
                            </Button>
                        </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>
            </Popup>
            <TextBlock x:Name="PlaceholderHint" HorizontalAlignment="Center" Margin="0,8,0,1"
                       FontSize="10" Foreground="{DynamicResource Cp.Faint}">
                <Run Text="Type "/><Run Text="@" FontWeight="Bold" Foreground="{DynamicResource Cp.Muted}"/><Run Text=" to reference a level, category, view, or selection"/>
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
