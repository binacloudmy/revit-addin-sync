<UserControl x:Class="RevitWebAppSync.UI.Copilot.Controls.PromptBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:RevitWebAppSync.UI.Copilot.Controls"
             FontFamily="{DynamicResource Cp.Font}">
    <Border BorderBrush="{DynamicResource Cp.Line}" BorderThickness="0,1,0,0"
            Background="{DynamicResource Cp.Bg}" Padding="14,12,14,11">
        <StackPanel>
            <!-- pending pasted screenshots (thumbnail chips with an × to remove) -->
            <StackPanel x:Name="ThumbStrip" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,8"/>
            <!-- pending slash command (accent chip with an × to clear) -->
            <StackPanel x:Name="CommandStrip" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,8"/>
            <!-- Slate composer: sunken rounded container, borderless input,
                 ghost attach button, accent-gradient send/stop button. -->
            <Border Background="{DynamicResource Cp.Sunken}" CornerRadius="13" Padding="13,8,8,8">
                <DockPanel LastChildFill="True">
                    <!-- send / stop: circular; gray while idle, accent gradient once
                         there is text; stop square while a reply streams -->
                    <Button x:Name="SendBtn" DockPanel.Dock="Right" Width="32" Height="32" Cursor="Hand"
                            Background="Transparent" BorderThickness="0" VerticalAlignment="Bottom"
                            FocusVisualStyle="{x:Null}" ToolTip="Send">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="9">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Path x:Name="SendIcon" Width="14" Height="14" Stretch="Uniform"
                              Fill="{DynamicResource Cp.Faint}"
                              Data="M12,4 L19,11.5 L14.4,11.5 L14.4,19 L9.6,19 L9.6,11.5 L5,11.5 Z"/>
                    </Button>
                    <!-- @ mention button -->
                    <Button x:Name="AtBtn" DockPanel.Dock="Right" Width="30" Height="30" Cursor="Hand"
                            Background="Transparent" BorderThickness="0" VerticalAlignment="Bottom"
                            FocusVisualStyle="{x:Null}"
                            Margin="0,0,4,1" ToolTip="Reference a level, category, view, or selection">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Cp.Hover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Path Width="16" Height="16" Stretch="Uniform" Fill="Transparent"
                              Stroke="{DynamicResource Cp.Muted}" StrokeThickness="1.9"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M16,8 v5 a3,3 0 0 0 6,0 v-1 a10,10 0 1 0 -4,8 M12,8 a4,4 0 1 0 0,8 a4,4 0 1 0 0,-8"/>
                    </Button>
                    <!-- attach file button -->
                    <Button x:Name="AttachBtn" DockPanel.Dock="Right" Width="30" Height="30" Cursor="Hand"
                            Background="Transparent" BorderThickness="0" VerticalAlignment="Bottom"
                            FocusVisualStyle="{x:Null}"
                            Margin="0,0,2,1" ToolTip="Attach a file (.txt, .csv, .md, .log, .json, .xml)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Cp.Hover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Path Width="14" Height="14" Stretch="Uniform" Fill="Transparent"
                              Stroke="{DynamicResource Cp.Muted}" StrokeThickness="1.9"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
                    </Button>
                    <ctl:MentionInput x:Name="Input" VerticalAlignment="Center" Margin="0,0,8,0"/>
                </DockPanel>
            </Border>
            <!-- Footer: composer hint only. The ambient usage affordance moved to
                 the header ring + popover (see CopilotPanel), so the hint now spans
                 the full width instead of yielding to a plan button on the right. -->
            <TextBlock x:Name="PlaceholderHint" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Margin="2,8,2,1"
                       FontSize="10" Foreground="{DynamicResource Cp.Faint}">
                    <Run Text="Type "/><Run Text="/" FontWeight="Bold" Foreground="{DynamicResource Cp.Muted}"/><Run Text=" for tools · "/><Run Text="@" FontWeight="Bold" Foreground="{DynamicResource Cp.Muted}"/><Run Text=" to reference a level, view or selection"/>
                </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
