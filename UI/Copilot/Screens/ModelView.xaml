<UserControl x:Class="RevitWebAppSync.UI.Copilot.Screens.ModelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Cp.PanelBg}">
    <!-- v6-panel "Model" view (docs/design/bina-copilot-v6-panel.dc.html):
         heading + Resync, then a key/value list with fading hairlines.
         Rows are built in code-behind from the live document context plus an
         on-demand model-statistics job — nothing hardcoded. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="14,14,14,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Model" FontSize="16" FontWeight="Medium" Foreground="{DynamicResource Cp.Ink}"/>
                <TextBlock x:Name="Subtitle" FontSize="12" Foreground="{DynamicResource Cp.Muted}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button x:Name="ResyncBtn" Grid.Column="1" Click="OnResync" Cursor="Hand" VerticalAlignment="Top"
                    Background="Transparent" FontSize="12" Foreground="{DynamicResource Cp.Ink}"
                    BorderBrush="{DynamicResource Cp.Line}" BorderThickness="1" Padding="11,4">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Cp.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                    <Path Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource Cp.Ink}" StrokeThickness="1.9"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,6,0" VerticalAlignment="Center"
                          Data="M21,2 v6 h-6 M3,12 a9,9 0 0 1 15,-6.7 L21,8 M3,22 v-6 h6 M21,12 a9,9 0 0 1 -15,6.7 L3,16"/>
                    <TextBlock Text="Resync" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,0,14,14">
            <StackPanel x:Name="Rows"/>
        </ScrollViewer>
    </Grid>
</UserControl>
