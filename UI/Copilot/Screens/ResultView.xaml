<UserControl x:Class="RevitWebAppSync.UI.Copilot.Screens.ResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:RevitWebAppSync.UI.Copilot.Controls"
             FontFamily="{DynamicResource Cp.Font}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource Cp.Line}" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0"
                        Command="{Binding BackHomeCommand}">
                    <Path Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource Cp.Muted}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M15,6 l-6,6 6,6"/>
                </Button>
                <Border Grid.Column="2" CornerRadius="999" Background="#dcfce7" Padding="8,3">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="5" Height="5" Fill="#16a34a" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock FontSize="11" Foreground="#16a34a" FontWeight="Medium">
                            <Run Text="Done · "/><Run Text="{Binding LastRunElapsed, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14">
            <StackPanel>
                <!-- body header row -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ctl:IconTile x:Name="Tile" Grid.Column="0" TileSize="36" GlyphSize="18" Corner="9" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ToolTitle" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Cp.Ink}"/>
                        <TextBlock Text="Just now" FontSize="11.5" Foreground="{DynamicResource Cp.Muted}"/>
                    </StackPanel>
                    <ctl:TierBadge x:Name="Badge" Grid.Column="2" VerticalAlignment="Center"/>
                </Grid>

                <ContentControl x:Name="ResultHost"/>

                <!-- 👍/👎 feedback on this response (built in code-behind) -->
                <StackPanel x:Name="FeedbackHost"/>

                <TextBlock Text="NEXT STEPS" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Cp.Faint}"
                           Margin="2,14,0,6"/>
                <StackPanel x:Name="NextHost"/>
            </StackPanel>
        </ScrollViewer>

        <ctl:PromptBar Grid.Row="2" Placeholder="Ask a follow-up…" SubmitCommand="{Binding FollowUpCommand}"/>
    </Grid>
</UserControl>
