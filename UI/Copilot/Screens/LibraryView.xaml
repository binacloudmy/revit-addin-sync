<UserControl x:Class="RevitWebAppSync.UI.Copilot.Screens.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource Cp.Font}">
    <Grid>
        <Grid.Resources>
            <!-- Same slim scrollbar as History. -->
            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource Cp.SlimScrollBar}"/>
        </Grid.Resources>

        <!-- Curated prompt list. "Tap a prompt…" hint + grouped rows are built
             in code-behind (icon geometry + per-section headers + PromptChosen
             wiring), mirroring HistoryView's RowsHost pattern. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="10,0,10,10">
            <StackPanel x:Name="ListHost" Margin="0,4,0,0"/>
        </ScrollViewer>
    </Grid>
</UserControl>
