<UserControl x:Class="RevitWebAppSync.UI.Copilot.Screens.ToolReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:RevitWebAppSync.UI.Copilot.Controls"
             FontFamily="{DynamicResource Cp.Font}">
    <UserControl.Resources>
        <ctl:BoolToVisibilityConverter x:Key="BoolVisShared"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ctl:ToolHeader x:Name="Header" Grid.Row="0" Tool="{Binding CurrentTool}" BackCommand="{Binding BackCommand}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14">
            <StackPanel>
                <!-- Plan -->
                <Border BorderBrush="{DynamicResource Cp.PurpleLine}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12"
                        Background="{DynamicResource Cp.PurpleSoft}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Path Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource Cp.Purple}" Margin="0,0,5,0"
                                  Data="M12,2 l2.09,6.26 L20,9.27 l-5,4.87 L16.18,22 12,18.27 7.82,22 9,14.14 4,9.27 l5.91,-1.01 L12,2 z"/>
                            <TextBlock Text="WHAT THIS WILL DO" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Cp.Purple}"/>
                        </StackPanel>
                        <StackPanel x:Name="PlanHost"/>
                    </StackPanel>
                </Border>

                <!-- Code disclosure -->
                <Border BorderBrush="{DynamicResource Cp.Line}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,12">
                    <StackPanel>
                        <ToggleButton x:Name="CodeToggle" Cursor="Hand" Background="{DynamicResource Cp.Sunken}" BorderThickness="0" Padding="12,9">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10,10,0,0" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path x:Name="Caret" Grid.Column="0" Width="11" Height="11" Stretch="Uniform" Stroke="{DynamicResource Cp.Muted}"
                                      StrokeThickness="1.6" VerticalAlignment="Center" Margin="0,0,8,0" Data="M9,6 l6,6 -6,6"/>
                                <TextBlock x:Name="CodeFileName" Grid.Column="1" FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource Cp.Ink}" FontFamily="{DynamicResource Cp.FontMono}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CodeLineCount" Grid.Column="2" FontSize="11" Foreground="{DynamicResource Cp.Muted}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </ToggleButton>
                        <TextBox x:Name="CodeBox" Style="{DynamicResource Cp.CodeBlock}"
                                 Visibility="{Binding IsChecked, ElementName=CodeToggle, Converter={StaticResource BoolVisShared}}"/>
                    </StackPanel>
                </Border>

                <!-- Reassurance -->
                <Border Background="{DynamicResource Cp.AmberBg}" BorderBrush="{DynamicResource Cp.AmberLn}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="13" Height="13" Stretch="Uniform" Stroke="{DynamicResource Cp.AmberFg}" StrokeThickness="1.6" Margin="0,1,8,0"
                              VerticalAlignment="Top" StrokeStartLineCap="Round"
                              Data="M12,9 v4 M12,17 v0.01 M10.3,3.86 L1.82,18 a2,2 0 0 0 1.71,3 h16.94 a2,2 0 0 0 1.71,-3 L13.71,3.86 a2,2 0 0 0 -3.42,0 z"/>
                        <TextBlock Text="This is AI-generated code. Review the plan before running. Failed runs auto-retry once with a fix."
                                   FontSize="11.5" Foreground="{DynamicResource Cp.AmberFg}" TextWrapping="Wrap" MaxWidth="340"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{DynamicResource Cp.Line}" BorderThickness="0,1,0,0" Padding="12">
            <StackPanel Orientation="Horizontal">
                <Button Content="Edit code" Style="{DynamicResource Cp.Ghost}" Margin="0,0,6,0"/>
                <Button Content="Regenerate" Style="{DynamicResource Cp.Ghost}"/>
                <Button x:Name="RunBtn" Style="{DynamicResource Cp.RunDark}" Command="{Binding RunCommand}"
                        HorizontalAlignment="Right" Margin="6,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="10" Height="10" Stretch="Uniform" Fill="White" Margin="0,0,5,0" Data="M6,4 l14,8 -14,8 V4 z"/>
                        <TextBlock Text="Run"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
