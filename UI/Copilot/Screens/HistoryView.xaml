<UserControl x:Class="RevitWebAppSync.UI.Copilot.Screens.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource Cp.Font}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.Resources>
            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource Cp.SlimScrollBar}"/>
        </Grid.Resources>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource Cp.Line}" BorderThickness="0,0,0,1" Padding="10,12,14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BackBtn" Grid.Column="0" Visibility="Collapsed"
                        Click="BackBtn_Click"
                        Style="{DynamicResource Cp.IconButton}"
                        VerticalAlignment="Center" Margin="0,0,4,0">
                    <Path Width="8" Height="13" Stretch="Uniform"
                          Stroke="{DynamicResource Cp.Faint}" StrokeThickness="1.8"
                          Data="M8,2 L2,7 L8,12"/>
                </Button>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="HeaderTitle" Text="History" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Cp.Ink}"/>
                    <TextBlock x:Name="Sub" FontSize="11.5" Foreground="{DynamicResource Cp.Muted}" Margin="0,1,0,0"/>
                </StackPanel>
                <!-- Continue this conversation in the Chat tab (visible only in session detail) -->
                <Button x:Name="ContinueBtn" Grid.Column="2" Visibility="Collapsed"
                        Click="ContinueBtn_Click"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Padding="6,3,6,3" VerticalAlignment="Center" Margin="0,0,6,0"
                        ToolTip="Continue this conversation">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="13" Height="13" Stretch="Uniform"
                              Stroke="{DynamicResource Cp.Accent}" StrokeThickness="1.8"
                              Data="M4,4 L20,12 L4,20 Z"/>
                        <TextBlock Text="Continue" FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource Cp.Accent}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!-- Download report (visible only in session detail) -->
                <Button x:Name="DownloadBtn" Grid.Column="3" Visibility="Collapsed"
                        Click="DownloadBtn_Click"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Padding="6,3,6,3" VerticalAlignment="Center"
                        ToolTip="Download this session as a report">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="13" Height="13" Stretch="Uniform"
                              Stroke="{DynamicResource Cp.Accent}" StrokeThickness="1.8"
                              Data="M12,3 L12,15 M7,10 L12,15 L17,10 M4,19 L20,19"/>
                        <TextBlock Text="Download" FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource Cp.Accent}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Session list -->
        <ScrollViewer x:Name="ListPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="RowsHost"/>
        </ScrollViewer>

        <!-- Session detail -->
        <ScrollViewer x:Name="DetailPanel" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="MessagesHost" Margin="0,8,0,16"/>
        </ScrollViewer>
    </Grid>
</UserControl>
