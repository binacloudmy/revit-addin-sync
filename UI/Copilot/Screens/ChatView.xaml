<UserControl x:Class="RevitWebAppSync.UI.Copilot.Screens.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:RevitWebAppSync.UI.Copilot.Controls"
             FontFamily="{DynamicResource Cp.Font}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Subheader (only with a thread) -->
        <Border x:Name="SubHeader" Grid.Row="0" BorderBrush="{DynamicResource Cp.LineSoft}" BorderThickness="0,0,0,1"
                Padding="14,7" Visibility="Collapsed">
            <Grid>
                <TextBlock x:Name="ConvCount" FontSize="11.5" Foreground="{DynamicResource Cp.Text}" VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Foreground="{DynamicResource Cp.Muted}" FontSize="11.5" Command="{Binding ClearChatCommand}"
                        Content="+ New chat"/>
            </Grid>
        </Border>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" ScrollChanged="OnScroll">
            <ScrollViewer.Resources>
                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource Cp.SlimScrollBar}"/>
            </ScrollViewer.Resources>
            <StackPanel x:Name="BodyHost"/>
        </ScrollViewer>

        <ctl:PromptBar x:Name="Prompt" Grid.Row="2" SubmitCommand="{Binding ChatSendCommand}"
                       Busy="{Binding IsSending}" CancelCommand="{Binding CancelSendCommand}"/>

        <!-- Usage-limit blocked state; replaces the composer at 100% usage
             (centered over the body when the thread is empty). -->
        <ContentControl x:Name="BlockedHost" Grid.Row="2" Visibility="Collapsed"/>

        <!-- Session expired: replaces the composer, so sending is blocked while the
             thread above stays visible and scrollable. Sign in reopens the browser
             flow through the panel's gate. -->
        <Border x:Name="ExpiredBanner" Grid.Row="2" Visibility="Collapsed"
                BorderBrush="{DynamicResource Cp.Line}" BorderThickness="0,1,0,0"
                Background="#1FF59E0B" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"
                      Margin="0,0,9,0" Fill="Transparent" Stroke="#f59e0b" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Data="M12,9 v4 M12,17 h.01 M10.3,3.9 1.8,18 a2,2 0 0 0 1.7,3 h17 a2,2 0 0 0 1.7,-3 L13.7,3.9 a2,2 0 0 0 -3.4,0 Z"/>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource Cp.Text}" Text="Session expired — sign in to continue"/>
                <Button x:Name="ExpiredSignInBtn" Grid.Column="2" Height="28" Padding="12,0" Cursor="Hand"
                        BorderThickness="0" Background="{DynamicResource Cp.AccentGrad}"
                        Foreground="{DynamicResource Cp.AccentContrast}" FontSize="11.5" FontWeight="SemiBold"
                        Click="OnExpiredSignIn" Content="Sign in">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                <!-- Margin, not the default no-op: without it the
                                     button's Padding is dropped and the label sits
                                     flush against the pill's edges. -->
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Slash-command palette overlay: an IN-PANEL layer (not a Popup, which
             floats outside the pane and ignores its bounds). Lives in the body row
             so it can never cover the header/tabs, stretches to the composer width,
             and is anchored just above the composer. The scrim closes it on an
             outside click; the tool list scrolls when content exceeds MaxHeight. -->
        <Grid x:Name="SlashLayer" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="SlashScrim" Background="Transparent"/>
            <ctl:CommandPalette x:Name="SlashPalette" VerticalAlignment="Bottom" Margin="14,12,14,8"/>
        </Grid>
    </Grid>
</UserControl>
