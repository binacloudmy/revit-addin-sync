<UserControl x:Class="RevitWebAppSync.UI.Copilot.Screens.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:RevitWebAppSync.UI.Copilot.Controls"
             FontFamily="{DynamicResource Cp.Font}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Subheader (only with a thread) -->
        <Border x:Name="SubHeader" Grid.Row="0" BorderBrush="{DynamicResource Cp.LineSoft}" BorderThickness="0,0,0,1"
                Padding="14,7" Visibility="Collapsed">
            <Grid>
                <TextBlock x:Name="ConvCount" FontSize="11.5" Foreground="{DynamicResource Cp.Text}" VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Foreground="{DynamicResource Cp.Muted}" FontSize="11.5" Command="{Binding ClearChatCommand}"
                        Content="+ New chat"/>
            </Grid>
        </Border>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" ScrollChanged="OnScroll">
            <ScrollViewer.Resources>
                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource Cp.SlimScrollBar}"/>
            </ScrollViewer.Resources>
            <StackPanel x:Name="BodyHost"/>
        </ScrollViewer>

        <!-- Bottom band: near-limit notice stacked directly above the composer, so
             the notice pushes the composer down instead of overlaying it. Both
             collapse together when the blocked state takes over (see UpdateUsage). -->
        <StackPanel Grid.Row="2">
            <ContentControl x:Name="NoticeHost" Visibility="Collapsed"/>
            <ctl:PromptBar x:Name="Prompt" SubmitCommand="{Binding ChatSendCommand}"
                           Busy="{Binding IsSending}" CancelCommand="{Binding CancelSendCommand}"/>
        </StackPanel>

        <!-- Usage-limit blocked state; replaces the composer at 100% usage
             (centered over the body when the thread is empty). -->
        <ContentControl x:Name="BlockedHost" Grid.Row="2" Visibility="Collapsed"/>

        <!-- Slash-command palette overlay: an IN-PANEL layer (not a Popup, which
             floats outside the pane and ignores its bounds). Lives in the body row
             so it can never cover the header/tabs, stretches to the composer width,
             and is anchored just above the composer. The scrim closes it on an
             outside click; the tool list scrolls when content exceeds MaxHeight. -->
        <Grid x:Name="SlashLayer" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="SlashScrim" Background="Transparent"/>
            <ctl:CommandPalette x:Name="SlashPalette" VerticalAlignment="Bottom" Margin="14,12,14,8"/>
        </Grid>
    </Grid>
</UserControl>
