<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════════
         SLATE — LIGHT theme. Theme-dependent surface/text/line tokens.
         MUST keep the same key set as CopilotTokens.Dark.xaml so
         CopilotTheme.SetTheme() can swap one for the other at runtime.
         Referenced via {DynamicResource Cp.*} from styles + views.
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Cp.Bg"        Color="#ffffff"/>
    <SolidColorBrush x:Key="Cp.PanelBg"   Color="#f3f6f9"/>
    <SolidColorBrush x:Key="Cp.Sunken"    Color="#f3f6f9"/>
    <SolidColorBrush x:Key="Cp.Menu"      Color="#ffffff"/>
    <SolidColorBrush x:Key="Cp.Hover"     Color="#f3f6f9"/>

    <!-- Text -->
    <SolidColorBrush x:Key="Cp.Ink"   Color="#131c2b"/>
    <SolidColorBrush x:Key="Cp.Ink2"  Color="#1f2937"/>
    <SolidColorBrush x:Key="Cp.Text"  Color="#586273"/>
    <SolidColorBrush x:Key="Cp.Muted" Color="#6b768a"/>
    <SolidColorBrush x:Key="Cp.Text3" Color="#6b768a"/>
    <SolidColorBrush x:Key="Cp.Faint" Color="#99a3b3"/>

    <!-- Hairlines (alpha over slate ink) -->
    <SolidColorBrush x:Key="Cp.Line"     Color="#140F1B2D"/>
    <SolidColorBrush x:Key="Cp.LineSoft" Color="#0A0F1B2D"/>
    <SolidColorBrush x:Key="Cp.Hair2"    Color="#290F1B2D"/>

    <!-- Misc surfaces -->
    <SolidColorBrush x:Key="Cp.Veil"           Color="#F7FFFFFF"/>  <!-- indexing overlay veil -->
    <SolidColorBrush x:Key="Cp.Track"          Color="#E5E7EB"/>    <!-- progress-bar track -->
    <SolidColorBrush x:Key="Cp.TabBadgeBg"     Color="#eef1f5"/>
    <SolidColorBrush x:Key="Cp.UserText"       Color="#ffffff"/>
    <SolidColorBrush x:Key="Cp.AccentContrast" Color="#ffffff"/>

    <!-- User chat bubble (light = blue→violet gradient) -->
    <LinearGradientBrush x:Key="Cp.UserBubble" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0"    Color="#84c5ff"/>
        <GradientStop Offset="0.52" Color="#4d88ef"/>
        <GradientStop Offset="1"    Color="#7a78f3"/>
    </LinearGradientBrush>

    <!-- ═══════════ STATUS + ICON-TILE TINTS (theme-aware) ═══════════ -->
    <!-- Green / success -->
    <SolidColorBrush x:Key="Cp.GreenBg"     Color="#dcfce7"/>
    <SolidColorBrush x:Key="Cp.GreenBgSoft" Color="#f0fdf4"/>
    <SolidColorBrush x:Key="Cp.GreenLn"     Color="#bbf7d0"/>
    <SolidColorBrush x:Key="Cp.GreenFg"     Color="#15803d"/>
    <SolidColorBrush x:Key="Cp.GreenFg2"    Color="#047857"/>
    <!-- Amber / warning -->
    <SolidColorBrush x:Key="Cp.AmberBg"     Color="#fef3c7"/>
    <SolidColorBrush x:Key="Cp.AmberBgSoft" Color="#fffbeb"/>
    <SolidColorBrush x:Key="Cp.AmberLn"     Color="#fde68a"/>
    <SolidColorBrush x:Key="Cp.AmberFg"     Color="#a16207"/>
    <SolidColorBrush x:Key="Cp.AmberFg2"    Color="#92400e"/>
    <!-- Red / issues -->
    <SolidColorBrush x:Key="Cp.RedBg"       Color="#fef2f2"/>
    <SolidColorBrush x:Key="Cp.RedBg2"      Color="#fee2e2"/>
    <SolidColorBrush x:Key="Cp.RedLn"       Color="#fecaca"/>
    <SolidColorBrush x:Key="Cp.RedFg"       Color="#b91c1c"/>
    <SolidColorBrush x:Key="Cp.RedFg2"      Color="#7f1d1d"/>
    <!-- Icon-tile families (bg + fg) -->
    <SolidColorBrush x:Key="Cp.VioletBg"    Color="#ede9fe"/>
    <SolidColorBrush x:Key="Cp.VioletFg"    Color="#6d28d9"/>
    <SolidColorBrush x:Key="Cp.BlueTileBg"  Color="#dbeafe"/>
    <SolidColorBrush x:Key="Cp.BlueTileFg"  Color="#1d4ed8"/>
    <SolidColorBrush x:Key="Cp.SlateTileBg" Color="#f1f5f9"/>
    <SolidColorBrush x:Key="Cp.SlateTileFg" Color="#475569"/>
    <SolidColorBrush x:Key="Cp.SkyTileBg"   Color="#e0f2fe"/>
    <SolidColorBrush x:Key="Cp.SkyTileFg"   Color="#0369a1"/>
    <SolidColorBrush x:Key="Cp.IndigoTileBg" Color="#e0e7ff"/>
    <SolidColorBrush x:Key="Cp.IndigoTileFg" Color="#4338ca"/>
    <SolidColorBrush x:Key="Cp.Tier2Bg"     Color="#f5f3ff"/>

</ResourceDictionary>
