<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════════
         SLATE — LIGHT theme. Theme-dependent surface/text/line tokens.
         MUST keep the same key set as CopilotTokens.Dark.xaml so
         CopilotTheme.SetTheme() can swap one for the other at runtime.
         Referenced via {DynamicResource Cp.*} from styles + views.
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Cp.Bg"        Color="#ffffff"/>
    <SolidColorBrush x:Key="Cp.PanelBg"   Color="#f3f6f9"/>
    <SolidColorBrush x:Key="Cp.Sunken"    Color="#f3f6f9"/>
    <SolidColorBrush x:Key="Cp.Menu"      Color="#ffffff"/>
    <SolidColorBrush x:Key="Cp.Hover"     Color="#f3f6f9"/>

    <!-- Text -->
    <SolidColorBrush x:Key="Cp.Ink"   Color="#131c2b"/>
    <SolidColorBrush x:Key="Cp.Ink2"  Color="#1f2937"/>
    <SolidColorBrush x:Key="Cp.Text"  Color="#586273"/>
    <SolidColorBrush x:Key="Cp.Muted" Color="#6b768a"/>
    <SolidColorBrush x:Key="Cp.Text3" Color="#6b768a"/>
    <SolidColorBrush x:Key="Cp.Faint" Color="#99a3b3"/>

    <!-- Hairlines (alpha over slate ink) -->
    <SolidColorBrush x:Key="Cp.Line"     Color="#140F1B2D"/>
    <SolidColorBrush x:Key="Cp.LineSoft" Color="#0A0F1B2D"/>
    <SolidColorBrush x:Key="Cp.Hair2"    Color="#290F1B2D"/>

    <!-- Misc surfaces -->
    <SolidColorBrush x:Key="Cp.Veil"           Color="#F7FFFFFF"/>  <!-- indexing overlay veil -->
    <SolidColorBrush x:Key="Cp.Track"          Color="#E5E7EB"/>    <!-- progress-bar track -->
    <SolidColorBrush x:Key="Cp.TabBadgeBg"     Color="#eef1f5"/>
    <SolidColorBrush x:Key="Cp.UserText"       Color="#ffffff"/>
    <SolidColorBrush x:Key="Cp.AccentContrast" Color="#ffffff"/>

    <!-- User chat bubble (light = blue→violet gradient) -->
    <LinearGradientBrush x:Key="Cp.UserBubble" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0"    Color="#84c5ff"/>
        <GradientStop Offset="0.52" Color="#4d88ef"/>
        <GradientStop Offset="1"    Color="#7a78f3"/>
    </LinearGradientBrush>

</ResourceDictionary>
