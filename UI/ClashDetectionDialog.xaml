<Window x:Class="RevitWebAppSync.UI.ClashDetectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clash Detection"
        Height="750"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinHeight="600"
        MinWidth="800">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="5,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Margin" Value="5,5,5,2"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <!-- TreeView Item Style -->
        <Style x:Key="CategoryTreeViewItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Information -->
        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,10">
            <Label Content="Clash Detection Configuration" FontWeight="Bold" FontSize="16"/>
            <TextBlock Name="CurrentFileText"
                       Text="Current Model: Loading..."
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="5,0,5,5"/>
        </StackPanel>

        <!-- Linked Files Selection Section -->
        <GroupBox Grid.Row="1" Header="Linked Files Selection">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Linked Files List -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ListBox Name="LinkedFilesListBox"
                             Grid.Column="0"
                             Height="100"
                             Margin="5"
                             SelectionMode="Extended"
                             SelectionChanged="LinkedFilesListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding DisplayName}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Tag="{Binding}"
                                          Checked="LinkedFileCheckBox_Changed"
                                          Unchecked="LinkedFileCheckBox_Changed"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Name="SelectAllLinksButton" Content="Select All" Click="SelectAllLinksButton_Click" ToolTip="Select all linked files"/>
                        <Button Name="ClearAllLinksButton" Content="Clear All" Click="ClearAllLinksButton_Click" ToolTip="Clear all linked file selections"/>
                        <Button Name="RefreshLinksButton" Content="Refresh" Click="RefreshLinksButton_Click" ToolTip="Refresh linked files list"/>
                    </StackPanel>
                </Grid>

                <!-- Preset Selection -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5">
                    <Label Content="Quick Presets:" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Name="PresetAllButton" Content="All vs All" Click="PresetAllButton_Click" Width="100"/>
                    <Button Name="PresetArchMepButton" Content="Arch vs MEP" Click="PresetArchMepButton_Click" Width="100"/>
                    <Button Name="PresetArchStructButton" Content="Arch vs Structure" Click="PresetArchStructButton_Click" Width="120"/>
                    <Button Name="PresetStructMepButton" Content="Structure vs MEP" Click="PresetStructMepButton_Click" Width="120"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Element Selection Section (Set A vs Set B) -->
        <Grid Grid.Row="2" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Set A Panel (Current Model) -->
            <GroupBox Grid.Column="0" Header="Set A: Current Model Elements">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Filters -->
                    <Grid Grid.Row="0" Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="Level:"/>
                        <ComboBox Name="SetALevelComboBox" Grid.Row="0" Grid.Column="1"
                                  SelectionChanged="SetALevelComboBox_SelectionChanged"
                                  ToolTip="Filter elements by level"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="Workset:"/>
                        <ComboBox Name="SetAWorksetComboBox" Grid.Row="1" Grid.Column="1"
                                  SelectionChanged="SetAWorksetComboBox_SelectionChanged"
                                  ToolTip="Filter elements by workset"/>
                    </Grid>

                    <!-- Category Tree -->
                    <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1" Margin="5">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TreeView Name="SetACategoryTreeView"
                                      ItemContainerStyle="{StaticResource CategoryTreeViewItemStyle}">
                                <!-- Tree items populated dynamically -->
                            </TreeView>
                        </ScrollViewer>
                    </Border>

                    <!-- Special Options -->
                    <StackPanel Grid.Row="2" Orientation="Vertical" Margin="5">
                        <CheckBox Name="SetAUseCurrentSelectionCheckBox"
                                  Content="Use Current Selection in Revit"
                                  Checked="SetAUseCurrentSelectionCheckBox_Changed"
                                  Unchecked="SetAUseCurrentSelectionCheckBox_Changed"
                                  ToolTip="Use elements currently selected in Revit"/>
                    </StackPanel>

                    <!-- Action Buttons and Status -->
                    <Grid Grid.Row="3" Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Name="SetASelectAllButton" Content="Select All" Click="SetASelectAllButton_Click" Width="80"/>
                            <Button Name="SetAClearAllButton" Content="Clear All" Click="SetAClearAllButton_Click" Width="80"/>
                        </StackPanel>

                        <TextBlock Name="SetAStatusText"
                                   Grid.Column="1"
                                   Text="Selected: 0 elements"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   FontWeight="Bold"
                                   Foreground="Blue"
                                   Margin="5"/>
                    </Grid>
                </Grid>
            </GroupBox>

            <!-- Set B Panel (Linked Files) -->
            <GroupBox Grid.Column="1" Header="Set B: Linked File Elements">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Filters -->
                    <Grid Grid.Row="0" Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="Level:"/>
                        <ComboBox Name="SetBLevelComboBox" Grid.Row="0" Grid.Column="1"
                                  SelectionChanged="SetBLevelComboBox_SelectionChanged"
                                  ToolTip="Filter elements by level"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="Workset:"/>
                        <ComboBox Name="SetBWorksetComboBox" Grid.Row="1" Grid.Column="1"
                                  SelectionChanged="SetBWorksetComboBox_SelectionChanged"
                                  ToolTip="Filter elements by workset"/>
                    </Grid>

                    <!-- Category Tree -->
                    <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1" Margin="5">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TreeView Name="SetBCategoryTreeView"
                                      ItemContainerStyle="{StaticResource CategoryTreeViewItemStyle}">
                                <!-- Tree items populated dynamically -->
                            </TreeView>
                        </ScrollViewer>
                    </Border>

                    <!-- Placeholder Text -->
                    <TextBlock Name="SetBPlaceholderText"
                               Grid.Row="1"
                               Text="Please select linked files from the list above"
                               Foreground="Gray"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="20"
                               Visibility="Visible"/>

                    <!-- Special Options -->
                    <StackPanel Grid.Row="2" Orientation="Vertical" Margin="5">
                        <!-- Placeholder for future options -->
                    </StackPanel>

                    <!-- Action Buttons and Status -->
                    <Grid Grid.Row="3" Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Name="SetBSelectAllButton" Content="Select All" Click="SetBSelectAllButton_Click" Width="80"/>
                            <Button Name="SetBClearAllButton" Content="Clear All" Click="SetBClearAllButton_Click" Width="80"/>
                        </StackPanel>

                        <TextBlock Name="SetBStatusText"
                                   Grid.Column="1"
                                   Text="Selected: 0 elements"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   FontWeight="Bold"
                                   Foreground="Blue"
                                   Margin="5"/>
                    </Grid>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Settings Section -->
        <GroupBox Grid.Row="3" Header="Clash Detection Settings">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Tolerance -->
                <Label Grid.Row="0" Grid.Column="0" Content="Clash Tolerance:" VerticalAlignment="Center"/>
                <TextBox Name="ToleranceTextBox"
                         Grid.Row="0" Grid.Column="1"
                         Text="0.0"
                         ToolTip="Distance tolerance for clearance clashes (model units)"
                         VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="2"
                           Text="mm (Elements within this distance are considered clearance clashes)"
                           VerticalAlignment="Center"
                           Foreground="Gray"
                           Margin="5"/>

                <!-- Clash Types -->
                <Label Grid.Row="1" Grid.Column="0" Content="Clash Types:" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                    <CheckBox Name="HardClashCheckBox" Content="Hard Clash" IsChecked="True" ToolTip="Geometric intersection"/>
                    <CheckBox Name="ClearanceClashCheckBox" Content="Clearance Clash" IsChecked="True" ToolTip="Within tolerance distance"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Name="RunClashDetectionButton"
                    Content="Run Clash Detection"
                    Click="RunClashDetectionButton_Click"
                    IsEnabled="False"
                    FontWeight="Bold"
                    Background="LightGreen"
                    Width="150"/>
            <Button Name="SavePresetButton"
                    Content="Save Preset..."
                    Click="SavePresetButton_Click"
                    ToolTip="Save current selection as preset"/>
            <Button Name="CancelButton"
                    Content="Cancel"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
        </StackPanel>

        <!-- Loading Overlay -->
        <Grid Name="LoadingOverlay"
              Grid.RowSpan="5"
              Background="#80FFFFFF"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="200" Height="20" IsIndeterminate="True" Margin="10"/>
                <TextBlock Name="LoadingText"
                           Text="Loading categories..."
                           HorizontalAlignment="Center"
                           FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
