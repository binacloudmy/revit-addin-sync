&lt;Window x:Class="RevitWebAppSync.UI.ProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sync Progress" 
        Height="300" 
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="False"
        Topmost="True"
        Icon="../Resources/sync_icon_16x16.png"&gt;

    &lt;Window.Resources&gt;
        &lt;Style TargetType="Button"&gt;
            &lt;Setter Property="Padding" Value="10,5"/&gt;
            &lt;Setter Property="Margin" Value="5"/&gt;
            &lt;Setter Property="MinWidth" Value="80"/&gt;
        &lt;/Style&gt;

        &lt;Style TargetType="TextBlock"&gt;
            &lt;Setter Property="Margin" Value="5"/&gt;
            &lt;Setter Property="TextWrapping" Value="Wrap"/&gt;
        &lt;/Style&gt;

        &lt;Style TargetType="ProgressBar"&gt;
            &lt;Setter Property="Height" Value="20"/&gt;
            &lt;Setter Property="Margin" Value="5"/&gt;
        &lt;/Style&gt;
    &lt;/Window.Resources&gt;

    &lt;Grid Margin="10"&gt;
        &lt;Grid.RowDefinitions&gt;
            &lt;RowDefinition Height="Auto"/&gt;
            &lt;RowDefinition Height="Auto"/&gt;
            &lt;RowDefinition Height="Auto"/&gt;
            &lt;RowDefinition Height="*"/&gt;
            &lt;RowDefinition Height="Auto"/&gt;
            &lt;RowDefinition Height="Auto"/&gt;
        &lt;/Grid.RowDefinitions&gt;

        &lt;!-- Header --&gt;
        &lt;StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10"&gt;
            &lt;Image Source="../Resources/sync_icon_32x32.png" 
                   Width="32" 
                   Height="32" 
                   VerticalAlignment="Center" 
                   Margin="0,0,10,0"/&gt;
            &lt;StackPanel&gt;
                &lt;TextBlock Name="HeaderText" 
                           Text="Syncing File to Web Application" 
                           FontWeight="Bold" 
                           FontSize="14"/&gt;
                &lt;TextBlock Name="FileInfoText" 
                           Text="File: Loading..." 
                           Foreground="Gray" 
                           FontSize="11"/&gt;
            &lt;/StackPanel&gt;
        &lt;/StackPanel&gt;

        &lt;!-- Current Step --&gt;
        &lt;TextBlock Grid.Row="1" 
                   Name="CurrentStepText" 
                   Text="Initializing..." 
                   FontWeight="Bold" 
                   FontSize="12"/&gt;

        &lt;!-- Progress Bar --&gt;
        &lt;ProgressBar Grid.Row="2" 
                     Name="MainProgressBar" 
                     Value="0" 
                     Maximum="100"/&gt;

        &lt;!-- Detailed Progress Log --&gt;
        &lt;ScrollViewer Grid.Row="3" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="5"&gt;
            &lt;TextBlock Name="ProgressLogText" 
                       FontFamily="Consolas, Courier New" 
                       FontSize="10" 
                       Foreground="DarkGray"
                       Background="#F8F8F8"
                       Padding="5"/&gt;
        &lt;/ScrollViewer&gt;

        &lt;!-- Status Information --&gt;
        &lt;Grid Grid.Row="4" Margin="0,5,0,5"&gt;
            &lt;Grid.ColumnDefinitions&gt;
                &lt;ColumnDefinition Width="Auto"/&gt;
                &lt;ColumnDefinition Width="*"/&gt;
                &lt;ColumnDefinition Width="Auto"/&gt;
                &lt;ColumnDefinition Width="*"/&gt;
            &lt;/Grid.ColumnDefinitions&gt;

            &lt;TextBlock Grid.Column="0" Text="Elapsed:" FontWeight="Bold"/&gt;
            &lt;TextBlock Grid.Column="1" Name="ElapsedTimeText" Text="00:00"/&gt;
            
            &lt;TextBlock Grid.Column="2" Text="Status:" FontWeight="Bold"/&gt;
            &lt;TextBlock Grid.Column="3" Name="StatusText" Text="In Progress"/&gt;
        &lt;/Grid&gt;

        &lt;!-- Buttons --&gt;
        &lt;StackPanel Grid.Row="5" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,10,0,0"&gt;
            &lt;Button Name="CancelButton" 
                    Content="Cancel" 
                    Click="CancelButton_Click"
                    IsEnabled="True"/&gt;
            &lt;Button Name="CloseButton" 
                    Content="Close" 
                    Click="CloseButton_Click"
                    IsEnabled="False"
                    IsDefault="True"/&gt;
        &lt;/StackPanel&gt;
    &lt;/Grid&gt;
&lt;/Window&gt;