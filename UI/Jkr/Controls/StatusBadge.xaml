<UserControl x:Class="RevitWebAppSync.UI.Jkr.Controls.StatusBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jkr="clr-namespace:RevitWebAppSync.UI.Jkr"
             x:Name="Root">
    <Border Background="{Binding StatusBg}" CornerRadius="8" Padding="7,2,7,2" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <jkr:IconGlyph Glyph="{Binding StatusIconName}" Size="10" StrokeThickness="2"
                           Foreground="{Binding StatusColor}" Margin="0,0,3,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding StatusLabel}" FontSize="9.5" FontWeight="SemiBold"
                       Foreground="{Binding StatusColor}" VerticalAlignment="Center"
                       FontFamily="{DynamicResource Font.Sans}"/>
        </StackPanel>
    </Border>
</UserControl>
