<UserControl x:Class="RevitWebAppSync.UI.Jkr.Controls.IssueRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jkr="clr-namespace:RevitWebAppSync.UI.Jkr"
             xmlns:ctl="clr-namespace:RevitWebAppSync.UI.Jkr.Controls"
             Cursor="Hand" Focusable="True">
    <UserControl.Resources>
        <jkr:BoolToVisibilityConverter x:Key="B2V"/>
    </UserControl.Resources>
    <!-- Outer: provides bottom divider -->
    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Surface.Line2}">
        <!-- Inner: priority bar + hover/active bg -->
        <Border x:Name="Bd" BorderThickness="3,0,0,0" BorderBrush="Transparent"
                MouseEnter="Bd_MouseEnter" MouseLeave="Bd_MouseLeave"
                MouseLeftButtonUp="Bd_Click">
            <Grid Margin="11,8,14,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Priority pip -->
                <Rectangle Grid.Column="0" Width="4" Height="28" RadiusX="2" RadiusY="2"
                           Fill="{Binding PriorityBarBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="Medium"
                               Foreground="{DynamicResource Ink}"
                               TextTrimming="CharacterEllipsis"
                               TextDecorations="{Binding TitleDecoration}"
                               Opacity="{Binding TitleOpacity}"
                               FontFamily="{DynamicResource Font.Sans}"/>
                    <!-- Element name + required/actual preview -->
                    <TextBlock FontSize="10.5" Foreground="{DynamicResource Ink3}" Margin="0,1,0,0"
                               TextTrimming="CharacterEllipsis" FontFamily="{DynamicResource Font.Sans}"
                               Visibility="{Binding HasElementName, Converter={StaticResource B2V}}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}">
                                <Binding Path="Element.Name"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <!-- Required → Actual summary -->
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                Visibility="{Binding HasActualOrRequired, Converter={StaticResource B2V}}">
                        <TextBlock Text="{Binding Actual}" FontSize="10" Foreground="{DynamicResource Hi}"
                                   FontFamily="{DynamicResource Font.Mono}" TextTrimming="CharacterEllipsis"
                                   MaxWidth="140" VerticalAlignment="Center"/>
                        <TextBlock Text=" → " FontSize="10" Foreground="{DynamicResource Ink4}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding RequiredOrExample}" FontSize="10" Foreground="{DynamicResource Ok}"
                                   FontFamily="{DynamicResource Font.Mono}" TextTrimming="CharacterEllipsis"
                                   MaxWidth="140" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- Meta line: priority + spec ref -->
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding PriorityLabel}" FontSize="9.5" FontWeight="SemiBold"
                                   Foreground="{Binding PriorityColor}" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource Font.Sans}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOpen}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource Ink4}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text=" · " FontSize="10" Foreground="{DynamicResource Ink4}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SpecLabel}" FontSize="9.5" Foreground="{DynamicResource Info}"
                                   VerticalAlignment="Center" FontFamily="{DynamicResource Font.Sans}"
                                   Visibility="{Binding HasSpec, Converter={StaticResource B2V}}"/>
                        <TextBlock Text=" · " FontSize="10" Foreground="{DynamicResource Ink4}" VerticalAlignment="Center"
                                   Visibility="{Binding HasSpec, Converter={StaticResource B2V}}"/>
                        <TextBlock Text="{Binding Id}" FontSize="9.5" Opacity="0.6"
                                   FontFamily="{DynamicResource Font.Mono}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Ink4}"/>
                        <TextBlock Text=" · " FontSize="10" Foreground="{DynamicResource Ink4}" VerticalAlignment="Center"
                                   Visibility="{Binding IsResolved, Converter={StaticResource B2V}}"/>
                        <ctl:StatusBadge Visibility="{Binding IsResolved, Converter={StaticResource B2V}}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsActionable, Converter={StaticResource B2V}}">
                    <Button Style="{DynamicResource Btn.QuickFix}" Margin="0,0,4,0"
                            ToolTip="Auto-fix (F)"
                            Visibility="{Binding ShowAutoFixButton, Converter={StaticResource B2V}}"
                            Click="AutoFix_Click">
                        <jkr:IconGlyph Glyph="bolt" Size="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</UserControl>
