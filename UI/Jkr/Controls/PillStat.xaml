<UserControl x:Class="RevitWebAppSync.UI.Jkr.Controls.PillStat"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Background="{Binding ElementName=Root, Path=Bg}" CornerRadius="10" Padding="7,2,7,2">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="5" Height="5" Fill="{Binding ElementName=Root, Path=Fg}" Margin="0,0,4,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ElementName=Root, Path=Count}" FontSize="10.5" FontWeight="SemiBold"
                       Foreground="{Binding ElementName=Root, Path=Fg}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ElementName=Root, Path=Label}" FontSize="10.5" FontWeight="Medium"
                       Foreground="{Binding ElementName=Root, Path=Fg}" Opacity="0.75" Margin="4,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>
