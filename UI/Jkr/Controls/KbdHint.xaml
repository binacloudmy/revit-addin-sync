<UserControl x:Class="RevitWebAppSync.UI.Jkr.Controls.KbdHint"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Background="{DynamicResource Surface.Line2}" CornerRadius="3" Padding="5,1,5,1" VerticalAlignment="Center">
            <TextBlock Text="{Binding ElementName=Root, Path=Key}" FontSize="9.5" FontWeight="SemiBold"
                       FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource Ink2}"/>
        </Border>
        <TextBlock Text="{Binding ElementName=Root, Path=Label}" FontSize="10"
                   Foreground="{DynamicResource Ink3}" VerticalAlignment="Center"
                   Margin="4,0,0,0" FontFamily="{DynamicResource Font.Sans}"/>
    </StackPanel>
</UserControl>
