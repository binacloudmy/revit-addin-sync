<Window x:Class="RevitWebAppSync.UI.Jkr.Export.BorangPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="760" Height="900"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        Background="Transparent" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" FontFamily="{DynamicResource Bz.Font.Sans}" FontSize="13" Foreground="{DynamicResource Bz.Text}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!-- Borang BIM010 preview (Clear Sheet): a card over a scrim. Header: title, the model's
         file name in mono, close. Body: the PDF's own pages, one at a time with a
         page counter (the pages are rendered by the same engine as the PDF and shown as they
         are). Footer: Export issues (a small menu: Excel / CSV with their issue counts) and
         Save PDF in ink. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevitWebAppSync;component/UI/Jkr/Panel/PanelTokens.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- A 32 px icon button without a hairline (page arrows) -->
            <Style x:Key="Bp.Arrow" TargetType="Button" BasedOn="{StaticResource Bz.ChromeIconButton}">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Foreground" Value="{StaticResource Bz.TextBody}"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{StaticResource Bz.Tone.Listed}"/>
                        <Setter Property="Cursor" Value="Arrow"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- A row of the Export issues menu -->
            <Style x:Key="Bp.MenuItem" TargetType="Button">
                <Setter Property="Height" Value="36"/>
                <Setter Property="Foreground" Value="{StaticResource Bz.Text}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource Bz.FocusRing}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,0">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bz.Hover}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bz.Hover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource Bz.Scrim}">
        <Border x:Name="Card" Width="480" Height="820" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="{StaticResource Bz.Surface}" CornerRadius="12" BorderBrush="{StaticResource Bz.Line}" BorderThickness="1"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect Color="#15181D" BlurRadius="40" ShadowDepth="12" Opacity="0.22"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- header: 56 px, hairline below -->
                <Border Grid.Row="0" Height="56" Padding="16,0,8,0" BorderBrush="{StaticResource Bz.Line}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Bz.Text}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="FileText" FontFamily="{StaticResource Bz.Font.Mono}" FontSize="11.5" Foreground="{StaticResource Bz.Text2}"
                                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                        </StackPanel>
                        <Button x:Name="CloseBtn" Grid.Column="1" Style="{StaticResource Bz.ChromeIconButton}" Width="32" Height="32"
                                VerticalAlignment="Center" Click="Close_Click">
                            <Path Data="M4.5,4.5 L11.5,11.5 M11.5,4.5 L4.5,11.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- the pages, as rendered -->
                <Grid Grid.Row="1" Background="{StaticResource Bz.Sunken2}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer x:Name="PageScroll" Grid.Row="0" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                  PreviewMouseWheel="PageScroll_Wheel" SizeChanged="PageScroll_SizeChanged">
                        <Border x:Name="PageBox" Margin="24,20,24,10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{StaticResource Bz.Surface}" CornerRadius="3">
                            <Border.Effect>
                                <DropShadowEffect Color="#15181D" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.22"/>
                            </Border.Effect>
                            <Image x:Name="PageImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                    </ScrollViewer>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                        <Button x:Name="PrevBtn" Style="{StaticResource Bp.Arrow}" Click="Prev_Click">
                            <Path Data="M9.5,4.5 L6,8 L9.5,11.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                        <TextBlock x:Name="PageText" FontSize="12" Foreground="{StaticResource Bz.TextBody}" VerticalAlignment="Center" Margin="6,0"/>
                        <Button x:Name="NextBtn" Style="{StaticResource Bp.Arrow}" Click="Next_Click">
                            <Path Data="M6.5,4.5 L10,8 L6.5,11.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="24,0,24,12">
                        <TextBlock x:Name="NoteText" FontSize="11" Foreground="{StaticResource Bz.Text2}" TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock x:Name="StatusText" FontSize="11" Foreground="{StaticResource Bz.Text2}" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Margin="0,4,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>

                <!-- footer: 60 px -->
                <Border Grid.Row="2" Height="60" Padding="16,0" Background="{StaticResource Bz.Sunken}" CornerRadius="0,0,12,12"
                        BorderBrush="{StaticResource Bz.Line}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="IssuesBtn" Grid.Column="0" Style="{StaticResource Bz.Btn.Ghost}" Height="36" Padding="14,0" FontSize="13" FontWeight="SemiBold"
                                Foreground="{StaticResource Bz.Text}" BorderBrush="{StaticResource Bz.Line2}" Click="Issues_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="IssuesLabel" VerticalAlignment="Center"/>
                                <Path x:Name="IssuesChevron" Data="M4.5,9.5 L8,6 L11.5,9.5" Stroke="{StaticResource Bz.Text2}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform"
                                      Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="PdfBtn" Grid.Column="2" Style="{StaticResource Bz.Btn.Ink}" Height="36" Padding="14,0" FontSize="13" Click="Pdf_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M8,2.5 L8,10.5 M4.8,7.3 L8,10.5 L11.2,7.3 M3,13.5 L13,13.5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock x:Name="PdfLabel" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Export issues menu: above the footer button -->
                <Border x:Name="IssuesMenu" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" Width="240"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16,0,0,68"
                        Background="{StaticResource Bz.Surface}" CornerRadius="10" Padding="4"
                        BorderBrush="{StaticResource Bz.Line}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#15181D" BlurRadius="28" ShadowDepth="10" Direction="270" Opacity="0.22"/>
                    </Border.Effect>
                    <StackPanel>
                        <Button x:Name="ExcelItem" Style="{StaticResource Bp.MenuItem}" Click="Excel_Click">
                            <DockPanel LastChildFill="False">
                                <TextBlock x:Name="ExcelCount" DockPanel.Dock="Right" FontSize="12" FontWeight="Normal" Foreground="{StaticResource Bz.Text2}"/>
                                <TextBlock x:Name="ExcelLabel"/>
                            </DockPanel>
                        </Button>
                        <Button x:Name="CsvItem" Style="{StaticResource Bp.MenuItem}" Click="Csv_Click">
                            <DockPanel LastChildFill="False">
                                <TextBlock x:Name="CsvCount" DockPanel.Dock="Right" FontSize="12" FontWeight="Normal" Foreground="{StaticResource Bz.Text2}"/>
                                <TextBlock x:Name="CsvLabel"/>
                            </DockPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
