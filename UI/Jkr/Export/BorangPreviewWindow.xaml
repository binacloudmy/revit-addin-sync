<Window x:Class="RevitWebAppSync.UI.Jkr.Export.BorangPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="900" Height="720"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        Background="{DynamicResource Bz.Sunken}" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" FontFamily="{DynamicResource Bz.Font.Sans}" FontSize="12" Foreground="{DynamicResource Bz.Text}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!-- Export preview (prototype .exp / .exp-bar / .exp-doc; frames e-p1, e-sum), in
         Direction C's dark look (BorangBM): a 44 px header with a hairline, PDF as the
         light button, the issue export as ghost, Close. The pages are the PDF's own
         pages, rendered by the same engine, shown as they are. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevitWebAppSync;component/UI/Jkr/Panel/PanelTokens.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Close: a ghost button without its hairline until hovered -->
            <Style x:Key="BarBtn" TargetType="Button" BasedOn="{StaticResource Bz.Btn.Ghost}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource Bz.Text2}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{StaticResource Bz.Line2}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- .exp-bar: 44 px header, hairline below -->
            <Border Background="{StaticResource Bz.Surface}" BorderBrush="{StaticResource Bz.Line}" BorderThickness="0,0,0,1"
                    Padding="14,0,10,0" MinHeight="44">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,6,12,6">
                        <TextBlock x:Name="TitleText" Foreground="{StaticResource Bz.Text}" FontSize="12.5" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="StatusText" Foreground="{StaticResource Bz.Text2}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="IssuesBtn" Style="{StaticResource Bz.Btn.Ghost}" Height="32" Padding="12,0,12,0" Margin="0,0,8,0" Click="Issues_Click"/>
                        <Button x:Name="PdfBtn" Style="{StaticResource Bz.Btn.Ink}" Height="32" Padding="14,0,14,0" Margin="0,0,8,0" Click="Pdf_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,3 L12,15 M7,10 L12,15 L17,10 M5,21 L19,21"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="PDF" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="CloseBtn" Style="{StaticResource BarBtn}" Height="32" Padding="10,0,10,0" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- .exp-doc: the pages, as rendered -->
            <ScrollViewer x:Name="Doc" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                          Focusable="False" PanningMode="VerticalOnly">
                <ItemsControl x:Name="PagesList" Margin="24" HorizontalAlignment="Center">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Bz.Line}" BorderThickness="1" Margin="0,0,0,22" Width="722">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.5"/>
                                </Border.Effect>
                                <Image Source="{Binding}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
