<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ═══════════ SURFACE ═══════════ -->
    <SolidColorBrush x:Key="Surface.Bg"    Color="#F8F9FA"/>
    <SolidColorBrush x:Key="Surface.Panel" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Surface.Line"  Color="#E5E7EB"/>
    <SolidColorBrush x:Key="Surface.Line2" Color="#EEF0F3"/>

    <!-- ═══════════ TEXT ═══════════ -->
    <SolidColorBrush x:Key="Ink"   Color="#15181D"/>
    <SolidColorBrush x:Key="Ink2"  Color="#4B5361"/>
    <SolidColorBrush x:Key="Ink3"  Color="#646B78"/>
    <SolidColorBrush x:Key="Ink4"  Color="#8A919C"/>

    <!-- ═══════════ BRAND ═══════════ -->
    <SolidColorBrush x:Key="Brand"     Color="#15181D"/>
    <SolidColorBrush x:Key="BrandDark" Color="#2C313A"/>
    <SolidColorBrush x:Key="BrandTint" Color="#F1F3F6"/>
    <SolidColorBrush x:Key="Peach"     Color="#C9CED6"/>
    <SolidColorBrush x:Key="Navy"      Color="#15181D"/>
    <SolidColorBrush x:Key="NavyAlt"   Color="#2C313A"/>
    <SolidColorBrush x:Key="NavySubtle" Color="#8A919C"/>

    <LinearGradientBrush x:Key="Jkr.LogoGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#2C313A"/>
        <GradientStop Offset="1" Color="#15181D"/>
    </LinearGradientBrush>

    <!-- ═══════════ PRIORITY ═══════════ -->
    <SolidColorBrush x:Key="Hi"    Color="#C2331F"/>
    <SolidColorBrush x:Key="HiBg"  Color="#FCEEEC"/>
    <SolidColorBrush x:Key="HiBg2" Color="#F9D9D5"/>
    <SolidColorBrush x:Key="Md"    Color="#B26B00"/>
    <SolidColorBrush x:Key="MdBg"  Color="#FFF5E0"/>
    <SolidColorBrush x:Key="MdBg2" Color="#F2D9A6"/>
    <SolidColorBrush x:Key="Lo"    Color="#646B78"/>
    <SolidColorBrush x:Key="LoBg"  Color="#F1F3F6"/>
    <SolidColorBrush x:Key="LoBg2" Color="#EEF0F3"/>

    <!-- Pill stat (semi-transparent on navy) -->
    <SolidColorBrush x:Key="PillHi"   Color="#F08A7C"/>
    <SolidColorBrush x:Key="PillHiBg" Color="#26F08A7C"/>
    <SolidColorBrush x:Key="PillMd"   Color="#F2B24D"/>
    <SolidColorBrush x:Key="PillMdBg" Color="#26F2B24D"/>
    <SolidColorBrush x:Key="PillLo"   Color="#C9CED6"/>
    <SolidColorBrush x:Key="PillLoBg" Color="#26C9CED6"/>

    <!-- ═══════════ STATUS ═══════════ -->
    <SolidColorBrush x:Key="Ok"    Color="#3DA570"/>
    <SolidColorBrush x:Key="OkBg"  Color="#EAF5EF"/>
    <SolidColorBrush x:Key="OkBg2" Color="#D4EBDF"/>
    <SolidColorBrush x:Key="Info"    Color="#5B3FD0"/>
    <SolidColorBrush x:Key="InfoBg"  Color="#EEEAFB"/>

    <!-- Diff row subtle backgrounds -->
    <SolidColorBrush x:Key="DiffOkSubtle"  Color="#F7FBF9"/>
    <SolidColorBrush x:Key="DiffBadSubtle" Color="#FEF8F7"/>

    <!-- Scrim -->
    <SolidColorBrush x:Key="Scrim" Color="#5915181D"/>

    <!-- ═══════════ TYPOGRAPHY ═══════════ -->
    <!-- Clear Sheet: Public Sans and IBM Plex Mono (bundled in Fonts/), Segoe UI and Consolas as fallback. -->
    <FontFamily x:Key="Font.Sans">pack://application:,,,/RevitWebAppSync;component/Fonts/#Public Sans, Segoe UI, system-ui, sans-serif</FontFamily>
    <FontFamily x:Key="Font.Mono">pack://application:,,,/RevitWebAppSync;component/Fonts/#IBM Plex Mono, Consolas, Cascadia Mono, Courier New, monospace</FontFamily>

    <!-- ═══════════ DIMENSIONS ═══════════ -->
    <sys:Double x:Key="Dim.PanelWidth">460</sys:Double>
    <sys:Double x:Key="Dim.TitleBarH">26</sys:Double>

</ResourceDictionary>
