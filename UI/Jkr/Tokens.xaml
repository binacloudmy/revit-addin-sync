<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ═══════════ SURFACE ═══════════ -->
    <SolidColorBrush x:Key="Surface.Bg"    Color="#F7F6F3"/>
    <SolidColorBrush x:Key="Surface.Panel" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Surface.Line"  Color="#E7E5DE"/>
    <SolidColorBrush x:Key="Surface.Line2" Color="#F0EEE8"/>

    <!-- ═══════════ TEXT ═══════════ -->
    <SolidColorBrush x:Key="Ink"   Color="#16181C"/>
    <SolidColorBrush x:Key="Ink2"  Color="#44484F"/>
    <SolidColorBrush x:Key="Ink3"  Color="#6B7078"/>
    <SolidColorBrush x:Key="Ink4"  Color="#9AA0A6"/>

    <!-- ═══════════ BRAND ═══════════ -->
    <SolidColorBrush x:Key="Brand"     Color="#E27449"/>
    <SolidColorBrush x:Key="BrandDark" Color="#C85A30"/>
    <SolidColorBrush x:Key="BrandTint" Color="#FFF1E9"/>
    <SolidColorBrush x:Key="Peach"     Color="#FFB089"/>
    <SolidColorBrush x:Key="Navy"      Color="#0E2238"/>
    <SolidColorBrush x:Key="NavyAlt"   Color="#1A3355"/>
    <SolidColorBrush x:Key="NavySubtle" Color="#97A9BE"/>

    <LinearGradientBrush x:Key="Jkr.LogoGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFB089"/>
        <GradientStop Offset="1" Color="#E27449"/>
    </LinearGradientBrush>

    <!-- ═══════════ PRIORITY ═══════════ -->
    <SolidColorBrush x:Key="Hi"    Color="#C73E3E"/>
    <SolidColorBrush x:Key="HiBg"  Color="#FDECEC"/>
    <SolidColorBrush x:Key="HiBg2" Color="#FCE0DF"/>
    <SolidColorBrush x:Key="Md"    Color="#B8721A"/>
    <SolidColorBrush x:Key="MdBg"  Color="#FDF3E2"/>
    <SolidColorBrush x:Key="MdBg2" Color="#F8E4BF"/>
    <SolidColorBrush x:Key="Lo"    Color="#5B6470"/>
    <SolidColorBrush x:Key="LoBg"  Color="#ECEDEF"/>
    <SolidColorBrush x:Key="LoBg2" Color="#DFE2E6"/>

    <!-- Pill stat (semi-transparent on navy) -->
    <SolidColorBrush x:Key="PillHi"   Color="#FF7A7A"/>
    <SolidColorBrush x:Key="PillHiBg" Color="#26FF7A7A"/>
    <SolidColorBrush x:Key="PillMd"   Color="#FFBD5C"/>
    <SolidColorBrush x:Key="PillMdBg" Color="#26FFBD5C"/>
    <SolidColorBrush x:Key="PillLo"   Color="#B8C1CD"/>
    <SolidColorBrush x:Key="PillLoBg" Color="#26B8C1CD"/>

    <!-- ═══════════ STATUS ═══════════ -->
    <SolidColorBrush x:Key="Ok"    Color="#2C8148"/>
    <SolidColorBrush x:Key="OkBg"  Color="#E6F3EA"/>
    <SolidColorBrush x:Key="OkBg2" Color="#D2E9D8"/>
    <SolidColorBrush x:Key="Info"    Color="#2B63A8"/>
    <SolidColorBrush x:Key="InfoBg"  Color="#E6EEF9"/>

    <!-- Diff row subtle backgrounds -->
    <SolidColorBrush x:Key="DiffOkSubtle"  Color="#FAFDFB"/>
    <SolidColorBrush x:Key="DiffBadSubtle" Color="#FDF9F9"/>

    <!-- Scrim -->
    <SolidColorBrush x:Key="Scrim" Color="#6B0A141E"/>

    <!-- ═══════════ TYPOGRAPHY ═══════════ -->
    <!-- Inter + JetBrains Mono not shipped; Segoe UI + Consolas cover fidelity close enough. -->
    <FontFamily x:Key="Font.Sans">Segoe UI, system-ui, sans-serif</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Courier New, monospace</FontFamily>

    <!-- ═══════════ DIMENSIONS ═══════════ -->
    <sys:Double x:Key="Dim.PanelWidth">460</sys:Double>
    <sys:Double x:Key="Dim.TitleBarH">26</sys:Double>

</ResourceDictionary>
