<Window x:Class="RevitWebAppSync.UI.Jkr.Panel.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RevitWebAppSync.UI.Jkr.Panel"
        Width="760" Height="720" Title="BINA JKR Compliance"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        Background="Transparent" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" FontFamily="{DynamicResource Bz.Font.Sans}" FontSize="13"
        Foreground="{DynamicResource Bz.Text}" TextOptions.TextFormattingMode="Display">
    <!-- Issue detail (Clear Sheet "issue with a fix", "issue with an AI fixer proposal",
         "semak manual issue"). Header: ‹ › "Issue n of m open" ×, with the progress strip on
         its bottom line. Body: severity tag · "Borang A5 · section" · hash; title and
         description; Element / Required / In model; one flat block (suggested fix, AI fixer
         proposal, semak manual reason, fix failed, how to fix); one "Source: …" line (opens
         the PDF when there is one). Action bar: Locate in 3D · Ignore (A) · Mark as Manual,
         then Apply fix (F) / Apply AI fix (F) / Reopen / Mark as reviewed on the right.
         DataContext: Core.DetailScreenModel. No animation: it breaks Revit panes. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevitWebAppSync;component/UI/Jkr/Panel/PanelTokens.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="B2V"/>

            <!-- 16-unit line icons (Clear Sheet .ic: stroke 1.6, round caps) -->
            <Style x:Key="Ico" TargetType="Path">
                <Setter Property="StrokeThickness" Value="1.6"/>
                <Setter Property="StrokeStartLineCap" Value="Round"/>
                <Setter Property="StrokeEndLineCap" Value="Round"/>
                <Setter Property="StrokeLineJoin" Value="Round"/>
                <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Style>
            <Geometry x:Key="BoltGeo">M9,1.8 L3.8,9 L7.8,9 L7,14.2 L12.2,7 L8.2,7 Z</Geometry>
            <Geometry x:Key="SparkBoltGeo">M7.6,2.2 L2.6,9.2 L6.4,9.2 L5.6,14.2 L10.8,7.2 L7,7.2 Z</Geometry>
            <Geometry x:Key="SparkGeo">M12.6,1.2 L13.3,2.9 L15,3.6 L13.3,4.3 L12.6,6 L11.9,4.3 L10.2,3.6 L11.9,2.9 Z</Geometry>
            <Geometry x:Key="BookGeo">M3,3.2 C5,2.4 6.6,2.6 8,3.8 C9.4,2.6 11,2.4 13,3.2 L13,12.8 C11,12 9.4,12.2 8,13.4 C6.6,12.2 5,12 3,12.8 Z M8,3.8 L8,13.4</Geometry>
            <Geometry x:Key="LocateGeo">M8,4 A4,4 0 1 1 7.99,4 Z M8,1.5 L8,4 M8,12 L8,14.5 M1.5,8 L4,8 M12,8 L14.5,8</Geometry>
            <Geometry x:Key="CheckGeo">M3.5,8.5 L6.5,11.5 L12.5,4.5</Geometry>

            <!-- Clear Sheet .btn: 36 px, radius 8, 600 13 px -->
            <Style x:Key="Btn" TargetType="Button">
                <Setter Property="Height" Value="36"/>
                <Setter Property="Padding" Value="14,0,14,0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource Bz.FocusRing}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- .pri: ink fill -->
            <Style x:Key="BtnPri" TargetType="Button" BasedOn="{StaticResource Btn}">
                <Setter Property="Background" Value="{StaticResource Bz.Ink}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Bz.Ink}"/>
                <Setter Property="Foreground" Value="{StaticResource Bz.OnBrand}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource Bz.InkHover}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Bz.InkHover}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- .sec: white with a 1 px #D0D4DA ring -->
            <Style x:Key="BtnSec" TargetType="Button" BasedOn="{StaticResource Btn}">
                <Setter Property="Background" Value="{StaticResource Bz.Surface}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Bz.Line2}"/>
                <Setter Property="Foreground" Value="{StaticResource Bz.Text}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource Bz.CodeBg}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- .gh: text button -->
            <Style x:Key="BtnGh" TargetType="Button" BasedOn="{StaticResource Btn}">
                <Setter Property="Padding" Value="10,0,10,0"/>
                <Setter Property="Foreground" Value="{StaticResource Bz.TextBody}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource Bz.Hover}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Bz.Hover}"/>
                        <Setter Property="Foreground" Value="{StaticResource Bz.Text}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- .ib: 32 px icon button in the header -->
            <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource BtnGh}">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource Bz.Tone.Listed}"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- .kbd: a key cap drawn in the button's own colour -->
            <Style x:Key="Kb" TargetType="Border">
                <Setter Property="Margin" Value="8,0,0,0"/>
                <Setter Property="Padding" Value="5,0,5,0"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Opacity" Value="0.7"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Style>
            <Style x:Key="KbText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Bz.Font.Mono}"/>
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="LineHeight" Value="14"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Style>

            <!-- Flat tinted block: radius 10, 16 / 14 in, 16 px apart, never bordered -->
            <Style x:Key="Blk" TargetType="Border">
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="16,14,16,16"/>
                <Setter Property="Margin" Value="0,16,0,0"/>
                <Setter Property="Background" Value="{StaticResource Bz.CodeBg}"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>
            <Style x:Key="BlkHead" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="LineHeight" Value="18"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="BlkNote" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="LineHeight" Value="17"/>
                <Setter Property="Foreground" Value="{StaticResource Bz.Text2}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,10,0,0"/>
            </Style>
            <!-- The diff: − old / + new mono lines on a white card -->
            <Style x:Key="DiffLine" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Bz.Font.Mono}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <!-- Evidence table: 112 px term column, soft dividers -->
            <Style x:Key="DlTerm" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource Bz.Text2}"/>
                <Setter Property="Margin" Value="0,10,12,10"/>
            </Style>
            <Style x:Key="DlValue" TargetType="TextBlock">
                <Setter Property="Grid.Column" Value="1"/>
                <Setter Property="FontFamily" Value="{StaticResource Bz.Font.Mono}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource Bz.Text}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,10,0,10"/>
            </Style>
            <!-- Required / In model rows: left out on a semak manual issue (Clear Sheet draws Element only) -->
            <Style x:Key="AiOnlyRow" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource Bz.LineSoft}"/>
                <Setter Property="BorderThickness" Value="0,1,0,0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Card.IsManual}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <!-- Scrim: covers Revit's window; a click on it closes -->
        <Border x:Name="Scrim" Background="{StaticResource Bz.Scrim}" MouseDown="Scrim_MouseDown"/>

        <!-- The card -->
        <Border x:Name="Card" MaxWidth="560" Margin="24" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                Background="{StaticResource Bz.Surface}" BorderBrush="{StaticResource Bz.Line}" BorderThickness="1"
                CornerRadius="12" MouseDown="Card_MouseDown"
                AutomationProperties.Name="{Binding IdxLabel}">
            <Border.Effect>
                <DropShadowEffect Color="#15181D" BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.22"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header, 52 px: ‹ › on the left, "Issue n of m open" centred, × on the right;
                     the progress strip sits on its bottom line -->
                <Border Grid.Row="0" Height="52" BorderBrush="{StaticResource Bz.Line}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid Margin="10,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="72"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="PrevBtn" Style="{StaticResource NavBtn}" IsEnabled="{Binding CanPrev}" Click="Prev_Click"
                                        AutomationProperties.Name="{Binding PrevLabel}" ToolTip="{Binding PrevLabel}">
                                    <Canvas Width="16" Height="16"><Path Style="{StaticResource Ico}" Data="M9.5,4.5 L6,8 L9.5,11.5"/></Canvas>
                                </Button>
                                <Button x:Name="NextBtn" Style="{StaticResource NavBtn}" Margin="4,0,0,0" IsEnabled="{Binding CanNext}" Click="Next_Click"
                                        AutomationProperties.Name="{Binding NextLabel}" ToolTip="{Binding NextLabel}">
                                    <Canvas Width="16" Height="16"><Path Style="{StaticResource Ico}" Data="M6.5,4.5 L10,8 L6.5,11.5"/></Canvas>
                                </Button>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding IdxLabel}" FontSize="12" Foreground="{StaticResource Bz.TextBody}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="2" x:Name="CloseBtn" Style="{StaticResource NavBtn}" HorizontalAlignment="Right"
                                    Click="Close_Click" AutomationProperties.Name="{Binding CloseLabel}" ToolTip="{Binding CloseLabel}">
                                <Canvas Width="16" Height="16"><Path Style="{StaticResource Ico}" Data="M4.5,4.5 L11.5,11.5 M11.5,4.5 L4.5,11.5"/></Canvas>
                            </Button>
                        </Grid>
                        <!-- progress: an ink bar over the bottom line, as wide as n / m -->
                        <Border Height="2" VerticalAlignment="Bottom" Margin="0,0,0,-1" Background="{StaticResource Bz.Ink}" IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding ProgFraction}" ScaleY="1"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </Border>

                <!-- The current issue -->
                <ScrollViewer x:Name="Body" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <StackPanel x:Name="CardBody" Margin="24,22,24,22">

                        <!-- State line: severity (or state) tag, the Manual tag, "Borang A5 · section", hash -->
                        <WrapPanel>
                            <Border CornerRadius="10" Padding="8,3,8,3" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource Bz.Tone.ListedBg}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Card.SvKind}" Value="High"><Setter Property="Background" Value="{StaticResource Bz.HighBg}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Card.SvKind}" Value="Med"><Setter Property="Background" Value="{StaticResource Bz.MedBg}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Card.SvKind}" Value="man">
                                                <Setter Property="Background" Value="{StaticResource Bz.ManualBg}"/>
                                                <Setter Property="Padding" Value="7,3,9,3"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Card.SvKind}" Value="ok"><Setter Property="Background" Value="{StaticResource Bz.OkBg}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <!-- semak manual: the outlined purple dot -->
                                    <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{StaticResource Bz.Surface}"
                                             Stroke="{StaticResource Bz.Manual}" StrokeThickness="2"
                                             Visibility="{Binding Card.IsManual, Converter={StaticResource B2V}}"/>
                                    <TextBlock x:Name="SvText" Text="{Binding Card.SvLabel}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Bz.TextBody}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Card.SvKind}" Value="High"><Setter Property="Foreground" Value="{StaticResource Bz.HighText}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Card.SvKind}" Value="Med"><Setter Property="Foreground" Value="{StaticResource Bz.MedInk}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Card.SvKind}" Value="man"><Setter Property="Foreground" Value="{StaticResource Bz.Manual}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Card.SvKind}" Value="ok"><Setter Property="Foreground" Value="{StaticResource Bz.OkInk}"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <!-- Mark as Manual (option b): still open, "Manual · you'll fix it in Revit" -->
                            <Border Background="{StaticResource Bz.Sunken2}" CornerRadius="10" Padding="8,3,8,3" Margin="0,0,10,0" VerticalAlignment="Center"
                                    Visibility="{Binding Card.IsMarkedManual, Converter={StaticResource B2V}}">
                                <TextBlock Text="{Binding Card.ManualTag}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Bz.TextBody}"/>
                            </Border>
                            <TextBlock Text="{Binding Card.Where}" FontSize="12" Foreground="{StaticResource Bz.TextBody}" Margin="0,0,10,0" VerticalAlignment="Center"
                                       Visibility="{Binding Card.HasWhere, Converter={StaticResource B2V}}"/>
                            <TextBlock Text="{Binding Card.Hash}" FontFamily="{StaticResource Bz.Font.Mono}" FontSize="11" Foreground="{StaticResource Bz.Text2}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </WrapPanel>

                        <!-- Title and description -->
                        <TextBlock Text="{Binding Card.Title}" FontSize="20" FontWeight="Bold" LineHeight="26"
                                   TextWrapping="Wrap" Margin="0,16,0,0" Foreground="{StaticResource Bz.Text}"/>
                        <TextBlock Text="{Binding Card.Desc}" FontSize="13" LineHeight="18" TextWrapping="Wrap" Foreground="{StaticResource Bz.TextBody}"
                                   Margin="0,4,0,0" Visibility="{Binding Card.HasDesc, Converter={StaticResource B2V}}"/>

                        <!-- Evidence table: Element / Required / In model -->
                        <Border Margin="0,16,0,0" BorderBrush="{StaticResource Bz.LineSoft}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <Border BorderBrush="{StaticResource Bz.LineSoft}" BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ElementLabel}" Style="{StaticResource DlTerm}"/>
                                        <TextBlock Text="{Binding Card.El}" Style="{StaticResource DlValue}"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource AiOnlyRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding RequiredLabel}" Style="{StaticResource DlTerm}"/>
                                        <TextBlock Text="{Binding Card.Req}" Style="{StaticResource DlValue}"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource AiOnlyRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ActualLabel}" Style="{StaticResource DlTerm}"/>
                                        <TextBlock Text="{Binding Card.Act}" Style="{StaticResource DlValue}" Foreground="{StaticResource Bz.Tone.Fail}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Semak manual: why the AI did not judge this, and what it means for the % and the Borang -->
                        <Border Style="{StaticResource Blk}" Background="{StaticResource Bz.ManualSoft}"
                                Visibility="{Binding Card.IsManual, Converter={StaticResource B2V}}">
                            <StackPanel>
                                <TextBlock Text="{Binding WhyManualLabel}" Style="{StaticResource BlkHead}" Foreground="{StaticResource Bz.Manual}"/>
                                <TextBlock Text="{Binding Card.Reason}" FontSize="13" LineHeight="18" Foreground="{StaticResource Bz.Text}"
                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding ManualNote}" Style="{StaticResource BlkNote}" Foreground="{StaticResource Bz.TextBody}"/>
                            </StackPanel>
                        </Border>

                        <!-- The last auto-fix failed: stays open, with the reason (item 4) -->
                        <Border Style="{StaticResource Blk}" Background="{StaticResource Bz.HighBg}"
                                Visibility="{Binding Card.HasFixError, Converter={StaticResource B2V}}">
                            <StackPanel>
                                <TextBlock Text="{Binding FixFailedLabel}" Style="{StaticResource BlkHead}" Foreground="{StaticResource Bz.HighText}"/>
                                <TextBlock Text="{Binding Card.FixError}" FontSize="13" LineHeight="18" Foreground="{StaticResource Bz.Text}"
                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Suggested fix (a ready-made rule) or Proposed by the AI fixer: the − / + diff -->
                        <Border Style="{StaticResource Blk}" Visibility="{Binding Card.HasApply, Converter={StaticResource B2V}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Canvas Width="16" Height="16" VerticalAlignment="Center"
                                            Visibility="{Binding Card.CanFix, Converter={StaticResource B2V}}">
                                        <Path Style="{StaticResource Ico}" Stroke="{StaticResource Bz.Text}" Data="{StaticResource BoltGeo}"/>
                                    </Canvas>
                                    <Canvas Width="16" Height="16" VerticalAlignment="Center"
                                            Visibility="{Binding Card.IsAiProposal, Converter={StaticResource B2V}}">
                                        <Path Style="{StaticResource Ico}" Stroke="{StaticResource Bz.Text}" Data="{StaticResource SparkBoltGeo}"/>
                                        <Path Fill="{StaticResource Bz.Text}" Data="{StaticResource SparkGeo}"/>
                                    </Canvas>
                                    <TextBlock Text="{Binding Card.DiffLabel}" Style="{StaticResource BlkHead}" Margin="8,0,0,0"/>
                                </StackPanel>
                                <Border Margin="0,10,0,0" CornerRadius="8" Background="{StaticResource Bz.Surface}"
                                        BorderBrush="{StaticResource Bz.Line}" BorderThickness="1" ClipToBounds="True">
                                    <StackPanel>
                                        <Border Background="{StaticResource Bz.HighBg}" CornerRadius="7,7,0,0" Padding="12,8,12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="−" Style="{StaticResource DiffLine}" Foreground="{StaticResource Bz.HighText}" Margin="0,0,12,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Card.Act}" Style="{StaticResource DiffLine}" Foreground="{StaticResource Bz.HighText}"/>
                                            </Grid>
                                        </Border>
                                        <Border Background="{StaticResource Bz.OkBg}" CornerRadius="0,0,7,7" Padding="12,8,12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="+" Style="{StaticResource DiffLine}" Foreground="{StaticResource Bz.OkInk}" Margin="0,0,12,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Card.Prop}" Style="{StaticResource DiffLine}" Foreground="{StaticResource Bz.OkInk}"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <!-- AI fixer: its reason line, then the caution in place of the plain note -->
                                <TextBlock Text="{Binding Card.AiReason}" FontSize="13" LineHeight="18" Foreground="{StaticResource Bz.Text}"
                                           TextWrapping="Wrap" Margin="0,10,0,0" Visibility="{Binding Card.HasAiReason, Converter={StaticResource B2V}}"/>
                                <TextBlock Text="{Binding AiCaution}" Style="{StaticResource BlkNote}"
                                           Visibility="{Binding Card.IsAiProposal, Converter={StaticResource B2V}}"/>
                                <TextBlock Text="{Binding SeeAgainNote}" Style="{StaticResource BlkNote}"
                                           Visibility="{Binding Card.CanFix, Converter={StaticResource B2V}}"/>
                            </StackPanel>
                        </Border>

                        <!-- An AI fixer candidate with no value yet: says so, claims nothing -->
                        <Border Style="{StaticResource Blk}" Visibility="{Binding Card.IsAiCanPropose, Converter={StaticResource B2V}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Canvas Width="16" Height="16" VerticalAlignment="Center">
                                        <Path Style="{StaticResource Ico}" Stroke="{StaticResource Bz.TextBody}" Data="{StaticResource SparkBoltGeo}"/>
                                        <Path Fill="{StaticResource Bz.TextBody}" Data="{StaticResource SparkGeo}"/>
                                    </Canvas>
                                    <TextBlock Text="{Binding AiCanTitle}" Style="{StaticResource BlkHead}" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding AiCanText}" Style="{StaticResource BlkNote}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- How to fix by hand (item 4): open AI items without a ready-made fix -->
                        <Border Style="{StaticResource Blk}" Visibility="{Binding Card.HasSteps, Converter={StaticResource B2V}}">
                            <StackPanel>
                                <TextBlock Text="{Binding HowToFixLabel}" Style="{StaticResource BlkHead}"/>
                                <ItemsControl x:Name="StepsList" ItemsSource="{Binding Card.Steps}" Margin="0,4,0,0" AlternationCount="1000">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontFamily="{StaticResource Bz.Font.Mono}" FontSize="12" Foreground="{StaticResource Bz.Text2}" Margin="0,1,0,0"
                                                           Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={x:Static local:DetailWindow.StepNumber}}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding}" FontSize="13" LineHeight="18" Foreground="{StaticResource Bz.Text}" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- One "Source: …" line (item 5): opens the spec PDF when there is one -->
                        <Grid Margin="0,16,0,0" Visibility="{Binding Card.HasCite, Converter={StaticResource B2V}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Canvas Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,0,0">
                                <Canvas.RenderTransform><ScaleTransform ScaleX="0.875" ScaleY="0.875" CenterX="8" CenterY="8"/></Canvas.RenderTransform>
                                <Path Style="{StaticResource Ico}" Stroke="{StaticResource Bz.Text2}" Data="{StaticResource BookGeo}"/>
                            </Canvas>
                            <TextBlock x:Name="SourceText" Grid.Column="1" Text="{Binding Card.SourceText}" FontSize="12" LineHeight="17"
                                       Foreground="{StaticResource Bz.Text2}" Margin="8,0,0,0" TextWrapping="Wrap"
                                       VerticalAlignment="Center" MouseLeftButtonUp="Source_Click">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Card.CanOpenSource}" Value="True">
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="ToolTip" Value="PDF"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Card.CanOpenSource}" Value="True"/>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="TextDecorations" Value="Underline"/>
                                                <Setter Property="Foreground" Value="{StaticResource Bz.Text}"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Action bar, 68 px: Locate in 3D · Ignore (A) · Mark as Manual | the primary on the right -->
                <Border Grid.Row="2" MinHeight="68" Background="{StaticResource Bz.Sunken}" BorderBrush="{StaticResource Bz.Line}" BorderThickness="0,1,0,0"
                        CornerRadius="0,0,11,11" Padding="16,10,16,10">
                    <!-- The left group wraps to a second line before it runs under the primary (long BM labels) -->
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <!-- right: Apply fix (F) / Apply AI fix (F), Reopen, or Mark as reviewed -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="FixBtn" Style="{StaticResource BtnPri}" IsEnabled="{Binding CanAct}" Click="Fix_Click" Margin="6,0,0,0"
                                    Visibility="{Binding Card.HasApply, Converter={StaticResource B2V}}">
                                <StackPanel Orientation="Horizontal">
                                    <Canvas Width="16" Height="16" Margin="0,0,8,0" Visibility="{Binding Card.CanFix, Converter={StaticResource B2V}}">
                                        <Canvas.RenderTransform><ScaleTransform ScaleX="0.875" ScaleY="0.875" CenterX="8" CenterY="8"/></Canvas.RenderTransform>
                                        <Path Style="{StaticResource Ico}" Data="{StaticResource BoltGeo}"/>
                                    </Canvas>
                                    <Canvas Width="16" Height="16" Margin="0,0,8,0" Visibility="{Binding Card.IsAiProposal, Converter={StaticResource B2V}}">
                                        <Canvas.RenderTransform><ScaleTransform ScaleX="0.875" ScaleY="0.875" CenterX="8" CenterY="8"/></Canvas.RenderTransform>
                                        <Path Style="{StaticResource Ico}" Data="{StaticResource SparkBoltGeo}"/>
                                        <Path Fill="{StaticResource Bz.OnBrand}" Data="{StaticResource SparkGeo}"/>
                                    </Canvas>
                                    <TextBlock Text="{Binding Card.ApplyLabel}" VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource Kb}" Opacity="0.85"><TextBlock Text="F" Style="{StaticResource KbText}"/></Border>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ReopenBtn" Style="{StaticResource BtnSec}" IsEnabled="{Binding CanAct}" Click="Reopen_Click" Margin="6,0,0,0"
                                    Content="{Binding ReopenLabel}" Visibility="{Binding Card.CanReopen, Converter={StaticResource B2V}}"/>
                            <!-- semak manual: Mark as reviewed (ink), or "✓ Reviewed" once done (click undoes) -->
                            <Button x:Name="ReviewBtn" Click="Review_Click" Margin="6,0,0,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BtnPri}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Card.IsManual}" Value="True"/>
                                                    <Condition Binding="{Binding Card.IsReviewed}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Canvas Width="16" Height="16" Margin="0,0,8,0">
                                        <Canvas.RenderTransform><ScaleTransform ScaleX="0.875" ScaleY="0.875" CenterX="8" CenterY="8"/></Canvas.RenderTransform>
                                        <Path Style="{StaticResource Ico}" Data="{StaticResource CheckGeo}"/>
                                    </Canvas>
                                    <TextBlock Text="{Binding Card.ReviewLabel}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ReviewedBtn" Click="Review_Click" Margin="6,0,0,0" Content="{Binding Card.ReviewLabel}"
                                    Visibility="{Binding Card.IsReviewed, Converter={StaticResource B2V}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BtnSec}">
                                        <Setter Property="Foreground" Value="{StaticResource Bz.Manual}"/>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <!-- left: Locate in 3D, Ignore (A), Mark as Manual -->
                        <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="LocateBtn" Style="{StaticResource BtnSec}" Margin="0,0,6,0" Click="Locate_Click"
                                    Visibility="{Binding Card.CanLocate, Converter={StaticResource B2V}}">
                                <StackPanel Orientation="Horizontal">
                                    <Canvas Width="16" Height="16" Margin="0,0,8,0">
                                        <Canvas.RenderTransform><ScaleTransform ScaleX="0.875" ScaleY="0.875" CenterX="8" CenterY="8"/></Canvas.RenderTransform>
                                        <Path Style="{StaticResource Ico}" Data="{StaticResource LocateGeo}"/>
                                    </Canvas>
                                    <TextBlock Text="{Binding LocateLabel}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="IgnoreBtn" Style="{StaticResource BtnGh}" Click="Ignore_Click" IsEnabled="{Binding CanAct}"
                                    Visibility="{Binding Card.CanIgnore, Converter={StaticResource B2V}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding IgnoreLabel}" VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource Kb}"><TextBlock Text="A" Style="{StaticResource KbText}"/></Border>
                                </StackPanel>
                            </Button>
                            <Button x:Name="MarkManualBtn" Style="{StaticResource BtnGh}" Click="MarkManual_Click" IsEnabled="{Binding CanAct}"
                                    Content="{Binding MarkManualLabel}" Visibility="{Binding Card.CanMarkManual, Converter={StaticResource B2V}}"/>
                        </WrapPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Toast over the scrim (the pane's own toast is behind it): ink pill, white text -->
        <Border x:Name="ToastBox" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="16,0,16,40" Background="{StaticResource Bz.Ink}" CornerRadius="8" Padding="14,10,14,10">
            <Border.Effect>
                <DropShadowEffect Color="#15181D" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.22"/>
            </Border.Effect>
            <TextBlock x:Name="ToastText" Foreground="{StaticResource Bz.OnBrand}" FontSize="13" LineHeight="18" VerticalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="460" AutomationProperties.LiveSetting="Polite"/>
        </Border>
    </Grid>
</Window>
