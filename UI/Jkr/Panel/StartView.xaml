<UserControl x:Class="RevitWebAppSync.UI.Jkr.Panel.StartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFFFFF" FontFamily="Segoe UI" Foreground="#161616">
    <!-- Start (prototype isStart; frames s-start, s-ready, s-lod100). DataContext:
         Core.StartScreenModel. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevitWebAppSync;component/UI/Jkr/Panel/PanelTokens.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="B2V"/>
            <!-- .fld label / .lb -->
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource Bz.Text2}"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
            <!-- .note -->
            <Style x:Key="Note" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Bz.BrandTint}"/>
                <Setter Property="CornerRadius" Value="5"/>
                <Setter Property="Padding" Value="10,8,10,8"/>
                <Setter Property="Margin" Value="0,16,0,0"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- .form: padding 18 16 20, gap 16 -->
        <StackPanel Margin="16,18,16,20">
            <!-- Project (read-only) -->
            <TextBlock Text="{Binding ProjectLabel}" Style="{StaticResource FieldLabel}"/>
            <Border Background="{StaticResource Bz.Sunken}" BorderBrush="{StaticResource Bz.Line}" BorderThickness="1"
                    CornerRadius="5" Padding="10,8,10,8">
                <TextBlock Text="{Binding FileLabel}" FontFamily="{StaticResource Bz.Font.Mono}" FontSize="11"
                           LineHeight="16.5" Foreground="{StaticResource Bz.TextBody}" TextWrapping="Wrap"/>
            </Border>

            <!-- LOD + discipline (.two) -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource FieldLabel}">
                        <Run Text="{Binding LodLabel, Mode=OneWay}"/><Run Text=" "/><Run Text="*" Foreground="#B08C00"/>
                    </TextBlock>
                    <ComboBox x:Name="LodSelect" Style="{StaticResource Bz.Select}" Tag="{Binding LodTag}"
                              ItemsSource="{Binding LodOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding LodValue, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding LodLabel}" AutomationProperties.IsRequiredForForm="True"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding DiscLabel}" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="DiscSelect" Style="{StaticResource Bz.Select}"
                              ItemsSource="{Binding DiscOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding DiscValue, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding DiscLabel}"/>
                </StackPanel>
            </Grid>

            <!-- LOD required / LOD 100 notes -->
            <Border Style="{StaticResource Note}" Visibility="{Binding LodMissing, Converter={StaticResource B2V}}">
                <TextBlock Text="{Binding LodRequiredNote}" FontSize="11.5" LineHeight="17" TextWrapping="Wrap"
                           Foreground="{StaticResource Bz.Text2}"/>
            </Border>
            <Border Style="{StaticResource Note}" Visibility="{Binding Lod100, Converter={StaticResource B2V}}">
                <TextBlock Text="{Binding Lod100Note}" FontSize="11.5" LineHeight="17" TextWrapping="Wrap"
                           Foreground="{StaticResource Bz.Text2}"/>
            </Border>

            <!-- Run audit (.btn-p .btn-l) -->
            <Button x:Name="RunBtn" Content="{Binding RunLabel}" Style="{StaticResource Bz.Btn.Primary}"
                    FontSize="13" Padding="14,10,14,10" HorizontalAlignment="Stretch" Margin="0,16,0,0"
                    IsEnabled="{Binding CanRun}" Click="Run_Click"/>
            <TextBlock Text="{Binding RunHint}" FontSize="11" Foreground="{StaticResource Bz.Text3}"
                       HorizontalAlignment="Center" Margin="0,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
