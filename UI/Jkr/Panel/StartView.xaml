<UserControl x:Class="RevitWebAppSync.UI.Jkr.Panel.StartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Bz.Surface}" FontFamily="{DynamicResource Bz.Font.Sans}" Foreground="{DynamicResource Bz.Text}">
    <!-- Start (frames s-start, s-ready, s-lod100), drawn as Direction C's Setup:
         a lead, the project file, numbered step cards, and Run pinned to the bottom.
         DataContext: Core.StartScreenModel.
         LOD is required and has no default (spec Q1): Run stays off until it is chosen. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevitWebAppSync;component/UI/Jkr/Panel/PanelTokens.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="B2V"/>

            <!-- Step card: raised dark, hairline, 10 px radius. Tag="need" = required and
                 empty: the card's border turns amber. -->
            <Style x:Key="StepCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Bz.Sunken2}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Bz.Line}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="12"/>
                <Style.Triggers>
                    <Trigger Property="Tag" Value="need">
                        <Setter Property="BorderBrush" Value="{StaticResource Bz.Brand}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 28 px round step number -->
            <Style x:Key="StepBadge" TargetType="Border">
                <Setter Property="Width" Value="28"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="Margin" Value="0,0,12,0"/>
            </Style>

            <Style x:Key="StepTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource Bz.Text}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="StepHelp" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="LineHeight" Value="17"/>
                <Setter Property="Foreground" Value="{StaticResource Bz.Text2}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,6,0,0"/>
            </Style>

            <!-- LOD segmented buttons: a ListBox whose items are 36 px buttons in one row.
                 The "— Select —" option (value "") stays in the list for the binding but is
                 never shown: no segment is lit until a LOD is chosen. -->
            <Style x:Key="LodSegItem" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{StaticResource Bz.Text}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Margin" Value="3,0,3,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource Bz.FocusRing}"/>
                <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="{StaticResource Bz.Sunken}" BorderBrush="{StaticResource Bz.Line2}" BorderThickness="1"
                                    CornerRadius="6" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Bz.Text3}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bz.Brand}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Bz.Brand}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Bz.OnBrand}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="True"/>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bz.BrandHover}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Bz.BrandHover}"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Value}" Value="">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Focusable" Value="False"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="LodSegments" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Margin" Value="-3,10,-3,0"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource Bz.FocusRing}"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource LodSegItem}"/>
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="5"/>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding Value}"/>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBox">
                            <ItemsPresenter/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="14,18,14,16">
                <!-- Lead -->
                <TextBlock Text="{Binding RunLabel}" FontSize="20" FontWeight="SemiBold" LineHeight="25" TextWrapping="Wrap"
                           Foreground="{StaticResource Bz.Text}"/>
                <TextBlock Text="{Binding RunHint}" FontSize="12.5" LineHeight="18" TextWrapping="Wrap" Margin="0,6,0,0"
                           Foreground="{StaticResource Bz.Text2}"/>

                <!-- Project file (read-only), one mono line -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ProjectLabel}" FontSize="11" LineHeight="16" Foreground="{StaticResource Bz.Text3}" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding FileLabel}" FontFamily="{StaticResource Bz.Font.Mono}" FontSize="11" LineHeight="16"
                               Foreground="{StaticResource Bz.Text2}" TextWrapping="Wrap"/>
                </Grid>

                <!-- Step 1: LOD (required, no default) -->
                <Border Style="{StaticResource StepCard}" Tag="{Binding LodTag}" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StepBadge}">
                                    <Setter Property="Background" Value="{StaticResource Bz.OkBg}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LodMissing}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Bz.Brand}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <TextBlock Text="1" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Bz.OnBrand}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding LodMissing, Converter={StaticResource B2V}}"/>
                                <Path Data="M3,7.3 L5.6,9.9 L11,4.5" Stroke="{StaticResource Bz.Ok}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LodMissing}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding LodLabel, Mode=OneWay}" Style="{StaticResource StepTitle}" Margin="0,5,0,0"/>
                            <!-- LOD required note -->
                            <TextBlock Text="{Binding LodRequiredNote}" Style="{StaticResource StepHelp}"
                                       Visibility="{Binding LodMissing, Converter={StaticResource B2V}}"/>
                            <ListBox x:Name="LodSelect" Style="{StaticResource LodSegments}"
                                     ItemsSource="{Binding LodOptions}" SelectedValuePath="Value"
                                     SelectedValue="{Binding LodValue, Mode=TwoWay}"
                                     AutomationProperties.Name="{Binding LodLabel}" AutomationProperties.IsRequiredForForm="True"/>
                            <!-- LOD 100 note -->
                            <Grid Margin="0,10,0,0" Visibility="{Binding Lod100, Converter={StaticResource B2V}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="M12,22 A10,10 0 1 1 12,2 A10,10 0 1 1 12,22 Z M12,11 L12,16 M12,8 L12.01,8"
                                      Stroke="{StaticResource Bz.BrandTintText}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Top" Margin="0,2,7,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Lod100Note}" FontSize="11.5" LineHeight="17" TextWrapping="Wrap"
                                           Foreground="{StaticResource Bz.BrandTintText}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Step 2: discipline -->
                <Border Style="{StaticResource StepCard}" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource StepBadge}" Background="{StaticResource Bz.OkBg}">
                            <Path Data="M3,7.3 L5.6,9.9 L11,4.5" Stroke="{StaticResource Bz.Ok}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding DiscLabel}" Style="{StaticResource StepTitle}" Margin="0,5,0,0"/>
                            <ComboBox x:Name="DiscSelect" Style="{StaticResource Bz.Select}" Margin="0,10,0,0"
                                      ItemsSource="{Binding DiscOptions}" ItemTemplate="{StaticResource Bz.OptionLabel}" SelectedValuePath="Value"
                                      SelectedValue="{Binding DiscValue, Mode=TwoWay}"
                                      AutomationProperties.Name="{Binding DiscLabel}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Run audit, pinned to the bottom -->
        <Border Grid.Row="1" Background="{StaticResource Bz.Sunken}" BorderBrush="{StaticResource Bz.Line}" BorderThickness="0,1,0,0" Padding="14,10,14,12">
            <Button x:Name="RunBtn" Style="{StaticResource Bz.Btn.Primary}"
                    FontSize="13.5" Padding="14,0,14,0" Height="44" HorizontalAlignment="Stretch"
                    IsEnabled="{Binding CanRun}" Click="Run_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M5,3 L19,12 L5,21 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Width="11" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding RunLabel}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Border>
    </Grid>
</UserControl>
