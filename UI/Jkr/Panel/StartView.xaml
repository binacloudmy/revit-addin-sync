<UserControl x:Class="RevitWebAppSync.UI.Jkr.Panel.StartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Bz.Surface}" FontFamily="{DynamicResource Bz.Font.Sans}" Foreground="{DynamicResource Bz.Text}">
    <!-- Start (set up the audit), drawn as Clear Sheet: title and lead, Level of development
         (Required, segmented, no default), Discipline (preset from the file name), the five
         Borang sections, and Run audit pinned to the bottom. The project file is in the pane
         header, so there is no file row here (the model still provides FileLabel).
         DataContext: Core.StartScreenModel. LOD is required and has no default (spec Q1). -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevitWebAppSync;component/UI/Jkr/Panel/PanelTokens.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="B2V"/>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource Bz.Text}"/>
            </Style>
            <Style x:Key="FieldNote" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="LineHeight" Value="16"/>
                <Setter Property="Foreground" Value="{StaticResource Bz.Text2}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <!-- LOD segment: 36 px, 7 px radius, ink when chosen. The "— Select —" option
                 (value "") stays in the list for the binding but is never shown. -->
            <Style x:Key="LodSegItem" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{StaticResource Bz.TextBody}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Margin" Value="2,0,2,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource Bz.FocusRing}"/>
                <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="7" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bz.Hover}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Bz.Text}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bz.Brand}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Bz.OnBrand}"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="True"/>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bz.BrandHover}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Bz.OnBrand}"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Value}" Value="">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Focusable" Value="False"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="LodSegments" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource Bz.FocusRing}"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource LodSegItem}"/>
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="5"/>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding Value}"/>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBox">
                            <ItemsPresenter/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,24,16,16">
                <!-- Title and lead -->
                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" LineHeight="26" TextWrapping="Wrap"
                           Foreground="{StaticResource Bz.Text}"/>
                <TextBlock Text="{Binding Lead}" FontSize="13" LineHeight="18" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{StaticResource Bz.TextBody}"/>

                <!-- Level of development: required, segmented, no default -->
                <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding LodLabel, Mode=OneWay}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
                    <TextBlock Grid.Column="1" Text="{Binding LodRequiredTag}" Style="{StaticResource FieldNote}" Margin="8,0,0,0"/>
                </Grid>
                <Border Background="{StaticResource Bz.Sunken}" CornerRadius="10" Padding="2,4,2,4" Margin="0,8,0,0">
                    <ListBox x:Name="LodSelect" Style="{StaticResource LodSegments}"
                             ItemsSource="{Binding LodOptions}" SelectedValuePath="Value"
                             SelectedValue="{Binding LodValue, Mode=TwoWay}"
                             AutomationProperties.Name="{Binding LodLabel}" AutomationProperties.IsRequiredForForm="True"/>
                </Border>
                <TextBlock Text="{Binding LodHint}" Style="{StaticResource FieldNote}" Margin="0,8,0,0"/>
                <!-- LOD 100 note -->
                <Grid Margin="0,8,0,0" Visibility="{Binding Lod100, Converter={StaticResource B2V}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Data="M12,22 A10,10 0 1 1 12,2 A10,10 0 1 1 12,22 Z M12,11 L12,16 M12,8 L12.01,8"
                          Stroke="{StaticResource Bz.BrandTintText}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Top" Margin="0,2,7,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding Lod100Note}" FontSize="12" LineHeight="16" TextWrapping="Wrap"
                               Foreground="{StaticResource Bz.BrandTintText}"/>
                </Grid>

                <!-- Discipline: preset from the file name -->
                <TextBlock Text="{Binding DiscLabel}" Style="{StaticResource FieldLabel}" Margin="0,24,0,0"/>
                <ComboBox x:Name="DiscSelect" IsEnabled="False" Style="{StaticResource Bz.Select}" Margin="0,8,0,0" Height="40" FontSize="13"
                          ItemsSource="{Binding DiscOptions}" ItemTemplate="{StaticResource Bz.OptionLabel}" SelectedValuePath="Value"
                          SelectedValue="{Binding DiscValue, Mode=TwoWay}"
                          AutomationProperties.Name="{Binding DiscLabel}"/>
                <TextBlock Text="{Binding DiscHint}" Style="{StaticResource FieldNote}" Margin="0,8,0,0"/>

                <!-- Borang sections -->
                <Grid Margin="0,24,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SectionsLabel}" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Column="1" Text="{Binding SectionsCount}" Style="{StaticResource FieldNote}"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Sections}" Focusable="False" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Bz.LineSoft}" BorderThickness="0,1,0,0" Padding="0,10,0,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource Bz.Sunken2}" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Letter}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Bz.TextBody}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource Bz.Text}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding CountLabel}" Style="{StaticResource FieldNote}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Ticks}" Margin="32,8,0,0" Focusable="False" IsTabStop="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="8" Height="20" CornerRadius="2" Margin="0,0,3,3" Background="{StaticResource Bz.Track}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Run audit, pinned to the bottom -->
        <Border Grid.Row="1" Background="{StaticResource Bz.Surface}" BorderBrush="{StaticResource Bz.Line}" BorderThickness="0,1,0,0" Padding="16">
            <StackPanel>
                <TextBlock Text="{Binding ReadyHint}" Style="{StaticResource FieldNote}" Margin="0,0,0,10"
                           Visibility="{Binding ReadyHintVisible, Converter={StaticResource B2V}}"/>
                <Button x:Name="RunBtn" Style="{StaticResource Bz.Btn.Primary}"
                        FontSize="13" Padding="14,0,14,0" Height="40" HorizontalAlignment="Stretch"
                        IsEnabled="{Binding CanRun}" Click="Run_Click">
                    <TextBlock Text="{Binding RunLabel}" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
