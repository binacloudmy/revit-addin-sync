<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- JKR pane tokens and shared styles.

         The pane uses the product's design system (UI/Copilot/CopilotTokens.xaml:
         Inter, the #2a69c6 accent, the hairline / sunken / ink scale) so it reads as
         one product with the Copilot pane. The Bz.* keys below are kept as the
         pane's own vocabulary and alias the Cp.* brushes, so every view and the
         code-behind (FindResource("Bz.Ink")) keep working; JKR-only state colours
         live in CopilotTokens under Cp.Jkr.*.

         The Copilot dictionary is merged here as well as at application level so the
         pane renders without the Copilot panel having loaded first (UiHarness, a
         pane opened before Copilot). The pane is light-only: the Copilot dark theme
         mutates the application-level brushes, not these copies. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/RevitWebAppSync;component/UI/Copilot/CopilotTokens.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ── Type ── -->
    <FontFamily x:Key="Bz.Font.Sans">pack://application:,,,/RevitWebAppSync;component/Fonts/#Inter, Segoe UI, system-ui, sans-serif</FontFamily>
    <FontFamily x:Key="Bz.Font.Mono">Geist Mono, Cascadia Mono, Consolas, Courier New, monospace</FontFamily>

    <!-- ── Ink and surfaces (Copilot scale) ── -->
    <StaticResource x:Key="Bz.Ink"       ResourceKey="Cp.Ink2"/>
    <StaticResource x:Key="Bz.Text"      ResourceKey="Cp.Ink"/>
    <StaticResource x:Key="Bz.TextBody"  ResourceKey="Cp.Text"/>
    <StaticResource x:Key="Bz.Text2"     ResourceKey="Cp.Muted"/>
    <StaticResource x:Key="Bz.Text3"     ResourceKey="Cp.Faint"/>
    <StaticResource x:Key="Bz.Surface"   ResourceKey="Cp.Bg"/>
    <StaticResource x:Key="Bz.Sunken"    ResourceKey="Cp.PanelBg"/>
    <StaticResource x:Key="Bz.Sunken2"   ResourceKey="Cp.Sunken"/>
    <StaticResource x:Key="Bz.Line"      ResourceKey="Cp.Line"/>
    <StaticResource x:Key="Bz.Line2"     ResourceKey="Cp.Hair2"/>
    <StaticResource x:Key="Bz.LineSoft"  ResourceKey="Cp.LineSoft"/>
    <StaticResource x:Key="Bz.Hover"     ResourceKey="Cp.Hover"/>
    <StaticResource x:Key="Bz.Disabled"  ResourceKey="Cp.Sunken"/>
    <StaticResource x:Key="Bz.DisabledText" ResourceKey="Cp.Faint"/>
    <SolidColorBrush x:Key="Bz.Scrim" Color="#8C0F172A"/>

    <!-- ── Brand = the product accent (the pane no longer uses the yellow) ── -->
    <Color x:Key="Bz.BrandColor">#2a69c6</Color>
    <StaticResource x:Key="Bz.Brand"         ResourceKey="Cp.Accent"/>
    <StaticResource x:Key="Bz.BrandHover"    ResourceKey="Cp.BlueHover"/>
    <StaticResource x:Key="Bz.OnBrand"       ResourceKey="Cp.AccentContrast"/>
    <StaticResource x:Key="Bz.BrandTint"     ResourceKey="Cp.PurpleSoft"/>
    <StaticResource x:Key="Bz.BrandTintLine" ResourceKey="Cp.PurpleLine"/>
    <StaticResource x:Key="Bz.BrandTintText" ResourceKey="Cp.BlueText"/>
    <StaticResource x:Key="Bz.BrandSoft"     ResourceKey="Cp.BlueSoft"/>

    <!-- ── Chrome (title and context bars): light, like the Copilot pane ── -->
    <StaticResource x:Key="Bz.Chrome"       ResourceKey="Cp.Bg"/>
    <StaticResource x:Key="Bz.Chrome2"      ResourceKey="Cp.PanelBg"/>
    <StaticResource x:Key="Bz.ChromeText"   ResourceKey="Cp.Ink"/>
    <StaticResource x:Key="Bz.ChromeMuted"  ResourceKey="Cp.Faint"/>
    <StaticResource x:Key="Bz.ChromeStrong" ResourceKey="Cp.Ink2"/>

    <!-- ── Severity, manual, ok (issue tabs) ── -->
    <StaticResource x:Key="Bz.High"     ResourceKey="Cp.Jkr.FailDot"/>
    <StaticResource x:Key="Bz.HighText" ResourceKey="Cp.Jkr.Fail"/>
    <StaticResource x:Key="Bz.HighBg"   ResourceKey="Cp.Jkr.FailBg"/>
    <StaticResource x:Key="Bz.Med"      ResourceKey="Cp.Jkr.WarnDot"/>
    <StaticResource x:Key="Bz.MedText"  ResourceKey="Cp.Jkr.Warn"/>
    <StaticResource x:Key="Bz.MedBg"    ResourceKey="Cp.Jkr.WarnBg"/>
    <StaticResource x:Key="Bz.Low"      ResourceKey="Cp.Jkr.Listed"/>
    <StaticResource x:Key="Bz.Manual"   ResourceKey="Cp.Jkr.Person"/>
    <StaticResource x:Key="Bz.ManualBg" ResourceKey="Cp.Jkr.PersonBg"/>
    <StaticResource x:Key="Bz.ManualDot" ResourceKey="Cp.Jkr.PersonDot"/>
    <StaticResource x:Key="Bz.Ok"       ResourceKey="Cp.Jkr.Pass"/>
    <StaticResource x:Key="Bz.OkBg"     ResourceKey="Cp.Jkr.PassBg"/>

    <!-- ── Checklist state tones (text / fill / dot), one per spec state ── -->
    <StaticResource x:Key="Bz.Tone.Fail"       ResourceKey="Cp.Jkr.Fail"/>
    <StaticResource x:Key="Bz.Tone.FailBg"     ResourceKey="Cp.Jkr.FailBg"/>
    <StaticResource x:Key="Bz.Tone.FailDot"    ResourceKey="Cp.Jkr.FailDot"/>
    <StaticResource x:Key="Bz.Tone.Critical"   ResourceKey="Cp.Jkr.Critical"/>
    <StaticResource x:Key="Bz.Tone.CriticalBg" ResourceKey="Cp.Jkr.CriticalBg"/>
    <StaticResource x:Key="Bz.Tone.Pass"       ResourceKey="Cp.Jkr.Pass"/>
    <StaticResource x:Key="Bz.Tone.PassBg"     ResourceKey="Cp.Jkr.PassBg"/>
    <StaticResource x:Key="Bz.Tone.PassDot"    ResourceKey="Cp.Jkr.PassDot"/>
    <StaticResource x:Key="Bz.Tone.Partial"    ResourceKey="Cp.Jkr.Warn"/>
    <StaticResource x:Key="Bz.Tone.PartialBg"  ResourceKey="Cp.Jkr.WarnBg"/>
    <StaticResource x:Key="Bz.Tone.PartialDot" ResourceKey="Cp.Jkr.WarnDot"/>
    <StaticResource x:Key="Bz.Tone.Warn"       ResourceKey="Cp.Jkr.Warn"/>
    <StaticResource x:Key="Bz.Tone.WarnBg"     ResourceKey="Cp.Jkr.WarnBg"/>
    <StaticResource x:Key="Bz.Tone.WarnLine"   ResourceKey="Cp.AmberLn"/>
    <StaticResource x:Key="Bz.Tone.Person"     ResourceKey="Cp.Jkr.Person"/>
    <StaticResource x:Key="Bz.Tone.PersonBg"   ResourceKey="Cp.Jkr.PersonBg"/>
    <StaticResource x:Key="Bz.Tone.PersonDot"  ResourceKey="Cp.Jkr.PersonDot"/>
    <StaticResource x:Key="Bz.Tone.Pending"    ResourceKey="Cp.Jkr.Pending"/>
    <StaticResource x:Key="Bz.Tone.PendingBg"  ResourceKey="Cp.Jkr.PendingBg"/>
    <StaticResource x:Key="Bz.Tone.Listed"     ResourceKey="Cp.Jkr.Listed"/>
    <StaticResource x:Key="Bz.Tone.ListedBg"   ResourceKey="Cp.Jkr.ListedBg"/>
    <StaticResource x:Key="Bz.Tone.ListedDot"  ResourceKey="Cp.Jkr.ListedDot"/>
    <StaticResource x:Key="Bz.Tone.Na"         ResourceKey="Cp.Jkr.Na"/>
    <StaticResource x:Key="Bz.Tone.NaBg"       ResourceKey="Cp.Jkr.NaBg"/>
    <StaticResource x:Key="Bz.Tone.NaDot"      ResourceKey="Cp.Jkr.NaDot"/>
    <StaticResource x:Key="Bz.Tone.None"       ResourceKey="Cp.Jkr.None"/>
    <StaticResource x:Key="Bz.Tone.NoneBg"     ResourceKey="Cp.Jkr.NoneBg"/>
    <StaticResource x:Key="Bz.Track"           ResourceKey="Cp.Jkr.Track"/>
    <StaticResource x:Key="Bz.CodeBg"          ResourceKey="Cp.CodeBg"/>
    <StaticResource x:Key="Bz.CodeFg"          ResourceKey="Cp.CodeFg"/>

    <!-- ── Focus ring: 2 px accent, 2 px out ── -->
    <Style x:Key="Bz.FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" BorderBrush="{StaticResource Cp.Accent}" BorderThickness="2" CornerRadius="7" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── BM / EN segmented toggle: sunken pill, the active half white with ink ── -->
    <Style x:Key="Bz.SegButton" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource Cp.Muted}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Bz.FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="9,3,9,4" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Cp.Ink}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Cp.Bg}"/>
                            <Setter Property="Foreground" Value="{StaticResource Cp.Ink2}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Title-bar icon button (close) ── -->
    <Style x:Key="Bz.ChromeIconButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Cp.Faint}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Bz.FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Cp.Hover}"/>
                            <Setter Property="Foreground" Value="{StaticResource Cp.Ink}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 28 × 28 bordered icon button (rows, detail header) ── -->
    <Style x:Key="Bz.Btn.Icon" TargetType="Button">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Foreground" Value="{StaticResource Cp.Muted}"/>
        <Setter Property="Background" Value="{StaticResource Cp.Bg}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Bz.FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Cp.Line}" BorderThickness="1" CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Cp.Hover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Cp.Hair2}"/>
                            <Setter Property="Foreground" Value="{StaticResource Cp.Ink}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Primary: accent fill, white text, 7 px radius ── -->
    <Style x:Key="Bz.Btn.Primary" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Cp.Accent}"/>
        <Setter Property="Foreground" Value="{StaticResource Cp.AccentContrast}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="12,7,12,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Bz.FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Cp.BlueHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Cp.Sunken}"/>
                            <Setter Property="Foreground" Value="{StaticResource Cp.Faint}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Ghost: hairline, ink on hover ── -->
    <Style x:Key="Bz.Btn.Ghost" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Cp.Bg}"/>
        <Setter Property="Foreground" Value="{StaticResource Cp.Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Cp.Line}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="11,6,11,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Bz.FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Cp.Hover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Cp.Hair2}"/>
                            <Setter Property="Foreground" Value="{StaticResource Cp.Ink}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Cp.Faint}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Ink (dark) button: Export; the one filled-dark control in the pane ── -->
    <Style x:Key="Bz.Btn.Ink" TargetType="Button" BasedOn="{StaticResource Bz.Btn.Primary}">
        <Setter Property="Background" Value="{StaticResource Cp.Ink2}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#3a3d46"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Cp.Sunken}"/>
                            <Setter Property="Foreground" Value="{StaticResource Cp.Faint}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Keyboard cap ("F", "J/K") ── -->
    <Style x:Key="Bz.Kbd" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Cp.CodeBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Cp.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="5,0,5,1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ── Select (ComboBox). Tag="need" = required and empty: accent border + soft halo. ── -->
    <Style x:Key="Bz.SelectItem" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="9,6,9,6"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource Cp.Ink}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="3,1,3,1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Cp.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Cp.BlueSoft}"/>
                            <Setter Property="Foreground" Value="{StaticResource Cp.BlueText}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- An option's label, live: with DisplayMemberPath a ComboBox copies the selected
         label once, so a BM / EN switch never reached the closed box. -->
    <DataTemplate x:Key="Bz.OptionLabel">
        <TextBlock Text="{Binding Label}"/>
    </DataTemplate>

    <Style x:Key="Bz.Select" TargetType="ComboBox">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource Cp.Ink}"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource Bz.SelectItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Halo" CornerRadius="9" Margin="-3" BorderThickness="3" BorderBrush="Transparent"/>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="{StaticResource Cp.Bg}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Cp.Hover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Border x:Name="Frame" BorderBrush="{StaticResource Cp.Hair2}" BorderThickness="1" CornerRadius="7" IsHitTestVisible="False"/>
                        <ContentPresenter Margin="10,6,28,6" IsHitTestVisible="False" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <Path Data="M0,0 L5,5 L10,0" Stroke="{StaticResource Cp.Muted}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="10" Height="6" Stretch="Uniform" HorizontalAlignment="Right" Margin="0,0,11,0"
                              VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="None">
                            <Border Background="{StaticResource Cp.Menu}" BorderBrush="{StaticResource Cp.Hair2}" BorderThickness="1" CornerRadius="8" Margin="0,3,0,0" Padding="0,3,0,3"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260">
                                <Border.Effect>
                                    <DropShadowEffect Color="#0F172A" BlurRadius="18" ShadowDepth="6" Direction="270" Opacity="0.18"/>
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="need">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Cp.Accent}"/>
                            <Setter TargetName="Halo" Property="BorderBrush" Value="{StaticResource Cp.BlueSoft}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Cp.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
