<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Binazone tokens: "Model Audit Prototype.dc.html" <style> and BUILD-BRIEF §5.
         Prefix Bz. so they never clash with the old pane's Tokens.xaml. -->

    <!-- Brand -->
    <Color x:Key="Bz.BrandColor">#F2C200</Color>
    <SolidColorBrush x:Key="Bz.Brand" Color="#F2C200"/>
    <SolidColorBrush x:Key="Bz.BrandHover" Color="#E3B600"/>
    <SolidColorBrush x:Key="Bz.OnBrand" Color="#0F0F0F"/>
    <SolidColorBrush x:Key="Bz.BrandTint" Color="#FEF8DC"/>
    <SolidColorBrush x:Key="Bz.BrandTintText" Color="#6B5600"/>
    <SolidColorBrush x:Key="Bz.Ink" Color="#0F0F0F"/>

    <!-- Chrome (title bar, context bar) -->
    <SolidColorBrush x:Key="Bz.Chrome" Color="#0B0F1A"/>
    <SolidColorBrush x:Key="Bz.Chrome2" Color="#161C2B"/>
    <SolidColorBrush x:Key="Bz.ChromeText" Color="#C7CDD8"/>
    <SolidColorBrush x:Key="Bz.ChromeMuted" Color="#8B94A5"/>
    <SolidColorBrush x:Key="Bz.ChromeStrong" Color="#E6E9EE"/>

    <!-- Text -->
    <SolidColorBrush x:Key="Bz.Text" Color="#161616"/>
    <SolidColorBrush x:Key="Bz.Text2" Color="#4B4F57"/>
    <SolidColorBrush x:Key="Bz.Text3" Color="#686C74"/>
    <SolidColorBrush x:Key="Bz.TextBody" Color="#2B2E33"/>

    <!-- Surfaces and lines -->
    <SolidColorBrush x:Key="Bz.Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Bz.Sunken" Color="#F5F5F3"/>
    <SolidColorBrush x:Key="Bz.Line" Color="#E7E6E2"/>
    <SolidColorBrush x:Key="Bz.Line2" Color="#D6D4CE"/>
    <SolidColorBrush x:Key="Bz.Disabled" Color="#EDEDEA"/>
    <SolidColorBrush x:Key="Bz.DisabledText" Color="#8A8D93"/>
    <SolidColorBrush x:Key="Bz.Scrim" Color="#99090B10"/>

    <!-- Severity, manual, ok -->
    <SolidColorBrush x:Key="Bz.High" Color="#C23B3B"/>
    <SolidColorBrush x:Key="Bz.HighText" Color="#B42F2F"/>
    <SolidColorBrush x:Key="Bz.Med" Color="#EA580C"/>
    <SolidColorBrush x:Key="Bz.MedText" Color="#B83D0B"/>
    <SolidColorBrush x:Key="Bz.Low" Color="#6B7079"/>
    <SolidColorBrush x:Key="Bz.Manual" Color="#4A4EB0"/>
    <SolidColorBrush x:Key="Bz.ManualBg" Color="#F2F2FC"/>
    <SolidColorBrush x:Key="Bz.Ok" Color="#2E7D4F"/>

    <!-- Type: Segoe UI, mono JetBrains Mono when installed. Min text 11 px. -->
    <FontFamily x:Key="Bz.Font.Sans">Segoe UI</FontFamily>
    <FontFamily x:Key="Bz.Font.Mono">JetBrains Mono, Cascadia Mono, Consolas</FontFamily>

    <!-- Focus ring: 2 px ink + 4 px yellow halo -->
    <Style x:Key="Bz.FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid Margin="-4" SnapsToDevicePixels="True">
                        <Border BorderBrush="#F2C200" BorderThickness="2" CornerRadius="6"/>
                        <Border Margin="2" BorderBrush="#0F0F0F" BorderThickness="2" CornerRadius="5"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .seg button (BM / EN): chrome, on = brand -->
    <Style x:Key="Bz.SegButton" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="#8B94A5"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Bz.FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="7,3,7,3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F2C200"/>
                            <Setter Property="Foreground" Value="#0F0F0F"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .tb-x: the title-bar close button -->
    <Style x:Key="Bz.ChromeIconButton" TargetType="Button">
        <Setter Property="Foreground" Value="#8B94A5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Bz.FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                            <Setter Property="Foreground" Value="#E6E9EE"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .btn-p primary -->
    <Style x:Key="Bz.Btn.Primary" TargetType="Button">
        <Setter Property="Background" Value="#F2C200"/>
        <Setter Property="Foreground" Value="#0F0F0F"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,6,10,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Bz.FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E3B600"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#EDEDEA"/>
                            <Setter Property="Foreground" Value="#8A8D93"/>
                            <Setter Property="Cursor" Value="No"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .btn-g ghost -->
    <Style x:Key="Bz.Btn.Ghost" TargetType="Button">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#2B2E33"/>
        <Setter Property="BorderBrush" Value="#D6D4CE"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,6,10,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Bz.FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F5F5F3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .fsel select. Tag="need" = required and empty: yellow border + soft halo. -->
    <Style x:Key="Bz.SelectItem" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="8,6,8,6"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="#161616"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F5F5F3"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FEF8DC"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- An option's label, live: with DisplayMemberPath a ComboBox copies the selected
         label once, so a BM / EN switch never reached the closed box. -->
    <DataTemplate x:Key="Bz.OptionLabel">
        <TextBlock Text="{Binding Label}"/>
    </DataTemplate>

    <Style x:Key="Bz.Select" TargetType="ComboBox">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="#161616"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Bz.FocusRing}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource Bz.SelectItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Halo" CornerRadius="7" Margin="-3" BorderThickness="3" BorderBrush="Transparent"/>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="#FFFFFF" BorderBrush="#D6D4CE" BorderThickness="1" CornerRadius="5"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Border x:Name="Frame" BorderBrush="#D6D4CE" BorderThickness="1" CornerRadius="5" IsHitTestVisible="False"/>
                        <ContentPresenter Margin="9,7,26,7" IsHitTestVisible="False" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <Path Data="M0,0 L5,5 L10,0" Stroke="#161616" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="10" Height="6" Stretch="Uniform" HorizontalAlignment="Right" Margin="0,0,10,0"
                              VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="None">
                            <Border Background="#FFFFFF" BorderBrush="#D6D4CE" BorderThickness="1" CornerRadius="5" Margin="0,2,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="need">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="#E0B400"/>
                            <Setter TargetName="Halo" Property="BorderBrush" Value="#40F2C200"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="#0F0F0F"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
