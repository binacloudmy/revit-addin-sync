<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- JKR pane tokens and shared styles: the "Clear Sheet" light theme. White surfaces, ink
         #15181D text, #E5E7EB hairlines, and ink-only actions (the primary button is ink with
         white text; amber #F2A91F belongs to the logo's top step alone). State colours are
         fail #C2331F, pass #3DA570, medium #B26B00 and semak manual #5B3FD0, each with a light
         wash for its tinted fills. Type is Public Sans (UI) and IBM Plex Mono (values, ids,
         file names), bundled in Fonts/.

         The Bz.* keys are the pane's own vocabulary. They are real brushes, not StaticResource
         aliases: a compiled (deferred) dictionary cannot resolve an alias entry at load time
         ("Cannot find resource named 'Bz.Chrome'").

         The Copilot dictionary is still merged so a view can use a Cp.* key directly and so the
         pane renders without the Copilot panel having loaded first (UiHarness, a pane opened
         before Copilot). The pane no longer mirrors Copilot's colours. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/RevitWebAppSync;component/UI/Copilot/CopilotTokens.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ── Type ── -->
    <FontFamily x:Key="Bz.Font.Sans">pack://application:,,,/RevitWebAppSync;component/Fonts/#Public Sans, Segoe UI, system-ui, sans-serif</FontFamily>
    <FontFamily x:Key="Bz.Font.Mono">pack://application:,,,/RevitWebAppSync;component/Fonts/#IBM Plex Mono, Consolas, Cascadia Mono, Courier New, monospace</FontFamily>

    <!-- ── Ink and surfaces ── -->
    <SolidColorBrush x:Key="Bz.Ink"               Color="#15181D"/>
    <SolidColorBrush x:Key="Bz.Text"              Color="#15181D"/>
    <SolidColorBrush x:Key="Bz.TextBody"          Color="#4B5361"/>
    <SolidColorBrush x:Key="Bz.Text2"             Color="#646B78"/>
    <SolidColorBrush x:Key="Bz.Text3"             Color="#8A919C"/>
    <SolidColorBrush x:Key="Bz.Surface"           Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Bz.Sunken"            Color="#F8F9FA"/>
    <SolidColorBrush x:Key="Bz.Sunken2"           Color="#F1F3F6"/>
    <SolidColorBrush x:Key="Bz.Line"              Color="#E5E7EB"/>
    <SolidColorBrush x:Key="Bz.Line2"             Color="#D0D4DA"/>
    <SolidColorBrush x:Key="Bz.LineSoft"          Color="#EEF0F3"/>
    <SolidColorBrush x:Key="Bz.Hover"             Color="#F1F3F6"/>
    <SolidColorBrush x:Key="Bz.Disabled"          Color="#EEF0F3"/>
    <SolidColorBrush x:Key="Bz.DisabledText"      Color="#8A919C"/>
    <SolidColorBrush x:Key="Bz.Scrim"             Color="#5915181D"/>
    <Color x:Key="Bz.BrandColor">#15181D</Color>
    <SolidColorBrush x:Key="Bz.Brand"             Color="#15181D"/>
    <SolidColorBrush x:Key="Bz.BrandHover"        Color="#2C313A"/>
    <SolidColorBrush x:Key="Bz.OnBrand"           Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Bz.BrandTint"         Color="#F1F3F6"/>
    <SolidColorBrush x:Key="Bz.BrandTintLine"     Color="#D0D4DA"/>
    <SolidColorBrush x:Key="Bz.BrandTintText"     Color="#15181D"/>
    <!-- Clear Sheet: BINA amber, the top step of the JKR Compliance mark only -->
    <SolidColorBrush x:Key="Bz.Logo.Amber"        Color="#F2A91F"/>
    <SolidColorBrush x:Key="Bz.BrandSoft"         Color="#1415181D"/>

    <!-- ── Chrome (title and context bars): light, like the Copilot pane ── -->
    <SolidColorBrush x:Key="Bz.Chrome"            Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Bz.Chrome2"           Color="#F8F9FA"/>
    <SolidColorBrush x:Key="Bz.ChromeText"        Color="#15181D"/>
    <SolidColorBrush x:Key="Bz.ChromeMuted"       Color="#646B78"/>
    <SolidColorBrush x:Key="Bz.ChromeStrong"      Color="#15181D"/>

    <!-- ── Severity, manual, ok (issue tabs) ── -->
    <SolidColorBrush x:Key="Bz.High"              Color="#C2331F"/>
    <SolidColorBrush x:Key="Bz.HighText"          Color="#B02E1C"/>
    <SolidColorBrush x:Key="Bz.HighBg"            Color="#FCEEEC"/>
    <SolidColorBrush x:Key="Bz.Med"               Color="#B26B00"/>
    <SolidColorBrush x:Key="Bz.MedText"           Color="#B26B00"/>
    <SolidColorBrush x:Key="Bz.MedBg"             Color="#FFF5E0"/>
    <!-- Clear Sheet's tag ink on the tints: Medium tag text, + line of a diff, the semak manual block -->
    <SolidColorBrush x:Key="Bz.MedInk"            Color="#8A5300"/>
    <SolidColorBrush x:Key="Bz.OkInk"             Color="#126A41"/>
    <SolidColorBrush x:Key="Bz.ManualSoft"        Color="#F5F3FE"/>
    <SolidColorBrush x:Key="Bz.Low"               Color="#8A919C"/>
    <SolidColorBrush x:Key="Bz.Manual"            Color="#5B3FD0"/>
    <SolidColorBrush x:Key="Bz.ManualBg"          Color="#EEEAFB"/>
    <SolidColorBrush x:Key="Bz.ManualDot"         Color="#5B3FD0"/>
    <SolidColorBrush x:Key="Bz.Ok"                Color="#3DA570"/>
    <SolidColorBrush x:Key="Bz.OkBg"              Color="#EAF5EF"/>

    <!-- ── Checklist state tones (text / fill / dot), one per spec state ── -->
    <SolidColorBrush x:Key="Bz.Tone.Fail"         Color="#C2331F"/>
    <SolidColorBrush x:Key="Bz.Tone.FailBg"       Color="#FCEEEC"/>
    <SolidColorBrush x:Key="Bz.Tone.FailDot"      Color="#C2331F"/>
    <SolidColorBrush x:Key="Bz.Tone.Critical"     Color="#B02E1C"/>
    <SolidColorBrush x:Key="Bz.Tone.CriticalBg"   Color="#F9D9D5"/>
    <SolidColorBrush x:Key="Bz.Tone.Pass"         Color="#3DA570"/>
    <SolidColorBrush x:Key="Bz.Tone.PassBg"       Color="#EAF5EF"/>
    <SolidColorBrush x:Key="Bz.Tone.PassDot"      Color="#3DA570"/>
    <!-- the pass mark's disc (Clear Sheet section screen): a darker green than the tick -->
    <SolidColorBrush x:Key="Bz.Tone.PassMark"     Color="#157347"/>
    <SolidColorBrush x:Key="Bz.Tone.Partial"      Color="#B26B00"/>
    <SolidColorBrush x:Key="Bz.Tone.PartialBg"    Color="#FFF5E0"/>
    <SolidColorBrush x:Key="Bz.Tone.PartialDot"   Color="#B26B00"/>
    <SolidColorBrush x:Key="Bz.Tone.Warn"         Color="#B26B00"/>
    <SolidColorBrush x:Key="Bz.Tone.WarnBg"       Color="#FFF5E0"/>
    <SolidColorBrush x:Key="Bz.Tone.WarnLine"     Color="#F2D9A6"/>
    <!-- the result's split banner (LOD changed / backend unavailable): text, dot, dashed mark -->
    <SolidColorBrush x:Key="Bz.Tone.WarnInk"      Color="#4F3300"/>
    <SolidColorBrush x:Key="Bz.Tone.WarnDot"      Color="#E39A0B"/>
    <SolidColorBrush x:Key="Bz.Tone.WarnDash"     Color="#8A6A2E"/>
    <SolidColorBrush x:Key="Bz.Tone.Person"       Color="#5B3FD0"/>
    <SolidColorBrush x:Key="Bz.Tone.PersonBg"     Color="#EEEAFB"/>
    <SolidColorBrush x:Key="Bz.Tone.PersonDot"    Color="#5B3FD0"/>
    <SolidColorBrush x:Key="Bz.Tone.Pending"      Color="#B26B00"/>
    <SolidColorBrush x:Key="Bz.Tone.PendingBg"    Color="#FFF5E0"/>
    <SolidColorBrush x:Key="Bz.Tone.Listed"       Color="#C9CED6"/>
    <SolidColorBrush x:Key="Bz.Tone.ListedBg"     Color="#F1F3F6"/>
    <SolidColorBrush x:Key="Bz.Tone.ListedDot"    Color="#C9CED6"/>
    <SolidColorBrush x:Key="Bz.Tone.Na"           Color="#646B78"/>
    <SolidColorBrush x:Key="Bz.Tone.NaBg"         Color="#F1F3F6"/>
    <SolidColorBrush x:Key="Bz.Tone.NaDot"        Color="#C9CED6"/>
    <SolidColorBrush x:Key="Bz.Tone.None"         Color="#8A919C"/>
    <SolidColorBrush x:Key="Bz.Tone.NoneBg"       Color="#F1F3F6"/>
    <SolidColorBrush x:Key="Bz.Track"             Color="#EEF0F3"/>
    <SolidColorBrush x:Key="Bz.CodeBg"            Color="#F5F6F8"/>
    <SolidColorBrush x:Key="Bz.CodeFg"            Color="#15181D"/>
    <SolidColorBrush x:Key="Bz.InkHover"          Color="#2C313A"/>
    <Style x:Key="Bz.FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" BorderBrush="{StaticResource Bz.Brand}" BorderThickness="2" CornerRadius="7" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── segmented toggle: sunken pill, the active half white with ink ── -->
    <Style x:Key="Bz.SegButton" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource Bz.Text2}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Bz.FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="9,3,9,4" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Bz.Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bz.Surface}"/>
                            <Setter Property="Foreground" Value="{StaticResource Bz.Ink}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Title-bar icon button (close) ── -->
    <Style x:Key="Bz.ChromeIconButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Bz.Text3}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Bz.FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bz.Hover}"/>
                            <Setter Property="Foreground" Value="{StaticResource Bz.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 28 × 28 bordered icon button (rows, detail header) ── -->
    <Style x:Key="Bz.Btn.Icon" TargetType="Button">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Foreground" Value="{StaticResource Bz.Text2}"/>
        <Setter Property="Background" Value="{StaticResource Bz.Surface}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Bz.FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Bz.Line}" BorderThickness="1" CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bz.Hover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Bz.Line2}"/>
                            <Setter Property="Foreground" Value="{StaticResource Bz.Text}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Primary: accent fill, white text, 7 px radius ── -->
    <Style x:Key="Bz.Btn.Primary" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Bz.Brand}"/>
        <Setter Property="Foreground" Value="{StaticResource Bz.OnBrand}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="12,7,12,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Bz.FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bz.BrandHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bz.Disabled}"/>
                            <Setter Property="Foreground" Value="{StaticResource Bz.DisabledText}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Ghost: hairline, ink on hover ── -->
    <Style x:Key="Bz.Btn.Ghost" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Bz.Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource Bz.TextBody}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Bz.Line}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="11,6,11,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Bz.FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bz.Hover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Bz.Line2}"/>
                            <Setter Property="Foreground" Value="{StaticResource Bz.Text}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Bz.DisabledText}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Ink (dark) button: Export; the one filled-dark control in the pane ── -->
    <Style x:Key="Bz.Btn.Ink" TargetType="Button" BasedOn="{StaticResource Bz.Btn.Primary}">
        <Setter Property="Background" Value="{StaticResource Bz.Ink}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bz.InkHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bz.Disabled}"/>
                            <Setter Property="Foreground" Value="{StaticResource Bz.DisabledText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Keyboard cap ("F", "J/K") ── -->
    <Style x:Key="Bz.Kbd" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Bz.CodeBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Bz.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="5,0,5,1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ── Select (ComboBox). Tag="need" = required and empty: accent border + soft halo. ── -->
    <Style x:Key="Bz.SelectItem" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="9,6,9,6"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource Bz.Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="3,1,3,1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bz.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bz.BrandSoft}"/>
                            <Setter Property="Foreground" Value="{StaticResource Bz.BrandTintText}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- An option's label, live: with DisplayMemberPath a ComboBox copies the selected
         label once, so a relabel never reached the closed box. -->
    <DataTemplate x:Key="Bz.OptionLabel">
        <TextBlock Text="{Binding Label}"/>
    </DataTemplate>

    <Style x:Key="Bz.Select" TargetType="ComboBox">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource Bz.Text}"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource Bz.SelectItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Halo" CornerRadius="9" Margin="-3" BorderThickness="3" BorderBrush="Transparent"/>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="{StaticResource Bz.Surface}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bz.Hover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Border x:Name="Frame" BorderBrush="{StaticResource Bz.Line2}" BorderThickness="1" CornerRadius="7" IsHitTestVisible="False"/>
                        <ContentPresenter Margin="10,6,28,6" IsHitTestVisible="False" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <Path Data="M0,0 L5,5 L10,0" Stroke="{StaticResource Bz.Text2}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="10" Height="6" Stretch="Uniform" HorizontalAlignment="Right" Margin="0,0,11,0"
                              VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="None">
                            <Border Background="{StaticResource Bz.Surface}" BorderBrush="{StaticResource Bz.Line2}" BorderThickness="1" CornerRadius="8" Margin="0,3,0,0" Padding="0,3,0,3"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260">
                                <Border.Effect>
                                    <DropShadowEffect Color="#0F172A" BlurRadius="18" ShadowDepth="6" Direction="270" Opacity="0.18"/>
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="need">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Bz.Brand}"/>
                            <Setter TargetName="Halo" Property="BorderBrush" Value="{StaticResource Bz.BrandSoft}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Bz.Brand}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Scroll bars: a thin thumb on the dark pane (the Windows default bar is light). Implicit,
         so every ScrollViewer under a view that merges these tokens picks it up, popups included.
         No animation: hover and drag swap the thumb's opacity. -->
    <Style x:Key="Bz.ScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" Background="{StaticResource Bz.Text3}" Opacity="0.45" CornerRadius="3" Margin="2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.7"/></Trigger>
                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.9"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Bz.ScrollPage" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource Bz.ScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                            <Track.Thumb><Thumb Style="{StaticResource Bz.ScrollThumb}"/></Track.Thumb>
                            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource Bz.ScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource Bz.ScrollPage}" Command="ScrollBar.PageLeftCommand"/></Track.DecreaseRepeatButton>
                                    <Track.Thumb><Thumb Style="{StaticResource Bz.ScrollThumb}"/></Track.Thumb>
                                    <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource Bz.ScrollPage}" Command="ScrollBar.PageRightCommand"/></Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
