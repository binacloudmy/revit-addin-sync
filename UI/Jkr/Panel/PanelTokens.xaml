<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- JKR pane tokens and shared styles. The pane is always dark ("Direction C" of
         the JKR design canvas): Copilot's Slate surfaces and ink, an amber primary
         action, and the Cp.Jkr.Dark.* state colours.

         The pane uses the product's design system (UI/Copilot/CopilotTokens.xaml:
         Inter, the Slate dark scale) so it reads as one product with the Copilot
         pane in dark mode. The Bz.* keys are the pane's own vocabulary; each one
         mirrors the Cp.* key named in its comment, and
         Tests/PaneShellTests keeps the two in step. They are real brushes, not
         StaticResource aliases: a compiled (deferred) dictionary cannot resolve an
         alias entry at load time ("Cannot find resource named 'Bz.Chrome'").

         The Copilot dictionary is merged here as well as at application level so a
         view can also use a Cp.* key directly, and so the pane renders without the
         Copilot panel having loaded first (UiHarness, a pane opened before Copilot).
         The pane is dark whatever the Copilot theme: it reads the fixed Cp.Dark.* and
         Cp.Jkr.Dark.* keys, which CopilotTheme never flips. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/RevitWebAppSync;component/UI/Copilot/CopilotTokens.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ── Type (= Cp.Font / Cp.FontMono) ── -->
    <FontFamily x:Key="Bz.Font.Sans">pack://application:,,,/RevitWebAppSync;component/Fonts/#Inter, Segoe UI, system-ui, sans-serif</FontFamily>
    <FontFamily x:Key="Bz.Font.Mono">Geist Mono, Cascadia Mono, Consolas, Courier New, monospace</FontFamily>

    <!-- ── Ink and surfaces ── -->
    <SolidColorBrush x:Key="Bz.Ink"               Color="#f4f7fb"/> <!-- Cp.Dark.Ink2 -->
    <SolidColorBrush x:Key="Bz.Text"              Color="#e8eef6"/> <!-- Cp.Dark.Ink -->
    <SolidColorBrush x:Key="Bz.TextBody"          Color="#e8eef6"/> <!-- Cp.Dark.Ink -->
    <SolidColorBrush x:Key="Bz.Text2"             Color="#8a94a6"/> <!-- Cp.Dark.Muted -->
    <SolidColorBrush x:Key="Bz.Text3"             Color="#7f8a9e"/> <!-- Cp.Jkr.Dark.Faint -->
    <SolidColorBrush x:Key="Bz.Surface"           Color="#131d2b"/> <!-- Cp.Dark.Bg -->
    <SolidColorBrush x:Key="Bz.Sunken"            Color="#0c1420"/> <!-- Cp.Dark.Sunken -->
    <SolidColorBrush x:Key="Bz.Sunken2"           Color="#172231"/> <!-- Cp.Jkr.Dark.Raised -->
    <SolidColorBrush x:Key="Bz.Line"              Color="#12FFFFFF"/> <!-- Cp.Dark.Line -->
    <SolidColorBrush x:Key="Bz.Line2"             Color="#24FFFFFF"/> <!-- Cp.Dark.Hair2 -->
    <SolidColorBrush x:Key="Bz.LineSoft"          Color="#0DFFFFFF"/> <!-- Cp.Dark.LineSoft -->
    <SolidColorBrush x:Key="Bz.Hover"             Color="#0DFFFFFF"/> <!-- Cp.Dark.Hover -->
    <SolidColorBrush x:Key="Bz.Disabled"          Color="#1e2a3a"/> <!-- Cp.Jkr.Dark.Disabled -->
    <SolidColorBrush x:Key="Bz.DisabledText"      Color="#7f8a9e"/> <!-- Cp.Jkr.Dark.Faint -->
    <SolidColorBrush x:Key="Bz.Scrim"             Color="#B3060A12"/> <!-- Cp.Jkr.Dark.Scrim -->
    <Color x:Key="Bz.BrandColor">#f5b942</Color>
    <SolidColorBrush x:Key="Bz.Brand"             Color="#f5b942"/> <!-- Cp.Jkr.Dark.Action -->
    <SolidColorBrush x:Key="Bz.BrandHover"        Color="#ffc85c"/> <!-- Cp.Jkr.Dark.ActionHover -->
    <SolidColorBrush x:Key="Bz.OnBrand"           Color="#1a1407"/> <!-- Cp.Jkr.Dark.OnAction -->
    <SolidColorBrush x:Key="Bz.BrandTint"         Color="#2660A5FA"/> <!-- Cp.Dark.BlueSoft -->
    <SolidColorBrush x:Key="Bz.BrandTintLine"     Color="#3360A5FA"/> <!-- Cp.Dark.BlueLine -->
    <SolidColorBrush x:Key="Bz.BrandTintText"     Color="#9cc3f7"/> <!-- Cp.Dark.BlueText -->
    <SolidColorBrush x:Key="Bz.BrandSoft"         Color="#29F5B942"/> <!-- Cp.Jkr.Dark.ActionSoft -->

    <!-- ── Chrome (title and context bars): light, like the Copilot pane ── -->
    <SolidColorBrush x:Key="Bz.Chrome"            Color="#131d2b"/> <!-- Cp.Dark.Bg -->
    <SolidColorBrush x:Key="Bz.Chrome2"           Color="#0c1420"/> <!-- Cp.Dark.Sunken -->
    <SolidColorBrush x:Key="Bz.ChromeText"        Color="#e8eef6"/> <!-- Cp.Dark.Ink -->
    <SolidColorBrush x:Key="Bz.ChromeMuted"       Color="#7f8a9e"/> <!-- Cp.Jkr.Dark.Faint -->
    <SolidColorBrush x:Key="Bz.ChromeStrong"      Color="#f4f7fb"/> <!-- Cp.Dark.Ink2 -->

    <!-- ── Severity, manual, ok (issue tabs) ── -->
    <SolidColorBrush x:Key="Bz.High"              Color="#ff6b5e"/> <!-- Cp.Jkr.Dark.FailDot -->
    <SolidColorBrush x:Key="Bz.HighText"          Color="#ff7a6e"/> <!-- Cp.Jkr.Dark.Fail -->
    <SolidColorBrush x:Key="Bz.HighBg"            Color="#33FF6B5E"/> <!-- Cp.Jkr.Dark.FailBg -->
    <SolidColorBrush x:Key="Bz.Med"               Color="#f5b942"/> <!-- Cp.Jkr.Dark.WarnDot -->
    <SolidColorBrush x:Key="Bz.MedText"           Color="#f5b942"/> <!-- Cp.Jkr.Dark.Warn -->
    <SolidColorBrush x:Key="Bz.MedBg"             Color="#24F5B942"/> <!-- Cp.Jkr.Dark.WarnBg -->
    <SolidColorBrush x:Key="Bz.Low"               Color="#a7b0bf"/> <!-- Cp.Jkr.Dark.Listed -->
    <SolidColorBrush x:Key="Bz.Manual"            Color="#8db8ff"/> <!-- Cp.Jkr.Dark.Person -->
    <SolidColorBrush x:Key="Bz.ManualBg"          Color="#2E7FB0FF"/> <!-- Cp.Jkr.Dark.PersonBg -->
    <SolidColorBrush x:Key="Bz.ManualDot"         Color="#7fb0ff"/> <!-- Cp.Jkr.Dark.PersonDot -->
    <SolidColorBrush x:Key="Bz.Ok"                Color="#4fd38f"/> <!-- Cp.Jkr.Dark.Pass -->
    <SolidColorBrush x:Key="Bz.OkBg"              Color="#264FD38F"/> <!-- Cp.Jkr.Dark.PassBg -->

    <!-- ── Checklist state tones (text / fill / dot), one per spec state ── -->
    <SolidColorBrush x:Key="Bz.Tone.Fail"         Color="#ff7a6e"/> <!-- Cp.Jkr.Dark.Fail -->
    <SolidColorBrush x:Key="Bz.Tone.FailBg"       Color="#33FF6B5E"/> <!-- Cp.Jkr.Dark.FailBg -->
    <SolidColorBrush x:Key="Bz.Tone.FailDot"      Color="#ff6b5e"/> <!-- Cp.Jkr.Dark.FailDot -->
    <SolidColorBrush x:Key="Bz.Tone.Critical"     Color="#ffb4ab"/> <!-- Cp.Jkr.Dark.Critical -->
    <SolidColorBrush x:Key="Bz.Tone.CriticalBg"   Color="#4DFF6B5E"/> <!-- Cp.Jkr.Dark.CriticalBg -->
    <SolidColorBrush x:Key="Bz.Tone.Pass"         Color="#4fd38f"/> <!-- Cp.Jkr.Dark.Pass -->
    <SolidColorBrush x:Key="Bz.Tone.PassBg"       Color="#264FD38F"/> <!-- Cp.Jkr.Dark.PassBg -->
    <SolidColorBrush x:Key="Bz.Tone.PassDot"      Color="#4fd38f"/> <!-- Cp.Jkr.Dark.PassDot -->
    <SolidColorBrush x:Key="Bz.Tone.Partial"      Color="#f5b942"/> <!-- Cp.Jkr.Dark.Warn -->
    <SolidColorBrush x:Key="Bz.Tone.PartialBg"    Color="#24F5B942"/> <!-- Cp.Jkr.Dark.WarnBg -->
    <SolidColorBrush x:Key="Bz.Tone.PartialDot"   Color="#f5b942"/> <!-- Cp.Jkr.Dark.WarnDot -->
    <SolidColorBrush x:Key="Bz.Tone.Warn"         Color="#f5b942"/> <!-- Cp.Jkr.Dark.Warn -->
    <SolidColorBrush x:Key="Bz.Tone.WarnBg"       Color="#24F5B942"/> <!-- Cp.Jkr.Dark.WarnBg -->
    <SolidColorBrush x:Key="Bz.Tone.WarnLine"     Color="#59F5B942"/> <!-- Cp.Jkr.Dark.WarnLine -->
    <SolidColorBrush x:Key="Bz.Tone.Person"       Color="#8db8ff"/> <!-- Cp.Jkr.Dark.Person -->
    <SolidColorBrush x:Key="Bz.Tone.PersonBg"     Color="#2E7FB0FF"/> <!-- Cp.Jkr.Dark.PersonBg -->
    <SolidColorBrush x:Key="Bz.Tone.PersonDot"    Color="#7fb0ff"/> <!-- Cp.Jkr.Dark.PersonDot -->
    <SolidColorBrush x:Key="Bz.Tone.Pending"      Color="#f5b942"/> <!-- Cp.Jkr.Dark.Pending -->
    <SolidColorBrush x:Key="Bz.Tone.PendingBg"    Color="#1AF5B942"/> <!-- Cp.Jkr.Dark.PendingBg -->
    <SolidColorBrush x:Key="Bz.Tone.Listed"       Color="#a7b0bf"/> <!-- Cp.Jkr.Dark.Listed -->
    <SolidColorBrush x:Key="Bz.Tone.ListedBg"     Color="#1FFFFFFF"/> <!-- Cp.Jkr.Dark.ListedBg -->
    <SolidColorBrush x:Key="Bz.Tone.ListedDot"    Color="#8a94a6"/> <!-- Cp.Jkr.Dark.ListedDot -->
    <SolidColorBrush x:Key="Bz.Tone.Na"           Color="#9fbcd0"/> <!-- Cp.Jkr.Dark.Na -->
    <SolidColorBrush x:Key="Bz.Tone.NaBg"         Color="#268FB0C4"/> <!-- Cp.Jkr.Dark.NaBg -->
    <SolidColorBrush x:Key="Bz.Tone.NaDot"        Color="#8fb0c4"/> <!-- Cp.Jkr.Dark.NaDot -->
    <SolidColorBrush x:Key="Bz.Tone.None"         Color="#8a94a6"/> <!-- Cp.Dark.Muted -->
    <SolidColorBrush x:Key="Bz.Tone.NoneBg"       Color="#1FFFFFFF"/> <!-- Cp.Jkr.Dark.ListedBg -->
    <SolidColorBrush x:Key="Bz.Track"             Color="#22303f"/> <!-- Cp.Jkr.Dark.Track -->
    <SolidColorBrush x:Key="Bz.CodeBg"            Color="#0c1420"/> <!-- Cp.Dark.Sunken -->
    <SolidColorBrush x:Key="Bz.CodeFg"            Color="#9cc3f7"/> <!-- Cp.Dark.CodeFg -->
    <SolidColorBrush x:Key="Bz.InkHover"          Color="#ffffff"/> <!-- Cp.Jkr.Dark.InkHover -->
    <Style x:Key="Bz.FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" BorderBrush="{StaticResource Bz.Brand}" BorderThickness="2" CornerRadius="7" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── BM / EN segmented toggle: sunken pill, the active half white with ink ── -->
    <Style x:Key="Bz.SegButton" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource Bz.Text2}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Bz.FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="9,3,9,4" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Bz.Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bz.Surface}"/>
                            <Setter Property="Foreground" Value="{StaticResource Bz.Ink}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Title-bar icon button (close) ── -->
    <Style x:Key="Bz.ChromeIconButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Bz.Text3}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Bz.FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bz.Hover}"/>
                            <Setter Property="Foreground" Value="{StaticResource Bz.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 28 × 28 bordered icon button (rows, detail header) ── -->
    <Style x:Key="Bz.Btn.Icon" TargetType="Button">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Foreground" Value="{StaticResource Bz.Text2}"/>
        <Setter Property="Background" Value="{StaticResource Bz.Surface}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Bz.FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Bz.Line}" BorderThickness="1" CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bz.Hover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Bz.Line2}"/>
                            <Setter Property="Foreground" Value="{StaticResource Bz.Text}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Primary: accent fill, white text, 7 px radius ── -->
    <Style x:Key="Bz.Btn.Primary" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Bz.Brand}"/>
        <Setter Property="Foreground" Value="{StaticResource Bz.OnBrand}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="12,7,12,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Bz.FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bz.BrandHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bz.Disabled}"/>
                            <Setter Property="Foreground" Value="{StaticResource Bz.DisabledText}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Ghost: hairline, ink on hover ── -->
    <Style x:Key="Bz.Btn.Ghost" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Bz.Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource Bz.TextBody}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Bz.Line}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="11,6,11,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Bz.FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bz.Hover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Bz.Line2}"/>
                            <Setter Property="Foreground" Value="{StaticResource Bz.Text}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Bz.DisabledText}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Ink (dark) button: Export; the one filled-dark control in the pane ── -->
    <Style x:Key="Bz.Btn.Ink" TargetType="Button" BasedOn="{StaticResource Bz.Btn.Primary}">
        <Setter Property="Background" Value="{StaticResource Bz.Ink}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bz.InkHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bz.Disabled}"/>
                            <Setter Property="Foreground" Value="{StaticResource Bz.DisabledText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Keyboard cap ("F", "J/K") ── -->
    <Style x:Key="Bz.Kbd" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Bz.CodeBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Bz.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="5,0,5,1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ── Select (ComboBox). Tag="need" = required and empty: accent border + soft halo. ── -->
    <Style x:Key="Bz.SelectItem" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="9,6,9,6"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource Bz.Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="3,1,3,1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bz.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bz.BrandSoft}"/>
                            <Setter Property="Foreground" Value="{StaticResource Bz.BrandTintText}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- An option's label, live: with DisplayMemberPath a ComboBox copies the selected
         label once, so a BM / EN switch never reached the closed box. -->
    <DataTemplate x:Key="Bz.OptionLabel">
        <TextBlock Text="{Binding Label}"/>
    </DataTemplate>

    <Style x:Key="Bz.Select" TargetType="ComboBox">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource Bz.Text}"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource Bz.SelectItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Halo" CornerRadius="9" Margin="-3" BorderThickness="3" BorderBrush="Transparent"/>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="{StaticResource Bz.Surface}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bz.Hover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Border x:Name="Frame" BorderBrush="{StaticResource Bz.Line2}" BorderThickness="1" CornerRadius="7" IsHitTestVisible="False"/>
                        <ContentPresenter Margin="10,6,28,6" IsHitTestVisible="False" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <Path Data="M0,0 L5,5 L10,0" Stroke="{StaticResource Bz.Text2}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="10" Height="6" Stretch="Uniform" HorizontalAlignment="Right" Margin="0,0,11,0"
                              VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="None">
                            <Border Background="{StaticResource Bz.Surface}" BorderBrush="{StaticResource Bz.Line2}" BorderThickness="1" CornerRadius="8" Margin="0,3,0,0" Padding="0,3,0,3"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260">
                                <Border.Effect>
                                    <DropShadowEffect Color="#0F172A" BlurRadius="18" ShadowDepth="6" Direction="270" Opacity="0.18"/>
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="need">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Bz.Brand}"/>
                            <Setter TargetName="Halo" Property="BorderBrush" Value="{StaticResource Bz.BrandSoft}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Bz.Brand}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Scroll bars: a thin thumb on the dark pane (the Windows default bar is light). Implicit,
         so every ScrollViewer under a view that merges these tokens picks it up, popups included.
         No animation: hover and drag swap the thumb's opacity. -->
    <Style x:Key="Bz.ScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" Background="{StaticResource Bz.Text3}" Opacity="0.45" CornerRadius="3" Margin="2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.7"/></Trigger>
                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.9"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Bz.ScrollPage" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource Bz.ScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                            <Track.Thumb><Thumb Style="{StaticResource Bz.ScrollThumb}"/></Track.Thumb>
                            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource Bz.ScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource Bz.ScrollPage}" Command="ScrollBar.PageLeftCommand"/></Track.DecreaseRepeatButton>
                                    <Track.Thumb><Thumb Style="{StaticResource Bz.ScrollThumb}"/></Track.Thumb>
                                    <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource Bz.ScrollPage}" Command="ScrollBar.PageRightCommand"/></Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
