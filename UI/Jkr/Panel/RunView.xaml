<UserControl x:Class="RevitWebAppSync.UI.Jkr.Panel.RunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Bz.Surface}" FontFamily="{DynamicResource Bz.Font.Sans}" Foreground="{DynamicResource Bz.Text}">
    <!-- Running (frames r-a, r-mid, r-done, r-fail). DataContext: Core.RunScreenModel. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevitWebAppSync;component/UI/Jkr/Panel/PanelTokens.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="B2V"/>

            <!-- spinner: 12 px ring, accent arc, 0.8 s turn -->
            <Style x:Key="Spinner" TargetType="Grid">
                <Setter Property="Width" Value="12"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                <Setter Property="RenderTransform">
                    <Setter.Value><RotateTransform/></Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsVisible" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard x:Name="SpinSb">
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                     From="0" To="360" Duration="0:0:0.8" RepeatBehavior="Forever"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <StopStoryboard BeginStoryboardName="SpinSb"/>
                        </Trigger.ExitActions>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="18,20,18,20">
            <!-- head -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Border Grid.Column="1" Background="{StaticResource Bz.Sunken2}" CornerRadius="6" Padding="8,3,8,4" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="{Binding LodDisc}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Bz.Text2}"/>
                </Border>
            </Grid>

            <!-- bar: 6 px, accent fill = sections done / 5 -->
            <Grid x:Name="BarTrack" Height="6" Margin="0,14,0,0">
                <Border Background="{StaticResource Bz.Track}" CornerRadius="3"/>
                <Border x:Name="BarFill" Background="{StaticResource Bz.Brand}" CornerRadius="3" HorizontalAlignment="Left" Width="0"/>
            </Grid>

            <!-- steps -->
            <Border BorderBrush="{StaticResource Bz.Line}" BorderThickness="1" CornerRadius="10" Margin="0,16,0,0" ClipToBounds="True">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="RowBd" BorderBrush="{StaticResource Bz.LineSoft}" BorderThickness="0,0,0,1" Padding="12,0,12,0" Height="44">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="KeyBd" Width="22" Height="22" CornerRadius="6" Background="{StaticResource Bz.Sunken2}" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock x:Name="Key" Text="{Binding Key}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{StaticResource Bz.Text2}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="Name" Grid.Column="1" Text="{Binding Name}" FontSize="12.5" FontWeight="Medium"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <Grid Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsDone, Converter={StaticResource B2V}}">
                                            <TextBlock Text="{Binding PctLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Bz.Text}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding PendLabel}" FontSize="11.5" Foreground="{StaticResource Bz.Manual}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            <Path Data="M4,12 L9,17 L20,6" Stroke="{StaticResource Bz.Tone.PassDot}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="12" Height="12" Stretch="Uniform" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsChecking, Converter={StaticResource B2V}}">
                                            <TextBlock Text="{Binding DataContext.CheckingLabel, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       FontSize="11.5" Foreground="{StaticResource Bz.Brand}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Grid Style="{StaticResource Spinner}" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <Ellipse Stroke="{StaticResource Bz.Track}" StrokeThickness="2"/>
                                                <Path Data="M6,1 A5,5 0 0 1 11,6" Stroke="{StaticResource Bz.Brand}" StrokeThickness="2" StrokeStartLineCap="Round"/>
                                            </Grid>
                                        </StackPanel>
                                        <TextBlock Visibility="{Binding IsWaiting, Converter={StaticResource B2V}}" FontSize="11.5"
                                                   Foreground="{StaticResource Bz.Text3}" VerticalAlignment="Center"
                                                   Text="{Binding DataContext.WaitingLabel, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                        <TextBlock Visibility="{Binding IsFailed, Converter={StaticResource B2V}}" FontSize="11.5"
                                                   FontWeight="SemiBold" Foreground="{StaticResource Bz.HighText}" VerticalAlignment="Center"
                                                   Text="{Binding DataContext.FailReadLabel, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                    </Grid>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsWaiting}" Value="True">
                                    <Setter TargetName="Name" Property="Foreground" Value="{StaticResource Bz.Text3}"/>
                                    <Setter TargetName="Name" Property="FontWeight" Value="Normal"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsChecking}" Value="True">
                                    <Setter TargetName="KeyBd" Property="Background" Value="{StaticResource Bz.BrandSoft}"/>
                                    <Setter TargetName="Key" Property="Foreground" Value="{StaticResource Bz.Brand}"/>
                                    <Setter TargetName="RowBd" Property="Background" Value="{StaticResource Bz.Sunken}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter TargetName="Key" Property="Foreground" Value="{StaticResource Bz.Text}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- failure (r-fail): why, Retry, Back to start -->
            <Border Visibility="{Binding IsFailed, Converter={StaticResource B2V}}" Background="{StaticResource Bz.HighBg}"
                    BorderBrush="{StaticResource Cp.IssueLn}" BorderThickness="1" CornerRadius="8" Padding="12,10,12,10" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="18" Foreground="{StaticResource Cp.IssueFg2}">
                        <Run Text="{Binding FailTitle, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" "/><Run Text="{Binding ErrorText, Mode=OneWay}"/>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="{Binding BackLabel}" Style="{StaticResource Bz.Btn.Ghost}" Click="Back_Click" Margin="0,0,8,0"/>
                        <Button Content="{Binding RetryLabel}" Style="{StaticResource Bz.Btn.Primary}" Click="Retry_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- live: n manual collected so far -->
            <Border Background="{StaticResource Bz.ManualBg}" CornerRadius="8" Padding="12,9,12,9" Margin="0,14,0,0">
                <TextBlock FontSize="12" LineHeight="17" Foreground="{StaticResource Bz.Text2}" TextWrapping="Wrap">
                    <Run Text="{Binding PendLive, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource Bz.Manual}"/><Run Text=" "/><Run Text="{Binding LiveText, Mode=OneWay}"/>
                </TextBlock>
            </Border>
            <TextBlock Text="{Binding NoOverall}" FontSize="11" LineHeight="16" Foreground="{StaticResource Bz.Text3}"
                       TextWrapping="Wrap" Margin="2,12,2,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
