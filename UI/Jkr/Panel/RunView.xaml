<UserControl x:Class="RevitWebAppSync.UI.Jkr.Panel.RunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Bz.Surface}" FontFamily="{DynamicResource Bz.Font.Sans}" Foreground="{DynamicResource Bz.Text}">
    <!-- Running and run failed, drawn as Clear Sheet ("audit running", "edge states: run failed").
         DataContext: Core.RunScreenModel. While it runs: a context strip (LOD, discipline, a
         disabled Re-scan), the heading and sub, the run bar with "n of N checks done", the five
         Borang sections (letter chip, name, manual and %, status, one tick per check), the
         BINA backend note, the manual-review key and the "overall result" note. When it fails:
         the heading becomes "The audit stopped in section X" with the reason, the A-E strip
         with "Stopped in X", the sections as dot rows, and Back to start / Retry.
         The scan has no per-check progress, so the ticks and the check count move a section at
         a time (a done section = all its checks). -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevitWebAppSync;component/UI/Jkr/Panel/PanelTokens.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="B2V"/>

            <!-- spinner: 14 px ring, ink arc. No Storyboard (Storyboards crash Revit dockable
                 panes): each spinner registers on Loaded and RunView turns its own
                 RotateTransform on a DispatcherTimer. -->
            <Style x:Key="Spinner" TargetType="Grid">
                <Setter Property="Width" Value="14"/>
                <Setter Property="Height" Value="14"/>
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            </Style>

            <!-- shown while the run has not failed -->
            <Style x:Key="OkOnly" TargetType="FrameworkElement">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <!-- shown only when the run failed -->
            <Style x:Key="FailOnly" TargetType="FrameworkElement">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- context strip: LOD, discipline, Re-scan (off while the audit runs) -->
        <Border Grid.Row="0" Height="48" BorderBrush="{StaticResource Bz.Line}" BorderThickness="0,0,0,1" Padding="16,0,12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="LOD" Foreground="{StaticResource Bz.Text2}"/>
                    <TextBlock Text="{Binding LodValue}" Foreground="{StaticResource Bz.TextBody}" FontWeight="Medium" Margin="6,0,0,0"/>
                    <TextBlock Text="{Binding DiscName}" Foreground="{StaticResource Bz.TextBody}" FontWeight="Medium" Margin="16,0,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" IsEnabled="False" Style="{StaticResource Bz.Btn.Ghost}" Height="32" Padding="12,0,12,0" FontSize="13" FontWeight="SemiBold"
                        VerticalAlignment="Center" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M13,8 A5,5 0 1 1 11.54,4.46 M13,2.5 L13,5 L10.5,5" Stroke="{StaticResource Bz.DisabledText}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding RescanLabel}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,24,16,20">

                <!-- heading + sub (running) -->
                <StackPanel Style="{StaticResource OkOnly}">
                    <StackPanel Orientation="Horizontal">
                        <Grid Style="{StaticResource Spinner}" Margin="0,0,10,0" VerticalAlignment="Center"
                              Visibility="{Binding IsRunning, Converter={StaticResource B2V}}" Loaded="Spinner_Loaded" Unloaded="Spinner_Unloaded">
                            <Ellipse Stroke="{StaticResource Bz.Line}" StrokeThickness="2"/>
                            <Path Data="M7,1 A6,6 0 0 1 13,7" Stroke="{StaticResource Bz.Ink}" StrokeThickness="2" StrokeStartLineCap="Round"/>
                        </Grid>
                        <TextBlock Text="{Binding Heading}" FontSize="20" LineHeight="26" FontWeight="Bold" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Sub}" Foreground="{StaticResource Bz.TextBody}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- failure: why it stopped -->
                <Grid Style="{StaticResource FailOnly}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource Bz.HighBg}" VerticalAlignment="Top" Margin="0,0,12,0">
                        <Path Data="M8,4.5 L8,8.7 M8,11.4 L8,11.45" Stroke="{StaticResource Bz.High}" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="None"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding FailHeading}" FontSize="17" LineHeight="22" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding FailDetail}" Foreground="{StaticResource Bz.TextBody}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- "n of N checks done" (+ "Stopped in X" when it failed); indented under the heading text on failure -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Margin" Value="0,16,0,0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                    <Setter Property="Margin" Value="44,12,0,0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ChecksDoneLabel}" FontSize="12" Foreground="{StaticResource Bz.TextBody}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding StoppedIn}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Bz.High}"
                               Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource FailOnly}"/>
                </Grid>

                <!-- run bar: 6 px, ink fill = sections done / 5 -->
                <Grid x:Name="BarTrack" Height="6" Margin="0,8,0,0" Style="{StaticResource OkOnly}">
                    <Border Background="{StaticResource Bz.Track}" CornerRadius="3"/>
                    <!-- scaled, never resized (transform-only motion) -->
                    <Border x:Name="BarFill" Background="{StaticResource Bz.Brand}" CornerRadius="3" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform><ScaleTransform x:Name="BarScale" ScaleX="0"/></Border.RenderTransform>
                    </Border>
                </Grid>

                <!-- A-E strip (failed run): one segment per section, as wide as its checks -->
                <ItemsControl ItemsSource="{Binding Rows}" Margin="44,10,0,0" Focusable="False" IsTabStop="False" Style="{StaticResource FailOnly}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid Loaded="StripGrid_Loaded"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Grid.Column" Value="{Binding Index}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,3,0">
                                <Border x:Name="Seg" Height="8" CornerRadius="4" Background="{StaticResource Bz.Track}"/>
                                <TextBlock x:Name="Let" Text="{Binding Letter}" FontSize="11" LineHeight="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource Bz.Text2}" Margin="0,7,0,0"/>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter TargetName="Seg" Property="Background" Value="{StaticResource Bz.Ink}"/>
                                    <Setter TargetName="Let" Property="Foreground" Value="{StaticResource Bz.Text}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsStopped}" Value="True">
                                    <Setter TargetName="Let" Property="Foreground" Value="{StaticResource Bz.High}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- sections: letter chip, name, manual and %, status, one tick per check -->
                <ItemsControl ItemsSource="{Binding Rows}" Margin="0,16,0,0" Focusable="False" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Bz.LineSoft}" BorderThickness="0,1,0,0" Padding="0,12,0,12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource Bz.Sunken2}" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Letter}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Bz.TextBody}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Name="Name" Grid.Column="1" Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource Bz.Text}"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <!-- done: manual and % -->
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsDone, Converter={StaticResource B2V}}">
                                                <TextBlock Text="{Binding PendLabel}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource Bz.Manual}"
                                                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding PctLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Bz.Text}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock FontSize="12" FontWeight="Medium" Foreground="{StaticResource Bz.Text}" VerticalAlignment="Center"
                                                       Visibility="{Binding IsChecking, Converter={StaticResource B2V}}"
                                                       Text="{Binding DataContext.CheckingLabel, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                            <TextBlock FontSize="12" Foreground="{StaticResource Bz.Text2}" VerticalAlignment="Center"
                                                       Visibility="{Binding IsWaiting, Converter={StaticResource B2V}}"
                                                       Text="{Binding DataContext.WaitingLabel, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                            <!-- failed run: where it got to -->
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Bz.High}" VerticalAlignment="Center"
                                                       Visibility="{Binding IsStopped, Converter={StaticResource B2V}}"
                                                       Text="{Binding DataContext.RowStoppedLabel, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                            <TextBlock FontSize="12" Foreground="{StaticResource Bz.Text2}" VerticalAlignment="Center"
                                                       Visibility="{Binding IsNotRun, Converter={StaticResource B2V}}"
                                                       Text="{Binding DataContext.RowNotRunLabel, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                            <Grid x:Name="Dot" Width="14" Height="14" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                                <Ellipse x:Name="DotHalo" Fill="Transparent"/>
                                                <Ellipse x:Name="DotCore" Width="8" Height="8" Fill="{StaticResource Bz.Ink}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                    <!-- one tick per check; the colour is the section's state (no per-check result in a run) -->
                                    <ItemsControl x:Name="TickBar" ItemsSource="{Binding Ticks}" Margin="32,8,0,0" Focusable="False" IsTabStop="False"
                                                  Foreground="{StaticResource Bz.Track}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="8" Height="20" CornerRadius="2" Margin="0,0,3,3"
                                                        Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsWaiting}" Value="True">
                                    <Setter TargetName="Name" Property="Foreground" Value="{StaticResource Bz.Text2}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsChecking}" Value="True">
                                    <Setter TargetName="TickBar" Property="Foreground" Value="{StaticResource Bz.Line2}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter TargetName="TickBar" Property="Foreground" Value="{StaticResource Bz.Ink}"/>
                                </DataTrigger>
                                <!-- failed run: a dot instead of the ticks -->
                                <DataTrigger Binding="{Binding DataContext.IsFailed, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                    <Setter TargetName="TickBar" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsNotRun}" Value="True">
                                    <Setter TargetName="Name" Property="Foreground" Value="{StaticResource Bz.Text2}"/>
                                    <Setter TargetName="DotCore" Property="Fill" Value="Transparent"/>
                                    <Setter TargetName="DotCore" Property="Stroke" Value="{StaticResource Bz.Tone.Listed}"/>
                                    <Setter TargetName="DotCore" Property="StrokeThickness" Value="1.5"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsStopped}" Value="True">
                                    <Setter TargetName="DotCore" Property="Fill" Value="{StaticResource Bz.High}"/>
                                    <Setter TargetName="DotHalo" Property="Fill" Value="{StaticResource Bz.HighBg}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding BackendNote}" FontSize="12" Foreground="{StaticResource Bz.Text2}" TextWrapping="Wrap" Margin="0,16,0,0"
                           Style="{StaticResource OkOnly}"/>

                <!-- key: manual review collected so far (a person decides; not in the %) -->
                <Border Background="{StaticResource Bz.ManualBg}" CornerRadius="10" Padding="12,10,12,10" Margin="0,14,0,0" Style="{StaticResource OkOnly}">
                    <TextBlock FontSize="12" LineHeight="17" Foreground="{StaticResource Bz.Text}" TextWrapping="Wrap">
                        <Run Text="{Binding PendLive, Mode=OneWay}" FontWeight="Bold" FontFamily="{StaticResource Bz.Font.Mono}" Foreground="{StaticResource Bz.Manual}"/><Run Text=" "/><Run Text="{Binding LiveText, Mode=OneWay}"/>
                    </TextBlock>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- footer: the overall-result note while it runs; Back to start / Retry when it stopped -->
        <Border Grid.Row="2" BorderBrush="{StaticResource Bz.Line}" BorderThickness="0,1,0,0" Padding="16,14,16,14">
            <Grid>
                <TextBlock Text="{Binding NoOverall}" FontSize="12" Foreground="{StaticResource Bz.Text2}" TextWrapping="Wrap" Style="{StaticResource OkOnly}"/>
                <Grid Style="{StaticResource FailOnly}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="{Binding BackLabel}" Style="{StaticResource Bz.Btn.Ghost}" Height="36" Padding="14,0,14,0" FontSize="13" Click="Back_Click"/>
                    <Button Grid.Column="2" Style="{StaticResource Bz.Btn.Primary}" Height="36" Padding="14,0,14,0" FontSize="13" Click="Retry_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M13,8 A5,5 0 1 1 11.54,4.46 M13,2.5 L13,5 L10.5,5" Stroke="{StaticResource Bz.OnBrand}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding RetryLabel}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
