<UserControl x:Class="RevitWebAppSync.UI.Jkr.Panel.RunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Bz.Surface}" FontFamily="{DynamicResource Bz.Font.Sans}" Foreground="{DynamicResource Bz.Text}">
    <!-- Running (frames r-a, r-mid, r-done, r-fail). DataContext: Core.RunScreenModel.
         Not drawn in Direction C: it takes Setup's dark look (28 px round badges,
         10 px radius, hairlines, amber for what is happening now). -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevitWebAppSync;component/UI/Jkr/Panel/PanelTokens.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="B2V"/>

            <!-- spinner: 12 px ring, accent arc. No Storyboard (Storyboards crash Revit
                 dockable panes): each spinner registers on Loaded and RunView turns its own
                 RotateTransform on a DispatcherTimer. -->
            <Style x:Key="Spinner" TargetType="Grid">
                <Setter Property="Width" Value="12"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="14,18,14,20">
            <!-- head -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" LineHeight="25" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Border Grid.Column="1" Background="{StaticResource Bz.Sunken2}" BorderBrush="{StaticResource Bz.Line}" BorderThickness="1"
                        CornerRadius="6" Padding="8,3,8,4" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="{Binding LodDisc}" FontSize="11" FontFamily="{StaticResource Bz.Font.Mono}" Foreground="{StaticResource Bz.Text2}"/>
                </Border>
            </Grid>

            <!-- bar: 6 px, accent fill = sections done / 5 -->
            <Grid x:Name="BarTrack" Height="6" Margin="0,16,0,0">
                <Border Background="{StaticResource Bz.Track}" CornerRadius="3"/>
                <!-- scaled, never resized (transform-only motion) -->
                <Border x:Name="BarFill" Background="{StaticResource Bz.Brand}" CornerRadius="3" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform><ScaleTransform x:Name="BarScale" ScaleX="0"/></Border.RenderTransform>
                </Border>
            </Grid>

            <!-- sections: one list, 44 px rows with round letter badges -->
            <Border BorderBrush="{StaticResource Bz.Line}" BorderThickness="1" CornerRadius="10" Margin="0,16,0,0" ClipToBounds="True">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="RowBd" BorderBrush="{StaticResource Bz.LineSoft}" BorderThickness="0,0,0,1" Padding="12,0,12,0" Height="44">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="KeyBd" Width="28" Height="28" CornerRadius="14" Background="{StaticResource Bz.Sunken}"
                                            BorderBrush="{StaticResource Bz.Line2}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock x:Name="Key" Text="{Binding Key}" FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource Bz.Text2}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="Name" Grid.Column="1" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <Grid Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsDone, Converter={StaticResource B2V}}">
                                            <TextBlock Text="{Binding PctLabel}" FontSize="12" FontWeight="SemiBold" FontFamily="{StaticResource Bz.Font.Mono}"
                                                       Foreground="{StaticResource Bz.Text}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding PendLabel}" FontSize="11.5" Foreground="{StaticResource Bz.Manual}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            <Path Data="M4,12 L9,17 L20,6" Stroke="{StaticResource Bz.Tone.PassDot}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="12" Height="12" Stretch="Uniform" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsChecking, Converter={StaticResource B2V}}">
                                            <TextBlock Text="{Binding DataContext.CheckingLabel, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       FontSize="11.5" Foreground="{StaticResource Bz.Brand}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Grid Style="{StaticResource Spinner}" Margin="8,0,0,0" VerticalAlignment="Center" Loaded="Spinner_Loaded" Unloaded="Spinner_Unloaded">
                                                <Ellipse Stroke="{StaticResource Bz.Track}" StrokeThickness="2"/>
                                                <Path Data="M6,1 A5,5 0 0 1 11,6" Stroke="{StaticResource Bz.Brand}" StrokeThickness="2" StrokeStartLineCap="Round"/>
                                            </Grid>
                                        </StackPanel>
                                        <TextBlock Visibility="{Binding IsWaiting, Converter={StaticResource B2V}}" FontSize="11.5"
                                                   Foreground="{StaticResource Bz.Text3}" VerticalAlignment="Center"
                                                   Text="{Binding DataContext.WaitingLabel, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                        <TextBlock Visibility="{Binding IsFailed, Converter={StaticResource B2V}}" FontSize="11.5"
                                                   FontWeight="SemiBold" Foreground="{StaticResource Bz.HighText}" VerticalAlignment="Center"
                                                   Text="{Binding DataContext.FailReadLabel, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                    </Grid>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsWaiting}" Value="True">
                                    <Setter TargetName="Name" Property="Foreground" Value="{StaticResource Bz.Text3}"/>
                                    <Setter TargetName="Name" Property="FontWeight" Value="Normal"/>
                                    <Setter TargetName="KeyBd" Property="Background" Value="Transparent"/>
                                    <Setter TargetName="Key" Property="Foreground" Value="{StaticResource Bz.Text3}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsChecking}" Value="True">
                                    <Setter TargetName="RowBd" Property="Background" Value="{StaticResource Bz.Sunken2}"/>
                                    <Setter TargetName="KeyBd" Property="Background" Value="{StaticResource Bz.BrandSoft}"/>
                                    <Setter TargetName="KeyBd" Property="BorderBrush" Value="{StaticResource Bz.Brand}"/>
                                    <Setter TargetName="Key" Property="Foreground" Value="{StaticResource Bz.Brand}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter TargetName="KeyBd" Property="Background" Value="{StaticResource Bz.Sunken2}"/>
                                    <Setter TargetName="Key" Property="Foreground" Value="{StaticResource Bz.Text}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                    <Setter TargetName="KeyBd" Property="Background" Value="{StaticResource Bz.HighBg}"/>
                                    <Setter TargetName="KeyBd" Property="BorderBrush" Value="Transparent"/>
                                    <Setter TargetName="Key" Property="Foreground" Value="{StaticResource Bz.HighText}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- failure (r-fail): why, Retry, Back to start -->
            <Border Visibility="{Binding IsFailed, Converter={StaticResource B2V}}" Background="{StaticResource Bz.HighBg}"
                    CornerRadius="10" Padding="12,10,12,12" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="18" Foreground="{StaticResource Bz.Text}">
                        <Run Text="{Binding FailTitle, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Bz.HighText}"/><Run Text=" "/><Run Text="{Binding ErrorText, Mode=OneWay}"/>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="{Binding BackLabel}" Style="{StaticResource Bz.Btn.Ghost}" Height="32" Padding="12,0,12,0" Click="Back_Click" Margin="0,0,8,0"/>
                        <Button Content="{Binding RetryLabel}" Style="{StaticResource Bz.Btn.Primary}" Height="32" Padding="14,0,14,0" Click="Retry_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- live: n manual collected so far -->
            <Border Background="{StaticResource Bz.ManualBg}" CornerRadius="10" Padding="12,10,12,10" Margin="0,14,0,0">
                <TextBlock FontSize="12" LineHeight="17" Foreground="{StaticResource Bz.Text}" TextWrapping="Wrap">
                    <Run Text="{Binding PendLive, Mode=OneWay}" FontWeight="Bold" FontFamily="{StaticResource Bz.Font.Mono}" Foreground="{StaticResource Bz.Manual}"/><Run Text=" "/><Run Text="{Binding LiveText, Mode=OneWay}"/>
                </TextBlock>
            </Border>
            <TextBlock Text="{Binding NoOverall}" FontSize="11" LineHeight="16" Foreground="{StaticResource Bz.Text3}"
                       TextWrapping="Wrap" Margin="2,12,2,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
