<UserControl x:Class="RevitWebAppSync.UI.Jkr.Panel.JkrPaneShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFFFFF" FontFamily="Segoe UI" FontSize="13" Foreground="#161616"
             TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <!-- Pane shell (prototype aside.pane): .tb title bar, .ctx context bar, body.
         The body shows the audit screens, or "No model open" (flow s-nomodel), or
         the login-required state. Designed at 380 px, the pane's minimum width.
         Revit cannot fix a pane's width (and remembers each user's), so the
         shell fills whatever width the pane has instead of leaving a blank strip. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevitWebAppSync;component/UI/Jkr/Panel/PanelTokens.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="B2V"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="Frame" MinWidth="380" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="28"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- .tb -->
        <Border Grid.Row="0" Background="{StaticResource Bz.Chrome}" Padding="12,0,6,0">
            <Grid>
                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Bz.ChromeText}">
                    <Run Text="BINA" FontWeight="SemiBold" Foreground="#FFFFFF"/><Run Text=" · "/><Run Text="{Binding PanelTitle, Mode=OneWay}"/>
                </TextBlock>
                <Button x:Name="CloseBtn" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource Bz.ChromeIconButton}" Click="Close_Click"
                        ToolTip="{Binding CloseLabel}" AutomationProperties.Name="{Binding CloseLabel}">
                    <Path Data="M18,6 L6,18 M6,6 L18,18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="12" Height="12" Stretch="Uniform"/>
                </Button>
            </Grid>
        </Border>

        <!-- .ctx -->
        <Border Grid.Row="1" Background="{StaticResource Bz.Chrome2}" BorderBrush="{StaticResource Bz.Chrome}"
                BorderThickness="0,0,0,1" Padding="14,10,12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{Binding ProjectLabel}" FontSize="11" Foreground="{StaticResource Bz.ChromeMuted}"/>
                    <TextBlock x:Name="FileText" Text="{Binding FileLabel}" FontSize="11.5" Margin="0,1,0,0"
                               FontFamily="{StaticResource Bz.Font.Mono}" Foreground="{StaticResource Bz.ChromeStrong}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding FileLabel}"/>
                </StackPanel>
                <!-- .seg BM / EN -->
                <Border Grid.Column="1" Background="{StaticResource Bz.Chrome}" CornerRadius="5" Padding="2"
                        VerticalAlignment="Center" AutomationProperties.Name="Language">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="BmBtn" GroupName="PaneLang" Content="BM" Style="{StaticResource Bz.SegButton}"
                                     IsChecked="{Binding IsBm, Mode=TwoWay}" Margin="0,0,2,0"/>
                        <RadioButton x:Name="EnBtn" GroupName="PaneLang" Content="EN" Style="{StaticResource Bz.SegButton}"
                                     IsChecked="{Binding IsEn, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- body -->
        <Grid Grid.Row="2">
            <!-- The existing panel stays loaded (it owns the scan, the issue statuses,
                 the Revit writes and the audit file) but is never shown: the Binazone
                 screens below are the view. -->
            <ContentPresenter x:Name="EngineHost" Visibility="Collapsed"/>
            <ContentPresenter x:Name="ContentHost" Visibility="{Binding ShowContent, Converter={StaticResource B2V}}"/>

            <!-- No model open (flow s-nomodel) -->
            <StackPanel x:Name="NoModelView" Visibility="{Binding ShowNoModel, Converter={StaticResource B2V}}"
                        Margin="24,64,24,0" HorizontalAlignment="Center">
                <Path Data="M12,2 L21,7 L21,17 L12,22 L3,17 L3,7 Z M3,7 L12,12 L21,7 M12,12 L12,22"
                      Stroke="{StaticResource Bz.Text3}" StrokeThickness="1.75" StrokeLineJoin="Round"
                      Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding NoModelTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,14,0,0"
                           HorizontalAlignment="Center" Foreground="{StaticResource Bz.Text}"/>
                <TextBlock Text="{Binding NoModelText}" FontSize="12.5" LineHeight="19" Margin="0,8,0,0"
                           TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Bz.Text2}"/>
            </StackPanel>

            <!-- Login required (kept from the old pane, in the prototype's tokens) -->
            <StackPanel x:Name="LoginView" Visibility="{Binding ShowLogin, Converter={StaticResource B2V}}"
                        Margin="24,64,24,0" HorizontalAlignment="Center">
                <Path Data="M6,11 L18,11 L18,21 L6,21 Z M8,11 L8,7 A4,4 0 0 1 16,7 L16,11"
                      Stroke="{StaticResource Bz.Text3}" StrokeThickness="1.75" StrokeLineJoin="Round"
                      Width="22" Height="26" Stretch="Uniform" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding LoginTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,14,0,0"
                           HorizontalAlignment="Center" Foreground="{StaticResource Bz.Text}"/>
                <Border Background="{StaticResource Bz.BrandTint}" CornerRadius="5" Padding="10,8,10,8" Margin="0,10,0,0">
                    <TextBlock Text="{Binding LoginText}" FontSize="11.5" LineHeight="17" TextWrapping="Wrap"
                               Foreground="{StaticResource Bz.Text2}"/>
                </Border>
                <Button x:Name="RetryBtn" Content="{Binding LoginRetry}" Style="{StaticResource Bz.Btn.Primary}"
                        HorizontalAlignment="Center" Margin="0,14,0,0" Click="Retry_Click"/>
            </StackPanel>
        </Grid>

        <!-- .toast: bottom centre, dark; Undo in brand yellow when offered -->
        <Border x:Name="ToastBox" Grid.Row="2" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="16,0,16,24" Background="#0F0F0F" CornerRadius="6" Padding="14,10,14,10">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="10" Direction="270" Opacity="0.35"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastText" Foreground="#FFFFFF" FontSize="12.5" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="300" AutomationProperties.LiveSetting="Polite"/>
                <Button x:Name="ToastUndo" Margin="14,0,0,0" Cursor="Hand" Click="ToastUndo_Click" VerticalAlignment="Center"
                        FocusVisualStyle="{StaticResource Bz.FocusRing}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" Padding="2,2,2,2">
                                <TextBlock x:Name="T" Text="{Binding UndoLabel}" Foreground="#F2C200" FontWeight="Bold" FontSize="12.5"
                                           TextDecorations="Underline"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>

        <!-- prototype .pane border-left -->
        <Border Grid.RowSpan="3" BorderBrush="{StaticResource Bz.Chrome}" BorderThickness="1,0,0,0" IsHitTestVisible="False"/>
    </Grid>
</UserControl>
