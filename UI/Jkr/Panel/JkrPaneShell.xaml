<UserControl x:Class="RevitWebAppSync.UI.Jkr.Panel.JkrPaneShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Bz.Surface}" FontFamily="{DynamicResource Bz.Font.Sans}" FontSize="13" Foreground="{DynamicResource Bz.Text}"
             TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!-- Pane shell: title bar, context bar, body. The body shows the audit screens,
         or "No model open", or the login-required state. Designed at 380 px, the
         pane's minimum width; the shell fills whatever width the pane has.
         Look: the product's Copilot pane (white, hairlines, Inter, blue accent). -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevitWebAppSync;component/UI/Jkr/Panel/PanelTokens.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="B2V"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="Frame" MinWidth="380" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar: brand mark · product name · close -->
        <Border Grid.Row="0" Background="{StaticResource Bz.Chrome}" BorderBrush="{StaticResource Bz.LineSoft}" BorderThickness="0,0,0,1" Padding="14,0,8,0" Height="42">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="16" Height="16" CornerRadius="4" Background="{StaticResource Cp.LogoGrad}" RenderTransformOrigin="0.5,0.5" Margin="0,0,10,0">
                        <Border.RenderTransform><RotateTransform Angle="45"/></Border.RenderTransform>
                    </Border>
                    <TextBlock VerticalAlignment="Center" FontSize="12.5">
                        <Run Text="{Binding PanelTitle, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Bz.ChromeStrong}"/><Run Text="  ·  " Foreground="{StaticResource Bz.LineSoft}"/><Run Text="BINA" Foreground="{StaticResource Bz.ChromeMuted}"/>
                    </TextBlock>
                </StackPanel>
                <Button x:Name="CloseBtn" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource Bz.ChromeIconButton}" Click="Close_Click"
                        ToolTip="{Binding CloseLabel}" AutomationProperties.Name="{Binding CloseLabel}">
                    <Path Data="M18,6 L6,18 M6,6 L18,18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="11" Height="11" Stretch="Uniform"/>
                </Button>
            </Grid>
        </Border>

        <!-- Context bar: project label + file (mono), the BM / EN switch -->
        <Border Grid.Row="1" Background="{StaticResource Bz.Chrome2}" BorderBrush="{StaticResource Bz.Line}"
                BorderThickness="0,0,0,1" Padding="14,8,10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{Binding ProjectLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Bz.ChromeMuted}"/>
                    <TextBlock x:Name="FileText" Text="{Binding FileLabel}" FontSize="11.5" Margin="0,2,0,0"
                               FontFamily="{StaticResource Bz.Font.Mono}" Foreground="{StaticResource Bz.ChromeStrong}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding FileLabel}"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource Bz.Sunken2}" CornerRadius="8" Padding="2"
                        VerticalAlignment="Center" AutomationProperties.Name="Language">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="BmBtn" GroupName="PaneLang" Content="BM" Style="{StaticResource Bz.SegButton}"
                                     IsChecked="{Binding IsBm, Mode=TwoWay}" Margin="0,0,2,0"/>
                        <RadioButton x:Name="EnBtn" GroupName="PaneLang" Content="EN" Style="{StaticResource Bz.SegButton}"
                                     IsChecked="{Binding IsEn, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- body -->
        <Grid Grid.Row="2">
            <!-- The existing panel stays loaded (it owns the scan, the issue statuses,
                 the Revit writes and the audit file) but is never shown: the screens
                 below are the view. -->
            <ContentPresenter x:Name="EngineHost" Visibility="Collapsed"/>
            <ContentPresenter x:Name="ContentHost" Visibility="{Binding ShowContent, Converter={StaticResource B2V}}"/>

            <!-- No model open -->
            <StackPanel x:Name="NoModelView" Visibility="{Binding ShowNoModel, Converter={StaticResource B2V}}"
                        Margin="28,72,28,0" HorizontalAlignment="Center" MaxWidth="320">
                <Border Width="48" Height="48" CornerRadius="14" Background="{StaticResource Bz.Sunken2}" HorizontalAlignment="Center">
                    <Path Data="M12,2 L21,7 L21,17 L12,22 L3,17 L3,7 Z M3,7 L12,12 L21,7 M12,12 L12,22"
                          Stroke="{StaticResource Bz.Text3}" StrokeThickness="1.6" StrokeLineJoin="Round"
                          Width="22" Height="22" Stretch="Uniform"/>
                </Border>
                <TextBlock Text="{Binding NoModelTitle}" FontSize="14.5" FontWeight="SemiBold" Margin="0,16,0,0"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Bz.Text}"/>
                <TextBlock Text="{Binding NoModelText}" FontSize="12.5" LineHeight="19" Margin="0,6,0,0"
                           TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Bz.Text2}"/>
            </StackPanel>

            <!-- Login required -->
            <StackPanel x:Name="LoginView" Visibility="{Binding ShowLogin, Converter={StaticResource B2V}}"
                        Margin="28,72,28,0" HorizontalAlignment="Center" MaxWidth="320">
                <Border Width="48" Height="48" CornerRadius="14" Background="{StaticResource Bz.Sunken2}" HorizontalAlignment="Center">
                    <Path Data="M6,11 L18,11 L18,21 L6,21 Z M8,11 L8,7 A4,4 0 0 1 16,7 L16,11"
                          Stroke="{StaticResource Bz.Text3}" StrokeThickness="1.6" StrokeLineJoin="Round"
                          Width="18" Height="22" Stretch="Uniform"/>
                </Border>
                <TextBlock Text="{Binding LoginTitle}" FontSize="14.5" FontWeight="SemiBold" Margin="0,16,0,0"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Bz.Text}"/>
                <Border Background="{StaticResource Bz.BrandTint}" BorderBrush="{StaticResource Bz.BrandTintLine}" BorderThickness="1" CornerRadius="8" Padding="12,9,12,9" Margin="0,12,0,0">
                    <TextBlock Text="{Binding LoginText}" FontSize="12" LineHeight="18" TextWrapping="Wrap"
                               Foreground="{StaticResource Bz.BrandTintText}"/>
                </Border>
                <Button x:Name="RetryBtn" Content="{Binding LoginRetry}" Style="{StaticResource Bz.Btn.Primary}"
                        HorizontalAlignment="Center" Margin="0,16,0,0" Padding="16,8,16,8" Click="Retry_Click"/>
            </StackPanel>
        </Grid>

        <!-- Toast: bottom centre, ink; Undo when offered -->
        <Border x:Name="ToastBox" Grid.Row="2" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="16,0,16,20" Background="{StaticResource Bz.Ink}" CornerRadius="9" Padding="14,10,14,10">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.28"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastText" Foreground="#FFFFFF" FontSize="12.5" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="300" AutomationProperties.LiveSetting="Polite"/>
                <Button x:Name="ToastUndo" Margin="14,0,0,0" Cursor="Hand" Click="ToastUndo_Click" VerticalAlignment="Center"
                        FocusVisualStyle="{StaticResource Bz.FocusRing}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#1FFFFFFF" CornerRadius="6" Padding="8,3,8,4">
                                <TextBlock x:Name="T" Text="{Binding UndoLabel}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>

        <!-- pane edge -->
        <Border Grid.RowSpan="3" BorderBrush="{StaticResource Bz.Line}" BorderThickness="1,0,0,0" IsHitTestVisible="False"/>
    </Grid>
</UserControl>
