<UserControl x:Class="RevitWebAppSync.UI.Jkr.Panel.JkrPaneShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Bz.Surface}" FontFamily="{DynamicResource Bz.Font.Sans}" FontSize="13" Foreground="{DynamicResource Bz.Text}"
             TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!-- Pane shell: top bar, context bar, body. The body shows the audit screens,
         or "No model open", or the login-required state. Designed at 380 px, the
         pane's minimum width; the shell fills whatever width the pane has.
         Look: Direction C of the JKR design canvas (the Setup / Cockpit top bar), always dark. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevitWebAppSync;component/UI/Jkr/Panel/PanelTokens.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="B2V"/>

            <!-- BM / EN half: 28 px; the active half light with dark text (Setup's language group) -->
            <Style x:Key="LangSeg" TargetType="ToggleButton">
                <Setter Property="Foreground" Value="{StaticResource Bz.Text2}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="MinWidth" Value="34"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource Bz.FocusRing}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="8,0,8,0" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Bz.Text}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bz.Text}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Bz.Sunken}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="Frame" MinWidth="380" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar, 44 px: brand diamond, product name, close -->
        <Border Grid.Row="0" Background="{StaticResource Bz.Chrome}" BorderBrush="{StaticResource Bz.Line}" BorderThickness="0,0,0,1" Padding="14,0,8,0" Height="44">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="12" Height="12" CornerRadius="3" Background="{StaticResource Bz.Brand}" RenderTransformOrigin="0.5,0.5"
                        VerticalAlignment="Center" Margin="2,0,12,0">
                    <Border.RenderTransform><RotateTransform Angle="45"/></Border.RenderTransform>
                </Border>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12.5" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding PanelTitle, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Bz.ChromeStrong}"/><Run Text=" BINA" Foreground="{StaticResource Bz.Text3}"/>
                </TextBlock>
                <Button x:Name="CloseBtn" Grid.Column="2" VerticalAlignment="Center"
                        Style="{StaticResource Bz.ChromeIconButton}" Click="Close_Click"
                        ToolTip="{Binding CloseLabel}" AutomationProperties.Name="{Binding CloseLabel}">
                    <Path Data="M18,6 L6,18 M6,6 L18,18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="11" Height="11" Stretch="Uniform"/>
                </Button>
            </Grid>
        </Border>

        <!-- Context bar: project label, the file (mono), the BM / EN switch -->
        <Border Grid.Row="1" Background="{StaticResource Bz.Chrome}" BorderBrush="{StaticResource Bz.Line}"
                BorderThickness="0,0,0,1" Padding="14,6,10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding ProjectLabel}" FontSize="11" Foreground="{StaticResource Bz.Text3}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="FileText" Grid.Column="1" Text="{Binding FileLabel}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,10,0"
                           FontFamily="{StaticResource Bz.Font.Mono}" Foreground="{StaticResource Bz.Text}"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding FileLabel}"/>
                <Border Grid.Column="2" Background="{StaticResource Bz.Sunken}" BorderBrush="{StaticResource Bz.Line}" BorderThickness="1"
                        CornerRadius="7" Padding="2" VerticalAlignment="Center" AutomationProperties.Name="Language">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="BmBtn" GroupName="PaneLang" Content="BM" Style="{StaticResource LangSeg}"
                                     IsChecked="{Binding IsBm, Mode=TwoWay}" Margin="0,0,2,0"/>
                        <RadioButton x:Name="EnBtn" GroupName="PaneLang" Content="EN" Style="{StaticResource LangSeg}"
                                     IsChecked="{Binding IsEn, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- body -->
        <Grid Grid.Row="2">
            <!-- The existing panel stays loaded (it owns the scan, the issue statuses,
                 the Revit writes and the audit file) but is never shown: the screens
                 below are the view. -->
            <ContentPresenter x:Name="EngineHost" Visibility="Collapsed"/>
            <ContentPresenter x:Name="ContentHost" Visibility="{Binding ShowContent, Converter={StaticResource B2V}}"/>

            <!-- No model open: centred icon tile, title, text -->
            <StackPanel x:Name="NoModelView" Visibility="{Binding ShowNoModel, Converter={StaticResource B2V}}"
                        Margin="28,0,28,48" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320">
                <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource Bz.Sunken2}"
                        BorderBrush="{StaticResource Bz.Line}" BorderThickness="1" HorizontalAlignment="Center">
                    <Path Data="M12,2 L21,7 L21,17 L12,22 L3,17 L3,7 Z M3,7 L12,12 L21,7 M12,12 L12,22"
                          Stroke="{StaticResource Bz.Text2}" StrokeThickness="1.6" StrokeLineJoin="Round"
                          Width="22" Height="22" Stretch="Uniform"/>
                </Border>
                <TextBlock Text="{Binding NoModelTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,0"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Bz.Text}"/>
                <TextBlock Text="{Binding NoModelText}" FontSize="12.5" LineHeight="19" Margin="0,6,0,0"
                           TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Bz.Text2}"/>
            </StackPanel>

            <!-- Login required: centred icon tile, title, info note, Retry (amber primary) -->
            <StackPanel x:Name="LoginView" Visibility="{Binding ShowLogin, Converter={StaticResource B2V}}"
                        Margin="28,0,28,48" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320">
                <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource Bz.Sunken2}"
                        BorderBrush="{StaticResource Bz.Line}" BorderThickness="1" HorizontalAlignment="Center">
                    <Path Data="M6,11 L18,11 L18,21 L6,21 Z M8,11 L8,7 A4,4 0 0 1 16,7 L16,11"
                          Stroke="{StaticResource Bz.Text2}" StrokeThickness="1.6" StrokeLineJoin="Round"
                          Width="18" Height="22" Stretch="Uniform"/>
                </Border>
                <TextBlock Text="{Binding LoginTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,0"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Bz.Text}"/>
                <Border Background="{StaticResource Bz.BrandTint}" BorderBrush="{StaticResource Bz.BrandTintLine}" BorderThickness="1" CornerRadius="8" Padding="12,9,12,9" Margin="0,12,0,0">
                    <TextBlock Text="{Binding LoginText}" FontSize="12" LineHeight="18" TextWrapping="Wrap"
                               Foreground="{StaticResource Bz.BrandTintText}"/>
                </Border>
                <Button x:Name="RetryBtn" Content="{Binding LoginRetry}" Style="{StaticResource Bz.Btn.Primary}"
                        HorizontalAlignment="Center" Margin="0,16,0,0" Padding="18,0,18,0" Height="36" FontSize="12.5" Click="Retry_Click"/>
            </StackPanel>
        </Grid>

        <!-- Toast: bottom centre, raised dark with a hairline; Undo as an amber text button when offered -->
        <Border x:Name="ToastBox" Grid.Row="2" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="16,0,16,20" Background="{StaticResource Bz.Sunken2}" BorderBrush="{StaticResource Bz.Line2}" BorderThickness="1"
                CornerRadius="9" Padding="14,6,8,6">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.55"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastText" Foreground="{StaticResource Bz.Text}" FontSize="12.5" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="290" Margin="0,4,6,4" AutomationProperties.LiveSetting="Polite"/>
                <Button x:Name="ToastUndo" Margin="6,0,0,0" Cursor="Hand" Click="ToastUndo_Click" VerticalAlignment="Center"
                        FocusVisualStyle="{StaticResource Bz.FocusRing}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,0,8,0" MinHeight="28">
                                <TextBlock x:Name="T" Text="{Binding UndoLabel}" Foreground="{StaticResource Bz.Brand}" FontWeight="SemiBold" FontSize="12"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bz.Hover}"/>
                                    <Setter TargetName="T" Property="Foreground" Value="{StaticResource Bz.BrandHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>

        <!-- pane edge -->
        <Border Grid.RowSpan="3" BorderBrush="{StaticResource Bz.Line}" BorderThickness="1,0,0,0" IsHitTestVisible="False"/>
    </Grid>
</UserControl>
