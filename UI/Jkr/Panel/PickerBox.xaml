<UserControl x:Class="RevitWebAppSync.UI.Jkr.Panel.PickerBox" x:Name="Self"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The multi-valid-code picker (AI-434): a dropdown of the valid codes, with the "AI suggested" badge
         while it sits on the AI's code and the AI's reason as its tooltip. One control for the docked pane
         row (FixerRow) and the Confirm dialog; the host binds Options / Selected / ShowBadge / BadgeText / Tip. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevitWebAppSync;component/UI/Jkr/Panel/PanelTokens.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="B2V"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="Root">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ComboBox x:Name="Pick" Style="{StaticResource Bz.Select}" MinHeight="32" FontSize="13"
                  ItemsSource="{Binding Options, ElementName=Self}" SelectedItem="{Binding Selected, ElementName=Self, Mode=TwoWay}"
                  ToolTip="{Binding Tip, ElementName=Self}"/>
        <Border Grid.Column="1" Margin="8,0,0,0" Padding="8,3,8,3" CornerRadius="10" VerticalAlignment="Center"
                Background="{StaticResource Bz.Tone.PassBg}" ToolTip="{Binding Tip, ElementName=Self}"
                Visibility="{Binding ShowBadge, ElementName=Self, Converter={StaticResource B2V}}">
            <TextBlock Text="{Binding BadgeText, ElementName=Self}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Bz.Tone.PassMark}"/>
        </Border>
    </Grid>
</UserControl>
