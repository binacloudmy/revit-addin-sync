<UserControl x:Class="RevitWebAppSync.UI.Jkr.Panel.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFFFFF" FontFamily="Segoe UI" Foreground="#161616" Focusable="True">
    <!-- Results (prototype isResults; frames t-results, t-section, t-search,
         t-manual, t-empty, t-stale). DataContext: Core.ResultsScreenModel. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevitWebAppSync;component/UI/Jkr/Panel/PanelTokens.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="B2V"/>

            <!-- Chromeless button whose template is its content (rows, tiles, tabs, chips) -->
            <Style x:Key="Bare" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource Bz.FocusRing}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- .btn-d (Export) -->
            <Style x:Key="BtnDark" TargetType="Button" BasedOn="{StaticResource Bz.Btn.Primary}">
                <Setter Property="Background" Value="#0F0F0F"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#2B2E33"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Background" Value="#EDEDEA"/>
                                    <Setter Property="Foreground" Value="#8A8D93"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Checklist state chip / text / bar colours, from the row's Tone -->
            <Style x:Key="ChipBd" TargetType="Border">
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="6,1,6,2"/>
                <Setter Property="MinWidth" Value="58"/>
                <Setter Property="Background" Value="#F5F5F3"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tone}" Value="fail"><Setter Property="Background" Value="#FDECEC"/></DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="pass"><Setter Property="Background" Value="#E6F3EA"/></DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="partial"><Setter Property="Background" Value="#FDF3E2"/></DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="person"><Setter Property="Background" Value="{StaticResource Bz.ManualBg}"/></DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ToneFg" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#8A8D93"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tone}" Value="fail"><Setter Property="Foreground" Value="#B42F2F"/></DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="pass"><Setter Property="Foreground" Value="#2E7D4F"/></DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="partial"><Setter Property="Foreground" Value="#B83D0B"/></DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="person"><Setter Property="Foreground" Value="#4A4EB0"/></DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="listed"><Setter Property="Foreground" Value="#4B4F57"/></DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ToneBar" TargetType="Border">
                <Setter Property="Background" Value="#E7E6E2"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tone}" Value="fail"><Setter Property="Background" Value="#C23B3B"/></DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="pass"><Setter Property="Background" Value="#2E7D4F"/></DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="partial"><Setter Property="Background" Value="#EA580C"/></DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="person"><Setter Property="Background" Value="#4A4EB0"/></DataTrigger>
                </Style.Triggers>
            </Style>
            <!-- Checks the run has no rule for are dimmed: the eye lands on verdicts. -->
            <Style x:Key="CheckGrid" TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tone}" Value="none"><Setter Property="Opacity" Value="0.6"/></DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="Icon" TargetType="Path">
                <Setter Property="Width" Value="13"/>
                <Setter Property="Height" Value="13"/>
                <Setter Property="Stretch" Value="Uniform"/>
                <Setter Property="StrokeThickness" Value="2"/>
                <Setter Property="StrokeStartLineCap" Value="Round"/>
                <Setter Property="StrokeEndLineCap" Value="Round"/>
                <Setter Property="StrokeLineJoin" Value="Round"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- .tools -->
            <RowDefinition Height="Auto"/>  <!-- .stale -->
            <RowDefinition Height="Auto"/>  <!-- .sum -->
            <RowDefinition Height="Auto"/>  <!-- .lt -->
            <RowDefinition Height="Auto"/>  <!-- busy -->
            <RowDefinition Height="*"/>     <!-- .list -->
            <RowDefinition Height="Auto"/>  <!-- .foot -->
        </Grid.RowDefinitions>

        <!-- .tools: LOD / Disc. / Re-scan -->
        <Border Grid.Row="0" Background="{StaticResource Bz.Sunken}" BorderBrush="{StaticResource Bz.Line}" BorderThickness="0,0,0,1" Padding="12,8,12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="LOD" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Bz.Text3}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox Grid.Column="1" Style="{StaticResource Bz.Select}" FontSize="12" MinWidth="62" Margin="0,0,6,0"
                          ItemsSource="{Binding LodOptions}" DisplayMemberPath="Value" SelectedValuePath="Value"
                          SelectedValue="{Binding LodValue, Mode=TwoWay}" AutomationProperties.Name="LOD"/>
                <TextBlock Grid.Column="2" Text="{Binding DiscShortLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Bz.Text3}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox Grid.Column="3" Style="{StaticResource Bz.Select}" FontSize="12" Margin="0,0,6,0"
                          ItemsSource="{Binding DiscOptions}" ItemTemplate="{StaticResource Bz.OptionLabel}" SelectedValuePath="Value"
                          SelectedValue="{Binding DiscValue, Mode=TwoWay}" AutomationProperties.Name="{Binding DiscShortLabel}"/>
                <Button Grid.Column="4" Style="{StaticResource Bz.Btn.Ghost}" Click="Rescan_Click" IsEnabled="{Binding CanAct}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon}" Stroke="{StaticResource Bz.TextBody}"
                              Data="M3,12 A9,9 0 1 0 12,3 A9.75,9.75 0 0 0 5.26,5.74 L3,8 M3,3 L3,8 L8,8"/>
                        <TextBlock Text="{Binding RescanLabel}" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- .stale: LOD changed since the run -->
        <Border Grid.Row="1" Background="{StaticResource Bz.BrandTint}" BorderBrush="#F0E3A8" BorderThickness="0,0,0,1" Padding="12,7,12,7"
                Visibility="{Binding LodChanged, Converter={StaticResource B2V}}">
            <TextBlock Text="{Binding LodChangedText}" FontSize="11.5" Foreground="{StaticResource Bz.BrandTintText}" TextWrapping="Wrap"/>
        </Border>

        <!-- .sum -->
        <Border Grid.Row="2" BorderBrush="{StaticResource Bz.Line}" BorderThickness="0,0,0,1" Padding="16,14,16,12">
            <StackPanel>
                <!-- Spec verdict: does the model comply with the JKR Model Audit spec? -->
                <StackPanel Margin="0,0,0,12" Visibility="{Binding HasSpec, Converter={StaticResource B2V}}">
                    <TextBlock Text="{Binding VerdictTitle}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#161616"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VerdictTone}" Value="fail"><Setter Property="Foreground" Value="#B42F2F"/></DataTrigger>
                                    <DataTrigger Binding="{Binding VerdictTone}" Value="pass"><Setter Property="Foreground" Value="#2E7D4F"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding VerdictText}" FontSize="11.5" LineHeight="16" Foreground="{StaticResource Bz.Text3}"
                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
                <!-- .sum-top -->
                <Grid>
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom">
                        <TextBlock>
                            <Run Text="{Binding HeadPctLabel, Mode=OneWay}" FontSize="26" FontWeight="SemiBold"/><Run Text=" "/><Run Text="{Binding CompliantLabel, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Bz.Text2}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding HeadCellsLabel}" FontSize="11.5" Foreground="{StaticResource Bz.Text3}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource Bare}" Click="GoManual_Click">
                        <Border Background="{StaticResource Bz.ManualBg}" CornerRadius="5" Padding="10,6,8,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#3F43A0">
                                    <Run Text="{Binding PendTotal, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding NeedPersonLabel, Mode=OneWay}"/>
                                </TextBlock>
                                <Path Style="{StaticResource Icon}" Width="10" Height="10" Margin="5,0,0,0" Stroke="#3F43A0" Data="M9,18 L15,12 L9,6"/>
                            </StackPanel>
                        </Border>
                    </Button>
                </Grid>

                <!-- .secs: five tiles, also the section filter -->
                <Border BorderBrush="{StaticResource Bz.Line}" BorderThickness="1" CornerRadius="6" Margin="0,12,0,0" ClipToBounds="True">
                    <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button x:Name="Tile" Style="{StaticResource Bare}" Tag="{Binding Key}" Click="Section_Click"
                                        AutomationProperties.Name="{Binding Aria}" Background="#FFFFFF">
                                    <Border x:Name="TileBd" BorderBrush="{StaticResource Bz.Line}" BorderThickness="0,0,1,0" Padding="8,7,8,8">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock x:Name="K" Text="{Binding Key}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Bz.Text3}"/>
                                                <TextBlock x:Name="P" Text="{Binding PendLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Bz.Manual}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <TextBlock x:Name="Pct" Text="{Binding PctLabel}" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                            <Grid x:Name="BarG" Height="3" Margin="0,4,0,0">
                                                <Border x:Name="Track" Background="#EDEDEA" CornerRadius="2"/>
                                                <Border Background="{StaticResource Bz.Brand}" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="{Binding Fraction}"/>
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsOn}" Value="True">
                                        <Setter TargetName="Tile" Property="Background" Value="#0F0F0F"/>
                                        <Setter TargetName="K" Property="Foreground" Value="#C7CDD8"/>
                                        <Setter TargetName="P" Property="Foreground" Value="#B9BBF5"/>
                                        <Setter TargetName="Pct" Property="Foreground" Value="#FFFFFF"/>
                                        <Setter TargetName="Track" Property="Background" Value="#3A3F48"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- .prog -->
                <Grid Margin="0,12,0,0">
                    <TextBlock FontSize="12" Foreground="{StaticResource Bz.Text2}" HorizontalAlignment="Left">
                        <Run Text="{Binding ResolvedN, Mode=OneWay}" FontWeight="SemiBold" Foreground="#161616"/><Run Text="{Binding ProgressRest, Mode=OneWay}"/>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding SevChips}" HorizontalAlignment="Right">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                    <Ellipse Width="6" Height="6" Fill="{Binding Color}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock FontSize="11" Foreground="{StaticResource Bz.Text2}">
                                        <Run Text="{Binding N, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Label, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
                <Grid Height="4" Margin="0,6,0,0">
                    <Border Background="#EDEDEA" CornerRadius="2"/>
                    <Border Background="{StaticResource Bz.Brand}" CornerRadius="2" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding ProgFraction}"/>
                        </Border.RenderTransform>
                    </Border>
                </Grid>

                <!-- .acts -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="{Binding IgnoreAllLabel}" Style="{StaticResource Bz.Btn.Ghost}" Click="IgnoreAll_Click"
                            IsEnabled="{Binding CanAct}" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource Bz.Btn.Primary}" Click="FixAll_Click" IsEnabled="{Binding CanFixAll}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M13,2 L3,14 L12,14 L11,22 L21,10 L12,10 Z"/>
                            <TextBlock Text="{Binding FixAllLabel}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- .lt: search, section pill, tabs -->
        <Border Grid.Row="3" BorderBrush="{StaticResource Bz.Line}" BorderThickness="0,0,0,1" Padding="12,10,12,0">
            <StackPanel>
                <Border x:Name="SearchBox" Height="30" Visibility="{Binding ShowList, Converter={StaticResource B2V}}" BorderBrush="{StaticResource Bz.Line2}" BorderThickness="1" CornerRadius="5" Padding="10,0,8,0" Background="#FFFFFF">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Path Style="{StaticResource Icon}" Stroke="{StaticResource Bz.Text3}" Data="M11,4 A7,7 0 1 1 11,18 A7,7 0 1 1 11,4 M21,21 L16.65,16.65"/>
                        <TextBox x:Name="SearchInput" Grid.Column="1" BorderThickness="0" Background="Transparent" FontSize="12.5"
                                 VerticalContentAlignment="Center" Margin="8,0,8,0"
                                 Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{Binding SearchPlaceholder}"
                                 GotKeyboardFocus="Search_Focus" LostKeyboardFocus="Search_Blur"/>
                        <TextBlock Grid.Column="1" Text="{Binding SearchPlaceholder}" FontSize="12.5" Foreground="{StaticResource Bz.Text3}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" x:Name="SearchHint"/>
                        <Border Grid.Column="2" BorderBrush="{StaticResource Bz.Line2}" BorderThickness="1" CornerRadius="3" Padding="5,0,5,0" VerticalAlignment="Center">
                            <TextBlock Text="/" FontFamily="{StaticResource Bz.Font.Mono}" FontSize="11" Foreground="{StaticResource Bz.Text3}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- .pill: active section filter -->
                <Button HorizontalAlignment="Left" Margin="0,8,0,0" Style="{StaticResource Bare}" Click="ClearCat_Click"
                        Visibility="{Binding HasCat, Converter={StaticResource B2V}}" AutomationProperties.Name="{Binding ClearCatLabel}">
                    <Border Background="#0F0F0F" CornerRadius="4" Padding="8,3,6,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CatLabel}" FontSize="11.5" Foreground="#FFFFFF"/>
                            <Path Style="{StaticResource Icon}" Width="9" Height="9" Margin="6,0,0,0" Stroke="#FFFFFF" Data="M18,6 L6,18 M6,6 L18,18"/>
                        </StackPanel>
                    </Border>
                </Button>

                <!-- .tabs + "n shown" -->
                <Grid Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Style="{StaticResource Bare}" Click="Checklist_Click" Margin="0,0,2,0"
                            Visibility="{Binding HasSpec, Converter={StaticResource B2V}}">
                        <Border BorderThickness="0,0,0,2" Padding="7,6,7,7">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowChecklist}" Value="True"><Setter Property="BorderBrush" Value="#0F0F0F"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ChecklistTabLabel}" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Bz.Text3}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowChecklist}" Value="True">
                                                <Setter Property="Foreground" Value="#161616"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Button>
                    <ItemsControl ItemsSource="{Binding Tabs}" HorizontalAlignment="Left">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Bare}" Tag="{Binding Tab}" Click="Tab_Click" Margin="0,0,2,0">
                                    <Border x:Name="Ul" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="7,6,7,7">
                                        <TextBlock x:Name="L" FontSize="12" Foreground="{StaticResource Bz.Text3}">
                                            <Run Text="{Binding Label, Mode=OneWay}"/><Run Text=" "/><Run x:Name="N" Text="{Binding N, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="#8A8D93"/>
                                        </TextBlock>
                                    </Border>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsOn}" Value="True">
                                        <Setter TargetName="Ul" Property="BorderBrush" Value="#0F0F0F"/>
                                        <Setter TargetName="L" Property="Foreground" Value="#161616"/>
                                        <Setter TargetName="L" Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                    <TextBlock Text="{Binding ShownLabel}" FontSize="11" Foreground="{StaticResource Bz.Text3}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,2"
                               Visibility="{Binding ShowList, Converter={StaticResource B2V}}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- busy: a fix batch is being written -->
        <Border Grid.Row="4" Background="{StaticResource Bz.BrandTint}" Padding="12,7,12,7"
                Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
            <TextBlock Text="{Binding BusyText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Bz.BrandTintText}"/>
        </Border>

        <!-- .list -->
        <ScrollViewer x:Name="ListScroll" Grid.Row="5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding ShowList, Converter={StaticResource B2V}}">
            <StackPanel>
                <Border Background="{StaticResource Bz.ManualBg}" BorderBrush="#E5E5F6" BorderThickness="0,0,0,1" Padding="12,8,12,8"
                        Visibility="{Binding IsManualTab, Converter={StaticResource B2V}}">
                    <TextBlock Text="{Binding ManualIntro}" FontSize="11.5" LineHeight="17" Foreground="#3F43A0" TextWrapping="Wrap"/>
                </Border>

                <ItemsControl x:Name="RowsList" ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="RowBd" Background="#FFFFFF" BorderBrush="#EFEEEA" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- .rm -->
                                    <Button Style="{StaticResource Bare}" Tag="{Binding Id}" Click="Row_Click" Padding="12,10,8,10"
                                            AutomationProperties.Name="{Binding Title}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Row}" FontFamily="{StaticResource Bz.Font.Mono}" FontSize="11"
                                                       Foreground="{StaticResource Bz.Text3}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock x:Name="Title" Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" LineHeight="17" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Diff}" FontFamily="{StaticResource Bz.Font.Mono}" FontSize="11" LineHeight="16"
                                                           Foreground="{StaticResource Bz.TextBody}" TextWrapping="Wrap" Margin="0,3,0,0"
                                                           Visibility="{Binding HasDiff, Converter={StaticResource B2V}}"/>
                                                <TextBlock Text="{Binding Reason}" FontSize="11.5" LineHeight="17" Foreground="#3F43A0" TextWrapping="Wrap" Margin="0,3,0,0"
                                                           Visibility="{Binding IsManual, Converter={StaticResource B2V}}"/>
                                                <TextBlock Text="{Binding FixError}" FontSize="11" LineHeight="16" Foreground="{StaticResource Bz.HighText}" TextWrapping="Wrap" Margin="0,3,0,0"
                                                           Visibility="{Binding HasFixError, Converter={StaticResource B2V}}"/>
                                                <TextBlock FontSize="11" LineHeight="16" Foreground="{StaticResource Bz.Text3}" TextWrapping="Wrap" Margin="0,3,0,0">
                                                    <Run x:Name="Sv" Text="{Binding SvLabel, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" · "/><Run Text="{Binding Meta, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <!-- .rfix -->
                                    <Button Grid.Column="1" Width="28" Height="28" Margin="0,9,10,0" VerticalAlignment="Top"
                                            Style="{StaticResource Bare}" Tag="{Binding Id}" Click="RowFix_Click"
                                            Visibility="{Binding ShowFix, Converter={StaticResource B2V}}"
                                            ToolTip="{Binding DataContext.KeyFix, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                        <Border x:Name="FixBd" Background="#FFFFFF" BorderBrush="#E9D27A" BorderThickness="1" CornerRadius="5">
                                            <Path Style="{StaticResource Icon}" Stroke="#6B5600" HorizontalAlignment="Center"
                                                  Data="M13,2 L3,14 L12,14 L11,22 L21,10 L12,10 Z"/>
                                        </Border>
                                    </Button>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSel}" Value="True">
                                    <Setter TargetName="RowBd" Property="Background" Value="#FEF8DC"/>
                                    <Setter TargetName="RowBd" Property="BorderBrush" Value="#E3C850"/>
                                    <Setter TargetName="RowBd" Property="BorderThickness" Value="1"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter TargetName="Title" Property="Foreground" Value="#4B4F57"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SvKind}" Value="High"><Setter TargetName="Sv" Property="Foreground" Value="#B42F2F"/></DataTrigger>
                                <DataTrigger Binding="{Binding SvKind}" Value="Med"><Setter TargetName="Sv" Property="Foreground" Value="#B83D0B"/></DataTrigger>
                                <DataTrigger Binding="{Binding SvKind}" Value="Low"><Setter TargetName="Sv" Property="Foreground" Value="#5F646C"/></DataTrigger>
                                <DataTrigger Binding="{Binding SvKind}" Value="man"><Setter TargetName="Sv" Property="Foreground" Value="#4A4EB0"/></DataTrigger>
                                <DataTrigger Binding="{Binding SvKind}" Value="ok"><Setter TargetName="Sv" Property="Foreground" Value="#2E7D4F"/></DataTrigger>
                                <DataTrigger Binding="{Binding SvKind}" Value="ign"><Setter TargetName="Sv" Property="Foreground" Value="#5F646C"/></DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- .empty -->
                <StackPanel Margin="20,36,20,36" HorizontalAlignment="Center" Visibility="{Binding ListEmpty, Converter={StaticResource B2V}}">
                    <TextBlock Text="{Binding EmptyTitle}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding EmptyHint}" FontSize="12" LineHeight="18" Foreground="{StaticResource Bz.Text3}"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <Button Content="{Binding ClearSearchLabel}" Style="{StaticResource Bz.Btn.Ghost}" HorizontalAlignment="Center" Margin="0,8,0,0"
                            Click="ClearQuery_Click" Visibility="{Binding HasQ, Converter={StaticResource B2V}}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Checklist: section → Borang item → spec check (JKR Model Audit spec) -->
        <ScrollViewer x:Name="ChecklistScroll" Grid.Row="5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Background="{StaticResource Bz.Sunken}" Visibility="{Binding ShowChecklist, Converter={StaticResource B2V}}">
            <StackPanel Margin="10,10,10,6">
                <TextBlock Text="{Binding ChecklistIntro}" FontSize="11" LineHeight="16" Foreground="{StaticResource Bz.Text3}"
                           TextWrapping="Wrap" Margin="2,0,2,8"/>
                <ItemsControl ItemsSource="{Binding Checklist}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFFFFF" BorderBrush="{StaticResource Bz.Line}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8" ClipToBounds="True">
                                <Grid>
                                    <Border Style="{StaticResource ToneBar}" Width="3" HorizontalAlignment="Left"/>
                                    <StackPanel Margin="3,0,0,0">
                                        <!-- section header -->
                                        <Button Style="{StaticResource Bare}" Tag="{Binding Key}" Click="ChecklistSection_Click" Padding="10,9,10,9"
                                                AutomationProperties.Name="{Binding Name}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="22" Height="22" CornerRadius="4" Background="#0F0F0F" VerticalAlignment="Top" Margin="0,0,9,0">
                                                    <TextBlock Text="{Binding Letter}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#161616"/>
                                                    <TextBlock Text="{Binding Summary}" FontSize="11" Margin="0,1,0,0" TextWrapping="Wrap" Style="{StaticResource ToneFg}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Chevron}" FontSize="12" Foreground="{StaticResource Bz.Text3}" Margin="8,2,0,0"/>
                                            </Grid>
                                        </Button>
                                        <!-- Borang items and their checks -->
                                        <ItemsControl ItemsSource="{Binding Items}" Margin="12,0,10,4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,4,0,4">
                                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Bz.Text3}" TextWrapping="Wrap" Margin="0,0,0,6">
                                                            <Run Text="{Binding No, Mode=OneWay}" FontFamily="{StaticResource Bz.Font.Mono}"/><Run Text="  "/><Run Text="{Binding Title, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <ItemsControl ItemsSource="{Binding Checks}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Style="{StaticResource CheckGrid}" Margin="0,0,0,9">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border Style="{StaticResource ChipBd}" VerticalAlignment="Top" Margin="0,1,8,0">
                                                                            <TextBlock Text="{Binding StateLabel}" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" Style="{StaticResource ToneFg}"/>
                                                                        </Border>
                                                                        <StackPanel Grid.Column="1">
                                                                            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="16" Foreground="#161616">
                                                                                <Run Text="{Binding ShownId, Mode=OneWay}" FontFamily="{StaticResource Bz.Font.Mono}" FontSize="11" Foreground="#686C74"/><Run Text="  "/><Run Text="{Binding Title, Mode=OneWay}"/>
                                                                            </TextBlock>
                                                                            <TextBlock Text="{Binding Meta}" FontSize="10.5" Foreground="#8A8D93" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                                                            <TextBlock Text="{Binding Detail}" FontSize="11.5" LineHeight="16" Foreground="{StaticResource Bz.TextBody}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                                            <TextBlock Text="{Binding Notes}" FontSize="11" LineHeight="15" Foreground="{StaticResource Bz.Text3}" TextWrapping="Wrap" Margin="0,3,0,0"
                                                                                       Visibility="{Binding HasNotes, Converter={StaticResource B2V}}"/>
                                                                            <!-- the issues behind it: open = detail (Locate, Fix, Ignore) -->
                                                                            <ItemsControl ItemsSource="{Binding Elements}" Margin="-6,4,0,0"
                                                                                          Visibility="{Binding HasElements, Converter={StaticResource B2V}}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <Button Style="{StaticResource Bare}" Tag="{Binding Id}" Click="ChecklistElement_Click" Padding="6,3,6,3"
                                                                                                AutomationProperties.Name="{Binding Label}">
                                                                                            <Button.Template>
                                                                                                <ControlTemplate TargetType="Button">
                                                                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                                                        <ContentPresenter/>
                                                                                                    </Border>
                                                                                                    <ControlTemplate.Triggers>
                                                                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#F5F5F3"/></Trigger>
                                                                                                    </ControlTemplate.Triggers>
                                                                                                </ControlTemplate>
                                                                                            </Button.Template>
                                                                                            <Grid>
                                                                                                <Grid.ColumnDefinitions>
                                                                                                    <ColumnDefinition Width="*"/>
                                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                                </Grid.ColumnDefinitions>
                                                                                                <StackPanel>
                                                                                                    <TextBlock Text="{Binding Label}" FontFamily="{StaticResource Bz.Font.Mono}" FontSize="11" Foreground="#161616" TextTrimming="CharacterEllipsis"/>
                                                                                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Bz.Text3}" TextTrimming="CharacterEllipsis"/>
                                                                                                </StackPanel>
                                                                                                <Border Grid.Column="1" Background="#F5F5F3" CornerRadius="3" Padding="5,0,5,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                                                        Visibility="{Binding HasTag, Converter={StaticResource B2V}}">
                                                                                                    <TextBlock Text="{Binding Tag}" FontSize="10" Foreground="#4B4F57"/>
                                                                                                </Border>
                                                                                            </Grid>
                                                                                        </Button>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                            <Button Style="{StaticResource Bare}" Tag="{Binding Id}" Click="ChecklistMore_Click" HorizontalAlignment="Left" Margin="0,2,0,0"
                                                                                    Visibility="{Binding HasMore, Converter={StaticResource B2V}}">
                                                                                <TextBlock Text="{Binding MoreLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#2B63A8" TextWrapping="Wrap"/>
                                                                            </Button>
                                                                        </StackPanel>
                                                                        <!-- Fix n: same confirm + AI-fix path as Fix all -->
                                                                        <Button Grid.Column="2" Style="{StaticResource Bz.Btn.Ghost}" Tag="{Binding Id}" Click="ChecklistFix_Click"
                                                                                VerticalAlignment="Top" Margin="8,0,0,0" Padding="8,3,8,3"
                                                                                IsEnabled="{Binding DataContext.CanAct, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                Visibility="{Binding CanFix, Converter={StaticResource B2V}}">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <Path Style="{StaticResource Icon}" Width="11" Height="11" Stroke="#6B5600" Data="M13,2 L3,14 L12,14 L11,22 L21,10 L12,10 Z"/>
                                                                                <TextBlock Text="{Binding FixLabel}" FontSize="11" Margin="4,0,0,0"/>
                                                                            </StackPanel>
                                                                        </Button>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- .foot -->
        <Border Grid.Row="6" Background="{StaticResource Bz.Sunken}" BorderBrush="{StaticResource Bz.Line}" BorderThickness="0,1,0,0" Padding="12,6,8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="11" Foreground="{StaticResource Bz.Text3}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <Run Text="⏎" FontFamily="{StaticResource Bz.Font.Mono}" Foreground="#2B2E33"/><Run Text="{Binding KeyOpen, Mode=OneWay, StringFormat=' {0}  '}"/><Run Text="J/K" FontFamily="{StaticResource Bz.Font.Mono}" Foreground="#2B2E33"/><Run Text="{Binding KeyNav, Mode=OneWay, StringFormat=' {0}  '}"/><Run Text="F" FontFamily="{StaticResource Bz.Font.Mono}" Foreground="#2B2E33"/><Run Text="{Binding KeyFix, Mode=OneWay, StringFormat=' {0}  '}"/><Run Text="A" FontFamily="{StaticResource Bz.Font.Mono}" Foreground="#2B2E33"/><Run Text="{Binding KeyIgnore, Mode=OneWay, StringFormat=' {0}'}"/>
                </TextBlock>
                <Button Grid.Column="1" Style="{StaticResource Bz.Btn.Ghost}" Click="Reset_Click" IsEnabled="{Binding CanAct}" Margin="6,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon}" Stroke="{StaticResource Bz.TextBody}"
                              Data="M3,12 A9,9 0 1 0 12,3 A9.75,9.75 0 0 0 5.26,5.74 L3,8 M3,3 L3,8 L8,8"/>
                        <TextBlock Text="{Binding ResetLabel}" Margin="5,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource BtnDark}" Click="Export_Click" IsEnabled="{Binding CanAct}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M12,3 L12,15 M7,10 L12,15 L17,10 M5,21 L19,21"/>
                        <TextBlock Text="{Binding ExportLabel}" Margin="5,0,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
