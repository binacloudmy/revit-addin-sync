<UserControl x:Class="RevitWebAppSync.UI.Jkr.Panel.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RevitWebAppSync.UI.Jkr.Panel"
             Background="{DynamicResource Bz.Surface}" FontFamily="{DynamicResource Bz.Font.Sans}" Foreground="{DynamicResource Bz.Text}"
             TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" Focusable="True">
    <!-- Result (Clear Sheet: "result", "no failures", "keputusan, 320 px", "section D", and the
         degraded result of "edge states, refined"). DataContext: Core.ResultsScreenModel.
         Three views share the frame:
         · the list (ShowOverview): head (verdict, "n spec checks fail.", score sentence,
           "n checks wait for semak manual"), Checklist / Issues tabs, the "Borang sections |
           Aspects" toggle, one row per section or aspect with its tick strip, "Other JKR rules",
           the legend;
         · a section, aspect or state opened from it (IsFocused): back bar, its head with ticks
           and state chips, then its checks, each opening to a card (inventory, Show all, why, Fix);
         · the issue tabs (ShowList, Clear Sheet "issues"): state tabs, search, progress and
           severity legend, Ignore all / Fix all n, then rows with old → new values and a meta line.
         Light Clear Sheet look, Bz.* tokens only (PanelTokens.xaml). Nothing may clip at 320 px. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevitWebAppSync;component/UI/Jkr/Panel/PanelTokens.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="B2V"/>

            <!-- Chromeless button whose template is its content (rows, tabs, chips) -->
            <Style x:Key="Bare" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource Bz.FocusRing}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- A list row (Clear Sheet .row / .chk): hover fill #F8F9FA -->
            <Style x:Key="RowBtn" TargetType="Button" BasedOn="{StaticResource Bare}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource Bz.Sunken}"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Text button (Clear Sheet .tb / .gh): no frame, 8 px radius, grey fill on hover -->
            <Style x:Key="TextBtn" TargetType="Button" BasedOn="{StaticResource Bare}">
                <Setter Property="Foreground" Value="{StaticResource Bz.TextBody}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="Padding" Value="8,0,10,0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bz.Sunken2}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Bz.Text}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource Bz.DisabledText}"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Text link as a control (Show all): 28 px tall, text centred -->
            <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource TextBtn}">
                <Setter Property="MinHeight" Value="28"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="4,0,8,0"/>
                <Setter Property="Margin" Value="-4,0,0,0"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
            </Style>
            <Style x:Key="LinkText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <!-- Segment of the "Borang sections | Aspects" toggle (off); the on one is white with a shadow -->
            <Style x:Key="Seg" TargetType="Button" BasedOn="{StaticResource Bare}">
                <Setter Property="Foreground" Value="{StaticResource Bz.Text2}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Height="28" Padding="12,0,12,0">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Tag" Value="on">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bz.Surface}"/>
                                    <Setter TargetName="Bd" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#15181D" BlurRadius="2" ShadowDepth="1" Direction="270" Opacity="0.14"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Foreground" Value="{StaticResource Bz.Text}"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="Tag" Value="{x:Null}"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Foreground" Value="{StaticResource Bz.Text}"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Icon" TargetType="Path">
                <Setter Property="Width" Value="14"/>
                <Setter Property="Height" Value="14"/>
                <Setter Property="Stretch" Value="Uniform"/>
                <Setter Property="StrokeThickness" Value="1.6"/>
                <Setter Property="StrokeStartLineCap" Value="Round"/>
                <Setter Property="StrokeEndLineCap" Value="Round"/>
                <Setter Property="StrokeLineJoin" Value="Round"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <!-- Icons drawn on Clear Sheet's 16 px grid; the 16 × 16 frame keeps their proportions -->
            <Style x:Key="Icon16" TargetType="Path" BasedOn="{StaticResource Icon}">
                <Setter Property="Stretch" Value="None"/>
                <Setter Property="Width" Value="16"/>
                <Setter Property="Height" Value="16"/>
            </Style>

            <!-- A tick of the strip, by code: f fail, p pass, h partly (half green), m semak manual
                 (purple outline), l listed, n not applicable, x not checked (dashed), . empty -->
            <DataTemplate x:Key="Tick">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border x:Name="Fill" Grid.RowSpan="2" CornerRadius="2" Background="{StaticResource Bz.Track}"/>
                    <Border x:Name="Half" Grid.Row="1" CornerRadius="0,0,2,2" Background="{StaticResource Bz.Tone.Pass}" Visibility="Collapsed"/>
                    <Border x:Name="Edge" Grid.RowSpan="2" CornerRadius="2" BorderThickness="0" BorderBrush="Transparent"/>
                    <Rectangle x:Name="Dash" Grid.RowSpan="2" RadiusX="2" RadiusY="2" Stroke="{StaticResource Bz.Text3}" StrokeThickness="1.5"
                               StrokeDashArray="1.5 1" Visibility="Collapsed"/>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding}" Value="f"><Setter TargetName="Fill" Property="Background" Value="{StaticResource Bz.Tone.Fail}"/></DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="p"><Setter TargetName="Fill" Property="Background" Value="{StaticResource Bz.Tone.Pass}"/></DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="h">
                        <Setter TargetName="Fill" Property="Background" Value="{StaticResource Bz.Surface}"/>
                        <Setter TargetName="Half" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="Edge" Property="BorderBrush" Value="{StaticResource Bz.Tone.Pass}"/>
                        <Setter TargetName="Edge" Property="BorderThickness" Value="1.5"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="m">
                        <Setter TargetName="Fill" Property="Background" Value="{StaticResource Bz.Surface}"/>
                        <Setter TargetName="Edge" Property="BorderBrush" Value="{StaticResource Bz.Tone.Person}"/>
                        <Setter TargetName="Edge" Property="BorderThickness" Value="2"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="l"><Setter TargetName="Fill" Property="Background" Value="{StaticResource Bz.Tone.Listed}"/></DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="n">
                        <Setter TargetName="Fill" Property="Background" Value="{StaticResource Bz.Surface}"/>
                        <Setter TargetName="Edge" Property="BorderBrush" Value="{StaticResource Bz.Tone.Listed}"/>
                        <Setter TargetName="Edge" Property="BorderThickness" Value="1"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="x">
                        <Setter TargetName="Fill" Property="Background" Value="{StaticResource Bz.Surface}"/>
                        <Setter TargetName="Dash" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- A state's 12 px mark, by tone (fail | pass | partial | person | listed | na | none);
                 "all" has none. Drawn in a 12 × 12 frame; a Viewbox scales it (the verdict's 24 px). -->
            <DataTemplate x:Key="Mark">
                <Grid x:Name="M" Width="12" Height="12">
                    <Ellipse x:Name="Disc" Fill="{StaticResource Bz.Tone.Fail}"/>
                    <Ellipse x:Name="Ring" Margin="1" StrokeThickness="2" Stroke="{StaticResource Bz.Tone.Person}" Fill="{StaticResource Bz.Surface}" Visibility="Collapsed"/>
                    <Path x:Name="HalfDisc" Data="M1.75,6 A4.25,4.25 0 0 0 10.25,6 Z" Fill="{StaticResource Bz.Tone.Pass}" Visibility="Collapsed"/>
                    <Rectangle x:Name="Sq" Margin="1" RadiusX="2.5" RadiusY="2.5" Fill="{StaticResource Bz.Tone.Listed}" Visibility="Collapsed"/>
                    <Path x:Name="X" Data="M4,4 L8,8 M8,4 L4,8" Stroke="{StaticResource Bz.Surface}" StrokeThickness="1.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Path x:Name="V" Data="M3.5,6.2 L5.3,8 L8.6,4.4" Stroke="{StaticResource Bz.Surface}" StrokeThickness="1.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding}" Value="pass">
                        <Setter TargetName="Disc" Property="Fill" Value="{StaticResource Bz.Tone.PassMark}"/>
                        <Setter TargetName="X" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="V" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="person">
                        <Setter TargetName="Disc" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="X" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="partial">
                        <Setter TargetName="Disc" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="X" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="Ring" Property="StrokeThickness" Value="1.5"/>
                        <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Bz.Tone.Pass}"/>
                        <Setter TargetName="HalfDisc" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="listed">
                        <Setter TargetName="Disc" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="X" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="Sq" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="na">
                        <Setter TargetName="Disc" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="X" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="Ring" Property="StrokeThickness" Value="1"/>
                        <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Bz.Tone.Listed}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="none">
                        <Setter TargetName="Disc" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="X" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="Ring" Property="StrokeThickness" Value="1.2"/>
                        <Setter TargetName="Ring" Property="StrokeDashArray" Value="1.5 1.2"/>
                        <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Bz.Tone.None}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="all"><Setter TargetName="M" Property="Visibility" Value="Collapsed"/></DataTrigger>
                    <DataTrigger Binding="{Binding}" Value=""><Setter TargetName="M" Property="Visibility" Value="Collapsed"/></DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- The tick strip of a row (8 × 20 ticks, 2 px apart; thinner, then wrapped, when narrow) -->
            <ItemsPanelTemplate x:Key="TickPanel">
                <local:TickStripPanel TickWidth="8" TickHeight="20" Gap="2" MinTickWidth="4"/>
            </ItemsPanelTemplate>
            <ItemsPanelTemplate x:Key="TickPanelWide">
                <local:TickStripPanel TickWidth="8" TickHeight="20" Gap="3" MinTickWidth="4"/>
            </ItemsPanelTemplate>

            <!-- Clear Sheet .ic: a 16 px grid path, stroke 1.6, round ends; wrapped in a Viewbox for its size -->
            <Style x:Key="Ico" TargetType="Path">
                <Setter Property="StrokeThickness" Value="1.6"/>
                <Setter Property="StrokeStartLineCap" Value="Round"/>
                <Setter Property="StrokeEndLineCap" Value="Round"/>
                <Setter Property="StrokeLineJoin" Value="Round"/>
            </Style>
            <!-- The ready-made fix bolt, and the AI fixer's spark bolt ("AI fix mark", option 1) -->
            <Geometry x:Key="BoltGeo">M9,1.8 L3.8,9 L7.8,9 L7,14.2 L12.2,7 L8.2,7 Z</Geometry>
            <Geometry x:Key="SparkBoltGeo">M7.6,2.2 L2.6,9.2 L6.4,9.2 L5.6,14.2 L10.8,7.2 L7,7.2 Z</Geometry>
            <Geometry x:Key="SparkGeo">M12.6,1.2 L13.3,2.9 L15,3.6 L13.3,4.3 L12.6,6 L11.9,4.3 L10.2,3.6 L11.9,2.9 Z</Geometry>

            <!-- Severity pip (Clear Sheet .pip): three 4 px cells, filled from the bottom:
                 High 3 red, Med 2 amber, Low 1 grey; "man" (semak manual) 3 purple -->
            <DataTemplate x:Key="Pip">
                <StackPanel Width="4" Focusable="False">
                    <Border x:Name="P3" Width="4" Height="4" CornerRadius="1" Background="{StaticResource Bz.Line}"/>
                    <Border x:Name="P2" Width="4" Height="4" CornerRadius="1" Margin="0,2,0,0" Background="{StaticResource Bz.Line}"/>
                    <Border x:Name="P1" Width="4" Height="4" CornerRadius="1" Margin="0,2,0,0" Background="{StaticResource Bz.Line}"/>
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding}" Value="High">
                        <Setter TargetName="P1" Property="Background" Value="{StaticResource Bz.Tone.Fail}"/>
                        <Setter TargetName="P2" Property="Background" Value="{StaticResource Bz.Tone.Fail}"/>
                        <Setter TargetName="P3" Property="Background" Value="{StaticResource Bz.Tone.Fail}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="Med">
                        <Setter TargetName="P1" Property="Background" Value="{StaticResource Bz.Med}"/>
                        <Setter TargetName="P2" Property="Background" Value="{StaticResource Bz.Med}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="Low">
                        <Setter TargetName="P1" Property="Background" Value="{StaticResource Bz.Text3}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="man">
                        <Setter TargetName="P1" Property="Background" Value="{StaticResource Bz.Tone.Person}"/>
                        <Setter TargetName="P2" Property="Background" Value="{StaticResource Bz.Tone.Person}"/>
                        <Setter TargetName="P3" Property="Background" Value="{StaticResource Bz.Tone.Person}"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- A row's 32 px icon button (Clear Sheet .ib): no frame until the row is selected -->
            <Style x:Key="RowIconBtn" TargetType="Button" BasedOn="{StaticResource Bare}">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Foreground" Value="{StaticResource Bz.TextBody}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bz.Sunken2}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Bz.Text}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Keyboard-hint caps in the footer tooltip -->
            <Style x:Key="KeyCap" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Bz.Font.Mono}"/>
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="Foreground" Value="{StaticResource Bz.Text2}"/>
            </Style>
            <Style x:Key="KeyLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource Bz.Text2}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="4,0,10,0"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- tools bar, or the back bar inside a section -->
            <RowDefinition Height="Auto"/>  <!-- split banner: LOD changed / backend unavailable -->
            <RowDefinition Height="Auto"/>  <!-- head: verdict (list), one-line verdict (issues), section head -->
            <RowDefinition Height="Auto"/>  <!-- tabs: Checklist n / Issues n -->
            <RowDefinition Height="Auto"/>  <!-- issue toolbar -->
            <RowDefinition Height="Auto"/>  <!-- busy -->
            <RowDefinition Height="*"/>     <!-- list / section checks / issues -->
            <RowDefinition Height="Auto"/>  <!-- footer -->
        </Grid.RowDefinitions>

        <!-- Tools bar (48 px): LOD, discipline, Re-scan. Hidden inside a section (its back bar instead). -->
        <Border Grid.Row="0" BorderBrush="{StaticResource Bz.Line}" BorderThickness="0,0,0,1" Padding="12,8,12,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFocused}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <!-- the LOD box reads "LOD 300"; Re-scan drops its word when the pane is too narrow for it (320 px BM) -->
            <Grid x:Name="ToolsGrid" SizeChanged="Tools_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="LodBox" Grid.Column="1" Style="{StaticResource Bz.Select}" FontSize="13" MinWidth="70" Margin="0,0,8,0" SizeChanged="Tools_SizeChanged"
                          ItemsSource="{Binding LodOptions}" DisplayMemberPath="Value" SelectedValuePath="Value"
                          SelectedValue="{Binding LodValue, Mode=TwoWay}" AutomationProperties.Name="LOD"/>
                <ComboBox x:Name="DiscBox" Grid.Column="2" Style="{StaticResource Bz.Select}" FontSize="13" MinWidth="64" Margin="0,0,8,0" SizeChanged="Tools_SizeChanged"
                          ItemsSource="{Binding DiscOptions}" ItemTemplate="{StaticResource Bz.OptionLabel}" SelectedValuePath="Value"
                          SelectedValue="{Binding DiscValue, Mode=TwoWay}" AutomationProperties.Name="{Binding DiscShortLabel}"/>
                <Button Grid.Column="4" Style="{StaticResource Bz.Btn.Ghost}" Click="Rescan_Click" IsEnabled="{Binding CanAct}"
                        MinHeight="32" MinWidth="32" Padding="8,0,8,0" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Bz.Text}" BorderBrush="{StaticResource Bz.Line2}"
                        AutomationProperties.Name="{Binding RescanLabel}" ToolTip="{Binding RescanLabel}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon16}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M13,8 A5,5 0 1 1 11.54,4.46 M13,2.5 L13,5 L10.5,5"/>
                        <TextBlock x:Name="RescanText" Text="{Binding RescanLabel}" Margin="4,0,4,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Back bar inside a section: "‹ Checklist" and "Section 4 of 5" -->
        <Border Grid.Row="0" BorderBrush="{StaticResource Bz.Line}" BorderThickness="0,0,0,1" Padding="10,8,16,8"
                Visibility="{Binding IsFocused, Converter={StaticResource B2V}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource TextBtn}" Click="Back_Click" Foreground="{StaticResource Bz.Text}" FontWeight="Medium" Padding="6,0,10,0"
                        AutomationProperties.Name="{Binding BackLabel}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon16}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M9.5,4.5 L6,8 L9.5,11.5"/>
                        <TextBlock Text="{Binding BackLabel}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="1" Text="{Binding FocusPosition}" FontSize="12" Foreground="{StaticResource Bz.Text2}" HorizontalAlignment="Right" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Right" Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <!-- Split banner (edge states, refined): "This result is for LOD 300. Re-scan …" and
             "BINA backend unavailable. B1.2 needs it, so it shows as not checked, never as passed." -->
        <Border Grid.Row="1" Margin="16,12,16,0" CornerRadius="10" Background="{StaticResource Bz.Tone.WarnBg}" BorderBrush="{StaticResource Bz.Tone.WarnLine}" BorderThickness="1"
                Visibility="{Binding ShowBanner, Converter={StaticResource B2V}}">
            <StackPanel>
                <Grid Margin="12,10,12,10" Visibility="{Binding ShowLodBanner, Converter={StaticResource B2V}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="6" Height="6" Fill="{StaticResource Bz.Tone.WarnDot}" VerticalAlignment="Top" Margin="3,6,7,0"/>
                    <TextBlock Grid.Column="1" FontSize="12" LineHeight="17" Foreground="{StaticResource Bz.Tone.WarnInk}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
                        <Run Text="{Binding LodBannerStrong, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" "/><Run Text="{Binding LodBannerRest, Mode=OneWay}"/>
                    </TextBlock>
                </Grid>
                <Border Height="1" Margin="12,0,12,0" Background="{StaticResource Bz.Tone.WarnLine}" Visibility="{Binding ShowBothBanners, Converter={StaticResource B2V}}"/>
                <Grid Margin="12,10,12,10" Visibility="{Binding ShowBackendBanner, Converter={StaticResource B2V}}" ToolTip="{Binding BackendErrorText}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Stroke="{StaticResource Bz.Tone.WarnDash}" StrokeThickness="1" StrokeDashArray="2 1.5"
                               VerticalAlignment="Top" Margin="1,3,5,0"/>
                    <TextBlock Grid.Column="1" FontSize="12" LineHeight="17" Foreground="{StaticResource Bz.Tone.WarnInk}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
                        <Run Text="{Binding BackendBannerStrong, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" "/><Run Text="{Binding BackendBannerRest, Mode=OneWay}"/>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Head of the list: verdict mark + "Does not comply" / "n spec checks fail.", the score
             sentence, "n checks wait for semak manual" (opens those checks). The same facts as the
             old progress ring and hero tile (item 11). -->
        <StackPanel Grid.Row="2" Margin="16,20,16,16" Visibility="{Binding ShowOverview, Converter={StaticResource B2V}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Viewbox Width="24" Height="24" VerticalAlignment="Top" Margin="0,2,12,0">
                    <ContentControl Content="{Binding VerdictTone}" ContentTemplate="{StaticResource Mark}" Focusable="False" IsTabStop="False"/>
                </Viewbox>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding VerdictHead}" FontSize="22" LineHeight="28" FontWeight="Bold" Foreground="{StaticResource Bz.Text}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding VerdictSub}" FontSize="13" LineHeight="18" Foreground="{StaticResource Bz.TextBody}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding HasVerdictSub, Converter={StaticResource B2V}}"/>
                </StackPanel>
            </Grid>
            <TextBlock FontSize="13" LineHeight="18" Foreground="{StaticResource Bz.TextBody}" TextWrapping="Wrap" Margin="0,12,0,0">
                <Run Text="{Binding HeadPctStrong, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Bz.Text}"/><Run Text="{Binding HeadResultsRest, Mode=OneWay}"/>
            </TextBlock>
            <Button Style="{StaticResource TextBtn}" Click="GoManual_Click" Foreground="{StaticResource Bz.Manual}" Margin="-8,8,0,0" HorizontalAlignment="Left"
                    Visibility="{Binding HasManualLink, Converter={StaticResource B2V}}" AutomationProperties.Name="{Binding ManualLinkLabel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="12" Height="12" Stroke="{StaticResource Bz.Manual}" StrokeThickness="2" Fill="{StaticResource Bz.Surface}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding ManualLinkLabel}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,6,0,6"/>
                    <Path Grid.Column="2" Style="{StaticResource Icon16}" Stroke="{StaticResource Bz.Manual}" Data="M6.5,4.5 L10,8 L6.5,11.5" Margin="6,0,0,0"/>
                </Grid>
            </Button>
        </StackPanel>

        <!-- Issues view: the verdict in one line (Clear Sheet issues); it opens the full result -->
        <Button Grid.Row="2" Style="{StaticResource RowBtn}" Click="Checklist_Click" Padding="16,0,16,0" MinHeight="44"
                Visibility="{Binding ShowVerdictBar, Converter={StaticResource B2V}}"
                BorderBrush="{StaticResource Bz.Line}" AutomationProperties.Name="{Binding VerdictHead}">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Viewbox Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center">
                    <ContentControl Content="{Binding VerdictTone}" ContentTemplate="{StaticResource Mark}" Focusable="False" IsTabStop="False"/>
                </Viewbox>
                <TextBlock Grid.Column="1" Text="{Binding VerdictHead}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,12,0,12"/>
                <TextBlock Grid.Column="2" Text="{Binding VerdictShortLine}" FontSize="12" Foreground="{StaticResource Bz.TextBody}" TextWrapping="Wrap"
                           TextAlignment="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
        </Button>
        <Border Grid.Row="2" Height="1" VerticalAlignment="Bottom" Background="{StaticResource Bz.Line}"
                Visibility="{Binding ShowVerdictBar, Converter={StaticResource B2V}}"/>

        <!-- Section head (Clear Sheet section D): letter, name, %, its ticks, then the state chips
             with counts in it (item 12). The other JKR rules: a dashed "+", no chips. -->
        <StackPanel Grid.Row="2" Margin="16,16,16,12" Visibility="{Binding IsFocused, Converter={StaticResource B2V}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Top" Visibility="{Binding HasFocusLetter, Converter={StaticResource B2V}}">
                    <Border x:Name="FocusChip" CornerRadius="7" Background="{StaticResource Bz.Sunken2}"/>
                    <Rectangle RadiusX="7" RadiusY="7" Stroke="{StaticResource Bz.Tone.Listed}" StrokeThickness="1" StrokeDashArray="3 2"
                               Visibility="{Binding FocusIsOther, Converter={StaticResource B2V}}"/>
                    <TextBlock Text="{Binding FocusLetter}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Bz.TextBody}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding FocusName}" FontSize="18" LineHeight="24" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding FocusPctLabel}" FontSize="18" LineHeight="24" FontWeight="Bold" VerticalAlignment="Top" Margin="10,1,0,0"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding FocusTicks}" ItemTemplate="{StaticResource Tick}" ItemsPanel="{StaticResource TickPanelWide}"
                          Margin="36,10,0,0" HorizontalAlignment="Left" Focusable="False" AutomationProperties.Name="{Binding FocusName}"/>
            <TextBlock Text="{Binding OtherRowCount}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Bz.Tone.Fail}" Margin="36,6,0,0"
                       Visibility="{Binding FocusIsOther, Converter={StaticResource B2V}}"/>
            <!-- State chips: All / Fails / Pass / Semak manual / Listed … with counts in this section -->
            <ItemsControl ItemsSource="{Binding StateChips}" Margin="0,14,0,0" Focusable="False"
                          Visibility="{Binding ShowFocusChips, Converter={StaticResource B2V}}" AutomationProperties.Name="{Binding FilterGroupAria}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button x:Name="Chip" Style="{StaticResource Bare}" Tag="{Binding Key}" Click="StateChip_Click" Margin="0,0,6,6"
                                AutomationProperties.Name="{Binding Aria}">
                            <Border x:Name="Bd" Height="28" CornerRadius="14" Padding="10,0,10,0" BorderThickness="1" BorderBrush="{StaticResource Bz.Line}" Background="Transparent">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ContentControl Content="{Binding Tone}" ContentTemplate="{StaticResource Mark}" Focusable="False" IsTabStop="False"
                                                    VerticalAlignment="Center" Margin="0,0,6,0" x:Name="Mk"/>
                                    <TextBlock x:Name="Lb" Text="{Binding Label}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource Bz.TextBody}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Cn" Text="{Binding N}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource Bz.Text2}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Key}" Value="all"><Setter TargetName="Mk" Property="Visibility" Value="Collapsed"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter TargetName="Chip" Property="Visibility" Value="Collapsed"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bz.Ink}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Bz.Ink}"/>
                                <Setter TargetName="Lb" Property="Foreground" Value="{StaticResource Bz.OnBrand}"/>
                                <Setter TargetName="Cn" Property="Foreground" Value="{StaticResource Bz.Tone.Listed}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- "12 issues in this section →": the Issues view, still filtered to this section
                 (items 9 and 10; its pill clears the filter) -->
            <Button Style="{StaticResource TextBtn}" Click="SectionIssues_Click" Foreground="{StaticResource Bz.Text}" Margin="-8,2,0,0" HorizontalAlignment="Left"
                    Visibility="{Binding HasSectionIssuesLink, Converter={StaticResource B2V}}" AutomationProperties.Name="{Binding SectionIssuesLabel}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding SectionIssuesLabel}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <Path Style="{StaticResource Icon16}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M2.5,8 L13.5,8 M9.8,4.5 L13.3,8 L9.8,11.5" Margin="6,0,0,0"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Tabs: Checklist n / Issues n (active: ink, 2 px ink underline) -->
        <Border Grid.Row="3" BorderBrush="{StaticResource Bz.Line}" BorderThickness="0,0,0,1" Padding="16,0,16,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFocused}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal" Height="44">
                <Button Style="{StaticResource Bare}" Click="Checklist_Click" Margin="0,0,20,0"
                        Visibility="{Binding HasSpec, Converter={StaticResource B2V}}" AutomationProperties.Name="{Binding ChecklistTabLabel}">
                    <Border BorderThickness="0,0,0,2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowChecklist}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Bz.Ink}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Bz.Text2}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowChecklist}" Value="True"><Setter Property="Foreground" Value="{StaticResource Bz.Text}"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="{Binding ChecklistTabLabel, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding ChecklistTabN, Mode=OneWay}" FontWeight="Medium" Foreground="{StaticResource Bz.Text2}"/>
                        </TextBlock>
                    </Border>
                </Button>
                <Button Style="{StaticResource Bare}" Click="Issues_Click" AutomationProperties.Name="{Binding IssuesTabLabel}">
                    <Border BorderThickness="0,0,0,2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IssuesTabOn}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Bz.Ink}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Bz.Text2}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IssuesTabOn}" Value="True"><Setter Property="Foreground" Value="{StaticResource Bz.Text}"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="{Binding IssuesTabLabel, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding IssuesTabN, Mode=OneWay}" FontWeight="Medium" Foreground="{StaticResource Bz.Text2}"/>
                        </TextBlock>
                    </Border>
                </Button>
            </StackPanel>
        </Border>

        <!-- Issue toolbar (Clear Sheet issues): state tabs Open / Ignored / Resolved / Manual with
             counts, search ("/"), "0 of 99 resolved" + severity legend + bar, the section pill
             (item 9: "Clear section filter"), "n shown" · Ignore all · Fix all n. At 320 px BM the
             legend and the buttons take their own line rather than cut a word. -->
        <StackPanel Grid.Row="4" Visibility="{Binding ShowList, Converter={StaticResource B2V}}">
            <StackPanel Margin="16,12,16,0">
                <Border Background="{StaticResource Bz.Sunken2}" CornerRadius="8" Padding="2" AutomationProperties.Name="{Binding StateTabsAria}">
                    <ItemsControl ItemsSource="{Binding Tabs}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><local:SegmentPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Bare}" Tag="{Binding Tab}" Click="Tab_Click">
                                    <AutomationProperties.Name>
                                        <MultiBinding StringFormat="{}{0} {1}">
                                            <Binding Path="Label"/>
                                            <Binding Path="N"/>
                                        </MultiBinding>
                                    </AutomationProperties.Name>
                                    <Border x:Name="Seg" MinHeight="28" CornerRadius="6" Background="Transparent" Padding="2,0,2,0">
                                        <!-- the count drops under its label only if a segment is narrower than both -->
                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock x:Name="L" Text="{Binding Label, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Bz.Text2}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding N, Mode=OneWay}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource Bz.Text2}" VerticalAlignment="Center"
                                                       Margin="5,0,0,0" Typography.NumeralAlignment="Tabular"/>
                                        </WrapPanel>
                                    </Border>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsOn}" Value="True">
                                        <Setter TargetName="Seg" Property="Background" Value="{StaticResource Bz.Surface}"/>
                                        <Setter TargetName="Seg" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#15181D" BlurRadius="2" ShadowDepth="1" Direction="270" Opacity="0.14"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter TargetName="L" Property="Foreground" Value="{StaticResource Bz.Text}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- search: 36 px, hairline, "/" focuses it -->
                <Border x:Name="SearchBox" Height="36" Margin="0,10,0,0" BorderBrush="{StaticResource Bz.Line2}" BorderThickness="1" CornerRadius="8"
                        Padding="10,0,8,0" Background="{StaticResource Bz.Surface}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                            <Canvas Width="16" Height="16">
                                <Path Style="{StaticResource Ico}" Stroke="{StaticResource Bz.Text2}"
                                      Data="M11.5,7 A4.5,4.5 0 1 1 2.5,7 A4.5,4.5 0 1 1 11.5,7 M10.4,10.4 L13.8,13.8"/>
                            </Canvas>
                        </Viewbox>
                        <TextBox x:Name="SearchInput" Grid.Column="1" BorderThickness="0" Background="Transparent" FontSize="13"
                                 Foreground="{StaticResource Bz.Text}" CaretBrush="{StaticResource Bz.Text}"
                                 VerticalContentAlignment="Center" Margin="6,0,8,0"
                                 Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{Binding SearchPlaceholder}"
                                 GotKeyboardFocus="Search_Focus" LostKeyboardFocus="Search_Blur"/>
                        <TextBlock Grid.Column="1" Text="{Binding SearchPlaceholder}" FontSize="13" Foreground="{StaticResource Bz.Text2}"
                                   Margin="8,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False" x:Name="SearchHint"/>
                        <Border Grid.Column="2" Style="{StaticResource Bz.Kbd}" Background="Transparent" BorderBrush="{StaticResource Bz.Line2}">
                            <TextBlock Text="/" Style="{StaticResource KeyCap}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- "0 of 99 resolved" … "4 high · 94 medium · 1 low" (the row's pip), then the bar -->
                <local:SplitRowPanel Margin="0,10,0,0" Gap="8" RowGap="4" WrapAlignment="Left">
                    <TextBlock Text="{Binding ProgressLabel}" FontSize="12" LineHeight="18" Foreground="{StaticResource Bz.TextBody}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <ItemsControl ItemsSource="{Binding SevChips}" VerticalAlignment="Center" Focusable="False" Margin="-8,0,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                                    <ContentControl Content="{Binding Key}" ContentTemplate="{StaticResource Pip}" Focusable="False" IsTabStop="False" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Text}" FontSize="12" LineHeight="18" Foreground="{StaticResource Bz.TextBody}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </local:SplitRowPanel>
                <Grid Height="3" Margin="0,6,0,0">
                    <Border Background="{StaticResource Bz.Track}" CornerRadius="2"/>
                    <Border Background="{StaticResource Bz.Ink}" CornerRadius="2" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding ProgFraction}"/>
                        </Border.RenderTransform>
                    </Border>
                </Grid>

                <!-- .pill: the section filter (item 9), on its own line so a 320 px pane never
                     squeezes it out; click clears it ("Clear section filter") -->
                <Button Style="{StaticResource Bare}" Click="ClearCat_Click" HorizontalAlignment="Left" Margin="0,10,0,0"
                        Visibility="{Binding HasCat, Converter={StaticResource B2V}}" AutomationProperties.Name="{Binding ClearCatLabel}" ToolTip="{Binding ClearCatLabel}">
                    <Border Background="{StaticResource Bz.Sunken2}" CornerRadius="14" MinHeight="28" Padding="10,4,10,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding CatLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Bz.Text}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <Path Grid.Column="1" Style="{StaticResource Icon}" Width="9" Height="9" Margin="8,0,0,0" Stroke="{StaticResource Bz.Text}" StrokeThickness="2" Data="M18,6 L6,18 M6,6 L18,18"/>
                        </Grid>
                    </Border>
                </Button>
            </StackPanel>

            <!-- "99 shown" · Ignore all · Fix all n (the buttons drop under it when the pane is narrow) -->
            <local:SplitRowPanel Margin="16,12,16,12" Gap="8" RowGap="8" WrapAlignment="Right">
                <TextBlock Text="{Binding ShownLabel}" FontSize="12" Foreground="{StaticResource Bz.Text2}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{Binding IgnoreAllLabel}" Style="{StaticResource TextBtn}" Click="IgnoreAll_Click" Padding="10,0,10,0" MinHeight="32"
                            IsEnabled="{Binding CanAct}" Margin="0,0,8,0" AutomationProperties.Name="{Binding IgnoreAllLabel}"/>
                    <Button Style="{StaticResource Bz.Btn.Primary}" Click="FixAll_Click" IsEnabled="{Binding CanFixAll}" Padding="12,0,12,0" MinHeight="32" FontSize="13"
                            AutomationProperties.Name="{Binding FixAllLabel}">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                                <Canvas Width="16" Height="16">
                                    <Path Style="{StaticResource Ico}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource BoltGeo}"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding FixAllLabel}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </local:SplitRowPanel>
        </StackPanel>

        <!-- busy: a fix batch is being written -->
        <Border Grid.Row="5" Background="{StaticResource Bz.BrandTint}" BorderBrush="{StaticResource Bz.BrandTintLine}" BorderThickness="0,0,0,1" Padding="16,8,16,8"
                Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
            <TextBlock Text="{Binding BusyText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Bz.BrandTintText}" TextWrapping="Wrap"/>
        </Border>

        <!-- The list: "Borang sections | Aspects", one row per section / aspect (a row opens it,
             item 10), "Other JKR rules", the aspects note, the legend -->
        <ScrollViewer x:Name="OverviewScroll" Grid.Row="6" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding ShowOverview, Converter={StaticResource B2V}}">
            <StackPanel Margin="0,0,0,16">
                <Border HorizontalAlignment="Left" Margin="16,10,16,10" Padding="2" CornerRadius="8" Background="{StaticResource Bz.Sunken2}"
                        AutomationProperties.Name="{Binding GroupToggleAria}">
                    <StackPanel Orientation="Horizontal">
                        <Button Click="ShowSections_Click" Content="{Binding SectionsToggleLabel}" AutomationProperties.Name="{Binding SectionsToggleLabel}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Seg}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowSections}" Value="True"><Setter Property="Tag" Value="on"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Click="ShowAspects_Click" Content="{Binding AspectsToggleLabel}" AutomationProperties.Name="{Binding AspectsToggleLabel}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Seg}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowAspects}" Value="True"><Setter Property="Tag" Value="on"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding GroupRows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource RowBtn}" Tag="{Binding Key}" Click="Group_Click" Padding="0"
                                    AutomationProperties.Name="{Binding Aria}">
                                <Border BorderBrush="{StaticResource Bz.LineSoft}" BorderThickness="0,1,0,0" Padding="16,11,12,11">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource Bz.Sunken2}" VerticalAlignment="Top" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Letter}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Bz.TextBody}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" LineHeight="18" FontWeight="Medium" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding PctLabel}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            <Path Grid.Column="3" Style="{StaticResource Icon16}" Stroke="{StaticResource Bz.Text3}" Data="M6.5,4.5 L10,8 L6.5,11.5" Margin="6,0,0,0"/>
                                        </Grid>
                                        <Grid Margin="32,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ItemsControl ItemsSource="{Binding Ticks}" ItemTemplate="{StaticResource Tick}" ItemsPanel="{StaticResource TickPanel}"
                                                          HorizontalAlignment="Left" VerticalAlignment="Center" Focusable="False"/>
                                            <TextBlock x:Name="Count" Grid.Column="1" Text="{Binding CountLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Bz.Text2}"
                                                       VerticalAlignment="Center" Margin="12,0,22,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding CountTone}" Value="fail"><Setter TargetName="Count" Property="Foreground" Value="{StaticResource Bz.Tone.Fail}"/></DataTrigger>
                                <DataTrigger Binding="{Binding CountTone}" Value="person"><Setter TargetName="Count" Property="Foreground" Value="{StaticResource Bz.Manual}"/></DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Other JKR rules · not in the Borang spec · n fail (sections view) -->
                <Button Style="{StaticResource RowBtn}" Click="Other_Click" Padding="0" AutomationProperties.Name="{Binding OtherRowName}"
                        Visibility="{Binding ShowOtherRow, Converter={StaticResource B2V}}">
                    <Border BorderBrush="{StaticResource Bz.LineSoft}" BorderThickness="0,1,0,0" Padding="16,11,12,11">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Top">
                                <Rectangle RadiusX="6" RadiusY="6" Stroke="{StaticResource Bz.Tone.Listed}" StrokeThickness="1" StrokeDashArray="3 2"/>
                                <TextBlock Text="+" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Bz.Text2}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Column="1" FontSize="13" LineHeight="18" TextWrapping="Wrap" VerticalAlignment="Center">
                                <Run Text="{Binding OtherRowName, Mode=OneWay}" FontWeight="Medium"/><Run Text=" "/><Run Text="{Binding OtherRowNote, Mode=OneWay}" Foreground="{StaticResource Bz.Text2}"/>
                            </TextBlock>
                            <TextBlock Grid.Column="2" Text="{Binding OtherRowCount}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Bz.Tone.Fail}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <Path Grid.Column="3" Style="{StaticResource Icon16}" Stroke="{StaticResource Bz.Text3}" Data="M6.5,4.5 L10,8 L6.5,11.5" Margin="6,0,0,0"/>
                        </Grid>
                    </Border>
                </Button>

                <!-- What aspects are (aspects view) -->
                <Border BorderBrush="{StaticResource Bz.LineSoft}" BorderThickness="0,1,0,0" Padding="16,14,16,0"
                        Visibility="{Binding ShowAspectsNote, Converter={StaticResource B2V}}">
                    <TextBlock Text="{Binding AspectsNote}" FontSize="12" LineHeight="16" Foreground="{StaticResource Bz.Text2}" TextWrapping="Wrap"/>
                </Border>

                <!-- Legend: the states this run has -->
                <Border BorderBrush="{StaticResource Bz.LineSoft}" BorderThickness="0,1,0,0" Padding="16,12,16,0" Margin="0,12,0,0">
                    <ItemsControl ItemsSource="{Binding Legend}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                                    <ContentControl Content="{Binding Tick}" ContentTemplate="{StaticResource Tick}" Width="6" Height="12" Focusable="False" IsTabStop="False" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Label}" FontSize="11" LineHeight="14" Foreground="{StaticResource Bz.TextBody}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- .list: the issue rows (Clear Sheet .iss) -->
        <ScrollViewer x:Name="ListScroll" Grid.Row="6" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding ShowList, Converter={StaticResource B2V}}">
            <StackPanel>
                <Border Background="{StaticResource Bz.ManualBg}" Padding="14,9,14,9"
                        Visibility="{Binding IsManualTab, Converter={StaticResource B2V}}">
                    <TextBlock Text="{Binding ManualIntro}" FontSize="11.5" LineHeight="17" Foreground="{StaticResource Bz.Manual}" TextWrapping="Wrap"/>
                </Border>

                <ItemsControl x:Name="RowsList" ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- .iss: pip · Borang key + title, old → new (mono), meta line · the fix mark -->
                            <Border x:Name="RowBd" Background="Transparent" BorderBrush="{StaticResource Bz.LineSoft}" BorderThickness="0,1,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource Bare}" Tag="{Binding Id}" Click="Row_Click" Padding="16,11,0,11"
                                            AutomationProperties.Name="{Binding Title}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentControl x:Name="Pip" Content="{Binding Sev}" ContentTemplate="{StaticResource Pip}" Focusable="False" IsTabStop="False"
                                                            VerticalAlignment="Top" Margin="0,3,0,0" AutomationProperties.Name="{Binding SvLabel}"/>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock x:Name="Title" FontSize="13" FontWeight="SemiBold" LineHeight="18" Foreground="{StaticResource Bz.Text}" TextWrapping="Wrap">
                                                    <Run Text="{Binding Row, Mode=OneWay}" FontFamily="{StaticResource Bz.Font.Mono}" FontSize="11" FontWeight="Normal" Foreground="{StaticResource Bz.Text2}"/><Run Text="  " FontSize="11"/><Run Text="{Binding Title, Mode=OneWay}"/>
                                                </TextBlock>
                                                <!-- old → new, in IBM Plex Mono -->
                                                <WrapPanel Margin="0,3,0,0" Visibility="{Binding HasChange, Converter={StaticResource B2V}}">
                                                    <TextBlock Text="{Binding OldValue}" FontFamily="{StaticResource Bz.Font.Mono}" FontSize="11.5" LineHeight="18"
                                                               Foreground="{StaticResource Bz.Tone.Fail}" TextDecorations="Strikethrough" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                    <Viewbox Width="12" Height="12" Margin="6,0,6,0" VerticalAlignment="Center">
                                                        <Canvas Width="16" Height="16">
                                                            <Path Style="{StaticResource Ico}" Stroke="{StaticResource Bz.Text3}" Data="M2.5,8 L13.5,8 M9.8,4.5 L13.3,8 L9.8,11.5"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                    <TextBlock Text="{Binding NewValue}" FontFamily="{StaticResource Bz.Font.Mono}" FontSize="11.5" LineHeight="18"
                                                               Foreground="{StaticResource Bz.Tone.PassMark}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                </WrapPanel>
                                                <!-- "No ready-made fix. Needs manual action." -->
                                                <TextBlock Text="{Binding NoFixText}" FontSize="12" LineHeight="17" Foreground="{StaticResource Bz.TextBody}" TextWrapping="Wrap" Margin="0,3,0,0"
                                                           Visibility="{Binding HasNoFixText, Converter={StaticResource B2V}}"/>
                                                <!-- semak manual: why a person decides -->
                                                <TextBlock Text="{Binding Reason}" FontSize="12" LineHeight="17" Foreground="{StaticResource Bz.Manual}" TextWrapping="Wrap" Margin="0,3,0,0"
                                                           Visibility="{Binding IsManual, Converter={StaticResource B2V}}"/>
                                                <TextBlock Text="{Binding FixError}" FontSize="11" LineHeight="15" Foreground="{StaticResource Bz.HighText}" TextWrapping="Wrap" Margin="0,3,0,0"
                                                           Visibility="{Binding HasFixError, Converter={StaticResource B2V}}"/>
                                                <!-- Mark as Manual (option b): stays open, "Manual · you'll fix it in Revit" -->
                                                <Border Background="{StaticResource Bz.Sunken2}" CornerRadius="4" Padding="6,1,6,2" Margin="0,5,0,0" HorizontalAlignment="Left"
                                                        Visibility="{Binding HasManualTag, Converter={StaticResource B2V}}">
                                                    <TextBlock Text="{Binding ManualTag}" FontSize="11" LineHeight="15" FontWeight="SemiBold" Foreground="{StaticResource Bz.TextBody}" TextWrapping="Wrap"/>
                                                </Border>
                                                <TextBlock Text="{Binding Meta}" FontSize="11" LineHeight="15" Foreground="{StaticResource Bz.Text2}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <!-- the ready-made fix (bolt, F) -->
                                    <Button x:Name="FixBtn" Grid.Column="1" Margin="12,11,8,0" VerticalAlignment="Top"
                                            Style="{StaticResource RowIconBtn}" Tag="{Binding Id}" Click="RowFix_Click"
                                            Visibility="{Binding ShowFix, Converter={StaticResource B2V}}"
                                            AutomationProperties.Name="{Binding DataContext.KeyFix, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            ToolTip="{Binding DataContext.KeyFix, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                        <Viewbox Width="14" Height="14">
                                            <Canvas Width="16" Height="16">
                                                <Path Style="{StaticResource Ico}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource BoltGeo}"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Button>
                                    <!-- an AI fixer candidate: the spark-bolt mark (Clear Sheet "AI fix mark", option 1) -->
                                    <Grid Grid.Column="1" Width="32" Height="32" Margin="12,11,8,0" VerticalAlignment="Top" Background="Transparent"
                                          Visibility="{Binding IsAiFixer, Converter={StaticResource B2V}}"
                                          ToolTip="{Binding AiMarkLabel}" AutomationProperties.Name="{Binding AiMarkLabel}">
                                        <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="16" Height="16">
                                                <Path Style="{StaticResource Ico}" Stroke="{StaticResource Bz.TextBody}" Data="{StaticResource SparkBoltGeo}"/>
                                                <Path Fill="{StaticResource Bz.TextBody}" Data="{StaticResource SparkGeo}"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="RowBd" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RowBd" Property="Background" Value="{StaticResource Bz.Sunken}"/>
                                </Trigger>
                                <!-- selected (J / K): the row's grey fill, its fix button framed in white -->
                                <DataTrigger Binding="{Binding IsSel}" Value="True">
                                    <Setter TargetName="RowBd" Property="Background" Value="{StaticResource Bz.Sunken2}"/>
                                    <Setter TargetName="FixBtn" Property="Background" Value="{StaticResource Bz.Surface}"/>
                                    <Setter TargetName="FixBtn" Property="BorderBrush" Value="{StaticResource Bz.Line2}"/>
                                    <Setter TargetName="FixBtn" Property="Foreground" Value="{StaticResource Bz.Text}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter TargetName="Title" Property="Foreground" Value="{StaticResource Bz.Text2}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SvKind}" Value="man">
                                    <Setter TargetName="Pip" Property="Content" Value="man"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- .empty -->
                <StackPanel Margin="20,40,20,36" HorizontalAlignment="Center" Visibility="{Binding ListEmpty, Converter={StaticResource B2V}}">
                    <Border Width="44" Height="44" CornerRadius="8" Background="{StaticResource Bz.Sunken2}" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Path Style="{StaticResource Icon}" Width="18" Height="18" Stroke="{StaticResource Bz.Text2}" HorizontalAlignment="Center"
                              Data="M20,6 L9,17 L4,12"/>
                    </Border>
                    <TextBlock Text="{Binding EmptyTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Bz.Text}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding EmptyHint}" FontSize="12" LineHeight="18" Foreground="{StaticResource Bz.Text2}"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <Button Content="{Binding ClearSearchLabel}" Style="{StaticResource Bz.Btn.Ghost}" HorizontalAlignment="Center" Margin="0,12,0,0" MinHeight="32"
                            Click="ClearQuery_Click" Visibility="{Binding HasQ, Converter={StaticResource B2V}}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Inside a section (Clear Sheet section D): Borang item headers, then one row per check
             (mark, id, title, one line why); a check opens to its card: what the run found, the
             inventory table and elements with "Show all" (item 13), why it fails, Fix n. -->
        <ScrollViewer x:Name="ChecklistScroll" Grid.Row="6" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      BorderBrush="{StaticResource Bz.Line}" BorderThickness="0,1,0,0"
                      Visibility="{Binding IsFocused, Converter={StaticResource B2V}}">
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="{Binding ChecklistEmptyText}" FontSize="12" Foreground="{StaticResource Bz.Text2}" HorizontalAlignment="Center"
                           TextWrapping="Wrap" Margin="16,24,16,24" Visibility="{Binding ChecklistEmpty, Converter={StaticResource B2V}}"/>
                <ItemsControl ItemsSource="{Binding Checklist}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <!-- the section's name, when the open checks come from several sections -->
                                <Border Padding="16,16,16,2" Visibility="{Binding DataContext.ShowSectionHeads, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}">
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Bz.Text}" TextWrapping="Wrap">
                                        <Run Text="{Binding Letter, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Name, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <!-- Borang item (.item): "D-a  Naming follows JKR coding" -->
                                                <TextBlock FontSize="12" LineHeight="16" Foreground="{StaticResource Bz.Text2}" TextWrapping="Wrap" Margin="16,14,16,6">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding No}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="{Binding No, Mode=OneWay}" FontFamily="{StaticResource Bz.Font.Mono}" FontSize="11"/><Run Text="  "/><Run Text="{Binding Title, Mode=OneWay}"/>
                                                </TextBlock>
                                                <!-- an item without a number (the other JKR rules): its title only -->
                                                <TextBlock Text="{Binding Title}" FontSize="12" LineHeight="16" Foreground="{StaticResource Bz.Text2}" TextWrapping="Wrap" Margin="16,14,16,6">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding No}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <ItemsControl ItemsSource="{Binding Checks}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border x:Name="CheckBd" BorderBrush="{StaticResource Bz.LineSoft}" BorderThickness="0,1,0,0" Background="Transparent">
                                                                <StackPanel>
                                                                    <!-- .chk: mark, id + title, chevron; the line under it says why -->
                                                                    <Button Style="{StaticResource RowBtn}" Tag="{Binding Id}" Click="CheckToggle_Click" Padding="16,12,16,12"
                                                                            AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding StateLabel}">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="12"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                            </Grid.RowDefinitions>
                                                                            <ContentControl Content="{Binding Tone}" ContentTemplate="{StaticResource Mark}" Focusable="False" IsTabStop="False"
                                                                                            VerticalAlignment="Top" Margin="0,3,0,0" ToolTip="{Binding StateLabel}"/>
                                                                            <TextBlock x:Name="IdTitle" Grid.Column="1" FontSize="13" LineHeight="18" TextWrapping="Wrap" Margin="12,0,8,0">
                                                                                <Run Text="{Binding ShownId, Mode=OneWay}" FontFamily="{StaticResource Bz.Font.Mono}" FontSize="11.5" Foreground="{StaticResource Bz.Text2}"/><Run Text="  "/><Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/>
                                                                            </TextBlock>
                                                                            <!-- a rule without a spec id (the other JKR rules): its title only -->
                                                                            <TextBlock x:Name="TitleOnly" Grid.Column="1" Text="{Binding Title}" FontSize="13" LineHeight="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="12,0,8,0" Visibility="Collapsed"/>
                                                                            <Path x:Name="Chev" Grid.Column="2" Style="{StaticResource Icon16}" Stroke="{StaticResource Bz.Text3}" Data="M4.5,6.5 L8,10 L11.5,6.5"
                                                                                  VerticalAlignment="Top" Margin="0,1,0,0"/>
                                                                            <!-- why it has this state in one line (else its reference) -->
                                                                            <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12" LineHeight="16" Foreground="{StaticResource Bz.TextBody}" TextWrapping="Wrap" Margin="12,4,8,0">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Text" Value="{Binding Detail}"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding Detail}" Value=""><Setter Property="Text" Value="{Binding Meta}"/></DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </Grid>
                                                                    </Button>

                                                                    <!-- the card (open check) -->
                                                                    <Border Margin="40,0,16,14" Background="{StaticResource Bz.Surface}" CornerRadius="10" BorderBrush="{StaticResource Bz.Line}" BorderThickness="1"
                                                                            Padding="14,12,14,14" Visibility="{Binding IsOpen, Converter={StaticResource B2V}}">
                                                                        <StackPanel>
                                                                            <!-- reference · how it is judged (when the line above is the Detail) -->
                                                                            <TextBlock Text="{Binding Meta}" FontSize="11.5" LineHeight="15" Foreground="{StaticResource Bz.Text2}" TextWrapping="Wrap" Margin="0,0,0,8">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding Detail}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                                            <DataTrigger Binding="{Binding Meta}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                            <!-- a check a person decides that has findings: "3 warnings" (amber, not a fail) -->
                                                                            <Border HorizontalAlignment="Left" Background="{StaticResource Bz.Tone.WarnBg}" CornerRadius="6"
                                                                                    Padding="8,3,8,4" Margin="0,0,0,8" Visibility="{Binding HasWarning, Converter={StaticResource B2V}}">
                                                                                <TextBlock Text="{Binding WarningLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Bz.Tone.Warn}"/>
                                                                            </Border>
                                                                            <!-- what the run found -->
                                                                            <TextBlock Text="{Binding Notes}" FontSize="12" LineHeight="16" Foreground="{StaticResource Bz.TextBody}" TextWrapping="Wrap" Margin="0,0,0,8"
                                                                                       Visibility="{Binding HasNotes, Converter={StaticResource B2V}}"/>
                                                                            <!-- the run's list as an inventory table: first column mono, the rest muted -->
                                                                            <ItemsControl ItemsSource="{Binding ListRows}" Grid.IsSharedSizeScope="True" Focusable="False" Margin="0,0,0,4"
                                                                                          Visibility="{Binding HasListRows, Converter={StaticResource B2V}}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <Grid Margin="0,0,0,8">
                                                                                            <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="ListLead"/>
                                                                                                <ColumnDefinition Width="*"/>
                                                                                            </Grid.ColumnDefinitions>
                                                                                            <TextBlock Text="{Binding Lead, Mode=OneWay}" FontFamily="{StaticResource Bz.Font.Mono}" FontSize="11.5" LineHeight="15" Foreground="{StaticResource Bz.Text}"
                                                                                                       TextWrapping="Wrap" MaxWidth="120" Margin="0,0,12,0"/>
                                                                                            <TextBlock Grid.Column="1" Text="{Binding Rest, Mode=OneWay}" FontSize="12" LineHeight="15" Foreground="{StaticResource Bz.Text2}" TextWrapping="Wrap"/>
                                                                                        </Grid>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                            <TextBlock Text="{Binding ListCutLabel}" FontSize="12" LineHeight="16" Foreground="{StaticResource Bz.Tone.Warn}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                                                       Visibility="{Binding HasListCut, Converter={StaticResource B2V}}"/>
                                                                            <Button Style="{StaticResource LinkButton}" Tag="{Binding Id}" Click="ChecklistMore_Click"
                                                                                    Visibility="{Binding HasListMore, Converter={StaticResource B2V}}" AutomationProperties.Name="{Binding ListMoreLabel}">
                                                                                <TextBlock Text="{Binding ListMoreLabel}" Style="{StaticResource LinkText}" TextWrapping="Wrap"/>
                                                                            </Button>
                                                                            <!-- the elements behind it: open = detail (Locate, Fix, Ignore) -->
                                                                            <ItemsControl ItemsSource="{Binding Elements}" Focusable="False" Margin="-6,0,-6,0"
                                                                                          Visibility="{Binding HasElements, Converter={StaticResource B2V}}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <Button Style="{StaticResource Bare}" Tag="{Binding Id}" Click="ChecklistElement_Click" Padding="6,5,6,5"
                                                                                                AutomationProperties.Name="{Binding Label}">
                                                                                            <Button.Template>
                                                                                                <ControlTemplate TargetType="Button">
                                                                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" MinHeight="32" Padding="{TemplateBinding Padding}">
                                                                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                                                                    </Border>
                                                                                                    <ControlTemplate.Triggers>
                                                                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource Bz.Sunken}"/></Trigger>
                                                                                                    </ControlTemplate.Triggers>
                                                                                                </ControlTemplate>
                                                                                            </Button.Template>
                                                                                            <Grid>
                                                                                                <Grid.ColumnDefinitions>
                                                                                                    <ColumnDefinition Width="*"/>
                                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                                </Grid.ColumnDefinitions>
                                                                                                <StackPanel VerticalAlignment="Center">
                                                                                                    <TextBlock Text="{Binding Label}" FontFamily="{StaticResource Bz.Font.Mono}" FontSize="11.5" LineHeight="15" Foreground="{StaticResource Bz.Text}" TextWrapping="Wrap"/>
                                                                                                    <TextBlock Text="{Binding Detail}" FontSize="12" LineHeight="16" Foreground="{StaticResource Bz.Text2}" TextWrapping="Wrap"/>
                                                                                                </StackPanel>
                                                                                                <TextBlock Grid.Column="1" Text="{Binding Tag}" FontSize="12" Foreground="{StaticResource Bz.Text2}" VerticalAlignment="Top" Margin="10,0,0,0"
                                                                                                           Visibility="{Binding HasTag, Converter={StaticResource B2V}}"/>
                                                                                            </Grid>
                                                                                        </Button>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                            <TextBlock Text="{Binding ElementsCutLabel}" FontSize="12" LineHeight="16" Foreground="{StaticResource Bz.Tone.Warn}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                                                       Visibility="{Binding HasElementsCut, Converter={StaticResource B2V}}"/>
                                                                            <Button Style="{StaticResource LinkButton}" Tag="{Binding Id}" Click="ChecklistMore_Click"
                                                                                    Visibility="{Binding HasMore, Converter={StaticResource B2V}}" AutomationProperties.Name="{Binding MoreLabel}">
                                                                                <TextBlock Text="{Binding MoreLabel}" Style="{StaticResource LinkText}" TextWrapping="Wrap"/>
                                                                            </Button>
                                                                            <!-- "Why this fails": the spec's criterion and what was tested -->
                                                                            <Button Style="{StaticResource LinkButton}" Tag="{Binding Id}" Click="CheckWhy_Click"
                                                                                    Visibility="{Binding CanToggleWhy, Converter={StaticResource B2V}}" AutomationProperties.Name="{Binding WhyToggleLabel}">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <Path x:Name="WhyChev" Style="{StaticResource Icon16}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                                          Data="M6.5,4.5 L10,8 L6.5,11.5"/>
                                                                                    <TextBlock Text="{Binding WhyToggleLabel}" Style="{StaticResource LinkText}" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                                                                </StackPanel>
                                                                            </Button>
                                                                            <Border BorderBrush="{StaticResource Bz.Line2}" BorderThickness="2,0,0,0" Padding="10,1,0,2" Margin="0,4,0,4"
                                                                                    Visibility="{Binding ShowWhy, Converter={StaticResource B2V}}">
                                                                                <StackPanel>
                                                                                    <TextBlock Text="{Binding WhyLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Bz.Text2}" TextWrapping="Wrap"
                                                                                               Visibility="{Binding HasWhy, Converter={StaticResource B2V}}"/>
                                                                                    <TextBlock Text="{Binding WhyText}" FontSize="12" LineHeight="16" Foreground="{StaticResource Bz.TextBody}" TextWrapping="Wrap" Margin="0,1,0,0"
                                                                                               Visibility="{Binding HasWhy, Converter={StaticResource B2V}}"/>
                                                                                    <!-- the rule awaits JKR's confirmation: shown whatever the state -->
                                                                                    <StackPanel Margin="0,6,0,0" Visibility="{Binding HasPending, Converter={StaticResource B2V}}">
                                                                                        <TextBlock Text="{Binding PendingLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Bz.Tone.Pending}" TextWrapping="Wrap"/>
                                                                                        <TextBlock Text="{Binding PendingText}" FontSize="12" LineHeight="16" Foreground="{StaticResource Bz.TextBody}" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                                                                    </StackPanel>
                                                                                    <TextBlock Text="{Binding Tested}" FontSize="11.5" LineHeight="15" Foreground="{StaticResource Bz.Text2}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                                                               Visibility="{Binding HasTested, Converter={StaticResource B2V}}"/>
                                                                                </StackPanel>
                                                                            </Border>
                                                                            <!-- Fix n: the same confirm + AI-fix path as Fix all -->
                                                                            <Button Style="{StaticResource Bz.Btn.Primary}" Tag="{Binding Id}" Click="ChecklistFix_Click"
                                                                                    HorizontalAlignment="Left" Margin="0,6,0,0" Padding="12,0,12,0" MinHeight="32" FontSize="13"
                                                                                    IsEnabled="{Binding DataContext.CanAct, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                    Visibility="{Binding CanFix, Converter={StaticResource B2V}}">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <Path Style="{StaticResource Icon16}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                                          Data="M9,1.8 L3.8,9 L7.8,9 L7,14.2 L12.2,7 L8.2,7 Z"/>
                                                                                    <TextBlock Text="{Binding FixLabel}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                                                </StackPanel>
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </StackPanel>
                                                            </Border>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding ShownId}" Value="">
                                                                    <Setter TargetName="IdTitle" Property="Visibility" Value="Collapsed"/>
                                                                    <Setter TargetName="TitleOnly" Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ShowWhy}" Value="True">
                                                                    <Setter TargetName="WhyChev" Property="Data" Value="M4.5,6.5 L8,10 L11.5,6.5"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                                    <Setter TargetName="CheckBd" Property="Background" Value="{StaticResource Bz.Sunken}"/>
                                                                    <Setter TargetName="Chev" Property="Data" Value="M4.5,9.5 L8,6 L11.5,9.5"/>
                                                                    <Setter TargetName="Chev" Property="Stroke" Value="{StaticResource Bz.Text2}"/>
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer (60 px): Reset (text), keyboard shortcuts, Export Borang (secondary) -->
        <Border Grid.Row="7" Background="{StaticResource Bz.Sunken}" BorderBrush="{StaticResource Bz.Line}" BorderThickness="0,1,0,0" Padding="8,12,16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource TextBtn}" Click="Reset_Click" IsEnabled="{Binding CanAct}" MinHeight="36" Padding="10,0,12,0"
                        AutomationProperties.Name="{Binding ResetLabel}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon16}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M3,8 A5,5 0 1 0 4.46,4.46 M3,2.5 L3,5 L5.5,5"/>
                        <TextBlock Text="{Binding ResetLabel}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!-- the list keys (J/K, Enter, F, A, /) work on the issue tabs: listed here -->
                <Button Grid.Column="1" Style="{StaticResource TextBtn}" Width="32" Height="32" Padding="0" HorizontalContentAlignment="Center"
                        AutomationProperties.Name="{Binding KeysAria}" ToolTipService.InitialShowDelay="200">
                    <Button.ToolTip>
                        <ToolTip>
                            <WrapPanel Orientation="Horizontal" MaxWidth="260">
                                <Border Style="{StaticResource Bz.Kbd}"><TextBlock Text="⏎" Style="{StaticResource KeyCap}"/></Border>
                                <TextBlock Text="{Binding KeyOpen}" Style="{StaticResource KeyLabel}"/>
                                <Border Style="{StaticResource Bz.Kbd}"><TextBlock Text="J/K" Style="{StaticResource KeyCap}"/></Border>
                                <TextBlock Text="{Binding KeyNav}" Style="{StaticResource KeyLabel}"/>
                                <Border Style="{StaticResource Bz.Kbd}"><TextBlock Text="F" Style="{StaticResource KeyCap}"/></Border>
                                <TextBlock Text="{Binding KeyFix}" Style="{StaticResource KeyLabel}"/>
                                <Border Style="{StaticResource Bz.Kbd}"><TextBlock Text="A" Style="{StaticResource KeyCap}"/></Border>
                                <TextBlock Text="{Binding KeyIgnore}" Style="{StaticResource KeyLabel}"/>
                                <Border Style="{StaticResource Bz.Kbd}"><TextBlock Text="/" Style="{StaticResource KeyCap}"/></Border>
                                <TextBlock Text="{Binding SearchPlaceholder}" Style="{StaticResource KeyLabel}"/>
                            </WrapPanel>
                        </ToolTip>
                    </Button.ToolTip>
                    <Path Style="{StaticResource Icon16}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center"
                          Data="M3,4 L13,4 A1.5,1.5 0 0 1 14.5,5.5 L14.5,10.5 A1.5,1.5 0 0 1 13,12 L3,12 A1.5,1.5 0 0 1 1.5,10.5 L1.5,5.5 A1.5,1.5 0 0 1 3,4 Z M4.2,6.6 L4.3,6.6 M6.7,6.6 L6.8,6.6 M9.2,6.6 L9.3,6.6 M11.7,6.6 L11.8,6.6 M5,9.4 L11,9.4"/>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource Bz.Btn.Ghost}" Click="Export_Click" IsEnabled="{Binding CanAct}" MinHeight="36" Padding="14,0,14,0"
                        FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Bz.Text}" BorderBrush="{StaticResource Bz.Line2}"
                        AutomationProperties.Name="{Binding ExportLabel}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon16}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M8,2.5 L8,10.5 M4.8,7.3 L8,10.5 L11.2,7.3 M3,13.5 L13,13.5"/>
                        <TextBlock Text="{Binding ExportLabel}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
