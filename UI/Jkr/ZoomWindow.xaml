<Window x:Class="RevitWebAppSync.UI.Jkr.ZoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:jkr="clr-namespace:RevitWebAppSync.UI.Jkr"
        xmlns:vm="clr-namespace:RevitWebAppSync.UI.Jkr.ViewModels"
        Title="Model Audit · BIM 005"
        Width="900" Height="640" MinWidth="520" MinHeight="360"
        Background="#F7F8FA" FontFamily="Segoe UI, system-ui, sans-serif"
        Foreground="#14171C"
        WindowStartupLocation="CenterOwner" ShowActivated="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevitWebAppSync;component/UI/Jkr/Tokens.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/RevitWebAppSync;component/UI/Jkr/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <jkr:HexToBrushConverter x:Key="Hex"/>
            <jkr:BoolToVisibilityConverter x:Key="B2V"/>
            <jkr:RuleStatusConverter x:Key="RuleStatus"/>
            <jkr:CountGtZeroConverter x:Key="GtZero"/>
            <jkr:EqualsParamConverter x:Key="EqP"/>

            <!-- Group card header only; rows are read-only in zoom -->
            <DataTemplate x:Key="ZoomGroup">
                <Border Margin="0,0,0,8" Padding="14,12"
                        Background="#FFFFFF" BorderBrush="#E2E5E9" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Item}" FontFamily="{StaticResource Font.Mono}"
                                       FontWeight="Bold" FontSize="15" Foreground="{StaticResource JkrCopilot.Navy}"/>
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource JkrCopilot.Ink}" Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding IsOpen, Converter={StaticResource B2V}}"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Rules}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,7" CornerRadius="8"
                                            Background="#F3F4F6" BorderBrush="#ECEEF1"
                                            BorderThickness="1" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Severity bar: colour follows the tier, not a
                                                 blanket red (Build Diff delta 03). -->
                                            <Border Width="2" Grid.Column="0" HorizontalAlignment="Left"
                                                    Background="{Binding SevBar, Converter={StaticResource Hex}}"/>
                                            <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                                <TextBlock Text="{Binding Title}" FontSize="13"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource JkrCopilot.Ink}"/>
                                                <!-- Diff line: what is wrong, not merely how much
                                                     (Build Diff delta 05). -->
                                                <TextBlock Text="{Binding DiffLine}" FontFamily="{StaticResource Font.Mono}"
                                                           FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                                           Foreground="#4A5158"/>
                                                <TextBlock Text="{Binding SubLine}" FontFamily="{StaticResource Font.Mono}"
                                                           FontSize="9.5" Margin="0,3,0,0"
                                                           Foreground="{StaticResource JkrCopilot.Muted}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                        HorizontalAlignment="Right" Margin="0,0,2,0">
                                                <Border Padding="5,2" CornerRadius="4" BorderThickness="1"
                                                        HorizontalAlignment="Right"
                                                        Background="{Binding SevBg, Converter={StaticResource Hex}}"
                                                        BorderBrush="{Binding SevBd, Converter={StaticResource Hex}}">
                                                    <TextBlock Text="{Binding SevTag}" FontFamily="{StaticResource Font.Mono}"
                                                               FontSize="9" FontWeight="SemiBold"
                                                               Foreground="{Binding SevFg, Converter={StaticResource Hex}}"/>
                                                </Border>
                                                <!-- The action belongs on the row where the finding is
                                                     (Build Diff delta 02). Hidden when no auto-fix exists,
                                                     so it never promises a fix that is not available. -->
                                                <Button Content="⚡ Fix" Click="RuleFix_Click" Tag="{Binding Id}"
                                                        Margin="0,6,0,0" MinHeight="30" Padding="12,0" Cursor="Hand"
                                                        HorizontalAlignment="Right"
                                                        Background="White" Foreground="#1F3A5F" BorderBrush="#C6D3E1"
                                                        BorderThickness="1" FontSize="11.5" FontWeight="SemiBold"
                                                        Visibility="{Binding IsFixable, Converter={StaticResource B2V}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <!-- The six regions the design specifies, top to bottom. The shipped window
             carried only 1, a partial 3, and 5 — toolbar, leverage band and status bar
             were absent entirely (Build Diff, "Window structure"). -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 2 toolbar -->
            <RowDefinition Height="Auto"/>   <!-- 3 summary bar -->
            <RowDefinition Height="Auto"/>   <!-- 4 leverage band -->
            <RowDefinition Height="*"/>      <!-- 5 rail + list -->
            <RowDefinition Height="Auto"/>   <!-- 6 status bar -->
        </Grid.RowDefinitions>

        <!-- ── 2 TOOLBAR ── run context plus every bulk action. Without this Fix all,
             Ignore all and Export had no home in the window at all, so the bulk actions
             were unreachable from the view where the work happens (delta 07). -->
        <Border Grid.Row="0" Margin="0,0,0,14" Padding="0,0,0,10"
                BorderBrush="{StaticResource JkrCopilot.Line}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           FontFamily="{StaticResource Font.Mono}" FontSize="11"
                           Foreground="{StaticResource JkrCopilot.Muted}">
                    <Run Text="LOD "/><Run Text="{Binding SelectedLodLevel, Mode=OneWay}"/>
                    <Run Text="  ·  "/><Run Text="{Binding SelectedDiscipline, Mode=OneWay}"/>
                    <Run Text="  ·  "/><Run Text="{Binding ReportLanguage, Mode=OneWay}"/>
                </TextBlock>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Ignore all" Click="IgnoreAll_Click" Style="{StaticResource Btn.Sec}" Margin="0,0,8,0"/>
                    <Button Content="Fix all" Click="FixAll_Click" Style="{StaticResource Btn.Sec}" Margin="0,0,8,0"/>
                    <Button Content="Export Borang" Click="Export_Click" Style="{StaticResource Btn.Sec}" Margin="0,0,8,0"/>
                    <Button Content="⤓ Dock back" Click="Dock_Click" Style="{StaticResource Btn.Sec}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Hero. The "AUTO-FIX QUEUE" strap is gone: it is not in the design and it
             named an action the window did not carry (Build Diff). The document name
             now lives in the title bar instead. -->
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Summary.Pct}" FontFamily="{StaticResource Font.Mono}"
                           FontSize="52" FontWeight="Bold" Foreground="{StaticResource JkrCopilot.Navy}"/>
                <TextBlock Text="%" FontSize="30" FontWeight="Bold"
                           Foreground="{StaticResource JkrCopilot.Navy}" Margin="2,8,0,0"/>
                <TextBlock VerticalAlignment="Bottom" Margin="16,0,0,6" FontSize="14"
                           Foreground="{StaticResource JkrCopilot.Muted}">
                    <Run Text="{Binding Summary.Verified, Mode=OneWay, StringFormat={}{0:N0}}"/><Run Text=" comply"/>
                    <Run Text=" · "/>
                    <Run Text="{Binding Summary.Failed, Mode=OneWay, StringFormat={}{0:N0}}"/><Run Text=" not comply"/>
                </TextBlock>

                <!-- The semak-manual figure, behind a dashed divider and explicitly OUTSIDE
                     the percentage. The window had dropped it, so it disagreed with the
                     docked panel about the state of the model and implied the AI had scored
                     cells it refused to judge (Build Diff delta 04, principle 0.4). -->
                <Border Width="1" Margin="18,6,0,8" BorderThickness="1,0,0,0"
                        BorderBrush="{StaticResource JkrCopilot.Line}"/>
                <TextBlock VerticalAlignment="Bottom" Margin="16,0,0,6" FontSize="14"
                           Foreground="{StaticResource JkrCopilot.Manual}">
                    <Run Text="{Binding ManualRuleCells, Mode=OneWay, StringFormat={}{0:N0}}" FontWeight="Bold"/><Run Text="  cells need you, not the AI"/>
                </TextBlock>
            </StackPanel>

            <!-- The bar the hero was missing. Spans the AI-verifiable budget only: the
                 manual cells above sit outside it by design, never inside the fill. -->
            <ProgressBar Height="6" Margin="0,12,0,0" Minimum="0" Maximum="100"
                         Value="{Binding Summary.Pct, Mode=OneWay}"
                         Foreground="{StaticResource JkrCopilot.Success}"
                         Background="#F0D9D6" BorderThickness="0"/>
        </StackPanel>

        <!-- Leverage band. This was the answer to the original brief: without it the
             window states a problem and offers no route out (Build Diff delta 01). -->
        <Border Grid.Row="2" Margin="0,0,0,14" Padding="14,12"
                Background="{StaticResource JkrCopilot.Banner}"
                BorderBrush="{StaticResource JkrCopilot.Line5}" BorderThickness="0,0,0,1"
                Visibility="{Binding RowsFail, Converter={StaticResource GtZero}}">
            <StackPanel>
                <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="12.5" FontWeight="Bold"
                           Foreground="{StaticResource JkrCopilot.Navy}">
                    <Run Text="{Binding RowsFail, Mode=OneWay, StringFormat={}{0} form rows will come back NOT COMPLY}"/>
                </TextBlock>
                <TextBlock Text="{Binding Leverage}" FontSize="11" Margin="0,6,0,0"
                           Foreground="{StaticResource JkrCopilot.Muted}" TextWrapping="Wrap"/>
                <Button Content="Apply those fixes first" Click="FixTop_Click"
                        Margin="0,10,0,0" HorizontalAlignment="Left"
                        Background="{StaticResource JkrCopilot.Navy}" Foreground="White"
                        BorderThickness="0" Padding="13,6"
                        FontSize="10.5" FontWeight="SemiBold" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- ── 5 RAIL + LIST ── the section figures were display-only, which removed the
             only way to work one Borang section at a time — how the form is actually
             reviewed and signed off (delta 06). They are now a filterable rail. -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          Style="{StaticResource ThinScroll}">
                <StackPanel>
                    <TextBlock Text="BORANG SECTIONS" FontFamily="{StaticResource Font.Mono}"
                               FontSize="9.5" Margin="0,0,0,8"
                               Foreground="{StaticResource JkrCopilot.Muted}"/>
                    <Button Content="Everything" Click="Section_Click" Tag="{x:Null}"
                            HorizontalContentAlignment="Left" Padding="10,7" Cursor="Hand"
                            Background="Transparent" BorderThickness="0" FontSize="12.5"
                            FontWeight="SemiBold" Foreground="{StaticResource JkrCopilot.Ink}"/>
                    <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="Section_Click" Tag="{Binding Id}" Cursor="Hand"
                                        HorizontalContentAlignment="Stretch" Padding="10,7"
                                        Background="Transparent" BorderThickness="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Id}" FontWeight="Bold"
                                                   FontSize="12.5" MinWidth="16"
                                                   Foreground="{StaticResource JkrCopilot.Navy}"/>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Name}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource JkrCopilot.Ink}"/>
                                            <TextBlock Text="{Binding OpenCellsLabel}" FontFamily="{StaticResource Font.Mono}"
                                                       FontSize="9.5" Margin="0,2,0,0"
                                                       Foreground="{StaticResource JkrCopilot.Muted}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Pct, StringFormat={}{0}%}"
                                                   FontFamily="{StaticResource Font.Mono}" FontSize="13"
                                                   FontWeight="Bold" VerticalAlignment="Center"
                                                   Foreground="{Binding Color, Converter={StaticResource Hex}}"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- List and detail share the area beside the rail, exactly as the design
                 splits it (sc-if noDetail / sc-if hasDetail, .dc.html:496-628): the rail
                 stays put, the queue gives way to the finding. -->
            <Grid Grid.Column="2"
                  Visibility="{Binding HasDetail, Converter={StaticResource B2V}, ConverterParameter=Invert}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Tabs + search. Without these, manual items could not be separated from
                     failures, resolved work could not be confirmed, and the only way to
                     reach a known finding was scrolling (delta 08). -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="240"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Click="Tab_Click" Tag="{x:Static vm:CopilotTab.Open}" Style="{StaticResource Btn.Sec}" Margin="0,0,6,0">
                            <TextBlock><Run Text="Open "/><Run Text="{Binding OpenRuleCells, Mode=OneWay, StringFormat={}{0:N0}}"/></TextBlock>
                        </Button>
                        <Button Click="Tab_Click" Tag="{x:Static vm:CopilotTab.Manual}" Style="{StaticResource Btn.Sec}" Margin="0,0,6,0">
                            <TextBlock><Run Text="Manual "/><Run Text="{Binding ManualRuleCells, Mode=OneWay, StringFormat={}{0:N0}}"/></TextBlock>
                        </Button>
                        <Button Click="Tab_Click" Tag="{x:Static vm:CopilotTab.Ignored}" Style="{StaticResource Btn.Sec}" Margin="0,0,6,0">
                            <TextBlock><Run Text="Ignored "/><Run Text="{Binding IgnoredRuleCells, Mode=OneWay, StringFormat={}{0:N0}}"/></TextBlock>
                        </Button>
                        <Button Click="Tab_Click" Tag="{x:Static vm:CopilotTab.Resolved}" Style="{StaticResource Btn.Sec}">
                            <TextBlock><Run Text="Fixed "/><Run Text="{Binding ResolvedRuleCells, Mode=OneWay, StringFormat={}{0:N0}}"/></TextBlock>
                        </Button>
                    </StackPanel>
                    <TextBox Grid.Column="1" Style="{StaticResource Tb.Search}" VerticalAlignment="Center"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Style="{StaticResource ThinScroll}">
                    <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource ZoomGroup}"/>
                </ScrollViewer>
            </Grid>

            <!-- ── 5b FOCUS PANE ── the design's hasDetail region (.dc.html:562-628).
                 The inline row already carried the Build Diff line, but Checked, Required,
                 In model and Clause had nowhere to land, so ⏎ opened onto nothing and the
                 window could state a failure without ever citing the clause behind it. -->
            <Border Grid.Column="2" Background="{StaticResource JkrCopilot.Surf}"
                    BorderBrush="{StaticResource JkrCopilot.Line}" BorderThickness="1"
                    CornerRadius="10"
                    Visibility="{Binding HasDetail, Converter={StaticResource B2V}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header: the way back, the position in the queue, and the two
                         nav keys spelled out on the buttons that do the same thing. -->
                    <Border Grid.Row="0" Padding="14,10" Background="{StaticResource JkrCopilot.Bg}"
                            BorderBrush="{StaticResource JkrCopilot.Line2}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="← All issues" Click="DetailBack_Click"
                                    Style="{StaticResource Btn.Sec}"/>
                            <TextBlock Grid.Column="1" Text="{Binding DetailPosition}" Margin="12,0,0,0"
                                       VerticalAlignment="Center" FontFamily="{StaticResource Font.Mono}"
                                       FontSize="11" Foreground="{StaticResource JkrCopilot.Muted}"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="↑ K" Click="NavPrev_Click" Style="{StaticResource Btn.Sec}" Margin="0,0,6,0"/>
                                <Button Content="↓ J" Click="NavNext_Click" Style="{StaticResource Btn.Sec}" Margin="0,0,6,0"/>
                                <Button Content="✕" Click="DetailBack_Click" Style="{StaticResource Btn.Sec}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Style="{StaticResource ThinScroll}">
                        <StackPanel Margin="20,16,20,18">
                            <StackPanel Orientation="Horizontal">
                                <Border Padding="6,2" CornerRadius="4" BorderThickness="1"
                                        Background="{Binding DetailRule.SevBg, Converter={StaticResource Hex}}"
                                        BorderBrush="{Binding DetailRule.SevBd, Converter={StaticResource Hex}}">
                                    <TextBlock Text="{Binding DetailRule.SevTag}" FontFamily="{StaticResource Font.Mono}"
                                               FontSize="9.5" FontWeight="SemiBold"
                                               Foreground="{Binding DetailRule.SevFg, Converter={StaticResource Hex}}"/>
                                </Border>
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                           FontFamily="{StaticResource Font.Mono}" FontSize="10.5"
                                           Foreground="{StaticResource JkrCopilot.Muted}">
                                    <Run Text="{Binding DetailRule.Item, Mode=OneWay}"/><Run Text=" · "/>
                                    <Run Text="{Binding DetailRule.Cat, Mode=OneWay}"/><Run Text=" · "/>
                                    <Run Text="{Binding DetailRule.Cells, Mode=OneWay, StringFormat={}{0:N0} cells}"/>
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Text="{Binding DetailRule.Title}" Margin="0,12,0,0" FontSize="19"
                                       FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{StaticResource JkrCopilot.Ink}"/>
                            <TextBlock Text="{Binding DetailRule.Checked}" Margin="0,6,0,0" FontSize="13"
                                       TextWrapping="Wrap" Foreground="#4A5158"/>

                            <!-- Required / In model / Clause — the three lines the inline
                                 DiffLine compresses into one and the design keeps apart. -->
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="REQUIRED" Margin="0,10,0,0"
                                           FontFamily="{StaticResource Font.Mono}" FontSize="9.5"
                                           Foreground="{StaticResource JkrCopilot.Muted}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DetailRule.Req}" Margin="0,10,0,0"
                                           FontFamily="{StaticResource Font.Mono}" FontSize="12" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="IN MODEL" Margin="0,10,0,0"
                                           FontFamily="{StaticResource Font.Mono}" FontSize="9.5"
                                           Foreground="{StaticResource JkrCopilot.Muted}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DetailRule.Act}" Margin="0,10,0,0"
                                           FontFamily="{StaticResource Font.Mono}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource JkrCopilot.Danger}"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="CLAUSE" Margin="0,10,0,0"
                                           FontFamily="{StaticResource Font.Mono}" FontSize="9.5"
                                           Foreground="{StaticResource JkrCopilot.Muted}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DetailRule.Cite}" Margin="0,10,0,0"
                                           FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource JkrCopilot.Navy}"/>
                            </Grid>

                            <!-- Proposed fix — the from/to pair, shown only where an
                                 auto-fix exists so the pane never offers one it lacks. -->
                            <Border Margin="0,18,0,0" CornerRadius="8" BorderThickness="1"
                                    BorderBrush="{StaticResource JkrCopilot.Line5}"
                                    Visibility="{Binding DetailRule.IsFixable, Converter={StaticResource B2V}}">
                                <StackPanel>
                                    <Border Padding="13,10" Background="{StaticResource JkrCopilot.Surf3}">
                                        <StackPanel>
                                            <TextBlock Text="Proposed fix" FontSize="13.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource JkrCopilot.Navy}"/>
                                            <TextBlock Margin="0,2,0,0" FontSize="11.5" TextWrapping="Wrap"
                                                       Foreground="#4A5158">
                                                <Run Text="{Binding DetailRule.Cells, Mode=OneWay, StringFormat={}{0:N0} cells}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding DetailRule.Rows, Mode=OneWay, StringFormat={}{0} Borang rows}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Margin="14,12,14,12" Background="Transparent">
                                        <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="12">
                                            <Run Text="− " Foreground="#B3261E"/><Run
                                                Text="{Binding DetailRule.From, Mode=OneWay}"
                                                Background="{StaticResource JkrCopilot.FailBg}"/>
                                        </TextBlock>
                                        <TextBlock Margin="0,5,0,0" FontFamily="{StaticResource Font.Mono}" FontSize="12">
                                            <Run Text="+ " Foreground="#1F7A4D"/><Run
                                                Text="{Binding DetailRule.To, Mode=OneWay}"
                                                Background="{StaticResource JkrCopilot.AddBg}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Content="⚡ Apply to model   F" Click="DetailApply_Click"
                                            Background="{StaticResource JkrCopilot.Navy}" Foreground="White"
                                            BorderThickness="0" Padding="14" FontSize="13" FontWeight="SemiBold"
                                            Cursor="Hand"/>
                                </StackPanel>
                            </Border>

                            <!-- Manual: no tick, no cross, no guess — the three verdicts
                                 the user records, none of which touch the percentage. -->
                            <Border Margin="0,18,0,0" Padding="14" CornerRadius="8" BorderThickness="1"
                                    Background="#0D3F5C7A" BorderBrush="{StaticResource JkrCopilot.Dash}"
                                    Visibility="{Binding DetailRule.Kind, Converter={StaticResource EqP}, ConverterParameter=manual}">
                                <StackPanel>
                                    <TextBlock Text="Why this is yours to call" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource JkrCopilot.DarkSoft}"/>
                                    <TextBlock Text="{Binding DetailRule.Reason}" Margin="0,8,0,0" FontSize="12.5"
                                               LineHeight="19" TextWrapping="Wrap" Foreground="{StaticResource JkrCopilot.Soft2}"/>
                                    <Button Content="I confirm comply" Click="DetailComply_Click" Margin="0,12,0,0"
                                            Padding="11" Background="White" Foreground="#1F7A4D"
                                            BorderBrush="#1F7A4D" BorderThickness="1"
                                            FontSize="12.5" FontWeight="SemiBold" Cursor="Hand"/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Not comply" Click="DetailNot_Click"
                                                Padding="10" Background="White" Foreground="#B3261E"
                                                BorderBrush="#B3261E" BorderThickness="1"
                                                FontSize="11.5" FontWeight="SemiBold" Cursor="Hand"/>
                                        <Button Grid.Column="2" Content="Leave for JKR" Click="DetailDefer_Click"
                                                Padding="10" Background="White" Foreground="#5C636B"
                                                BorderBrush="#DBDFE4" BorderThickness="1"
                                                FontSize="11.5" FontWeight="SemiBold" Cursor="Hand"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Padding="14,10" Background="{StaticResource JkrCopilot.Bg}"
                            BorderBrush="{StaticResource JkrCopilot.Line2}" BorderThickness="0,1,0,0">
                        <Button Content="Ignore" Click="DetailIgnore_Click" HorizontalAlignment="Right"
                                Style="{StaticResource Btn.Sec}"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ── 6 STATUS BAR ── J/K, F and A already worked but were undiscoverable, so the
             fast path through 722 findings went unused (delta 14). -->
        <Border Grid.Row="4" Margin="0,12,0,0" Padding="0,9,0,0"
                BorderBrush="{StaticResource JkrCopilot.Line}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- The keys, then what they would act on. J/K move a cursor that is
                     otherwise invisible until ⏎ opens it, so the cursor has to be
                     readable somewhere or the nav keys feel inert. -->
                <TextBlock Grid.Column="0" FontFamily="{StaticResource Font.Mono}" FontSize="10.5"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource JkrCopilot.Muted}">
                    <Run Text="↵ open   J/K nav   F fix   A ignore   ESC dock"/>
                    <Run Text="   ▸ " Foreground="{StaticResource JkrCopilot.Dash2}"/>
                    <Run Text="{Binding DetailPosition, Mode=OneWay}"/>
                    <Run Text=" "/>
                    <Run Text="{Binding CursorRule.Title, Mode=OneWay}"
                         Foreground="{StaticResource JkrCopilot.Ink}"/>
                </TextBlock>
                <TextBlock Grid.Column="1" FontFamily="{StaticResource Font.Mono}" FontSize="10.5"
                           Foreground="{StaticResource JkrCopilot.Muted}">
                    <Run Text="{Binding RowsFail, Mode=OneWay}"/><Run Text=" rows failing · "/>
                    <Run Text="{Binding ManualRuleCells, Mode=OneWay, StringFormat={}{0:N0}}"/><Run Text=" semak manual · BIM 005 · PINDAAN 00"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- ── CONFIRM SHEET ── the ask-first gate (design :657-666). Fix all, Ignore
             all, ⚡ Fix and the F key all set a ConfirmRequest; without this the window
             raised the sheet and never showed it, so those actions looked dead and
             nothing was ever written. Nothing is written until you confirm. -->
        <Grid Grid.RowSpan="5" Panel.ZIndex="9"
              Visibility="{Binding HasConfirm, Converter={StaticResource B2V}}">
            <Border Background="#2A2422" Opacity="0.42"/>
            <Border Width="452" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{StaticResource JkrCopilot.Surf}" CornerRadius="12"
                    BorderBrush="{StaticResource JkrCopilot.Navy}" BorderThickness="0,2,0,0">
                <StackPanel Margin="20">
                    <TextBlock Text="{Binding ConfirmRequest.Title}" FontSize="15" FontWeight="Bold"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ConfirmRequest.Body}" Margin="0,10,0,0" FontSize="12.5"
                               Foreground="{StaticResource JkrCopilot.Ink2}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ConfirmRequest.Note}" Margin="0,10,0,0" FontSize="10.5"
                               FontFamily="{StaticResource Font.Mono}"
                               Foreground="{StaticResource JkrCopilot.Muted}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Cancel" Click="ConfirmNo_Click" Style="{StaticResource Btn.Sec}"
                                Margin="0,0,8,0"/>
                        <Button Content="{Binding ConfirmRequest.Cta}" Click="ConfirmYes_Click"
                                Background="{StaticResource JkrCopilot.Navy}" Foreground="White"
                                BorderThickness="0" Padding="16,9" FontSize="12" FontWeight="SemiBold"
                                Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>