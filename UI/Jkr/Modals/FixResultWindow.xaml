<Window x:Class="RevitWebAppSync.UI.Jkr.Modals.FixResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="600" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        Background="Transparent" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" FontFamily="{DynamicResource Bz.Font.Sans}" FontSize="13"
        Foreground="{DynamicResource Bz.Text}" TextOptions.TextFormattingMode="Display">
    <!-- Fix outcome (Clear Sheet "fix outcome"): the 520 white card, "n changes written,
         m not written", the one-undo-step line with the green tick, one grey card per
         reason (title and count, the how-to tip, "[id] element" rows with Locate), "The m
         changes not written stay in Open.", and Copy list for BIM manager / Done on the
         68 px footer. DataContext: FixResultModel. No animation. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevitWebAppSync;component/UI/Jkr/Panel/PanelTokens.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="B2V"/>

            <!-- 16-unit line icons (Clear Sheet .ic: stroke 1.6, round caps) -->
            <Style x:Key="Ico" TargetType="Path">
                <Setter Property="StrokeThickness" Value="1.6"/>
                <Setter Property="StrokeStartLineCap" Value="Round"/>
                <Setter Property="StrokeEndLineCap" Value="Round"/>
                <Setter Property="StrokeLineJoin" Value="Round"/>
                <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Style>
            <Geometry x:Key="LocateGeo">M8,4 A4,4 0 1 1 7.99,4 Z M8,1.5 L8,4 M8,12 L8,14.5 M1.5,8 L4,8 M12,8 L14.5,8</Geometry>
            <Geometry x:Key="CopyGeo">M7,5.5 L12,5.5 A1.5,1.5 0 0 1 13.5,7 L13.5,12 A1.5,1.5 0 0 1 12,13.5 L7,13.5 A1.5,1.5 0 0 1 5.5,12 L5.5,7 A1.5,1.5 0 0 1 7,5.5 Z M3,10.5 L3,4.5 A1.5,1.5 0 0 1 4.5,3 L10.5,3</Geometry>

            <!-- Clear Sheet .btn: 36 px, radius 8, 600 13 px -->
            <Style x:Key="Btn" TargetType="Button">
                <Setter Property="Height" Value="36"/>
                <Setter Property="Padding" Value="14,0,14,0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource Bz.FocusRing}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- .pri: ink fill -->
            <Style x:Key="BtnPri" TargetType="Button" BasedOn="{StaticResource Btn}">
                <Setter Property="Background" Value="{StaticResource Bz.Ink}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Bz.Ink}"/>
                <Setter Property="Foreground" Value="{StaticResource Bz.OnBrand}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource Bz.InkHover}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Bz.InkHover}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- .gh: text button -->
            <Style x:Key="BtnGh" TargetType="Button" BasedOn="{StaticResource Btn}">
                <Setter Property="Padding" Value="12,0,12,0"/>
                <Setter Property="Foreground" Value="{StaticResource Bz.TextBody}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource Bz.Hover}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Bz.Hover}"/>
                        <Setter Property="Foreground" Value="{StaticResource Bz.Text}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- .lk: Locate, 28 px, radius 6, ink 600 12 px; hover a step darker than the card -->
            <Style x:Key="BtnLocate" TargetType="Button" BasedOn="{StaticResource Btn}">
                <Setter Property="Height" Value="28"/>
                <Setter Property="Padding" Value="8,0,8,0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource Bz.Ink}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource Bz.Line}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Scrim over Revit; a click on it closes. -->
    <Grid x:Name="Scrim" Background="{StaticResource Bz.Scrim}" MouseLeftButtonDown="Scrim_MouseDown">
        <Border x:Name="Card" Width="520" Margin="40" Background="{StaticResource Bz.Surface}"
                BorderBrush="{StaticResource Bz.Line}" BorderThickness="1" CornerRadius="12"
                VerticalAlignment="Center" HorizontalAlignment="Center" MouseLeftButtonDown="Card_MouseDown">
            <Border.Effect>
                <DropShadowEffect Color="#15181D" BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.18"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Headline and the undo line -->
                <StackPanel Grid.Row="0" Margin="24,24,24,0">
                    <TextBlock Text="{Binding Title}" FontSize="18" LineHeight="24" FontWeight="Bold" Foreground="{StaticResource Bz.Ink}"
                               TextWrapping="Wrap"/>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Written: the filled green tick -->
                        <Canvas Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,10,0"
                                Visibility="{Binding AnyWritten, Converter={StaticResource B2V}}">
                            <Ellipse Width="14" Height="14" Fill="{StaticResource Bz.OkInk}"/>
                            <Path Data="M4.1,7.2 L6.2,9.3 L10,5.1" Stroke="{StaticResource Bz.OnBrand}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Canvas>
                        <!-- Nothing written: a grey dot with a dash -->
                        <Canvas Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,10,0"
                                Visibility="{Binding NothingWritten, Converter={StaticResource B2V}}">
                            <Ellipse Width="14" Height="14" Fill="{StaticResource Bz.Text3}"/>
                            <Path Data="M4.2,7 L9.8,7" Stroke="{StaticResource Bz.OnBrand}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                        <TextBlock Grid.Column="1" Text="{Binding UndoLine}" FontSize="13" LineHeight="18"
                                   Foreground="{StaticResource Bz.TextBody}" TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>

                <!-- One card per reason (scrolls when the card is capped by Revit's window height).
                     The 2 px inset keeps the focus ring inside the scroll viewport. -->
                <ScrollViewer Grid.Row="1" x:Name="GroupsScroll" Margin="22,12,22,0" MaxHeight="460" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasStayOpen, Converter={StaticResource B2V}}">
                    <ItemsControl ItemsSource="{Binding Groups}" Margin="2" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,2,0,12" CornerRadius="10" Background="{StaticResource Bz.Sunken2}" Padding="14,12,14,12"
                                        AutomationProperties.Name="{Binding Title}">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Bz.Ink}"
                                                       TextWrapping="Wrap" Margin="0,0,32,0"/>
                                            <TextBlock Text="{Binding Count}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource Bz.Text2}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                        </Grid>
                                        <TextBlock Text="{Binding HowTo}" FontSize="12" LineHeight="17" Foreground="{StaticResource Bz.TextBody}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>

                                        <ItemsControl ItemsSource="{Binding Visible}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,6,0,0" Padding="0,8,0,0" BorderBrush="{StaticResource Bz.Line}" BorderThickness="0,1,0,0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Where}" FontFamily="{StaticResource Bz.Font.Mono}" FontSize="12"
                                                                           Foreground="{StaticResource Bz.Ink}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Where}"/>
                                                                <!-- What it would have written: the parameter, or "→ new name" -->
                                                                <TextBlock Text="{Binding Param}" FontFamily="{StaticResource Bz.Font.Mono}" FontSize="11.5"
                                                                           Foreground="{StaticResource Bz.Text2}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                                           ToolTip="{Binding Param}"/>
                                                                <TextBlock Text="{Binding Reason}" FontSize="12" LineHeight="17" Foreground="{StaticResource Bz.Tone.Fail}"
                                                                           Margin="0,3,0,0" TextWrapping="Wrap"
                                                                           Visibility="{Binding HasReason, Converter={StaticResource B2V}}"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Style="{StaticResource BtnLocate}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                    Click="Locate_Click" Visibility="{Binding CanLocate, Converter={StaticResource B2V}}"
                                                                    ToolTip="{Binding DataContext.LocateHint, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    AutomationProperties.Name="{Binding DataContext.LocateHint, RelativeSource={RelativeSource AncestorType=Window}}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Canvas Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                        <Canvas.RenderTransform><ScaleTransform ScaleX="0.875" ScaleY="0.875" CenterX="8" CenterY="8"/></Canvas.RenderTransform>
                                                                        <Path Style="{StaticResource Ico}" Data="{StaticResource LocateGeo}"/>
                                                                    </Canvas>
                                                                    <TextBlock Text="{Binding DataContext.LocateLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                               VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Style="{StaticResource BtnLocate}" HorizontalAlignment="Left" Margin="-8,6,0,0"
                                                Click="More_Click" Visibility="{Binding HasMore, Converter={StaticResource B2V}}">
                                            <TextBlock Text="{Binding MoreText}"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- "The m changes not written stay in Open." -->
                <TextBlock Grid.Row="2" Text="{Binding StayOpenLine}" FontSize="12" LineHeight="17" Foreground="{StaticResource Bz.Text2}"
                           TextWrapping="Wrap" Margin="24,2,24,0"
                           Visibility="{Binding HasStayOpen, Converter={StaticResource B2V}}"/>

                <!-- Footer, 68 px: Copy list for BIM manager (text button) and Done -->
                <Border Grid.Row="3" Height="68" Margin="0,16,0,0" Background="{StaticResource Bz.Sunken}" BorderBrush="{StaticResource Bz.Line}"
                        BorderThickness="0,1,0,0" CornerRadius="0,0,11,11" Padding="16,0,16,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CopyBtn" Style="{StaticResource BtnGh}" Click="Copy_Click"
                                Visibility="{Binding CanCopy, Converter={StaticResource B2V}}">
                            <StackPanel Orientation="Horizontal">
                                <Canvas Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Canvas.RenderTransform><ScaleTransform ScaleX="0.875" ScaleY="0.875" CenterX="8" CenterY="8"/></Canvas.RenderTransform>
                                    <Path Style="{StaticResource Ico}" Data="{StaticResource CopyGeo}"/>
                                </Canvas>
                                <TextBlock x:Name="CopyText" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" x:Name="CloseBtn" Style="{StaticResource BtnPri}"
                                Content="{Binding DoneLabel}" Click="Close_Click" IsCancel="True"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
