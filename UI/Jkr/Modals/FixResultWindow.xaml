<Window x:Class="RevitWebAppSync.UI.Jkr.Modals.FixResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="640" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        Background="Transparent" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" FontFamily="{DynamicResource Bz.Font.Sans}" FontSize="13"
        Foreground="{DynamicResource Bz.Text}" TextOptions.TextFormattingMode="Display">
    <!-- Fix all result: Direction C "Verify", the outcome. Written gets a pass-tone
         tick panel, not written a fail-tone panel, then the split bar (pass on a
         fail-tone track) and the reasons on soft dividers. Locate and Copy are
         ghost buttons, Close the amber primary on the sunken bar. No animation. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevitWebAppSync;component/UI/Jkr/Panel/PanelTokens.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="Vis"/>

            <!-- Locate: the 28 px ghost button; hover goes blue tint -->
            <Style x:Key="BtnLocate" TargetType="Button" BasedOn="{StaticResource Bz.Btn.Ghost}">
                <Setter Property="Height" Value="28"/>
                <Setter Property="Padding" Value="10,0,10,0"/>
                <Setter Property="BorderBrush" Value="{StaticResource Bz.Line2}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bz.BrandTint}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Bz.BrandTintLine}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Bz.BrandTintText}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Flat buttons: the group headers and "show more" -->
            <Style x:Key="BtnFlat" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource Bz.FocusRing}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="0"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bz.Hover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Outcome panel (Verify): flat tint, radius 10, icon column + text -->
            <Style x:Key="Outcome" TargetType="Border">
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="12,11,14,11"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Scrim over Revit; a click on it closes. -->
    <Grid x:Name="Scrim" Background="{StaticResource Bz.Scrim}" MouseLeftButtonDown="Scrim_MouseDown">
        <Border x:Name="Card" Width="560" Margin="40" Background="{StaticResource Bz.Surface}"
                BorderBrush="{StaticResource Bz.Line2}" BorderThickness="1" CornerRadius="12"
                VerticalAlignment="Center" HorizontalAlignment="Center" MouseLeftButtonDown="Card_MouseDown">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="0.55"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header, 44 px: kicker and title on one line, × -->
                <Border Grid.Row="0" MinHeight="44" BorderBrush="{StaticResource Bz.Line}" BorderThickness="0,0,0,1" Padding="18,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Kicker}" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource Bz.Text3}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Bz.Text}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,11,8,11"/>
                        <Button Grid.Column="2" x:Name="CloseX" Style="{StaticResource Bz.Btn.Icon}" Width="32" Height="32"
                                VerticalAlignment="Center" Click="Close_Click" HorizontalContentAlignment="Center"
                                AutomationProperties.Name="{Binding CloseLabel}">
                            <Viewbox Width="14" Height="14">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.75"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </Grid>
                </Border>

                <!-- Outcome -->
                <StackPanel Grid.Row="1" Margin="18,16,18,16">
                    <!-- Some written: a pass panel and a fail panel, then the split bar -->
                    <StackPanel Visibility="{Binding AnyWritten, Converter={StaticResource Vis}}">
                        <Border Style="{StaticResource Outcome}" Background="{StaticResource Bz.OkBg}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,0,0">
                                    <Canvas Width="18" Height="18">
                                        <Ellipse Canvas.Left="1.5" Canvas.Top="1.5" Width="15" Height="15" Stroke="{StaticResource Bz.Ok}" StrokeThickness="1.5"/>
                                        <Path Data="M5.5,9.2 L7.8,11.5 L12.5,6.5" Stroke="{StaticResource Bz.Ok}" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Applied}" FontFamily="{StaticResource Bz.Font.Mono}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Bz.Ok}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding WrittenLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Bz.Ok}"
                                                   Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock FontSize="12" LineHeight="18" Foreground="{StaticResource Bz.TextBody}" Margin="0,4,0,0" TextWrapping="Wrap">
                                        <Run Text="{Binding WrittenSub, Mode=OneWay}"/><InlineUIContainer BaselineAlignment="Center"><Border Style="{StaticResource Bz.Kbd}"><TextBlock Text="{Binding UndoKey}" FontFamily="{StaticResource Bz.Font.Mono}" FontSize="11" Foreground="{StaticResource Bz.Text}"/></Border></InlineUIContainer><Run Text="{Binding WrittenSubEnd, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Outcome}" Background="{StaticResource Bz.HighBg}" Margin="0,6,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,0,0">
                                    <Canvas Width="18" Height="18">
                                        <Ellipse Canvas.Left="1.5" Canvas.Top="1.5" Width="15" Height="15" Stroke="{StaticResource Bz.HighText}" StrokeThickness="1.5"/>
                                        <Path Data="M6.5,6.5 L11.5,11.5 M11.5,6.5 L6.5,11.5" Stroke="{StaticResource Bz.HighText}" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Failed}" FontFamily="{StaticResource Bz.Font.Mono}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Bz.HighText}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding FailedLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Bz.HighText}"
                                                   Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding FailedSub}" FontSize="12" LineHeight="18" Foreground="{StaticResource Bz.TextBody}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- Written vs not written: pass on a fail-tone track -->
                        <Border Height="4" CornerRadius="2" Background="{StaticResource Bz.High}" Margin="0,12,0,0" ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="BarWritten" Width="0*"/>
                                    <ColumnDefinition x:Name="BarFailed" Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource Bz.Ok}" CornerRadius="2,0,0,2"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Nothing written: one fail-tone panel -->
                    <Border Visibility="{Binding NothingWritten, Converter={StaticResource Vis}}"
                            Style="{StaticResource Outcome}" Background="{StaticResource Bz.HighBg}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,0,0">
                                <Canvas Width="18" Height="18">
                                    <Ellipse Canvas.Left="1.5" Canvas.Top="1.5" Width="15" Height="15" Stroke="{StaticResource Bz.HighText}" StrokeThickness="1.5"/>
                                    <Path Data="M6.5,6.5 L11.5,11.5 M11.5,6.5 L6.5,11.5" Stroke="{StaticResource Bz.HighText}" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="{Binding NothingTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Bz.HighText}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding NothingSub}" FontSize="12" LineHeight="18" Foreground="{StaticResource Bz.TextBody}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Reasons header -->
                <Grid Grid.Row="2" Margin="18,0,18,8">
                    <TextBlock Text="{Binding ReasonsHeader}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Bz.Text2}"/>
                    <TextBlock Text="{Binding ReasonsCount}" FontFamily="{StaticResource Bz.Font.Mono}" FontSize="11.5" Foreground="{StaticResource Bz.Text3}" HorizontalAlignment="Right"/>
                </Grid>

                <!-- Groups on soft dividers (scroll when the card is capped by Revit's window height).
                     The 2 px inset keeps the focus ring inside the scroll viewport. -->
                <Border Grid.Row="3" BorderBrush="{StaticResource Bz.Line}" BorderThickness="0,1,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="460" x:Name="GroupsScroll">
                        <ItemsControl ItemsSource="{Binding Groups}" Margin="2">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Bz.LineSoft}" BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <Button Style="{StaticResource BtnFlat}" Padding="16,10,16,10" Click="Group_Click"
                                                    AutomationProperties.Name="{Binding Title}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Viewbox Width="14" Height="14" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                                                        <Viewbox.Style>
                                                            <Style TargetType="Viewbox">
                                                                <Setter Property="RenderTransform">
                                                                    <Setter.Value><RotateTransform Angle="0"/></Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                                        <Setter Property="RenderTransform">
                                                                            <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                                                                        </Setter>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Viewbox.Style>
                                                        <Canvas Width="24" Height="24">
                                                            <Path Data="M9,6 L15,12 L9,18" Stroke="{StaticResource Bz.Text3}" StrokeThickness="2.2"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Bz.Text}" Margin="10,0,10,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Scope}" FontSize="12" Foreground="{StaticResource Bz.Text3}"
                                                               Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="3" MinWidth="26" Height="20" CornerRadius="4" Background="{StaticResource Bz.HighBg}" Padding="6,0,6,0">
                                                        <TextBlock Text="{Binding Count}" FontFamily="{StaticResource Bz.Font.Mono}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Bz.HighText}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Button>

                                            <StackPanel Margin="40,0,16,12" Visibility="{Binding IsOpen, Converter={StaticResource Vis}}">
                                                <!-- How to fix: the flat blue info tint -->
                                                <Border Background="{StaticResource Bz.BrandTint}" CornerRadius="10" Padding="12,10,12,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Viewbox Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,8,0">
                                                            <Canvas Width="24" Height="24">
                                                                <Path Data="M9,18 L15,18 M10,21 L14,21 M12,3 A6,6 0 0 0 8.5,13.9 C9.1,14.3 9.5,15 9.5,15.7 L9.5,16 L14.5,16 L14.5,15.7 C14.5,15 14.9,14.3 15.5,13.9 A6,6 0 0 0 12,3 Z"
                                                                      Stroke="{StaticResource Bz.BrandTintText}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                        <TextBlock Grid.Column="1" FontSize="12" LineHeight="18" Foreground="{StaticResource Bz.BrandTintText}" TextWrapping="Wrap">
                                                            <Run Text="{Binding DataContext.HowToLabel, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{Binding HowTo, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>

                                                <!-- Rows on soft dividers, no frame -->
                                                <StackPanel Margin="0,6,0,0">
                                                    <ItemsControl ItemsSource="{Binding Visible}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border x:Name="Row" Padding="2,9,0,9" BorderBrush="{StaticResource Bz.LineSoft}" BorderThickness="0,0,0,1" Background="Transparent">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Param}" FontFamily="{StaticResource Bz.Font.Mono}" FontSize="12"
                                                                                       Foreground="{StaticResource Bz.Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Param}"/>
                                                                            <TextBlock Text="{Binding Where}" FontSize="11.5" Foreground="{StaticResource Bz.Text3}" Margin="0,2,0,0"
                                                                                       TextTrimming="CharacterEllipsis"/>
                                                                            <TextBlock Text="{Binding Reason}" FontSize="11.5" Foreground="{StaticResource Bz.HighText}" Margin="0,3,0,0" TextWrapping="Wrap"
                                                                                       Visibility="{Binding HasReason, Converter={StaticResource Vis}}"/>
                                                                        </StackPanel>
                                                                        <Button Grid.Column="1" Style="{StaticResource BtnLocate}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                                                Click="Locate_Click" Visibility="{Binding CanLocate, Converter={StaticResource Vis}}"
                                                                                ToolTip="{Binding DataContext.LocateHint, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                AutomationProperties.Name="{Binding DataContext.LocateHint, RelativeSource={RelativeSource AncestorType=Window}}">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <Viewbox Width="13" Height="13" Margin="0,0,6,0">
                                                                                    <Canvas Width="24" Height="24">
                                                                                        <Ellipse Canvas.Left="5" Canvas.Top="5" Width="14" Height="14" Stroke="{StaticResource Bz.Text2}" StrokeThickness="2"/>
                                                                                        <Path Data="M12,2 L12,6 M12,18 L12,22 M2,12 L6,12 M18,12 L22,12" Stroke="{StaticResource Bz.Text2}" StrokeThickness="2"
                                                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                                                    </Canvas>
                                                                                </Viewbox>
                                                                                <TextBlock Text="{Binding DataContext.LocateLabel, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                            </StackPanel>
                                                                        </Button>
                                                                    </Grid>
                                                                </Border>
                                                                <DataTemplate.Triggers>
                                                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource Bz.Hover}"/>
                                                                    </Trigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Button Style="{StaticResource BtnFlat}" Padding="2,8,2,8" HorizontalContentAlignment="Left"
                                                            Click="More_Click" Visibility="{Binding HasMore, Converter={StaticResource Vis}}"
                                                            BorderThickness="0">
                                                        <TextBlock Text="{Binding MoreText}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource Bz.Brand}"/>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Footer: Copy (ghost) and the hint, Close (amber) on the sunken bar -->
                <Border Grid.Row="4" Background="{StaticResource Bz.Sunken}" BorderBrush="{StaticResource Bz.Line}" BorderThickness="0,1,0,0"
                        CornerRadius="0,0,11,11" Padding="18,10,18,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CopyBtn" Style="{StaticResource Bz.Btn.Ghost}" Height="36" Padding="12,0,12,0" FontSize="12.5"
                                BorderBrush="{StaticResource Bz.Line2}" Click="Copy_Click">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M11,9 L18,9 A2,2 0 0 1 20,11 L20,18 A2,2 0 0 1 18,20 L11,20 A2,2 0 0 1 9,18 L9,11 A2,2 0 0 1 11,9 Z M5,15 L5,5 A2,2 0 0 1 7,3 L17,3"
                                              Stroke="{StaticResource Bz.Text2}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock x:Name="CopyText" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Column="1" Text="{Binding CopyHint}" FontSize="11.5" Foreground="{StaticResource Bz.Text3}" Margin="12,0,12,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="2" x:Name="CloseBtn" Style="{StaticResource Bz.Btn.Primary}" Height="36" Padding="18,0,18,0" FontSize="12.5"
                                Content="{Binding CloseLabel}" Click="Close_Click" IsCancel="True"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
