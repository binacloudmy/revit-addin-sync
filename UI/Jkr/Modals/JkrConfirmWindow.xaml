<Window x:Class="RevitWebAppSync.UI.Jkr.Modals.JkrConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        Background="Transparent" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" FontFamily="{DynamicResource Bz.Font.Sans}" FontSize="13"
        Foreground="{DynamicResource Bz.Text}" TextOptions.TextFormattingMode="Display">
    <!-- Confirm before a write: Direction C "Verify", step confirm. The dark card,
         a 44 px header over a hairline, the change rows on soft dividers (old value
         struck in fail tone, new value in pass tone), the pause panel
         flat, and Cancel / Confirm on the sunken bar. No animation. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevitWebAppSync;component/UI/Jkr/Panel/PanelTokens.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </Window.Resources>

    <!-- Scrim over Revit. Clicking it cancels. Normally the window covers Revit's
         main window (CoverRevitWindow); if that can't be measured it sizes to the
         card, and the scrim margin leaves room for the shadow. -->
    <Grid x:Name="Scrim" Background="{StaticResource Bz.Scrim}" MouseLeftButtonDown="Scrim_MouseDown">
        <Border x:Name="Card" MaxWidth="440" Margin="40" Background="{StaticResource Bz.Surface}"
                BorderBrush="{StaticResource Bz.Line2}" BorderThickness="1" CornerRadius="12"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                MouseLeftButtonDown="Card_MouseDown">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="0.55"/>
            </Border.Effect>
            <!-- Grid, not StackPanel: when the card is capped by the window height
                 the change list (the * row) shrinks and scrolls, so the buttons
                 always stay on screen. -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header, 44 px: the title over a hairline -->
                <Border Grid.Row="0" MinHeight="44" BorderBrush="{StaticResource Bz.Line}" BorderThickness="0,0,0,1" Padding="18,0,18,0">
                    <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Bz.Text}"
                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,11,0,11"/>
                </Border>

                <TextBlock Grid.Row="1" x:Name="SubText" FontSize="13" Foreground="{StaticResource Bz.Text2}" LineHeight="19.5"
                           TextWrapping="Wrap" Margin="18,14,18,0"/>

                <!-- The changes: soft dividers, no frame; max 220 tall, scrolls -->
                <Border Grid.Row="2" Margin="18,12,18,0" BorderBrush="{StaticResource Bz.Line}" BorderThickness="0,1,0,0"
                        VerticalAlignment="Top" MinHeight="44" ClipToBounds="True">
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" ClipToBounds="True">
                        <ItemsControl x:Name="RowsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,9,0,9" BorderBrush="{StaticResource Bz.LineSoft}" BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Caption}" FontSize="12.5" Foreground="{StaticResource Bz.Text}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Caption}"/>
                                            <TextBlock FontFamily="{StaticResource Bz.Font.Mono}" FontSize="12"
                                                       TextWrapping="Wrap" Margin="0,4,0,0">
                                                <Run Text="{Binding Actual, Mode=OneWay}" Foreground="{StaticResource Bz.Tone.Fail}" TextDecorations="Strikethrough"/><Run Text="  →  " Foreground="{StaticResource Bz.Text3}"/><Run Text="{Binding Proposed, Mode=OneWay}" Foreground="{StaticResource Bz.Tone.Pass}" FontWeight="SemiBold"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- "Revit may pause" (500+ affected elements): the warning tint -->
                <Border Grid.Row="3" x:Name="PauseBox" Visibility="Collapsed" Margin="18,12,18,0" Background="{StaticResource Bz.MedBg}"
                        CornerRadius="10" Padding="14,10,14,10">
                    <TextBlock x:Name="PauseText" FontSize="12" LineHeight="18" TextWrapping="Wrap" Foreground="{StaticResource Bz.MedText}"/>
                </Border>

                <!-- Footer: Cancel and Confirm, right-aligned, on the sunken bar -->
                <Border Grid.Row="4" Margin="0,18,0,0" Background="{StaticResource Bz.Sunken}" BorderBrush="{StaticResource Bz.Line}"
                        BorderThickness="0,1,0,0" CornerRadius="0,0,11,11" Padding="18,10,18,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelBtn" Style="{StaticResource Bz.Btn.Ghost}" Height="36" Padding="14,0,14,0" FontSize="12.5"
                                BorderBrush="{StaticResource Bz.Line2}" Click="Cancel_Click" IsCancel="True"/>
                        <Button x:Name="ConfirmBtn" Style="{StaticResource Bz.Btn.Primary}" Height="36" Padding="16,0,16,0" FontSize="12.5"
                                Margin="8,0,0,0" Click="Confirm_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
