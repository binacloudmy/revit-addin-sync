<Window x:Class="RevitWebAppSync.UI.Jkr.Modals.JkrConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:panel="clr-namespace:RevitWebAppSync.UI.Jkr.Panel"
        Width="600" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        Background="Transparent" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" FontFamily="{DynamicResource Bz.Font.Sans}" FontSize="13"
        Foreground="{DynamicResource Bz.Text}" TextOptions.TextFormattingMode="Display">
    <!-- Confirm before a write (Clear Sheet "confirm changes"): the 520 white card, the
         18 px title and its sub line, "Ready-made fixes n" (bolt) and "Proposed by the AI
         fixer n" (spark-bolt) with "title · scope" over "old → new" in mono, the
         "Revit may pause" note from 500 elements, and Cancel / "Write n changes" on the
         68 px footer. Every proposal is back before this opens, so there is no "on the
         way" line (spec Q2). DataContext: JkrConfirmModel. No animation. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevitWebAppSync;component/UI/Jkr/Panel/PanelTokens.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="B2V"/>

            <!-- 16-unit line icons (Clear Sheet .ic: stroke 1.6, round caps) -->
            <Style x:Key="Ico" TargetType="Path">
                <Setter Property="StrokeThickness" Value="1.6"/>
                <Setter Property="StrokeStartLineCap" Value="Round"/>
                <Setter Property="StrokeEndLineCap" Value="Round"/>
                <Setter Property="StrokeLineJoin" Value="Round"/>
                <Setter Property="Stroke" Value="{StaticResource Bz.Ink}"/>
            </Style>
            <Geometry x:Key="BoltGeo">M9,1.8 L3.8,9 L7.8,9 L7,14.2 L12.2,7 L8.2,7 Z</Geometry>
            <Geometry x:Key="SparkBoltGeo">M7.6,2.2 L2.6,9.2 L6.4,9.2 L5.6,14.2 L10.8,7.2 L7,7.2 Z</Geometry>
            <Geometry x:Key="SparkGeo">M12.6,1.2 L13.3,2.9 L15,3.6 L13.3,4.3 L12.6,6 L11.9,4.3 L10.2,3.6 L11.9,2.9 Z</Geometry>
            <Geometry x:Key="ArrowGeo">M2.5,8 L13.5,8 M9.8,4.5 L13.3,8 L9.8,11.5</Geometry>
            <Geometry x:Key="WarnGeo">M8,2.2 L1.8,13.3 L14.2,13.3 Z M8,6.6 L8,9.8 M8,11.6 L8,11.65</Geometry>

            <!-- Clear Sheet .btn: 36 px, radius 8, 600 13 px -->
            <Style x:Key="Btn" TargetType="Button">
                <Setter Property="Height" Value="36"/>
                <Setter Property="Padding" Value="14,0,14,0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource Bz.FocusRing}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- .pri: ink fill -->
            <Style x:Key="BtnPri" TargetType="Button" BasedOn="{StaticResource Btn}">
                <Setter Property="Background" Value="{StaticResource Bz.Ink}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Bz.Ink}"/>
                <Setter Property="Foreground" Value="{StaticResource Bz.OnBrand}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource Bz.InkHover}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Bz.InkHover}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- .gh: text button -->
            <Style x:Key="BtnGh" TargetType="Button" BasedOn="{StaticResource Btn}">
                <Setter Property="Padding" Value="12,0,12,0"/>
                <Setter Property="Foreground" Value="{StaticResource Bz.TextBody}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource Bz.Hover}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Bz.Hover}"/>
                        <Setter Property="Foreground" Value="{StaticResource Bz.Text}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- .gh2: the group header, label left and count right -->
            <Style x:Key="GroupHead" TargetType="Grid">
                <Setter Property="Margin" Value="0,14,0,6"/>
            </Style>
            <Style x:Key="GroupLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource Bz.Ink}"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="GroupCount" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Foreground" Value="{StaticResource Bz.Text2}"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- .ci: one change, "title · scope" over "old → new" (mono) on a soft top line -->
            <DataTemplate x:Key="ChangeRow">
                <Border Padding="0,9,0,9" BorderBrush="{StaticResource Bz.LineSoft}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Caption}" FontSize="12" Foreground="{StaticResource Bz.Text2}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Caption}"/>
                        <WrapPanel Margin="0,3,0,0">
                            <TextBlock Text="{Binding Old}" FontFamily="{StaticResource Bz.Font.Mono}" FontSize="12"
                                       Foreground="{StaticResource Bz.Tone.Fail}" TextDecorations="Strikethrough" TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                            <Canvas Width="16" Height="16" Margin="6,0,6,0" VerticalAlignment="Center">
                                <Canvas.RenderTransform><ScaleTransform ScaleX="0.75" ScaleY="0.75" CenterX="8" CenterY="8"/></Canvas.RenderTransform>
                                <Path Style="{StaticResource Ico}" Stroke="{StaticResource Bz.Text3}" Data="{StaticResource ArrowGeo}"/>
                            </Canvas>
                            <TextBlock Text="{Binding Proposed}" FontFamily="{StaticResource Bz.Font.Mono}" FontSize="12"
                                       Foreground="{StaticResource Bz.OkInk}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Scrim over Revit. Clicking it cancels. Normally the window covers Revit's
         main window (CoverRevitWindow); if that can't be measured it sizes to the
         card, and the scrim margin leaves room for the shadow. -->
    <Grid x:Name="Scrim" Background="{StaticResource Bz.Scrim}" MouseLeftButtonDown="Scrim_MouseDown">
        <Border x:Name="Card" Width="520" Margin="40" Background="{StaticResource Bz.Surface}"
                BorderBrush="{StaticResource Bz.Line}" BorderThickness="1" CornerRadius="12"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                MouseLeftButtonDown="Card_MouseDown">
            <Border.Effect>
                <DropShadowEffect Color="#15181D" BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.18"/>
            </Border.Effect>
            <!-- Grid, not StackPanel: when the card is capped by the window height the
                 change list (the * row) shrinks and scrolls, so the buttons stay on screen. -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title and sub line -->
                <StackPanel Grid.Row="0" Margin="24,24,24,0">
                    <TextBlock Text="{Binding Title}" FontSize="18" LineHeight="24" FontWeight="Bold" Foreground="{StaticResource Bz.Ink}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Sub}" FontSize="13" LineHeight="18" Foreground="{StaticResource Bz.TextBody}"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- The changes, in two groups; scrolls when the card is capped -->
                <ScrollViewer Grid.Row="1" x:Name="RowsScroll" Margin="24,8,24,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Visibility="{Binding HasReady, Converter={StaticResource B2V}}">
                            <Grid Style="{StaticResource GroupHead}">
                                <StackPanel Orientation="Horizontal">
                                    <Canvas Width="16" Height="16" VerticalAlignment="Center">
                                        <Canvas.RenderTransform><ScaleTransform ScaleX="0.875" ScaleY="0.875" CenterX="8" CenterY="8"/></Canvas.RenderTransform>
                                        <Path Style="{StaticResource Ico}" Data="{StaticResource BoltGeo}"/>
                                    </Canvas>
                                    <TextBlock Text="{Binding ReadyHeader}" Style="{StaticResource GroupLabel}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ReadyCount}" Style="{StaticResource GroupCount}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding ReadyRows}" ItemTemplate="{StaticResource ChangeRow}" Focusable="False"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding HasAi, Converter={StaticResource B2V}}">
                            <Grid Style="{StaticResource GroupHead}">
                                <StackPanel Orientation="Horizontal">
                                    <Canvas Width="16" Height="16" VerticalAlignment="Center">
                                        <Canvas.RenderTransform><ScaleTransform ScaleX="0.875" ScaleY="0.875" CenterX="8" CenterY="8"/></Canvas.RenderTransform>
                                        <Path Style="{StaticResource Ico}" Data="{StaticResource SparkBoltGeo}"/>
                                        <Path Fill="{StaticResource Bz.Ink}" Data="{StaticResource SparkGeo}"/>
                                    </Canvas>
                                    <TextBlock Text="{Binding AiHeader}" Style="{StaticResource GroupLabel}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding AiCount}" Style="{StaticResource GroupCount}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding AiRows}" ItemTemplate="{StaticResource ChangeRow}" Focusable="False"/>
                        </StackPanel>
                        <!-- AI-434: rows with several valid codes. One picker per category + parameter; each element
                             listed under it is still its own write and its own re-check. -->
                        <StackPanel Visibility="{Binding HasPick, Converter={StaticResource B2V}}">
                            <Grid Style="{StaticResource GroupHead}">
                                <TextBlock Text="{Binding PickHeader}" Style="{StaticResource GroupLabel}"/>
                                <TextBlock Text="{Binding PickCount}" Style="{StaticResource GroupCount}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding PickGroups}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,9,0,9" BorderBrush="{StaticResource Bz.LineSoft}" BorderThickness="0,1,0,0">
                                            <StackPanel>
                                                <TextBlock FontSize="12" Foreground="{StaticResource Bz.Text2}" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Category, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Parameter, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding CountLabel, Mode=OneWay}"/>
                                                </TextBlock>
                                                <panel:PickerBox Margin="0,6,0,0" Options="{Binding Options}" Selected="{Binding Selected, Mode=TwoWay}"
                                                                 ShowBadge="{Binding ShowAiBadge}" BadgeText="{Binding Badge}" Tip="{Binding Tooltip}"/>
                                                <ItemsControl ItemsSource="{Binding Rows}" Margin="0,6,0,0" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Caption}" FontSize="12" Foreground="{StaticResource Bz.Text3}"
                                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Caption}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <!-- The last row's bottom line -->
                        <Border BorderBrush="{StaticResource Bz.LineSoft}" BorderThickness="0,1,0,0"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- "Revit may pause" (500+ affected elements): the warning note -->
                <Border Grid.Row="2" x:Name="PauseBox" Margin="24,16,24,0" Background="{StaticResource Bz.MedBg}"
                        CornerRadius="8" Padding="12,10,12,10"
                        Visibility="{Binding ShowPauseWarning, Converter={StaticResource B2V}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Canvas Width="16" Height="16" VerticalAlignment="Top" Margin="-1,0,9,0">
                            <Canvas.RenderTransform><ScaleTransform ScaleX="0.875" ScaleY="0.875" CenterX="8" CenterY="8"/></Canvas.RenderTransform>
                            <Path Style="{StaticResource Ico}" Stroke="{StaticResource Bz.Med}" Data="{StaticResource WarnGeo}"/>
                        </Canvas>
                        <TextBlock Grid.Column="1" Text="{Binding PauseWarning}" FontSize="12" LineHeight="17" TextWrapping="Wrap"
                                   Foreground="{StaticResource Bz.Tone.WarnInk}"/>
                    </Grid>
                </Border>

                <!-- Footer, 68 px: Cancel and "Write n changes" on the sunken bar -->
                <Border Grid.Row="3" Height="68" Margin="0,16,0,0" Background="{StaticResource Bz.Sunken}" BorderBrush="{StaticResource Bz.Line}"
                        BorderThickness="0,1,0,0" CornerRadius="0,0,11,11" Padding="16,0,16,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="CancelBtn" Style="{StaticResource BtnGh}" Content="{Binding CancelLabel}"
                                Click="Cancel_Click" IsCancel="True"/>
                        <Button x:Name="ConfirmBtn" Style="{StaticResource BtnPri}" Content="{Binding ConfirmLabel}"
                                Margin="8,0,0,0" Click="Confirm_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
