<Window x:Class="RevitWebAppSync.UI.Jkr.Modals.JkrConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" Height="480"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        Background="Transparent" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="13"
        Foreground="#161616" TextOptions.TextFormattingMode="Display">
    <!-- Prototype "Model Audit Prototype.dc.html" .cf-scrim / .cf (frames f-confirm,
         f-paid). Colours are the prototype's literal values until step 7 moves
         them into the pane's token dictionary. -->
    <Window.Resources>
        <Style x:Key="BtnGhost" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#2B2E33"/>
            <Setter Property="BorderBrush" Value="#D6D4CE"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="5" Padding="10,6,10,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F5F5F3"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0F0F0F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="#F2C200"/>
            <Setter Property="Foreground" Value="#0F0F0F"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="10,6,10,6"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E3B600"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0F0F0F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#EDEDEA"/>
                                <Setter Property="Foreground" Value="#8A8D93"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Scrim: rgba(9,11,16,.6). Clicking it cancels. -->
    <Grid x:Name="Scrim" Background="#99090B10" MouseLeftButtonDown="Scrim_MouseDown">
        <Border x:Name="Card" MaxWidth="420" Margin="20" Background="#FFFFFF" CornerRadius="8"
                Padding="22,20,22,20" VerticalAlignment="Center" HorizontalAlignment="Center"
                MouseLeftButtonDown="Card_MouseDown">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="64" ShadowDepth="24" Direction="270" Opacity="0.4"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" Foreground="#161616"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="SubText" FontSize="12.5" Foreground="#4B4F57" LineHeight="19.4"
                           TextWrapping="Wrap" Margin="0,14,0,0"/>

                <!-- .cf-rows: max 220 tall, scrolls -->
                <Border Margin="0,14,0,0" BorderBrush="#E7E6E2" BorderThickness="1" CornerRadius="6">
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" ClipToBounds="True">
                        <!-- Last row's divider is hidden under the frame (prototype .cf-r:last-child). -->
                        <ItemsControl x:Name="RowsList" Margin="0,0,0,-1">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="RowBd" Padding="10,8,10,8" BorderBrush="#EFEEEA" BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Caption}" FontSize="11" Foreground="#686C74"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontSize="11.5"
                                                       TextWrapping="Wrap" Margin="0,2,0,0">
                                                <Run Text="{Binding Actual, Mode=OneWay}" Foreground="#A12E2E"/><Run Text=" → " Foreground="#161616"/><Run Text="{Binding Proposed, Mode=OneWay}" Foreground="#1E6B3F"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- "Revit may pause" (500+ affected elements). Same amber as the consent box. -->
                <Border x:Name="PauseBox" Visibility="Collapsed" Margin="0,14,0,0" Background="#FEF8DC"
                        CornerRadius="6" Padding="12,10,12,10">
                    <TextBlock x:Name="PauseText" FontSize="12.5" LineHeight="18.75" TextWrapping="Wrap" Foreground="#161616"/>
                </Border>

                <!-- .cons: paid action consent; starts unticked -->
                <Border x:Name="ConsentBox" Visibility="Collapsed" Margin="0,14,0,0" Background="#FEF8DC"
                        CornerRadius="6" Padding="12,10,12,10" Cursor="Hand">
                    <CheckBox x:Name="ConsentCheck" VerticalContentAlignment="Top"
                              Checked="Consent_Changed" Unchecked="Consent_Changed">
                        <TextBlock x:Name="ConsentText" FontSize="12.5" LineHeight="18.75" TextWrapping="Wrap"
                                   Foreground="#161616" Margin="4,0,0,0"/>
                    </CheckBox>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button x:Name="CancelBtn" Style="{StaticResource BtnGhost}" Click="Cancel_Click" IsCancel="True"/>
                    <Button x:Name="ConfirmBtn" Style="{StaticResource BtnPrimary}" Margin="8,0,0,0" Click="Confirm_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
