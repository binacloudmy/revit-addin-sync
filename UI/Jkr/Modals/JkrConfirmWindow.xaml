<Window x:Class="RevitWebAppSync.UI.Jkr.Modals.JkrConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        Background="Transparent" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" FontFamily="{DynamicResource Bz.Font.Sans}" FontSize="13"
        Foreground="{DynamicResource Bz.Text}" TextOptions.TextFormattingMode="Display">
    <!-- Confirm before a write (frames f-confirm, f-paid): the detail window's card
         (white, radius 12, hairline header) with the pane's Bz.* tokens and buttons. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevitWebAppSync;component/UI/Jkr/Panel/PanelTokens.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Scrim over Revit. Clicking it cancels. Normally the window covers Revit's
         main window (CoverRevitWindow); if that can't be measured it sizes to the
         card, and the scrim margin leaves room for the shadow. -->
    <Grid x:Name="Scrim" Background="{StaticResource Bz.Scrim}" MouseLeftButtonDown="Scrim_MouseDown">
        <Border x:Name="Card" MaxWidth="440" Margin="40" Background="{StaticResource Bz.Surface}" CornerRadius="12"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                MouseLeftButtonDown="Card_MouseDown">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" BlurRadius="48" ShadowDepth="16" Direction="270" Opacity="0.22"/>
            </Border.Effect>
            <!-- Grid, not StackPanel: when the card is capped by the window height
                 the change list (the * row) shrinks and scrolls, so the buttons
                 always stay on screen. -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header: title over a hairline -->
                <Border Grid.Row="0" BorderBrush="{StaticResource Bz.Line}" BorderThickness="0,0,0,1" Padding="22,15,22,14">
                    <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Bz.Text}"
                               TextWrapping="Wrap"/>
                </Border>

                <TextBlock Grid.Row="1" x:Name="SubText" FontSize="13" Foreground="{StaticResource Bz.Text2}" LineHeight="19.5"
                           TextWrapping="Wrap" Margin="22,16,22,0"/>

                <!-- .cf-rows: max 220 tall, scrolls -->
                <Border Grid.Row="2" Margin="22,14,22,0" BorderBrush="{StaticResource Bz.Line}" BorderThickness="1" CornerRadius="10"
                        VerticalAlignment="Top" MinHeight="60" ClipToBounds="True">
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" ClipToBounds="True">
                        <!-- Last row's divider is hidden under the frame (prototype .cf-r:last-child). -->
                        <ItemsControl x:Name="RowsList" Margin="0,0,0,-1">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,9,12,9" BorderBrush="{StaticResource Bz.LineSoft}" BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Caption}" FontSize="12" Foreground="{StaticResource Bz.Text3}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontFamily="{StaticResource Bz.Font.Mono}" FontSize="12"
                                                       TextWrapping="Wrap" Margin="0,3,0,0">
                                                <Run Text="{Binding Actual, Mode=OneWay}" Foreground="{StaticResource Cp.IssueFg}"/><Run Text=" → " Foreground="{StaticResource Bz.Text3}"/><Run Text="{Binding Proposed, Mode=OneWay}" Foreground="{StaticResource Bz.Ok}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- "Revit may pause" (500+ affected elements): the warning tint. -->
                <Border Grid.Row="3" x:Name="PauseBox" Visibility="Collapsed" Margin="22,12,22,0" Background="{StaticResource Bz.MedBg}"
                        CornerRadius="10" Padding="14,10,14,10">
                    <TextBlock x:Name="PauseText" FontSize="12" LineHeight="18" TextWrapping="Wrap" Foreground="{StaticResource Bz.MedText}"/>
                </Border>

                <!-- .cons: paid action consent; starts unticked -->
                <Border Grid.Row="4" x:Name="ConsentBox" Visibility="Collapsed" Margin="22,12,22,0" Background="{StaticResource Bz.BrandTint}"
                        BorderBrush="{StaticResource Bz.BrandTintLine}" BorderThickness="1"
                        CornerRadius="10" Padding="14,10,14,10" Cursor="Hand">
                    <CheckBox x:Name="ConsentCheck" VerticalContentAlignment="Top"
                              Checked="Consent_Changed" Unchecked="Consent_Changed">
                        <TextBlock x:Name="ConsentText" FontSize="12" LineHeight="18" TextWrapping="Wrap"
                                   Foreground="{StaticResource Bz.TextBody}" Margin="4,0,0,0"/>
                    </CheckBox>
                </Border>

                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="22,18,22,20">
                    <Button x:Name="CancelBtn" Style="{StaticResource Bz.Btn.Ghost}" Padding="14,7,14,7" Click="Cancel_Click" IsCancel="True"/>
                    <Button x:Name="ConfirmBtn" Style="{StaticResource Bz.Btn.Primary}" Padding="14,7,14,7" Margin="8,0,0,0" Click="Confirm_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
