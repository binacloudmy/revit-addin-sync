<Window x:Class="RevitWebAppSync.UI.Jkr.Modals.IssueFocusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:jkr="clr-namespace:RevitWebAppSync.UI.Jkr"
        xmlns:ctl="clr-namespace:RevitWebAppSync.UI.Jkr.Controls"
        Width="680" Height="640"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Topmost="False"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RevitWebAppSync;component/UI/Jkr/Tokens.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/RevitWebAppSync;component/UI/Jkr/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <jkr:BoolToVisibilityConverter x:Key="B2V"/>
            <jkr:NonEmptyStringToVisibilityConverter x:Key="StrVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Scrim + rounded card -->
    <Grid Background="#6B0A141E" MouseLeftButtonDown="Scrim_Click">
        <Border x:Name="Card" Width="680" MaxHeight="640"
                Background="{StaticResource Surface.Panel}"
                CornerRadius="10" MouseLeftButtonDown="Card_Click">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="64" ShadowDepth="24" Opacity="0.35"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Modal header -->
                <Border Grid.Row="0" Padding="14,11,14,11"
                        BorderBrush="{StaticResource Surface.Line}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource Btn.ModalNav}" x:Name="BackBtn"
                                Click="Back_Click" ToolTip="Back to list (Esc)">
                            <jkr:IconGlyph Glyph="arrowL" Size="13" Foreground="{StaticResource Ink2}"/>
                        </Button>

                        <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Issue " FontSize="11" Foreground="{StaticResource Ink3}"/>
                                <TextBlock x:Name="IssueIdxText" Text="—" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                                <TextBlock x:Name="IssueOfText" Text=" of —" FontSize="11" Foreground="{StaticResource Ink3}"/>
                                <TextBlock x:Name="CategorySuffix" Text="" FontSize="11" Foreground="{StaticResource Ink3}"/>
                            </StackPanel>
                            <Border Height="3" Background="{StaticResource Surface.Line2}" CornerRadius="2" Margin="0,5,0,0" ClipToBounds="True">
                                <Border x:Name="QueueBar" HorizontalAlignment="Left" Background="{StaticResource Brand}" CornerRadius="2"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="PrevBtn" Style="{StaticResource Btn.ModalNav}" Click="Prev_Click" ToolTip="Previous (← / K)">
                                <jkr:IconGlyph Glyph="arrowL" Size="12" Foreground="{StaticResource Ink2}"/>
                            </Button>
                            <Button x:Name="NextBtn" Style="{StaticResource Btn.ModalNav}" Margin="4,0,0,0" Click="Next_Click" ToolTip="Next (→ / J)">
                                <jkr:IconGlyph Glyph="arrowR" Size="12" Foreground="{StaticResource Ink2}"/>
                            </Button>
                            <Button x:Name="CloseBtn" Style="{StaticResource Btn.ModalNav}" Margin="8,0,0,0" Click="Close_Click" ToolTip="Close (Esc)">
                                <jkr:IconGlyph Glyph="close" Size="12" Foreground="{StaticResource Ink3}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Sticky meta row -->
                <Border Grid.Row="1" Background="{StaticResource Surface.Panel}"
                        BorderBrush="{StaticResource Surface.Line}" BorderThickness="0,0,0,1"
                        Padding="14,10,14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="PrioBadge" CornerRadius="3" Padding="6,2,6,2" VerticalAlignment="Center">
                                <TextBlock x:Name="PrioLabel" FontSize="9.5" FontWeight="Bold"/>
                            </Border>
                            <TextBlock x:Name="CatLabel" Margin="6,0,6,0" FontSize="10.5" VerticalAlignment="Center" Foreground="{StaticResource Ink3}"/>
                            <TextBlock Text="·" FontSize="10.5" Foreground="{StaticResource Ink4}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="IdLabel" Margin="6,0,0,0" FontSize="10.5" FontFamily="{StaticResource Font.Mono}" Foreground="{StaticResource Ink3}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ContentControl Grid.Column="1" x:Name="StatusBadgeHost" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Scrollable body -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="16,14,16,16"
                              Background="{StaticResource Surface.Bg}">
                    <StackPanel>
                        <!-- Title + description -->
                        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}" TextWrapping="Wrap" Margin="0,0,0,6"
                                   FontFamily="{StaticResource Font.Sans}"/>
                        <TextBlock x:Name="DescText" FontSize="12" Foreground="{StaticResource Ink2}"
                                   TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,14"
                                   FontFamily="{StaticResource Font.Sans}"/>

                        <!-- Element block -->
                        <TextBlock Text="ELEMENT" FontSize="9.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink3}" Margin="0,0,0,3"/>
                        <TextBlock x:Name="ElementText" FontSize="11" Foreground="{StaticResource Ink2}"
                                   TextWrapping="Wrap" FontFamily="{StaticResource Font.Mono}" Margin="0,0,0,0"/>

                        <!-- Diff card -->
                        <Border Margin="0,10,0,0" CornerRadius="7"
                                BorderBrush="{StaticResource Surface.Line}" BorderThickness="1"
                                Background="{StaticResource Surface.Panel}" ClipToBounds="True">
                            <StackPanel>
                                <!-- Required row -->
                                <Border Background="{StaticResource DiffOkSubtle}"
                                        BorderBrush="{StaticResource Surface.Line2}" BorderThickness="0,0,0,1">
                                    <Grid Margin="11,9,11,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource OkBg}"
                                                VerticalAlignment="Top" Margin="0,1,10,0">
                                            <jkr:IconGlyph Glyph="check" Size="9" StrokeThickness="2" Foreground="{StaticResource Ok}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="REQUIRED" FontSize="9.5" FontWeight="Bold"
                                                       Foreground="{StaticResource Ok}" Margin="0,0,0,2"/>
                                            <TextBlock x:Name="RequiredText" FontSize="11.5" Foreground="{StaticResource Ink}"
                                                       TextWrapping="Wrap" FontFamily="{StaticResource Font.Mono}" LineHeight="18"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <!-- Actual row -->
                                <Border Background="{StaticResource DiffBadSubtle}">
                                    <Grid Margin="11,9,11,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource HiBg}"
                                                VerticalAlignment="Top" Margin="0,1,10,0">
                                            <jkr:IconGlyph Glyph="x" Size="9" StrokeThickness="2" Foreground="{StaticResource Hi}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="ACTUAL" FontSize="9.5" FontWeight="Bold"
                                                       Foreground="{StaticResource Hi}" Margin="0,0,0,2"/>
                                            <TextBlock x:Name="ActualText" FontSize="11.5" Foreground="{StaticResource Ink}"
                                                       TextWrapping="Wrap" FontFamily="{StaticResource Font.Mono}" LineHeight="18"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Action zone -->
                        <StackPanel x:Name="OpenActions" Margin="0,14,0,0">
                            <!-- Auto-fix card -->
                            <Border x:Name="AutoFixCard" CornerRadius="8" BorderBrush="#66E27449" BorderThickness="1" ClipToBounds="True">
                                <StackPanel>
                                    <Border Background="{StaticResource BrandTint}" Padding="12,10,12,10">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource Brand}">
                                                <jkr:IconGlyph Glyph="bolt" Size="15" Foreground="White"/>
                                            </Border>
                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="AI can fix this for you" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource BrandDark}"/>
                                                <TextBlock Text="One click — preview the change below" FontSize="10.5"
                                                           Foreground="{StaticResource Ink3}" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Grid Margin="12,10,12,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="−" FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource Hi}" VerticalAlignment="Top" Margin="0,2,8,0"/>
                                        <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource HiBg}" CornerRadius="3" Padding="6,3,6,3">
                                            <TextBlock x:Name="DiffMinus" FontSize="10.5" Foreground="{StaticResource Hi}"
                                                       TextWrapping="Wrap" FontFamily="{StaticResource Font.Mono}"/>
                                        </Border>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="+" FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource Ok}" VerticalAlignment="Top" Margin="0,4,8,0"/>
                                        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource OkBg}" CornerRadius="3" Padding="6,3,6,3" Margin="0,2,0,0">
                                            <TextBlock x:Name="DiffPlus" FontSize="10.5" Foreground="{StaticResource Ok}"
                                                       TextWrapping="Wrap" FontFamily="{StaticResource Font.Mono}"/>
                                        </Border>
                                    </Grid>
                                    <Button Style="{StaticResource Btn.Primary}" Margin="12,0,12,12" Click="ApplyFix_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <jkr:IconGlyph Glyph="bolt" Size="12" Foreground="White" Margin="0,0,6,0"/>
                                            <TextBlock Text="Apply Auto-fix" FontSize="12.5" FontWeight="SemiBold"/>
                                            <Border Background="#33FFFFFF" CornerRadius="3" Padding="5,1,5,1" Margin="8,0,0,0">
                                                <TextBlock Text="F" FontSize="10" Foreground="White" FontFamily="{StaticResource Font.Mono}"/>
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Manual fix (collapsible) -->
                            <Border x:Name="ManualCard" CornerRadius="8" BorderBrush="{StaticResource Surface.Line}" BorderThickness="1" ClipToBounds="True" Visibility="Collapsed">
                                <StackPanel>
                                    <Button x:Name="StepsToggle" Click="StepsToggle_Click" HorizontalContentAlignment="Stretch">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{StaticResource OkBg}" Padding="12,10,12,10">
                                                    <ContentPresenter HorizontalAlignment="Stretch"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="26" Height="26" CornerRadius="6" Background="{StaticResource Ok}">
                                                <jkr:IconGlyph Glyph="gear" Size="13" Foreground="White"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="ManualTitle" Text="How to fix manually" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Ok}"/>
                                                <TextBlock Text="AI can't auto-fix this one" FontSize="10.5" Foreground="{StaticResource Ink3}" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <jkr:IconGlyph x:Name="StepsCaret" Grid.Column="2" Name="caretDn" Size="10" Foreground="{StaticResource Ok}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                    <Border x:Name="StepsBody" Background="{StaticResource Surface.Panel}" Padding="14,12,14,12">
                                        <StackPanel x:Name="StepsList"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Secondary actions -->
                            <WrapPanel Margin="0,8,0,0">
                                <Button Style="{StaticResource Btn.Sec}" Margin="0,0,6,6" Click="Locate_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <jkr:IconGlyph Glyph="crosshair" Size="12" Foreground="{StaticResource Ink2}" Margin="0,0,5,0"/>
                                        <TextBlock Text="Locate in 3D" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Btn.Sec}" Margin="0,0,6,6" Click="Accept_Click" ToolTip="Accept (A)">
                                    <StackPanel Orientation="Horizontal">
                                        <jkr:IconGlyph Glyph="check" Size="12" Foreground="{StaticResource Ok}" Margin="0,0,5,0"/>
                                        <TextBlock Text="Accept" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ApproveBtn" Style="{StaticResource Btn.Sec}" Margin="0,0,6,6" Click="Approve_Click" ToolTip="Approve — engineer's override (X)">
                                    <StackPanel Orientation="Horizontal">
                                        <jkr:IconGlyph Glyph="approve" Size="12" Foreground="{StaticResource Info}" Margin="0,0,5,0"/>
                                        <TextBlock Text="Approve" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>

                        <!-- Resolved actions -->
                        <StackPanel x:Name="ResolvedActions" Margin="0,14,0,0" Visibility="Collapsed">
                            <WrapPanel>
                                <Button Style="{StaticResource Btn.Sec}" Margin="0,0,6,6" Click="Reopen_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <jkr:IconGlyph Glyph="undo" Size="12" Foreground="{StaticResource Ink2}" Margin="0,0,5,0"/>
                                        <TextBlock Text="Reopen" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Btn.Sec}" Margin="0,0,6,6" Click="Locate_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <jkr:IconGlyph Glyph="crosshair" Size="12" Foreground="{StaticResource Ink2}" Margin="0,0,5,0"/>
                                        <TextBlock Text="Locate in 3D" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>

                        <!-- Spec ref (collapsible) -->
                        <Border Margin="0,14,0,0">
                            <StackPanel>
                                <Button x:Name="SpecToggle" Click="SpecToggle_Click" Style="{StaticResource Btn.Link}" HorizontalContentAlignment="Stretch">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <jkr:IconGlyph Glyph="book" Size="12" Foreground="{StaticResource Info}" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="1" x:Name="SpecShort" Foreground="{StaticResource Info}" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                                        <jkr:IconGlyph x:Name="SpecCaret" Grid.Column="2" Name="caretR" Size="10" Foreground="{StaticResource Info}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Border x:Name="SpecBody" Visibility="Collapsed" Background="{StaticResource InfoBg}" CornerRadius="6" Padding="12,10,12,10" Margin="0,4,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="SpecFull" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Info}" Margin="0,0,0,5" TextWrapping="Wrap"/>
                                        <Border Background="White" BorderBrush="{StaticResource Info}" BorderThickness="2,0,0,0" Padding="10,8,10,8" CornerRadius="0">
                                            <TextBlock x:Name="SpecQuote" FontSize="11" FontStyle="Italic" Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock x:Name="SpecMeta" FontSize="10" Foreground="{StaticResource Ink3}"/>
                                            <TextBlock Text="  Open PDF ↗" FontSize="10" Foreground="{StaticResource Info}" TextDecorations="Underline" Margin="8,0,0,0" Cursor="Hand"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
