<UserControl x:Class="RevitWebAppSync.UI.CostDashboard.ChartsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CostDashboardStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Chart-local brushes (not shared with Overview). -->
            <SolidColorBrush x:Key="Ch.LineAreaFill"   Color="#3B7FD6" Opacity="0.12"/>
            <SolidColorBrush x:Key="Ch.Gridline"       Color="#D9DCE2"/>
            <SolidColorBrush x:Key="Ch.MedianBar"      Color="#A6C4E8"/>
            <SolidColorBrush x:Key="Ch.BlueMid"        Color="#5E97DF"/>
            <SolidColorBrush x:Key="Ch.BlueLight"      Color="#7FAEE6"/>
            <SolidColorBrush x:Key="Ch.BlueLighter"    Color="#A6C4E8"/>
            <SolidColorBrush x:Key="Ch.ExportBg"       Color="#E3F2FD"/>
            <SolidColorBrush x:Key="Ch.ExportFg"       Color="#1E5BB5"/>

            <!-- Flat action button: no chrome, content-only, hand cursor. -->
            <Style x:Key="Ch.FlatButton" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Card header row: section title left, hint/pill right. -->
            <Style x:Key="Ch.HeaderGrid" TargetType="Grid">
                <Setter Property="Margin" Value="0,0,0,14"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel x:Name="Root">

        <!-- ═══ 1. COST BY DISCIPLINE ═══ -->
        <Border Style="{StaticResource Cd.Card}">
            <StackPanel>
                <Grid Style="{StaticResource Ch.HeaderGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="DisciplineHeaderText" Style="{StaticResource Cd.SectionHeader}"/>
                    <TextBlock x:Name="DisciplineHintText" Grid.Column="1" Style="{StaticResource Cd.Caption}" VerticalAlignment="Center"/>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <Grid Width="160" Height="160">
                        <Canvas x:Name="DonutCanvas" Width="160" Height="160"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="DonutTotalText" Style="{StaticResource Cd.MetricValue}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="DonutTotalLabelText" Style="{StaticResource Cd.Caption}" FontWeight="SemiBold"
                                       Foreground="{StaticResource Cd.TextSecondary}" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel x:Name="DonutLegend" VerticalAlignment="Center" Margin="28,0,0,0"/>
                </StackPanel>

                <Rectangle Height="1" Fill="{StaticResource Cd.Divider}" Margin="0,16,0,0" SnapsToDevicePixels="True"/>
                <TextBlock x:Name="DisciplineNoteText" Style="{StaticResource Cd.Body}" FontSize="{StaticResource Cd.FontSize.Caption}"
                           TextWrapping="Wrap" TextTrimming="None" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>

        <!-- ═══ 2. COST BY REVISION ═══ -->
        <Border Style="{StaticResource Cd.Card}" Margin="0,12,0,0">
            <StackPanel>
                <Grid Style="{StaticResource Ch.HeaderGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="RevisionHeaderText" Style="{StaticResource Cd.SectionHeader}"/>
                    <Border Grid.Column="1" Style="{StaticResource Cd.Pill.Success}">
                        <TextBlock x:Name="RevisionPillText" FontSize="{StaticResource Cd.FontSize.Caption}"/>
                    </Border>
                </Grid>

                <!-- Line chart: axis labels + gridlines + area + line + points drawn in code on SizeChanged. -->
                <Canvas x:Name="LineCanvas" Height="210" ClipToBounds="False"/>

                <Rectangle Height="1" Fill="{StaticResource Cd.Divider}" Margin="0,12,0,0" SnapsToDevicePixels="True"/>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="RevisionScaleNoteText" Style="{StaticResource Cd.Caption}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock x:Name="RevisionNoteText" Grid.Column="1" Style="{StaticResource Cd.Body}"
                               TextWrapping="Wrap" TextTrimming="None" TextAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ═══ 3. COST PER M² VS JKR MEDIAN ═══ -->
        <Border Style="{StaticResource Cd.Card}" Margin="0,12,0,0">
            <StackPanel>
                <Grid Style="{StaticResource Ch.HeaderGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PerM2HeaderText" Style="{StaticResource Cd.SectionHeader}"/>
                    <TextBlock x:Name="PerM2GfaText" Grid.Column="1" Style="{StaticResource Cd.Body}" VerticalAlignment="Center"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="PerM2CurrencyText" Style="{StaticResource Cd.Subhead}"
                                   Foreground="{StaticResource Cd.TextSecondary}" VerticalAlignment="Bottom" Margin="0,0,6,6"/>
                        <TextBlock x:Name="PerM2ValueText" Style="{StaticResource Cd.MetricValue.Hero}"/>
                        <TextBlock x:Name="PerM2UnitText" Style="{StaticResource Cd.Body}" VerticalAlignment="Bottom" Margin="6,0,0,6"/>
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource Cd.Pill.Success}">
                        <TextBlock x:Name="PerM2PillText" FontSize="{StaticResource Cd.FontSize.Caption}"/>
                    </Border>
                </Grid>

                <Grid x:Name="PerM2Bars" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" MinWidth="56"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                </Grid>

                <Rectangle Height="1" Fill="{StaticResource Cd.Divider}" Margin="0,16,0,0" SnapsToDevicePixels="True"/>
                <TextBlock x:Name="PerM2NoteText" Style="{StaticResource Cd.Body}" FontSize="{StaticResource Cd.FontSize.Caption}"
                           TextWrapping="Wrap" TextTrimming="None" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>

        <!-- ═══ 4. TOP COST DRIVERS ═══ -->
        <Border Style="{StaticResource Cd.Card}" Margin="0,12,0,0">
            <StackPanel>
                <Grid Style="{StaticResource Ch.HeaderGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="DriversHeaderText" Style="{StaticResource Cd.SectionHeader}"/>
                    <TextBlock x:Name="DriversHintText" Grid.Column="1" Style="{StaticResource Cd.Body}" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel x:Name="DriverRows"/>
            </StackPanel>
        </Border>

        <!-- ═══ 5. PRICED COST BY LEVEL ═══ -->
        <Border Style="{StaticResource Cd.Card}" Margin="0,12,0,0">
            <StackPanel>
                <Grid Style="{StaticResource Ch.HeaderGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LevelsHeaderText" Style="{StaticResource Cd.SectionHeader}"/>
                    <TextBlock x:Name="LevelsHintText" Grid.Column="1" Style="{StaticResource Cd.Body}" VerticalAlignment="Center"/>
                </Grid>
                <Grid x:Name="LevelRows">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" MinWidth="92"/>
                    </Grid.ColumnDefinitions>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ═══ EXPORT BUTTONS ═══ -->
        <Grid Margin="0,14,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource Ch.FlatButton}" HorizontalAlignment="Stretch" Click="OnExportPdf">
                <Border Background="{StaticResource Ch.ExportBg}" CornerRadius="{StaticResource Cd.Radius.Pill}" Padding="18,11">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- PDF glyph: page with folded corner -->
                        <Path Width="16" Height="16" Stretch="Uniform" Fill="{StaticResource Ch.ExportFg}"
                              VerticalAlignment="Center" Margin="0,0,10,0"
                              Data="F1 M6,2 H14 L20,8 V22 H6 Z M14,2 V8 H20 M8,14 H16 V16 H8 Z M8,18 H13 V20 H8 Z"/>
                        <TextBlock x:Name="ExportPdfText" Style="{StaticResource Cd.Subhead}"
                                   Foreground="{StaticResource Ch.ExportFg}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Button>

            <Button Grid.Column="1" Style="{StaticResource Ch.FlatButton}" Margin="10,0,0,0" Click="OnExportXlsx">
                <Border Background="{StaticResource Ch.ExportBg}" CornerRadius="{StaticResource Cd.Radius.Pill}" Padding="18,11">
                    <StackPanel Orientation="Horizontal">
                        <!-- XLSX glyph: grid/table -->
                        <Path Width="16" Height="16" Stretch="Uniform" Fill="{StaticResource Ch.ExportFg}"
                              VerticalAlignment="Center" Margin="0,0,10,0"
                              Data="F1 M3,4 H21 V20 H3 Z M5,6 V18 H19 V6 Z M5,10 H19 V11.5 H5 Z M5,14 H19 V15.5 H5 Z M11,6 H12.5 V18 H11 Z"/>
                        <TextBlock x:Name="ExportXlsxText" Style="{StaticResource Cd.Subhead}"
                                   Foreground="{StaticResource Ch.ExportFg}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Button>
        </Grid>

    </StackPanel>
</UserControl>
