<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:cd="clr-namespace:RevitWebAppSync.UI.CostDashboard">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="CostDashboardTokens.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ══════════ CARD ══════════
         White rounded surface on the light-grey page. Reference cards carry a
         hairline border + very soft shadow; we use a 1px Cd.Divider border and
         a faint DropShadowEffect (cheap enough for a handful of cards). -->
    <Style x:Key="Cd.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Cd.Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Cd.Divider}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Cd.Radius.Card}"/>
        <Setter Property="Padding" Value="{DynamicResource Cd.Padding.Card}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="10" ShadowDepth="1" Direction="270"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card with zero padding — for cards that own their inner rows/dividers. -->
    <Style x:Key="Cd.Card.Flush" TargetType="Border" BasedOn="{StaticResource Cd.Card}">
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- ══════════ PILLS ══════════ -->
    <!-- Neutral pill: light grey fill, secondary text (e.g. "Revit 2026"). -->
    <Style x:Key="Cd.Pill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Cd.PillBg}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Cd.Radius.Pill}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource Cd.TextSecondary}"/>
        <Setter Property="TextBlock.FontFamily" Value="{DynamicResource Cd.Font}"/>
        <Setter Property="TextBlock.FontSize" Value="{DynamicResource Cd.FontSize.Body}"/>
        <Setter Property="TextBlock.FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Success pill: pale green fill, green text (e.g. "High confidence"). -->
    <Style x:Key="Cd.Pill.Success" TargetType="Border" BasedOn="{StaticResource Cd.Pill}">
        <Setter Property="Background" Value="{DynamicResource Cd.GreenFill}"/>
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource Cd.Green}"/>
        <Setter Property="Padding" Value="12,5"/>
    </Style>

    <!-- ══════════ TEXT ══════════ -->
    <Style x:Key="Cd.Text" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Cd.Font}"/>
        <Setter Property="FontSize" Value="{DynamicResource Cd.FontSize.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Cd.TextPrimary}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Page / card title: "Design to Cost", discipline names. -->
    <Style x:Key="Cd.Title" TargetType="TextBlock" BasedOn="{StaticResource Cd.Text}">
        <Setter Property="FontSize" Value="{DynamicResource Cd.FontSize.Title}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- Subhead: row amounts / medium emphasis. -->
    <Style x:Key="Cd.Subhead" TargetType="TextBlock" BasedOn="{StaticResource Cd.Text}">
        <Setter Property="FontSize" Value="{DynamicResource Cd.FontSize.Subhead}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Body secondary grey (model code, "2,145 items · 98% priced"). -->
    <Style x:Key="Cd.Body" TargetType="TextBlock" BasedOn="{StaticResource Cd.Text}">
        <Setter Property="Foreground" Value="{DynamicResource Cd.TextSecondary}"/>
    </Style>

    <!-- Caption: small muted grey. -->
    <Style x:Key="Cd.Caption" TargetType="TextBlock" BasedOn="{StaticResource Cd.Text}">
        <Setter Property="FontSize" Value="{DynamicResource Cd.FontSize.Caption}"/>
        <Setter Property="Foreground" Value="{DynamicResource Cd.TextMuted}"/>
    </Style>

    <!-- All-caps grey section heading: "ESTIMATED COST", "BREAKDOWN BY DISCIPLINE". -->
    <Style x:Key="Cd.SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource Cd.Text}">
        <Setter Property="FontSize" Value="{DynamicResource Cd.FontSize.Body}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource Cd.TextSecondary}"/>
        <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Large bold number: "6,014,750", "4,463". -->
    <Style x:Key="Cd.MetricValue" TargetType="TextBlock" BasedOn="{StaticResource Cd.Text}">
        <Setter Property="FontSize" Value="{DynamicResource Cd.FontSize.Metric}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- Hero number for the estimated-cost card. -->
    <Style x:Key="Cd.MetricValue.Hero" TargetType="TextBlock" BasedOn="{StaticResource Cd.MetricValue}">
        <Setter Property="FontSize" Value="{DynamicResource Cd.FontSize.Hero}"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
    </Style>

    <!-- ══════════ TAB BUTTON ══════════
         Segmented control: grey track (owned by the page) holding ToggleButtons.
         Checked = white pill, near-black text, hairline border. Unchecked = grey text. -->
    <Style x:Key="Cd.TabButton" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Cd.TextSecondary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Cd.Font}"/>
        <Setter Property="FontSize" Value="{DynamicResource Cd.FontSize.Subhead}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="9"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Cd.TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Cd.Card}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Cd.Divider}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Cd.TextPrimary}"/>
                            <Setter TargetName="bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="6" ShadowDepth="1" Direction="270"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════ DISCIPLINE BAR ══════════
         Rounded 6px track; Foreground = discipline brush. Fill scales in from
         the left on Loaded (ScaleTransform animation) so rows "grow" in. -->
    <Style x:Key="Cd.DisciplineBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Background" Value="{DynamicResource Cd.Track}"/>
        <Setter Property="Foreground" Value="{DynamicResource Cd.Primary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="TemplateRoot" SnapsToDevicePixels="True">
                        <Border x:Name="PART_Track"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"/>
                        <Border x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="3"
                                RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="fillScale" ScaleX="1"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="fillScale"
                                                     Storyboard.TargetProperty="ScaleX"
                                                     From="0" To="1" Duration="0:0:0.6">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════ CIRCULAR GAUGE (default template) ══════════
         Implicit style for CircularGaugeControl. Canvas is 100x100 in a Viewbox
         so Width/Height on the control scale the whole gauge. Code-behind fills
         PART_Arc.Data from Value. -->
    <Style TargetType="{x:Type cd:CircularGaugeControl}">
        <Setter Property="Width" Value="140"/>
        <Setter Property="Height" Value="140"/>
        <Setter Property="Foreground" Value="{DynamicResource Cd.TextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource Cd.Track}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Cd.Font}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type cd:CircularGaugeControl}">
                    <Viewbox Stretch="Uniform">
                        <Grid Width="100" Height="100">
                            <Canvas Width="100" Height="100">
                                <Ellipse x:Name="PART_Track" Canvas.Left="6" Canvas.Top="6"
                                         Width="88" Height="88"
                                         Stroke="{TemplateBinding Background}"
                                         StrokeThickness="{TemplateBinding StrokeThickness}"
                                         Fill="Transparent"/>
                                <Path x:Name="PART_Arc"
                                      Stroke="{TemplateBinding ArcBrush}"
                                      StrokeThickness="{TemplateBinding StrokeThickness}"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Fill="Transparent"/>
                            </Canvas>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="PART_Value"
                                           Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0}%}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="20" FontWeight="Bold"
                                           Foreground="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="PART_Label"
                                           Text="{TemplateBinding Label}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="8.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Cd.TextSecondary}"
                                           HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
