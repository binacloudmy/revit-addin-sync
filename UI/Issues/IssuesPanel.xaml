<UserControl x:Class="RevitWebAppSync.UI.Issues.IssuesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F9FAFB" MinWidth="320">

    <UserControl.Resources>
        <Style x:Key="IssueCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#2A64F9"/>
                    <Setter Property="Background" Value="#FBFDFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Primary action: BINA blue, matching the web's buttons -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2A64F9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4FD8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#C7D2FE"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ============ LIST ============ -->
        <Grid x:Name="ListView">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Issues" FontSize="17" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock x:Name="SubtitleText" FontSize="11" Foreground="#6B7280"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="SyncButton" Content="Sync" Width="72"
                            Style="{StaticResource PrimaryButton}" Click="SyncButton_Click" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <ProgressBar x:Name="Busy" Grid.Row="1" Height="2" IsIndeterminate="True"
                         Visibility="Collapsed" Foreground="#2A64F9" BorderThickness="0" Background="Transparent"/>

            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="14,8">
                <StackPanel>
                    <ComboBox x:Name="ScopeFilter" Height="26" Margin="0,0,0,6" SelectionChanged="Filter_Changed"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" x:Name="StatusFilter" Height="26" SelectionChanged="Filter_Changed"/>
                    <ComboBox Grid.Column="1" x:Name="SourceFilter" Height="26" Margin="8,0,0,0" SelectionChanged="Filter_Changed"/>
                    <TextBlock Grid.Column="2" x:Name="CountText" FontSize="11" Foreground="#6B7280"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="12,12,12,0">
                <StackPanel>
                    <TextBlock x:Name="EmptyText" Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap"
                               Margin="6,28,6,0" TextAlignment="Center"
                               Text="Press Sync to load issues from BINA."/>
                    <ItemsControl x:Name="IssueItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource IssueCard}" MouseLeftButtonUp="Card_Click"
                                        Tag="{Binding}" Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="78" Height="62" CornerRadius="6"
                                                Background="#F3F4F6" Margin="0,0,10,0" ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Text="No image" FontSize="9" Foreground="#9CA3AF"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding PlaceholderVisibility}"/>
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                       Visibility="{Binding ThumbnailVisibility}"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold"
                                                           FontSize="12.5" Foreground="#111827" TextTrimming="CharacterEllipsis"/>
                                                <Border Grid.Column="1" Style="{StaticResource Pill}"
                                                        Background="{Binding StatusBackground}" Margin="6,0,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="6" Height="6" Margin="0,0,4,0"
                                                                 VerticalAlignment="Center" Fill="{Binding StatusDot}"/>
                                                        <TextBlock Text="{Binding StatusLabel}" FontSize="10"
                                                                   FontWeight="SemiBold" Foreground="{Binding StatusForeground}"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <Border Style="{StaticResource Pill}" Background="#EEF2FF"
                                                    HorizontalAlignment="Left" Margin="0,5,0,0"
                                                    Visibility="{Binding CoordinationVisibility}">
                                                <TextBlock Text="Coordination" FontSize="9.5" Foreground="#3730A3"/>
                                            </Border>

                                            <TextBlock Text="{Binding Preview}" FontSize="11" Foreground="#6B7280"
                                                       TextWrapping="Wrap" MaxHeight="32" Margin="0,4,0,0"/>

                                            <!-- Which model, when the list spans the project -->
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                                        Visibility="{Binding ModelVisibility}">
                                                <TextBlock Text="&#x1F5CE;" FontSize="9.5" Foreground="#9CA3AF"
                                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding ModelName}" FontSize="10" Foreground="#6B7280"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                <Border Style="{StaticResource Pill}" Background="{Binding PriorityBackground}"
                                                        Visibility="{Binding PriorityVisibility}">
                                                    <TextBlock Text="{Binding Priority}" FontSize="10"
                                                               Foreground="{Binding PriorityForeground}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Byline}" FontSize="10" Foreground="#9CA3AF"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="4" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="14,8">
                <TextBlock x:Name="StatusText" FontSize="11" Foreground="#6B7280" TextWrapping="Wrap"
                           Text="Read-only — edit issues in BINA Cloud."/>
            </Border>
        </Grid>

        <!-- ============ DETAIL ============ -->
        <Grid x:Name="DetailView" Visibility="Collapsed" Background="#FFFFFF">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="14,12">
                <StackPanel>
                    <Button x:Name="BackButton" Content="&#x2190;  All issues" HorizontalAlignment="Left"
                            Background="Transparent" BorderThickness="0" Foreground="#2A64F9"
                            FontSize="11" Cursor="Hand" Padding="0" Click="BackButton_Click"/>
                    <TextBlock x:Name="DetailTitle" FontSize="15" FontWeight="Bold" Foreground="#111827"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Border x:Name="DetailStatusPill" Style="{StaticResource Pill}">
                            <TextBlock x:Name="DetailStatusText" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                        <Border x:Name="DetailPriorityPill" Style="{StaticResource Pill}" Margin="6,0,0,0">
                            <TextBlock x:Name="DetailPriorityText" FontSize="10"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="DetailByline" FontSize="11" Foreground="#9CA3AF" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,12">
                <StackPanel>
                    <Border CornerRadius="8" Background="#F3F4F6" Margin="0,0,0,12"
                            x:Name="DetailImageBox" ClipToBounds="True">
                        <Image x:Name="DetailImage" Stretch="Uniform" MaxHeight="260"/>
                    </Border>

                    <TextBlock x:Name="DetailText" FontSize="12" Foreground="#374151" TextWrapping="Wrap"/>

                    <TextBlock x:Name="DetailElements" FontSize="11" Foreground="#6B7280"
                               TextWrapping="Wrap" Margin="0,12,0,0"/>

                    <TextBlock Text="Replies" FontWeight="SemiBold" FontSize="12" Foreground="#111827"
                               Margin="0,16,0,6" x:Name="RepliesHeader"/>
                    <ItemsControl x:Name="RepliesItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1"
                                        CornerRadius="6" Padding="9" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Who}" FontSize="10.5" FontWeight="SemiBold" Foreground="#374151"/>
                                        <TextBlock Text="{Binding Text}" FontSize="11.5" Foreground="#4B5563"
                                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="14,10">
                <StackPanel>
                    <Button x:Name="ShowInModelButton" Content="Show in model"
                            Style="{StaticResource PrimaryButton}" Click="ShowInModel_Click"/>
                    <TextBlock x:Name="DetailStatusLine" FontSize="11" Foreground="#6B7280"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
