<UserControl x:Class="RevitWebAppSync.UI.Issues.IssuesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F9FAFB" MinWidth="300">

    <UserControl.Resources>
        <!-- Card, list row: mirrors the web's issue list (rounded, hairline
             border, lifts on hover) so the two read as the same product. -->
        <Style x:Key="IssueCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#93C5FD"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Issues" FontSize="16" FontWeight="SemiBold" Foreground="#111827"/>
                    <TextBlock x:Name="SubtitleText" Text="Not synced yet" FontSize="11"
                               Foreground="#6B7280" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="SyncButton" Content="Sync" Width="64" Height="28"
                        Click="SyncButton_Click" VerticalAlignment="Top"/>
            </Grid>
        </Border>

        <!-- Filters -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="14,8">
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="StatusFilter" Width="110" Height="26" SelectionChanged="Filter_Changed"/>
                <ComboBox x:Name="ScopeFilter" Width="130" Height="26" Margin="8,0,0,0" SelectionChanged="Filter_Changed"/>
                <TextBlock x:Name="CountText" Text="" FontSize="11" Foreground="#6B7280"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="12,12,12,0">
            <StackPanel>
                <TextBlock x:Name="EmptyText" Text="Press Sync to load issues from BINA."
                           Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" Margin="2,20,2,0"
                           TextAlignment="Center"/>
                <ItemsControl x:Name="IssueItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource IssueCard}" MouseLeftButtonUp="Card_Click"
                                    Tag="{Binding}" Cursor="Hand">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Snapshot thumbnail, as the web list shows -->
                                    <Border Grid.Column="0" Width="76" Height="60" CornerRadius="4"
                                            Background="#F3F4F6" Margin="0,0,10,0"
                                            Visibility="{Binding ThumbnailVisibility}">
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                    </Border>

                                    <StackPanel Grid.Column="1">
                                        <!-- Title + status pill -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold"
                                                       FontSize="12.5" Foreground="#111827"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="1" Style="{StaticResource Pill}"
                                                    Background="{Binding StatusBackground}" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="10"
                                                           FontWeight="SemiBold" Foreground="{Binding StatusForeground}"/>
                                            </Border>
                                        </Grid>

                                        <TextBlock Text="{Binding Preview}" FontSize="11" Foreground="#6B7280"
                                                   TextWrapping="Wrap" MaxHeight="30" Margin="0,3,0,0"/>

                                        <!-- Footer: priority, author, date -->
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Border Style="{StaticResource Pill}" Background="{Binding PriorityBackground}"
                                                    Visibility="{Binding PriorityVisibility}">
                                                <TextBlock Text="{Binding Priority}" FontSize="10"
                                                           Foreground="{Binding PriorityForeground}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Byline}" FontSize="10" Foreground="#9CA3AF"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Status line -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="14,8">
            <TextBlock x:Name="StatusText" Text="Read-only — edit issues in BINA Cloud."
                       FontSize="11" Foreground="#6B7280" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
