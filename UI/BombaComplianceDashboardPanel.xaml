<UserControl x:Class="RevitWebAppSync.UI.BombaComplianceDashboardPanel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:jkr="clr-namespace:RevitWebAppSync.UI.Jkr"
      Background="#FFFFFF" FontFamily="Segoe UI" Focusable="True">

    <!-- Modern Flow (design 10A, Bomba Modern Flow.dc.html): LIGHT, one
         screen at a time, plain language, one big action per screen.
         Deliberately a separate visual system from the JKR pane (user
         decision) — the palette lives in BombaModernModels.M and the
         literals below. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <jkr:BoolToVisibilityConverter x:Key="BoolVis"/>

            <LinearGradientBrush x:Key="M.AccentGrad" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFC838" Offset="0"/>
                <GradientStop Color="#F0AE00" Offset="1"/>
            </LinearGradientBrush>

            <Style x:Key="M.Card" TargetType="Border">
                <Setter Property="Background" Value="#F4F3F0"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <!-- big yellow primary; dark ink per the design -->
            <Style x:Key="M.BtnPrimary" TargetType="Button">
                <Setter Property="Foreground" Value="#2A2000"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{StaticResource M.AccentGrad}"
                                    CornerRadius="14" Padding="0,15" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value=".9"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value=".35"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- card secondary -->
            <Style x:Key="M.BtnGhost" TargetType="Button">
                <Setter Property="Foreground" Value="#6B7078"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="#F4F3F0" CornerRadius="12" Padding="0,12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#ECEAE4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- borderless text button (Back, Later) -->
            <Style x:Key="M.BtnText" TargetType="Button">
                <Setter Property="Foreground" Value="#A97F00"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" Padding="6,8">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- light templated select for the band ask -->
            <Style x:Key="M.ComboItem" TargetType="ComboBoxItem">
                <Setter Property="Padding" Value="12,9"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="#1A1C20"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#ECEAE4"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#ECEAE4"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="M.Combo" TargetType="ComboBox">
                <Setter Property="Foreground" Value="#1A1C20"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource M.ComboItem}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Chrome" Background="#F4F3F0" BorderBrush="#E5E3DD"
                                                    BorderThickness="1" CornerRadius="12">
                                                <Path HorizontalAlignment="Right" Margin="0,0,13,0"
                                                      VerticalAlignment="Center" Data="M0,0 L4,4 8,0"
                                                      Stroke="#7A7F88" StrokeThickness="1.5"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="#A97F00"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="#A97F00"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter Margin="13,10,30,10" VerticalAlignment="Center"
                                                  HorizontalAlignment="Left" IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                <TextBlock x:Name="Placeholder" Text="Choose…" Margin="13,10,30,10"
                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                           Foreground="#7A7F88" Visibility="Collapsed"/>
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                       AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
                                    <Border Background="#FFFFFF" BorderBrush="#E5E3DD" BorderThickness="1"
                                            CornerRadius="12" Margin="0,4,0,0" MaxHeight="280"
                                            MinWidth="{TemplateBinding ActualWidth}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="SelectedItem" Value="{x:Null}">
                                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- top bar: Back + wizard dots -->
        <Grid Grid.Row="0" Margin="16,12,16,0" MinHeight="30">
            <Button Style="{StaticResource M.BtnText}" Content="‹ Back" HorizontalAlignment="Left"
                    Click="Back_Click"
                    Visibility="{Binding BackVisible, Converter={StaticResource BoolVis}}"/>
            <ItemsControl ItemsSource="{Binding Dots}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Visibility="{Binding DotsVisible, Converter={StaticResource BoolVis}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="{Binding W}" Height="7" CornerRadius="4" Margin="3,0"
                                Background="{Binding Fill}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- ===== HOME ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding OnHome, Converter={StaticResource BoolVis}}">
            <StackPanel Margin="20,8,20,20">
                <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource M.AccentGrad}"
                        HorizontalAlignment="Left">
                    <TextBlock Text="✓" FontSize="26" Foreground="#2A2000"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Fire safety check" FontSize="25" FontWeight="Bold" Foreground="#1A1C20"
                           Margin="0,14,0,0"/>
                <TextBlock Text="Nothing retyped — the model is the form, and every finding points at the element that caused it."
                           FontSize="14" Foreground="#6B7078" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="20"/>

                <Border Background="#FDF3E2" BorderBrush="#F0E2C4" BorderThickness="1" CornerRadius="12"
                        Padding="12,10" Margin="0,14,0,0"
                        Visibility="{Binding HasNotice, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding Notice}" FontSize="12" Foreground="#B8721A"
                               TextWrapping="Wrap" LineHeight="17"/>
                </Border>

                <Border Style="{StaticResource M.Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <!-- Building type: the value row IS the select — tap to
                             expand the options in place (design: no separate
                             screen for a single-field edit). -->
                        <Border Padding="16,13" BorderBrush="#E5E3DD" BorderThickness="0,0,0,1"
                                Background="Transparent" Cursor="Hand" MouseLeftButtonUp="BuildingType_Click">
                            <DockPanel>
                                <TextBlock Text="{Binding PgChev}" DockPanel.Dock="Right" FontSize="12"
                                           Foreground="#AEB2BA" VerticalAlignment="Center"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding BuildingType}" FontSize="14" Foreground="#6B7078"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text=" · " FontSize="12" Foreground="#AEB2BA" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding PgTag}" FontSize="12" Foreground="#8A8F98"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Building type" FontSize="14" Foreground="#1A1C20"/>
                            </DockPanel>
                        </Border>
                        <StackPanel Visibility="{Binding PgOpen, Converter={StaticResource BoolVis}}">
                            <ItemsControl ItemsSource="{Binding PgOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="28,11,16,11" BorderBrush="#E5E3DD" BorderThickness="0,0,0,1"
                                                Background="#EFEEE9" Cursor="Hand" MouseLeftButtonUp="PgOption_Click">
                                            <DockPanel>
                                                <TextBlock Text="{Binding Mark}" DockPanel.Dock="Right" FontSize="14"
                                                           Foreground="{Binding MarkInk}" VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Label}" FontSize="14" Foreground="#1A1C20"
                                                               VerticalAlignment="Center"/>
                                                    <Border Background="#2434C07A" CornerRadius="20" Padding="8,2"
                                                            Margin="8,0,0,0" VerticalAlignment="Center"
                                                            Visibility="{Binding Detected, Converter={StaticResource BoolVis}}">
                                                        <TextBlock Text="detected" FontSize="10" FontWeight="Bold"
                                                                   Foreground="#1F9D5B"/>
                                                    </Border>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Padding="28,8,16,10" BorderBrush="#E5E3DD" BorderThickness="0,0,0,1"
                                    Background="#EFEEE9">
                                <TextBlock FontSize="11" Foreground="#8A8F98" TextWrapping="Wrap" LineHeight="16"
                                           Text="Pick what the building is used for, not what it's called — a surau inside an office block is still a place of assembly. Your pick is remembered for this model."/>
                            </Border>
                        </StackPanel>
                        <Border Padding="16,8" Background="#FBFAF8" BorderBrush="#E5E3DD" BorderThickness="0,0,0,1"
                                Visibility="{Binding HasPgEvidence, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding PgEvidence}" FontSize="12" Foreground="#7A7F88"
                                       TextWrapping="Wrap" LineHeight="17"/>
                        </Border>
                        <Border Padding="16,13" BorderBrush="#E5E3DD" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <TextBlock Text="{Binding FloorLabel}" DockPanel.Dock="Right" FontSize="14"
                                           Foreground="#6B7078"/>
                                <TextBlock Text="Model" FontSize="14" Foreground="#1A1C20"/>
                            </DockPanel>
                        </Border>
                        <Border Padding="16,13" BorderBrush="#E5E3DD" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <TextBlock Text="{Binding ReadLabel}" DockPanel.Dock="Right" FontSize="14"
                                           Foreground="#6B7078"/>
                                <TextBlock Text="Measured" FontSize="14" Foreground="#1A1C20"/>
                            </DockPanel>
                        </Border>
                        <!-- M&E scope: tap to designate which models carry the
                             fire systems (§A.4 — ask once, persist in the model).
                             An unloaded designated link gets the amber strip. -->
                        <Border Padding="16,13" Background="Transparent" Cursor="Hand"
                                MouseLeftButtonUp="MeScope_Click">
                            <DockPanel>
                                <TextBlock Text="{Binding MeValue}" DockPanel.Dock="Right" FontSize="13"
                                           Foreground="{Binding MeInk}" TextWrapping="Wrap" MaxWidth="200"
                                           TextAlignment="Right"/>
                                <TextBlock Text="M&amp;E scope" FontSize="14" Foreground="#1A1C20"/>
                            </DockPanel>
                        </Border>
                        <Border Padding="16,9" Background="#FDF3E2" BorderBrush="#F0E2C4" BorderThickness="0,1,0,0"
                                Visibility="{Binding HasMeWarn, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding MeWarn}" FontSize="12" Foreground="#B8721A"
                                       TextWrapping="Wrap" LineHeight="17"/>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock Text="WHAT IT CHECKS" FontSize="12" FontWeight="Bold" Foreground="#7A7F88"
                           Margin="4,18,0,8"/>
                <Border Style="{StaticResource M.Card}">
                    <StackPanel>
                        <Border Padding="16,12" BorderBrush="#E5E3DD" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <Border Width="34" Height="34" CornerRadius="10" Background="#24F0B45A" DockPanel.Dock="Left">
                                    <TextBlock Text="🔔" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="12,0,0,0">
                                    <TextBlock Text="Fire systems" FontSize="14" Foreground="#1A1C20" FontWeight="SemiBold"/>
                                    <TextBlock Text="alarms, extinguishers, hose reels — required vs in the model"
                                               FontSize="12" Foreground="#6B7078"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Padding="16,12" BorderBrush="#E5E3DD" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <Border Width="34" Height="34" CornerRadius="10" Background="#24FF7A7A" DockPanel.Dock="Left">
                                    <TextBlock Text="🚪" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="12,0,0,0">
                                    <TextBlock Text="Exit widths" FontSize="14" Foreground="#1A1C20" FontWeight="SemiBold"/>
                                    <TextBlock Text="occupant load → stair &amp; door widths — By-laws 168/175/181" FontSize="12" Foreground="#6B7078"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Padding="16,12" BorderBrush="#E5E3DD" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <Border Width="34" Height="34" CornerRadius="10" Background="#24F0B45A" DockPanel.Dock="Left">
                                    <TextBlock Text="📏" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="12,0,0,0">
                                    <TextBlock Text="Escape routes" FontSize="14" Foreground="#1A1C20" FontWeight="SemiBold"/>
                                    <TextBlock Text="direct distance to an exit — By-law 165 (route walk arrives later)" FontSize="12" Foreground="#6B7078"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Padding="16,12">
                            <DockPanel>
                                <Border Width="34" Height="34" CornerRadius="10" Background="#2434C07A" DockPanel.Dock="Left">
                                    <TextBlock Text="🧯" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="12,0,0,0">
                                    <TextBlock Text="Rising mains" FontSize="14" Foreground="#1A1C20" FontWeight="SemiBold"/>
                                    <TextBlock Text="dry/wet riser by topmost occupied floor — By-laws 230/231" FontSize="12" Foreground="#6B7078"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Padding="16,12">
                            <DockPanel>
                                <Border Width="34" Height="34" CornerRadius="10" Background="#2434C07A" DockPanel.Dock="Left">
                                    <TextBlock Text="🧱" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="12,0,0,0">
                                    <TextBlock Text="Compartmentation &amp; fire resistance" FontSize="14" Foreground="#1A1C20" FontWeight="SemiBold"/>
                                    <TextBlock Text="storey limits, shafts, ratings audit, appliance access — 5th/6th Schedule" FontSize="12" Foreground="#6B7078"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 10th Schedule entry point -->
                <Border Style="{StaticResource M.Card}" Margin="0,10,0,0" Cursor="Hand"
                        MouseLeftButtonUp="Needs_Click">
                    <Border Padding="16,12" Background="Transparent">
                        <DockPanel>
                            <TextBlock Text="›" DockPanel.Dock="Right" FontSize="15" Foreground="#AEB2BA"
                                       VerticalAlignment="Center"/>
                            <Border Width="34" Height="34" CornerRadius="10" Background="#24F0B45A" DockPanel.Dock="Left">
                                <TextBlock Text="📋" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,8,0">
                                <TextBlock Text="Required fire systems" FontSize="14" Foreground="#1A1C20" FontWeight="SemiBold"/>
                                <TextBlock Text="10th Schedule — what this building must have" FontSize="12" Foreground="#6B7078"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Border>

                <Button Style="{StaticResource M.BtnPrimary}" Content="Run check" Margin="0,18,0,0"
                        Click="Rescan_Click" IsEnabled="{Binding NotScanning}"/>
                <TextBlock Text="Reads the model. Changes nothing." FontSize="12" Foreground="#7A7F88"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== SETUP (band ask — needs_input only) ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding OnSetup, Converter={StaticResource BoolVis}}">
            <StackPanel Margin="20,8,20,20">
                <TextBlock Text="One question" FontSize="23" FontWeight="Bold" Foreground="#1A1C20"/>
                <TextBlock Text="{Binding SetupGuidance}" FontSize="14" Foreground="#6B7078"
                           TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="20"/>

                <ItemsControl ItemsSource="{Binding Cascade}" Margin="0,16,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="{Binding Label}" FontFamily="Consolas" FontSize="10"
                                           Foreground="#7A7F88" Margin="2,0,0,5"/>
                                <ComboBox Style="{StaticResource M.Combo}"
                                          ItemsSource="{Binding Options}" DisplayMemberPath="Label"
                                          SelectedItem="{Binding Selected, Mode=TwoWay}"
                                          SelectionChanged="CascadeLevel_SelectionChanged" MinHeight="40"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource M.Card}" Padding="14,11"
                        Visibility="{Binding HasMeasuredFacts, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding MeasuredFacts}" FontFamily="Consolas" FontSize="12"
                               Foreground="#6B7078" TextWrapping="Wrap"/>
                </Border>

                <Button Style="{StaticResource M.BtnPrimary}" Content="Use this &amp; run" Margin="0,16,0,0"
                        Click="RunSetupScan_Click" IsEnabled="{Binding CanRun}"/>
                <TextBlock Text="You're asked once per model." FontSize="12" Foreground="#7A7F88"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== CHECKING ===== -->
        <Grid Grid.Row="1" Visibility="{Binding OnChecking, Converter={StaticResource BoolVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="280">
                <Grid Width="96" Height="96" HorizontalAlignment="Center">
                    <Ellipse Stroke="#E5E3DD" StrokeThickness="7"/>
                    <TextBlock Text="{Binding ProgressText}" FontSize="20" FontWeight="Bold" Foreground="#1A1C20"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="{Binding ProgressTitle}" FontSize="18" FontWeight="SemiBold" Foreground="#1A1C20"
                           HorizontalAlignment="Center" Margin="0,18,0,0"/>
                <TextBlock Text="{Binding ProgressSub}" FontSize="13" Foreground="#6B7078"
                           HorizontalAlignment="Center" Margin="0,5,0,16"/>
                <ItemsControl ItemsSource="{Binding CheckRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,4">
                                <TextBlock Text="{Binding Glyph}" Foreground="{Binding GlyphInk}" FontSize="13"
                                           Width="18" DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding Label}" Foreground="{Binding LabelInk}" FontSize="13"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>

        <!-- ===== SUMMARY ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding OnSummary, Converter={StaticResource BoolVis}}">
            <StackPanel Margin="20,8,20,20">
                <TextBlock Text="{Binding OpenCountText}" FontSize="42" FontWeight="Bold" Foreground="#D64545"/>
                <TextBlock Text="{Binding OpenWord}" FontSize="21" FontWeight="Bold" Foreground="#1A1C20"/>
                <TextBlock Text="Quick wins first — tap a chip to filter." FontSize="13" Foreground="#6B7078"
                           Margin="0,6,0,0"/>

                <Border Background="#2434C07A" CornerRadius="10" Padding="12,8" Margin="0,10,0,0"
                        Visibility="{Binding HasFixedSinceLast, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding FixedSinceLast}" FontSize="12" FontWeight="SemiBold"
                               Foreground="#1F9D5B" TextWrapping="Wrap"/>
                </Border>

                <!-- verdict chips = the filter bar; counts computed from the
                     issue list, so they can never disagree with it -->
                <ItemsControl ItemsSource="{Binding Chips}" Margin="0,12,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Bg}" BorderBrush="{Binding Ring}" BorderThickness="2"
                                    CornerRadius="20" Padding="10,4" Margin="0,0,8,8" Cursor="Hand"
                                    MouseLeftButtonUp="Chip_Click">
                                <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Bold"
                                           Foreground="{Binding Ink}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource M.Card}" Margin="0,8,0,0">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding FilteredIssues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="16,13" BorderBrush="#E5E3DD" BorderThickness="0,0,0,1"
                                            Background="Transparent" Cursor="Hand"
                                            MouseLeftButtonUp="SummaryRow_Click">
                                        <DockPanel>
                                            <TextBlock Text="›" DockPanel.Dock="Right" FontSize="15" Foreground="#AEB2BA"
                                                       VerticalAlignment="Center"/>
                                            <Border Width="34" Height="34" CornerRadius="10" Background="{Binding IconBg}"
                                                    DockPanel.Dock="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Icon}" FontSize="15"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Margin="12,0,8,0">
                                                <TextBlock Text="{Binding Title}" FontSize="14" Foreground="#1A1C20"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Sub}" FontSize="12" Foreground="#6B7078"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Padding="16,16" Visibility="{Binding FilterEmpty, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding FilterEmptyText}" FontSize="13" Foreground="#7A7F88"
                                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource M.BtnText}" Content="Required fire systems — 10th Schedule ›"
                        HorizontalAlignment="Left" Margin="0,6,0,0" Click="NeedsBtn_Click"/>

                <Button Style="{StaticResource M.BtnPrimary}" Content="Start fixing" Margin="0,12,0,0"
                        Click="StartFixing_Click"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== ISSUE DETAIL ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding OnDetail, Converter={StaticResource BoolVis}}">
            <StackPanel Margin="20,4,20,20" DataContext="{Binding}">
                <StackPanel Orientation="Horizontal">
                    <Border Background="{Binding CurrentIssue.TagBg}" CornerRadius="20" Padding="9,3">
                        <TextBlock Text="{Binding CurrentIssue.Tag}" FontSize="11" FontWeight="Bold"
                                   Foreground="{Binding CurrentIssue.TagInk}"/>
                    </Border>
                    <TextBlock Text="{Binding CurPos}" FontSize="12" Foreground="#7A7F88" Margin="9,3,0,0"/>
                </StackPanel>
                <TextBlock Text="{Binding CurrentIssue.Title}" FontSize="22" FontWeight="Bold" Foreground="#1A1C20"
                           TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="27"/>
                <TextBlock Text="{Binding CurrentIssue.Where}" FontSize="13" Foreground="#6B7078" Margin="0,4,0,0"
                           Visibility="{Binding CurrentIssue.HasWhere, Converter={StaticResource BoolVis}}"/>

                <Border Style="{StaticResource M.Card}" Margin="0,14,0,0">
                    <ItemsControl ItemsSource="{Binding CurrentIssue.Facts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,12" BorderBrush="#E5E3DD" BorderThickness="0,0,0,1">
                                    <DockPanel>
                                        <TextBlock Text="{Binding V}" DockPanel.Dock="Right" FontSize="14"
                                                   FontWeight="Bold" Foreground="{Binding Ink}"/>
                                        <TextBlock Text="{Binding K}" FontSize="13" Foreground="#6B7078"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <TextBlock Text="{Binding CurrentIssue.Body}" FontSize="14" Foreground="#44484F"
                           TextWrapping="Wrap" Margin="0,14,0,0" LineHeight="21"/>

                <Border Background="#FDF3E2" BorderBrush="#F0E2C4" BorderThickness="1" CornerRadius="12"
                        Padding="13,11" Margin="0,14,0,0"
                        Visibility="{Binding CurrentIssue.HasNote, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding CurrentIssue.NoFixNote}" FontSize="12" Foreground="#B8721A"
                               TextWrapping="Wrap" LineHeight="18"/>
                </Border>

                <Button Style="{StaticResource M.BtnGhost}" Content="Show in model ›" Foreground="#A97F00"
                        Margin="0,14,0,0" Click="ShowInModel_Click"
                        Visibility="{Binding CurrentIssue.HasElements, Converter={StaticResource BoolVis}}"/>
                <Button Style="{StaticResource M.BtnGhost}" Content="{Binding CurrentIssue.DoLabel}"
                        Foreground="#B8721A" Margin="0,8,0,0" Click="Rescan_Click"/>
                <Button Style="{StaticResource M.BtnText}" Content="Later" HorizontalAlignment="Center"
                        Margin="0,4,0,0" Foreground="#7A7F88" Click="Later_Click"/>
                <TextBlock Text="{Binding CurrentIssue.Cite}" FontSize="10" Foreground="#AEB2BA"
                           HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== DONE ===== -->
        <Grid Grid.Row="1" Visibility="{Binding OnDone, Converter={StaticResource BoolVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
                <Border Width="76" Height="76" CornerRadius="38" HorizontalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1F9D5B" Offset="0"/>
                            <GradientStop Color="#22995F" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="✓" FontSize="34" Foreground="#FFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding DoneTitle}" FontSize="25" FontWeight="Bold" Foreground="#1A1C20"
                           HorizontalAlignment="Center" Margin="0,14,0,0"/>
                <TextBlock Text="{Binding DoneSub}" FontSize="14" Foreground="#6B7078" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="20"/>
                <Button Style="{StaticResource M.BtnText}" Content="Required fire systems — 10th Schedule ›"
                        HorizontalAlignment="Center" Margin="0,14,0,0" Click="NeedsBtn_Click"/>
                <Button Style="{StaticResource M.BtnGhost}" Content="Run again" Margin="0,10,0,0"
                        Click="Rescan_Click"/>
            </StackPanel>
        </Grid>

        <!-- ===== REQUIRED FIRE SYSTEMS (the schedule row's full answer) ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding OnNeeds, Converter={StaticResource BoolVis}}">
            <StackPanel Margin="20,4,20,20">
                <TextBlock Text="Required fire systems" FontSize="22" FontWeight="Bold" Foreground="#1A1C20"/>
                <TextBlock Text="{Binding NeedsSub}" FontSize="13" Foreground="#6B7078" TextWrapping="Wrap"
                           Margin="0,5,0,0"/>

                <TextBlock Text="EXTINGUISHING" FontSize="12" FontWeight="Bold" Foreground="#7A7F88"
                           Margin="4,16,0,8"/>
                <Border Style="{StaticResource M.Card}">
                    <ItemsControl ItemsSource="{Binding Extinguishing}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,12" BorderBrush="#E5E3DD" BorderThickness="0,0,0,1"
                                        Background="Transparent" MouseLeftButtonUp="ReqRow_Click">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Background="{Binding ChipBg}" CornerRadius="20"
                                                Padding="10,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ChipText}" FontSize="12" FontWeight="Bold"
                                                       Foreground="{Binding ChipInk}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="14" Foreground="#1A1C20"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <TextBlock Text="ALARM" FontSize="12" FontWeight="Bold" Foreground="#7A7F88"
                           Margin="4,16,0,8"/>
                <Border Style="{StaticResource M.Card}">
                    <ItemsControl ItemsSource="{Binding Alarm}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,12" BorderBrush="#E5E3DD" BorderThickness="0,0,0,1"
                                        Background="Transparent" MouseLeftButtonUp="ReqRow_Click">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Background="{Binding ChipBg}" CornerRadius="20"
                                                Padding="10,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ChipText}" FontSize="12" FontWeight="Bold"
                                                       Foreground="{Binding ChipInk}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="14" Foreground="#1A1C20"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Border Background="#FDF3E2" BorderBrush="#F0E2C4" BorderThickness="1" CornerRadius="12"
                        Padding="13,11" Margin="0,14,0,0"
                        Visibility="{Binding HasNeedsNote, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding NeedsNote}" FontSize="12" Foreground="#B8721A"
                               TextWrapping="Wrap" LineHeight="18"/>
                </Border>

                <TextBlock Text="WHY — THE RULE BEHIND THIS" FontSize="12" FontWeight="Bold"
                           Foreground="#7A7F88" Margin="4,16,0,8"/>
                <Border Style="{StaticResource M.Card}" Cursor="Hand" MouseLeftButtonUp="Bylaw_Click">
                    <StackPanel>
                        <Border Padding="16,12" Background="Transparent">
                            <DockPanel>
                                <TextBlock Text="{Binding BylawChev}" DockPanel.Dock="Right" FontSize="13"
                                           Foreground="#AEB2BA" VerticalAlignment="Center"/>
                                <TextBlock Text="By-law 225 — the requirement itself" FontSize="14"
                                           Foreground="#1A1C20" FontWeight="SemiBold"/>
                            </DockPanel>
                        </Border>
                        <Border Padding="16,0,16,13"
                                Visibility="{Binding BylawOpen, Converter={StaticResource BoolVis}}">
                            <TextBlock FontSize="12" Foreground="#6B7078" TextWrapping="Wrap" LineHeight="19"
                                       Text="&#8220;Every building shall be provided with such fire alarm system and fire extinguishment system as specified in the Tenth Schedule.&#8221; The list above is that specification for this building&#8217;s row. Certification at submission is By-law 239 — a person signs, the software never does."/>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding NeedsCite}" FontSize="10" Foreground="#AEB2BA"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Margin="0,14,0,0" LineHeight="15"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
