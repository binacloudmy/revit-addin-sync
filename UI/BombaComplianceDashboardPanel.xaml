<UserControl x:Class="RevitWebAppSync.UI.BombaComplianceDashboardPanel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:jkr="clr-namespace:RevitWebAppSync.UI.Jkr"
      Background="#0F1115" FontFamily="Segoe UI" Focusable="True">

    <!-- Modern Flow (design 10A, Bomba Modern Flow.dc.html): dark, one screen
         at a time, plain language, one big action per screen. Deliberately a
         separate visual system from the JKR pane (user decision) — the
         palette lives in BombaModernModels.M and the literals below. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <jkr:BoolToVisibilityConverter x:Key="BoolVis"/>

            <LinearGradientBrush x:Key="M.AccentGrad" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#7C86FF" Offset="0"/>
                <GradientStop Color="#5A63E8" Offset="1"/>
            </LinearGradientBrush>

            <Style x:Key="M.Card" TargetType="Border">
                <Setter Property="Background" Value="#1A1E26"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <!-- big gradient primary -->
            <Style x:Key="M.BtnPrimary" TargetType="Button">
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{StaticResource M.AccentGrad}"
                                    CornerRadius="14" Padding="0,15" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value=".9"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value=".35"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- dark card secondary -->
            <Style x:Key="M.BtnGhost" TargetType="Button">
                <Setter Property="Foreground" Value="#9AA3B2"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="#1A1E26" CornerRadius="12" Padding="0,12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#20242E"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- borderless text button (Back, Later) -->
            <Style x:Key="M.BtnText" TargetType="Button">
                <Setter Property="Foreground" Value="#7C86FF"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" Padding="6,8">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- dark templated select for the Setup cascade -->
            <Style x:Key="M.ComboItem" TargetType="ComboBoxItem">
                <Setter Property="Padding" Value="12,9"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="#E8EAF0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#247C86FF"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#247C86FF"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="M.Combo" TargetType="ComboBox">
                <Setter Property="Foreground" Value="#E8EAF0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource M.ComboItem}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Chrome" Background="#1A1E26" BorderBrush="#232834"
                                                    BorderThickness="1" CornerRadius="12">
                                                <Path HorizontalAlignment="Right" Margin="0,0,13,0"
                                                      VerticalAlignment="Center" Data="M0,0 L4,4 8,0"
                                                      Stroke="#6B7280" StrokeThickness="1.5"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="#7C86FF"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="#7C86FF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter Margin="13,10,30,10" VerticalAlignment="Center"
                                                  HorizontalAlignment="Left" IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                <TextBlock x:Name="Placeholder" Text="Choose…" Margin="13,10,30,10"
                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                           Foreground="#6B7280" Visibility="Collapsed"/>
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                       AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
                                    <Border Background="#1A1E26" BorderBrush="#232834" BorderThickness="1"
                                            CornerRadius="12" Margin="0,4,0,0" MaxHeight="280"
                                            MinWidth="{TemplateBinding ActualWidth}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="SelectedItem" Value="{x:Null}">
                                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- top bar: Back + wizard dots -->
        <Grid Grid.Row="0" Margin="16,12,16,0" MinHeight="30">
            <Button Style="{StaticResource M.BtnText}" Content="‹ Back" HorizontalAlignment="Left"
                    Click="Back_Click"
                    Visibility="{Binding BackVisible, Converter={StaticResource BoolVis}}"/>
            <ItemsControl ItemsSource="{Binding Dots}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Visibility="{Binding DotsVisible, Converter={StaticResource BoolVis}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="{Binding W}" Height="7" CornerRadius="4" Margin="3,0"
                                Background="{Binding Fill}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- ===== HOME ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding OnHome, Converter={StaticResource BoolVis}}">
            <StackPanel Margin="20,8,20,20">
                <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource M.AccentGrad}"
                        HorizontalAlignment="Left">
                    <TextBlock Text="✓" FontSize="26" Foreground="#FFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Fire safety check" FontSize="25" FontWeight="Bold" Foreground="#E8EAF0"
                           Margin="0,14,0,0"/>
                <TextBlock Text="Checks the model against the Bomba rules and shows you exactly what to fix."
                           FontSize="14" Foreground="#9AA3B2" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="20"/>

                <Border Background="#2E241F14" CornerRadius="12" Padding="12,10" Margin="0,14,0,0"
                        Visibility="{Binding HasNotice, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding Notice}" FontSize="12" Foreground="#F0B45A"
                               TextWrapping="Wrap" LineHeight="17"/>
                </Border>

                <Border Style="{StaticResource M.Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <Border Padding="16,13" BorderBrush="#232834" BorderThickness="0,0,0,1"
                                Background="Transparent" Cursor="Hand" MouseLeftButtonUp="BuildingType_Click">
                            <DockPanel>
                                <TextBlock Text="›" DockPanel.Dock="Right" FontSize="15" Foreground="#4A5160"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding BuildingType}" DockPanel.Dock="Right" FontSize="14"
                                           Foreground="#9AA3B2" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Building type" FontSize="14" Foreground="#E8EAF0"/>
                            </DockPanel>
                        </Border>
                        <Border Padding="16,13" BorderBrush="#232834" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <TextBlock Text="{Binding FloorLabel}" DockPanel.Dock="Right" FontSize="14"
                                           Foreground="#9AA3B2"/>
                                <TextBlock Text="Model" FontSize="14" Foreground="#E8EAF0"/>
                            </DockPanel>
                        </Border>
                        <Border Padding="16,13">
                            <DockPanel>
                                <TextBlock Text="{Binding ReadLabel}" DockPanel.Dock="Right" FontSize="14"
                                           Foreground="#9AA3B2"/>
                                <TextBlock Text="Read from model" FontSize="14" Foreground="#E8EAF0"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <TextBlock Text="Everything except the building type is read straight from the model — tap › to set or change it."
                           FontSize="12" Foreground="#6B7280" TextWrapping="Wrap" Margin="4,10,4,0" LineHeight="17"/>

                <TextBlock Text="WHAT IT CHECKS" FontSize="12" FontWeight="Bold" Foreground="#6B7280"
                           Margin="4,18,0,8"/>
                <Border Style="{StaticResource M.Card}">
                    <StackPanel>
                        <Border Padding="16,12" BorderBrush="#232834" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <Border Width="34" Height="34" CornerRadius="10" Background="#24F0B45A" DockPanel.Dock="Left">
                                    <TextBlock Text="🔔" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="12,0,0,0">
                                    <TextBlock Text="Fire systems" FontSize="14" Foreground="#E8EAF0" FontWeight="SemiBold"/>
                                    <TextBlock Text="alarms, extinguishers, hose reels — required vs in the model"
                                               FontSize="12" Foreground="#9AA3B2"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Padding="16,12" BorderBrush="#232834" BorderThickness="0,0,0,1" Opacity=".45">
                            <DockPanel>
                                <Border Width="34" Height="34" CornerRadius="10" Background="#26FF7A7A" DockPanel.Dock="Left">
                                    <TextBlock Text="🚪" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="12,0,0,0">
                                    <TextBlock Text="Exit widths" FontSize="14" Foreground="#E8EAF0" FontWeight="SemiBold"/>
                                    <TextBlock Text="arrives with the next update" FontSize="12" Foreground="#9AA3B2"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Padding="16,12" BorderBrush="#232834" BorderThickness="0,0,0,1" Opacity=".45">
                            <DockPanel>
                                <Border Width="34" Height="34" CornerRadius="10" Background="#247C86FF" DockPanel.Dock="Left">
                                    <TextBlock Text="📏" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="12,0,0,0">
                                    <TextBlock Text="Escape routes" FontSize="14" Foreground="#E8EAF0" FontWeight="SemiBold"/>
                                    <TextBlock Text="arrives with the next update" FontSize="12" Foreground="#9AA3B2"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Padding="16,12" Opacity=".45">
                            <DockPanel>
                                <Border Width="34" Height="34" CornerRadius="10" Background="#2434C07A" DockPanel.Dock="Left">
                                    <TextBlock Text="🧱" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="12,0,0,0">
                                    <TextBlock Text="Wall openings" FontSize="14" Foreground="#E8EAF0" FontWeight="SemiBold"/>
                                    <TextBlock Text="arrives with a later update" FontSize="12" Foreground="#9AA3B2"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource M.BtnPrimary}" Content="Run check" Margin="0,18,0,0"
                        Click="Rescan_Click" IsEnabled="{Binding NotScanning}"/>
                <TextBlock Text="Reads the model. Changes nothing." FontSize="12" Foreground="#6B7280"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== SETUP (building type) ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding OnSetup, Converter={StaticResource BoolVis}}">
            <StackPanel Margin="20,8,20,20">
                <TextBlock Text="Building type" FontSize="23" FontWeight="Bold" Foreground="#E8EAF0"/>
                <TextBlock Text="{Binding SetupGuidance}" FontSize="14" Foreground="#9AA3B2"
                           TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="20"/>

                <ItemsControl ItemsSource="{Binding Cascade}" Margin="0,16,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="{Binding Label}" FontFamily="Consolas" FontSize="10"
                                           Foreground="#6B7280" Margin="2,0,0,5"/>
                                <ComboBox Style="{StaticResource M.Combo}"
                                          ItemsSource="{Binding Options}" DisplayMemberPath="Label"
                                          SelectedItem="{Binding Selected, Mode=TwoWay}"
                                          SelectionChanged="CascadeLevel_SelectionChanged" MinHeight="40"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource M.Card}" Padding="14,11"
                        Visibility="{Binding HasMeasuredFacts, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding MeasuredFacts}" FontFamily="Consolas" FontSize="12"
                               Foreground="#9AA3B2" TextWrapping="Wrap"/>
                </Border>

                <Button Style="{StaticResource M.BtnPrimary}" Content="Use this &amp; run" Margin="0,16,0,0"
                        Click="RunSetupScan_Click" IsEnabled="{Binding CanRun}"/>
                <TextBlock Text="You're asked once per model." FontSize="12" Foreground="#6B7280"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== CHECKING ===== -->
        <Grid Grid.Row="1" Visibility="{Binding OnChecking, Converter={StaticResource BoolVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="280">
                <Grid Width="96" Height="96" HorizontalAlignment="Center">
                    <Ellipse Stroke="#232834" StrokeThickness="7"/>
                    <TextBlock Text="{Binding ProgressText}" FontSize="20" FontWeight="Bold" Foreground="#E8EAF0"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="{Binding ProgressTitle}" FontSize="18" FontWeight="SemiBold" Foreground="#E8EAF0"
                           HorizontalAlignment="Center" Margin="0,18,0,0"/>
                <TextBlock Text="{Binding ProgressSub}" FontSize="13" Foreground="#9AA3B2"
                           HorizontalAlignment="Center" Margin="0,5,0,16"/>
                <ItemsControl ItemsSource="{Binding CheckRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,4">
                                <TextBlock Text="{Binding Glyph}" Foreground="{Binding GlyphInk}" FontSize="13"
                                           Width="18" DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding Label}" Foreground="{Binding LabelInk}" FontSize="13"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>

        <!-- ===== SUMMARY ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding OnSummary, Converter={StaticResource BoolVis}}">
            <StackPanel Margin="20,8,20,20">
                <TextBlock Text="{Binding OpenCountText}" FontSize="42" FontWeight="Bold" Foreground="#FF7A7A"/>
                <TextBlock Text="{Binding OpenWord}" FontSize="21" FontWeight="Bold" Foreground="#E8EAF0"/>
                <TextBlock Text="One at a time — quick wins first." FontSize="13" Foreground="#9AA3B2"
                           Margin="0,6,0,0"/>

                <Border Style="{StaticResource M.Card}" Margin="0,16,0,0">
                    <ItemsControl ItemsSource="{Binding Issues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,13" BorderBrush="#232834" BorderThickness="0,0,0,1"
                                        Background="Transparent" Cursor="Hand"
                                        MouseLeftButtonUp="SummaryRow_Click">
                                    <DockPanel>
                                        <TextBlock Text="›" DockPanel.Dock="Right" FontSize="15" Foreground="#4A5160"
                                                   VerticalAlignment="Center"/>
                                        <Border Width="34" Height="34" CornerRadius="10" Background="{Binding IconBg}"
                                                DockPanel.Dock="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Icon}" FontSize="15"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="12,0,8,0">
                                            <TextBlock Text="{Binding Title}" FontSize="14" Foreground="#E8EAF0"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Sub}" FontSize="12" Foreground="#9AA3B2"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Button Style="{StaticResource M.BtnPrimary}" Content="Start fixing" Margin="0,18,0,0"
                        Click="StartFixing_Click"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== ISSUE DETAIL ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding OnDetail, Converter={StaticResource BoolVis}}">
            <StackPanel Margin="20,4,20,20" DataContext="{Binding}">
                <StackPanel Orientation="Horizontal">
                    <Border Background="{Binding CurrentIssue.TagBg}" CornerRadius="20" Padding="9,3">
                        <TextBlock Text="{Binding CurrentIssue.Tag}" FontSize="11" FontWeight="Bold"
                                   Foreground="{Binding CurrentIssue.TagInk}"/>
                    </Border>
                    <TextBlock Text="{Binding CurPos}" FontSize="12" Foreground="#6B7280" Margin="9,3,0,0"/>
                </StackPanel>
                <TextBlock Text="{Binding CurrentIssue.Title}" FontSize="22" FontWeight="Bold" Foreground="#E8EAF0"
                           TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="27"/>
                <TextBlock Text="{Binding CurrentIssue.Where}" FontSize="13" Foreground="#9AA3B2" Margin="0,4,0,0"
                           Visibility="{Binding CurrentIssue.HasWhere, Converter={StaticResource BoolVis}}"/>

                <Border Style="{StaticResource M.Card}" Margin="0,14,0,0">
                    <ItemsControl ItemsSource="{Binding CurrentIssue.Facts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,12" BorderBrush="#232834" BorderThickness="0,0,0,1">
                                    <DockPanel>
                                        <TextBlock Text="{Binding V}" DockPanel.Dock="Right" FontSize="14"
                                                   FontWeight="Bold" Foreground="{Binding Ink}"/>
                                        <TextBlock Text="{Binding K}" FontSize="13" Foreground="#9AA3B2"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <TextBlock Text="{Binding CurrentIssue.Body}" FontSize="14" Foreground="#C3C9D4"
                           TextWrapping="Wrap" Margin="0,14,0,0" LineHeight="21"/>

                <Border Background="#241F14" BorderBrush="#3A3420" BorderThickness="1" CornerRadius="12"
                        Padding="13,11" Margin="0,14,0,0"
                        Visibility="{Binding CurrentIssue.HasNote, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding CurrentIssue.NoFixNote}" FontSize="12" Foreground="#F0B45A"
                               TextWrapping="Wrap" LineHeight="18"/>
                </Border>

                <Button Style="{StaticResource M.BtnGhost}" Content="{Binding CurrentIssue.DoLabel}"
                        Foreground="#F0B45A" Margin="0,14,0,0" Click="Rescan_Click"/>
                <Button Style="{StaticResource M.BtnText}" Content="Later" HorizontalAlignment="Center"
                        Margin="0,4,0,0" Foreground="#6B7280" Click="Later_Click"/>
                <TextBlock Text="{Binding CurrentIssue.Cite}" FontSize="10" Foreground="#4A5160"
                           HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== DONE ===== -->
        <Grid Grid.Row="1" Visibility="{Binding OnDone, Converter={StaticResource BoolVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
                <Border Width="76" Height="76" CornerRadius="38" HorizontalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#34C07A" Offset="0"/>
                            <GradientStop Color="#22995F" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="✓" FontSize="34" Foreground="#FFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding DoneTitle}" FontSize="25" FontWeight="Bold" Foreground="#E8EAF0"
                           HorizontalAlignment="Center" Margin="0,14,0,0"/>
                <TextBlock Text="{Binding DoneSub}" FontSize="14" Foreground="#9AA3B2" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="20"/>
                <Button Style="{StaticResource M.BtnGhost}" Content="Run again" Margin="0,22,0,0"
                        Click="Rescan_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
