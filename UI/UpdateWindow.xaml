<Window x:Class="RevitWebAppSync.UI.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BINA Sync — Update Required"
        Height="320" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        Background="#F5F5F5">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="HeadingText"
                   Text="Update required"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#333333"/>

        <TextBlock Grid.Row="1"
                   x:Name="VersionText"
                   FontSize="14"
                   Foreground="#555555"
                   Margin="0,8,0,0"/>

        <TextBlock Grid.Row="2"
                   x:Name="BlurbText"
                   Text="A new version of BINA Sync must be installed before the plugin can be used."
                   FontSize="12"
                   Foreground="#777777"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"/>

        <TextBlock Grid.Row="3"
                   x:Name="NotesText"
                   FontSize="12"
                   Foreground="#777777"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"/>

        <StackPanel Grid.Row="4" Margin="0,12,0,12">
            <ProgressBar x:Name="Progress"
                         Height="14"
                         Minimum="0" Maximum="1"
                         Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText"
                       FontSize="12"
                       Foreground="#555555"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <Button Grid.Row="5"
                x:Name="UpdateButton"
                Content="Update now"
                Height="38"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="White"
                Background="#2563EB"
                BorderThickness="0"
                Cursor="Hand"
                Click="UpdateButton_Click"/>
    </Grid>
</Window>
