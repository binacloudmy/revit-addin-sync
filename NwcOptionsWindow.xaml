<Window x:Class="RevitWebAppSync.NwcOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export NWC"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <!-- Deliberately the same shape as the sync dialog: one column of labelled
         controls, Cancel and the verb on the right. Every row Auto so the
         window is as short as its content. -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Export NWC"
                   FontSize="20" FontWeight="Bold" Foreground="#333333"
                   Margin="0,0,0,4"/>

        <TextBlock Grid.Row="1" x:Name="SubtitleText"
                   Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="Exports a Navisworks cache from a temporary 3D view. Your own views are not changed."/>

        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="Coordinates" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,4"/>
            <ComboBox x:Name="CoordinatesCombo" Height="30" SelectedIndex="0">
                <ComboBoxItem Content="Shared (recommended)"/>
                <ComboBoxItem Content="Project internal"/>
            </ComboBox>
            <TextBlock Text="Shared coordinates keep every discipline in the same place when the coordinator federates the models."
                       FontSize="11" Foreground="#666666" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,14">
            <CheckBox x:Name="PurgeCheck" Content="Purge unused elements first"/>
            <TextBlock x:Name="PurgeNote" FontSize="11" Foreground="#B54708"
                       TextWrapping="Wrap" Margin="20,4,0,0" Visibility="Collapsed"/>
            <TextBlock x:Name="PurgeHint" FontSize="11" Foreground="#666666"
                       TextWrapping="Wrap" Margin="20,4,0,0"
                       Text="Deletes unused families and types from the model itself. This one is a real edit and is kept even if the export then fails."/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,4">
            <TextBlock Text="Save to" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="DestinationText"
                           Foreground="#666666" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1" x:Name="ChangeDestinationButton" Content="Change…"
                        Height="26" Padding="10,0" Margin="8,0,0,0"
                        Click="ChangeDestinationButton_Click"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Width="100" Height="32"
                    Margin="0,0,10,0" Click="CancelButton_Click" IsCancel="True"/>
            <Button x:Name="ExportButton" Content="Export" Width="120" Height="32"
                    Click="ExportButton_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
