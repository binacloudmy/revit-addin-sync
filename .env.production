# BINA Sync — PRODUCTION links (Release builds embed this).
# BASE_URL serves API + AI + login (same host); login hits BASE_URL/api/auth/user/sign-in.
BASE_URL=https://bina-ai-prod.azurewebsites.net

# OTA update feed (version.json). Empty = updater disabled.
#
# Points at the BACKEND, not github.com — matching .env.staging. The backend
# resolves TM One first and falls back to GitHub, so delivery can move again
# later without reshipping the client.
#
# This value is baked in at BUILD time, which is why switching it needs a
# bridge. Every installed 0.0.29 carries the old github.com URL and asks GitHub,
# not us: publishing to TM One alone is invisible to that fleet — no error, just
# an update check that keeps succeeding against a release which never changes.
# So the release carrying THIS line must ALSO be published as a GitHub Release,
# or the only clients that need to see it never will. sign-release.ps1 does that
# automatically for prod tags; it can be dropped once no 0.0.29 remains.
#
# Do not ship this ahead of a prod backend that can serve /addin/version.json.
# A 404 here disables update checks on every client at once, and the way back is
# a manual reinstall on each machine.
UPDATE_FEED_URL=https://bina-ai-prod.azurewebsites.net/addin/version.json

# Web origin for the desktop OAuth browser flow. The plugin opens
# LOGIN_WEB_URL/signup/?redirect_uri=... — set the ORIGIN only (no path).
LOGIN_WEB_URL=https://plugins.jkrbinaxone.com

# Sign-in path, appended to BASE_URL → final login URL.
LOGIN_PATH=/api/auth/user/sign-in

# Optional full sign-in URL override. Set only if auth lives on a different
# host; when empty the URL derives from BASE_URL + LOGIN_PATH above.
LOGIN_URL=
