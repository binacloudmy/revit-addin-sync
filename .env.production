# BINA Sync — PRODUCTION links (Release builds embed this).
# BASE_URL serves API + AI + login (same host); login hits BASE_URL/api/auth/user/sign-in.
BASE_URL=https://bina-ai-staging.azurewebsites.net

# OTA update feed (version.json). Empty = updater disabled.
UPDATE_FEED_URL=https://github.com/binacloudmy/revit-addin-sync/releases/latest/download/version.json

# Sign-in path, appended to BASE_URL → final login URL.
LOGIN_PATH=/api/auth/user/sign-in

# Optional full sign-in URL override. Set only if auth lives on a different
# host; when empty the URL derives from BASE_URL + LOGIN_PATH above.
LOGIN_URL=
