&lt;?xml version="1.0" encoding="utf-8"?&gt;
&lt;configuration&gt;
  &lt;!--
    Application Configuration File for Revit Web App Sync
    This file contains default configuration settings.
    
    Configuration Priority (highest to lowest):
    1. Environment Variables
    2. JSON Configuration File (config.json)
    3. This app.config file
    
    TODO: Customize settings for your environment
  --&gt;
  
  &lt;appSettings&gt;
    &lt;!-- Autodesk APS (Platform Services) Configuration --&gt;
    &lt;!-- TODO: Replace with your actual APS application credentials --&gt;
    &lt;add key="APS_CLIENT_ID" value="your-aps-client-id-here" /&gt;
    &lt;add key="APS_CLIENT_SECRET" value="your-aps-client-secret-here" /&gt;
    &lt;add key="APS_REDIRECT_URI" value="http://localhost:8080/callback" /&gt;
    
    &lt;!-- Object Storage Service (OSS) Configuration --&gt;
    &lt;add key="OSS_BucketKey" value="revit-webapp-sync-your-company" /&gt;
    &lt;add key="OSS_Region" value="US" /&gt;
    
    &lt;!-- Web Application Configuration --&gt;
    &lt;!-- TODO: Replace with your web application's API endpoint --&gt;
    &lt;add key="WebApp_BaseUrl" value="https://your-webapp.com/api" /&gt;
    &lt;add key="WebApp_ApiKey" value="your-web-app-api-key" /&gt;
    
    &lt;!-- File Processing Settings --&gt;
    &lt;add key="ExportFormat" value="RVT" /&gt; &lt;!-- Options: RVT, IFC, DWG, NWC --&gt;
    &lt;add key="MaxFileSizeMB" value="100" /&gt;
    &lt;add key="AutoSync" value="false" /&gt;
    
    &lt;!-- Performance Settings --&gt;
    &lt;add key="EnableFileHash" value="true" /&gt;
    &lt;add key="HashMethod" value="SHA256" /&gt; &lt;!-- Options: SHA256, Fast, MetadataOnly --&gt;
    &lt;add key="CacheTokens" value="true" /&gt;
    
    &lt;!-- Logging Settings --&gt;
    &lt;add key="LogLevel" value="Info" /&gt; &lt;!-- Options: Trace, Debug, Info, Warn, Error --&gt;
    &lt;add key="LogToFile" value="true" /&gt;
    &lt;add key="LogFilePath" value="" /&gt; &lt;!-- Empty = auto-generate in temp folder --&gt;
    
    &lt;!-- UI Settings --&gt;
    &lt;add key="ShowProgressDialog" value="true" /&gt;
    &lt;add key="AutoCloseProgress" value="false" /&gt;
    &lt;add key="ConfirmBeforeSync" value="true" /&gt;
    
    &lt;!-- Advanced Settings --&gt;
    &lt;add key="HttpTimeoutSeconds" value="300" /&gt; &lt;!-- 5 minutes --&gt;
    &lt;add key="RetryAttempts" value="3" /&gt;
    &lt;add key="RetryDelaySeconds" value="5" /&gt;
    
    &lt;!-- Development Settings --&gt;
    &lt;!-- TODO: Set to false for production builds --&gt;
    &lt;add key="DebugMode" value="true" /&gt;
    &lt;add key="VerboseLogging" value="false" /&gt;
  &lt;/appSettings&gt;
  
  &lt;!-- Connection Strings (if needed for database connectivity) --&gt;
  &lt;connectionStrings&gt;
    &lt;!-- TODO: Add connection strings if your web app uses database connectivity --&gt;
    &lt;!-- &lt;add name="DefaultConnection" connectionString="your-connection-string" providerName="System.Data.SqlClient" /&gt; --&gt;
  &lt;/connectionStrings&gt;
  
  &lt;!-- Runtime Configuration --&gt;
  &lt;runtime&gt;
    &lt;assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1"&gt;
      &lt;!-- Assembly binding redirects (auto-generated by Visual Studio) --&gt;
      &lt;!-- TODO: Add binding redirects as needed for package conflicts --&gt;
      
      &lt;!-- Example binding redirect for System.Text.Json --&gt;
      &lt;dependentAssembly&gt;
        &lt;assemblyIdentity name="System.Text.Json" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" /&gt;
        &lt;bindingRedirect oldVersion="0.0.0.0-8.0.0.0" newVersion="8.0.0.0" /&gt;
      &lt;/dependentAssembly&gt;
    &lt;/assemblyBinding&gt;
  &lt;/runtime&gt;
  
  &lt;!-- System.Net Configuration --&gt;
  &lt;system.net&gt;
    &lt;settings&gt;
      &lt;!-- Enable modern TLS versions --&gt;
      &lt;httpWebRequest useUnsafeHeaderParsing="false" /&gt;
    &lt;/settings&gt;
    
    &lt;!-- Default proxy settings --&gt;
    &lt;defaultProxy enabled="true" useDefaultCredentials="true"&gt;
      &lt;!-- TODO: Configure proxy if your network requires it --&gt;
      &lt;!-- &lt;proxy proxyaddress="http://proxy.company.com:8080" usesystemdefault="False" /&gt; --&gt;
    &lt;/defaultProxy&gt;
  &lt;/system.net&gt;
  
  &lt;!-- Startup Configuration --&gt;
  &lt;startup&gt;
    &lt;supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" /&gt;
  &lt;/startup&gt;
  
&lt;/configuration&gt;