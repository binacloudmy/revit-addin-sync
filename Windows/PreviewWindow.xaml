<Window x:Class="RevitWebAppSync.Windows.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review Changes"
        Width="600" Height="550"
        MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Dark theme styles -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="ChangeItem" TargetType="Border">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1084D9"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#3F3F46"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#3F3F46"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#505054"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#D32F2F"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E53935"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Risk Indicator -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Review Changes"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#FFFFFF"/>
                <Border x:Name="RiskBadge"
                        CornerRadius="4"
                        Padding="8,4"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="RiskText"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
            <TextBlock x:Name="ExplanationText"
                       Foreground="#AAAAAA"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Summary Bar -->
        <Border Grid.Row="1"
                Background="#252526"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock x:Name="SummaryText"
                           Foreground="#FFFFFF"
                           FontSize="14"
                           FontWeight="SemiBold"/>
                <StackPanel x:Name="SummaryDetails"
                            Orientation="Horizontal"
                            Margin="0,8,0,0">
                    <!-- Dynamic summary badges will be added here -->
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Changes List -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      Margin="0,0,0,16">
            <StackPanel x:Name="ChangesPanel">
                <!-- Deleted Elements Section -->
                <StackPanel x:Name="DeletedSection" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Ellipse Width="10" Height="10" Fill="#F44336" VerticalAlignment="Center"/>
                        <TextBlock Text="Will be Deleted"
                                   Style="{StaticResource SectionHeader}"
                                   Foreground="#F44336"
                                   Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="DeletedList"/>
                </StackPanel>

                <!-- Modified Elements Section -->
                <StackPanel x:Name="ModifiedSection" Visibility="Collapsed" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Ellipse Width="10" Height="10" Fill="#FF9800" VerticalAlignment="Center"/>
                        <TextBlock Text="Will be Modified"
                                   Style="{StaticResource SectionHeader}"
                                   Foreground="#FF9800"
                                   Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="ModifiedList"/>
                </StackPanel>

                <!-- Created Elements Section -->
                <StackPanel x:Name="CreatedSection" Visibility="Collapsed" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Ellipse Width="10" Height="10" Fill="#4CAF50" VerticalAlignment="Center"/>
                        <TextBlock Text="Will be Created"
                                   Style="{StaticResource SectionHeader}"
                                   Foreground="#4CAF50"
                                   Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="CreatedList"/>
                </StackPanel>

                <!-- Selected Elements Section -->
                <StackPanel x:Name="SelectedSection" Visibility="Collapsed" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Ellipse Width="10" Height="10" Fill="#2196F3" VerticalAlignment="Center"/>
                        <TextBlock Text="Will be Selected"
                                   Style="{StaticResource SectionHeader}"
                                   Foreground="#2196F3"
                                   Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="SelectedList"/>
                </StackPanel>

                <!-- No Changes Message -->
                <TextBlock x:Name="NoChangesText"
                           Text="No element changes detected. This may be a read-only operation."
                           Foreground="#888888"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Highlight Button -->
        <Button x:Name="HighlightButton"
                Grid.Row="3"
                Content="Highlight Elements in View"
                Style="{StaticResource SecondaryButton}"
                HorizontalAlignment="Left"
                Margin="0,0,0,16"
                Click="HighlightButton_Click"
                Visibility="Collapsed"/>

        <!-- Action Buttons -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       x:Name="WarningText"
                       Foreground="#FF9800"
                       FontSize="12"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"/>

            <Button x:Name="CancelButton"
                    Grid.Column="1"
                    Content="Cancel"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,12,0"
                    Click="CancelButton_Click"/>

            <Button x:Name="ApplyButton"
                    Grid.Column="2"
                    Content="Apply Changes"
                    Click="ApplyButton_Click"/>
        </Grid>
    </Grid>
</Window>
