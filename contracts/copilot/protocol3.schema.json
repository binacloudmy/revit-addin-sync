{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://binacloud.ai/contracts/copilot/protocol3.schema.json",
  "title": "Copilot protocol 3 (HTTP + SSE)",
  "description": "Add-in <-> bina-ai turn protocol (spec §9, plan §2.2). Requests carry Authorization: Bearer <token>; turn and results POSTs answer with Accept: text/event-stream. SSE wire format: 'event: <type>\\ndata: <json>\\n\\n'. Every event's data carries seq, an integer that starts at 1 and increases within a turn. A stream ends after tool_request, ask or turn_end. Nullable fields are omitted when null; readers also accept an explicit null. The root accepts any one protocol message; validate against a specific $defs entry when the message kind is known.",
  "x-routes": {
    "POST /copilot/turns": {
      "headers": ["Authorization: Bearer <token>", "Accept: text/event-stream"],
      "body": "#/$defs/turn_request",
      "responses": {
        "200": "text/event-stream of #/$defs/sse_frame",
        "409": "a turn is already active for this session",
        "426": "#/$defs/update_required (protocol mismatch)"
      }
    },
    "POST /copilot/turns/{turn_id}/results": {
      "headers": ["Authorization: Bearer <token>", "Accept: text/event-stream"],
      "body": "#/$defs/results_request",
      "responses": {
        "200": "text/event-stream of #/$defs/sse_frame; idempotent by request_id: a repeat returns the same stream",
        "426": "#/$defs/update_required (protocol mismatch)"
      }
    },
    "GET /copilot/turns/{turn_id}/events?after=<seq>": {
      "headers": ["Authorization: Bearer <token>", "Accept: text/event-stream"],
      "responses": {
        "200": "text/event-stream replaying the turn's frames with seq > after (after=0 replays all)"
      }
    },
    "POST /copilot/turns/{turn_id}/cancel": {
      "headers": ["Authorization: Bearer <token>"]
    }
  },
  "anyOf": [
    { "$ref": "#/$defs/turn_request" },
    { "$ref": "#/$defs/results_request" },
    { "$ref": "#/$defs/sse_frame" },
    { "$ref": "#/$defs/update_required" }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "cell": {
      "type": ["string", "number", "boolean", "null"]
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["table", "image"] },
        "columns": { "type": "array", "items": { "type": "string" } },
        "rows": {
          "type": "array",
          "items": { "type": "array", "items": { "$ref": "#/$defs/cell" } },
          "description": "Row-major cells aligned with columns (each row has one cell per column)."
        },
        "image_b64": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": "table" } } },
          "then": { "required": ["columns", "rows"] }
        },
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": "image" } } },
          "then": { "required": ["image_b64"] }
        }
      ]
    },
    "turn_request": {
      "description": "Body of POST /copilot/turns.",
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "turn_id", "text", "snapshot", "attachments"],
      "properties": {
        "protocol": { "const": 3 },
        "turn_id": { "$ref": "#/$defs/uuid", "description": "Generated by the add-in." },
        "session_id": {
          "type": ["string", "null"],
          "description": "Issued by the server in turn_end; absent or null to start a new session."
        },
        "text": { "type": "string" },
        "snapshot": { "$ref": "snapshot.schema.json" },
        "attachments": { "type": "array", "items": { "$ref": "#/$defs/attachment" } }
      }
    },
    "tool_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["call_id", "envelope"],
      "properties": {
        "call_id": { "type": "string", "minLength": 1 },
        "envelope": { "$ref": "envelope.schema.json" }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values"],
      "properties": {
        "values": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] },
          "description": "Keyed by field id or option id. A chosen option is <option_id>: true; a free-text question with neither options nor fields is answered under the id 'text'."
        }
      }
    },
    "results_request": {
      "description": "Body of POST /copilot/turns/{turn_id}/results. Carries either results (for a tool_request) or answer (for an ask), never both.",
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "request_id", "snapshot"],
      "properties": {
        "protocol": { "const": 3 },
        "request_id": { "type": "string", "minLength": 1 },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/tool_result" },
          "description": "One per call of the tool_request, in call order."
        },
        "answer": { "$ref": "#/$defs/answer" },
        "snapshot": { "$ref": "snapshot.schema.json" }
      },
      "oneOf": [{ "required": ["results"] }, { "required": ["answer"] }]
    },
    "update_required": {
      "description": "Body of a 426 response (protocol mismatch).",
      "type": "object",
      "additionalProperties": false,
      "required": ["update_required"],
      "properties": { "update_required": { "const": true } }
    },
    "addin_args_check": {
      "description": "check args as the add-in receives them: the cloud replaced rule_set (an id) with rule_set_content (the full rule set). scope is as in tools.json.",
      "type": "object",
      "required": ["rule_set_content"],
      "properties": {
        "rule_set_content": { "$ref": "ruleset.schema.json" },
        "scope": { "type": "object" }
      },
      "not": { "required": ["rule_set"] }
    },
    "addin_args_set_parameters": {
      "description": "set_parameters args as the add-in receives them: from_table (an attachment name) was replaced by table_rows, one object per table row keyed by column name. Every other field is as in tools.json.",
      "type": "object",
      "properties": {
        "table_rows": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "object", "additionalProperties": { "$ref": "#/$defs/cell" } }
        }
      },
      "not": { "required": ["from_table"] }
    },
    "tool_call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["call_id", "idempotency_key", "tool", "args"],
      "properties": {
        "call_id": { "type": "string", "minLength": 1 },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "description": "Stable across retries of the same call; the add-in ledger keys commits on it."
        },
        "tool": {
          "enum": ["model_overview", "find_elements", "inspect", "check", "set_parameters", "look", "run_revit_code"]
        },
        "args": {
          "type": "object",
          "description": "The model's arguments (tools.json parameters) after the cloud-side rewrites."
        }
      },
      "allOf": [
        {
          "if": { "required": ["tool"], "properties": { "tool": { "const": "check" } } },
          "then": { "properties": { "args": { "$ref": "#/$defs/addin_args_check" } } }
        },
        {
          "if": { "required": ["tool"], "properties": { "tool": { "const": "set_parameters" } } },
          "then": { "properties": { "args": { "$ref": "#/$defs/addin_args_set_parameters" } } }
        }
      ]
    },
    "ask_option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "ask_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "type": { "enum": ["text", "number", "choice"] },
        "unit": { "type": "string" },
        "choices": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/ask_option" },
          "description": "The choices of a choice field; required when type is choice. The answer value is the chosen choice id."
        }
      },
      "if": { "required": ["type"], "properties": { "type": { "const": "choice" } } },
      "then": { "required": ["choices"] }
    },
    "event_progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "kind", "text"],
      "properties": {
        "seq": { "$ref": "#/$defs/seq" },
        "kind": { "enum": ["thinking", "running", "awaiting_confirm", "revit_busy"] },
        "text": { "type": "string" }
      }
    },
    "event_reply_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "text"],
      "properties": {
        "seq": { "$ref": "#/$defs/seq" },
        "text": { "type": "string" }
      }
    },
    "event_tool_request": {
      "description": "Read requests never carry set_parameters; write requests carry only set_parameters and run_revit_code (writes always reach the confirm card).",
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "request_id", "kind", "calls"],
      "properties": {
        "seq": { "$ref": "#/$defs/seq" },
        "request_id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["read", "write"] },
        "calls": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tool_call" } },
        "description": {
          "type": "string",
          "description": "The assistant's own words about the batch; the confirm card shows them on a labelled line."
        }
      },
      "allOf": [
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": "read" } } },
          "then": {
            "properties": {
              "calls": { "items": { "properties": { "tool": { "not": { "const": "set_parameters" } } } } }
            }
          }
        },
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": "write" } } },
          "then": {
            "properties": {
              "calls": { "items": { "properties": { "tool": { "enum": ["set_parameters", "run_revit_code"] } } } }
            }
          }
        }
      ]
    },
    "event_ask": {
      "description": "A question for the drafter (from ask_user). Give options or fields; with neither the pane shows one free-text box answered under the id 'text'.",
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "request_id", "question", "multi", "purpose"],
      "properties": {
        "seq": { "$ref": "#/$defs/seq" },
        "request_id": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "options": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "$ref": "#/$defs/ask_option" } },
        "fields": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ask_field" } },
        "multi": { "type": "boolean" },
        "purpose": { "enum": ["clarify", "project_note"] },
        "note_text": {
          "type": "string",
          "minLength": 1,
          "description": "The project fact to save; required when purpose is project_note. Saved only if the drafter confirms."
        }
      },
      "if": { "required": ["purpose"], "properties": { "purpose": { "const": "project_note" } } },
      "then": { "required": ["note_text"] }
    },
    "event_turn_end": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "status", "session_id", "receipt_ids"],
      "properties": {
        "seq": { "$ref": "#/$defs/seq" },
        "status": { "enum": ["done", "cancelled", "failed", "limit", "interrupted"] },
        "session_id": { "type": "string", "minLength": 1 },
        "receipt_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "event_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "code", "message"],
      "properties": {
        "seq": { "$ref": "#/$defs/seq" },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" }
      }
    },
    "sse_frame": {
      "description": "One SSE frame: the event line's type plus the parsed data line.",
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "data"],
      "properties": {
        "event": { "enum": ["progress", "reply_delta", "tool_request", "ask", "turn_end", "error"] },
        "data": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "required": ["event"], "properties": { "event": { "const": "progress" } } },
          "then": { "properties": { "data": { "$ref": "#/$defs/event_progress" } } }
        },
        {
          "if": { "required": ["event"], "properties": { "event": { "const": "reply_delta" } } },
          "then": { "properties": { "data": { "$ref": "#/$defs/event_reply_delta" } } }
        },
        {
          "if": { "required": ["event"], "properties": { "event": { "const": "tool_request" } } },
          "then": { "properties": { "data": { "$ref": "#/$defs/event_tool_request" } } }
        },
        {
          "if": { "required": ["event"], "properties": { "event": { "const": "ask" } } },
          "then": { "properties": { "data": { "$ref": "#/$defs/event_ask" } } }
        },
        {
          "if": { "required": ["event"], "properties": { "event": { "const": "turn_end" } } },
          "then": { "properties": { "data": { "$ref": "#/$defs/event_turn_end" } } }
        },
        {
          "if": { "required": ["event"], "properties": { "event": { "const": "error" } } },
          "then": { "properties": { "data": { "$ref": "#/$defs/event_error" } } }
        }
      ]
    }
  }
}
