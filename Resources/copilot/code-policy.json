  "categories": [
    { "id": "declaration_outside_body", "why": "write method-body statements only; no classes, members or code outside the body" },
    { "id": "unsafe_code", "why": "no unsafe code, pointers, stackalloc or fixed" },
    { "id": "async_and_lock", "why": "no async, await or lock; the code runs on Revit's thread" },
    { "id": "unbounded_control_flow", "why": "no goto, labels or yield; use loops" },
    { "id": "attributes_and_extern", "why": "no attributes or extern" },
    { "id": "preprocessor", "why": "no # directives" },
    { "id": "host_internals", "why": "only doc, uidoc, view and Print(obj) come from the host, and the host owns them: never dispose them" },
    { "id": "dynamic", "why": "no dynamic; use typed Revit API calls" },
    { "id": "event_hook", "why": "no event subscriptions" },
    { "id": "unsupported_construct", "why": "this C# construct is not supported here" },
    { "id": "reflection", "why": "no reflection; typeof(T) only as an argument to a Revit API call such as OfClass" },
    { "id": "file_io", "why": "no file or folder access" },
    { "id": "network", "why": "no network access" },
    { "id": "process", "why": "no processes, environment, console or diagnostics" },
    { "id": "threading", "why": "no threads, tasks or timers" },
    { "id": "transaction_construction", "why": "do not open transactions; the host does" },
    { "id": "task_dialog", "why": "no dialogs; use Print(obj) for output" },
    { "id": "application_access", "why": "no Application, UIApplication, PostCommand, ExternalEvent or updater access" },
    { "id": "export", "why": "no exporting" },
    { "id": "save_sync", "why": "no saving, opening, closing or syncing documents" },
    { "id": "link_load", "why": "no linking, importing or loading families and links" },
    { "id": "ownership", "why": "no element or workset ownership changes" },
    { "id": "print", "why": "no printing" },
    { "id": "paths", "why": "no file paths or external resources" },
    { "id": "ui_interaction", "why": "no picking, prompts or view switching; use uidoc.Selection and uidoc.RequestViewChange" },
    { "id": "system_not_allowed", "why": "only basic System types are allowed: primitives, string, Math, Convert, StringBuilder, generic collections and LINQ" },
    { "id": "assembly_not_allowed", "why": "only the Revit API and basic System types are allowed; nothing from add-ins or other libraries" }
  ],
  "rules": [
    { "category": "declaration_outside_body", "kind": "syntax", "match": ["wrapper_escape", "member_or_type_declaration"] },
    { "category": "unsafe_code", "kind": "syntax", "match": ["unsafe", "pointer", "stackalloc", "fixed", "function_pointer", "undocumented_keyword"] },
    { "category": "async_and_lock", "kind": "syntax", "match": ["async", "await", "lock"] },
    { "category": "unbounded_control_flow", "kind": "syntax", "match": ["goto", "label", "yield"] },
    { "category": "attributes_and_extern", "kind": "syntax", "match": ["attribute", "extern"] },
