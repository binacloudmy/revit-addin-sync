    { "category": "task_dialog", "kind": "revit_type", "match": ["Autodesk.Revit.UI.TaskDialog"] },
    { "category": "application_access", "kind": "revit_type", "match": ["Autodesk.Revit.UI.UIApplication", "Autodesk.Revit.UI.UIControlledApplication", "Autodesk.Revit.UI.ExternalEvent", "Autodesk.Revit.UI.RevitCommandId", "Autodesk.Revit.DB.UpdaterRegistry"] },
    { "category": "application_access", "kind": "revit_namespace", "match": ["Autodesk.Revit.ApplicationServices", "Autodesk.Revit.DB.ExternalService", "Autodesk.Revit.DB.Events", "Autodesk.Revit.UI.Events"] },
    { "category": "application_access", "kind": "revit_member", "match": ["^Application$", "^PostCommand$", "^CanPostCommand$"] },
    { "category": "print", "kind": "revit_type", "match": ["Autodesk.Revit.DB.PrintManager", "Autodesk.Revit.DB.ViewSheetSetting", "Autodesk.Revit.DB.PrintSetup"] },
    { "category": "print", "kind": "revit_member", "match": ["^Print$", "^SubmitPrint$"] },
    { "category": "export", "kind": "revit_member", "match": ["^Export([A-Z]|$)"] },
    { "category": "save_sync", "kind": "revit_member", "match": ["^Save([A-Z]|$)", "^Open([A-Z]|$)", "^Close$", "^SynchronizeWithCentral", "^ReloadLatest", "^EditFamily$", "^EnableWorksharing$", "^EnableCloudWorksharing$"] },
    { "category": "link_load", "kind": "revit_member", "match": ["^Link$", "^Import$", "^LoadFamily", "^Load$", "^LoadFrom$", "^Reload([A-Z]|$)", "^Unload([A-Z]|$)"] },
    { "category": "ownership", "kind": "revit_member", "match": ["Ownership$", "^Checkout([A-Z]|$)", "^Relinquish([A-Z]|$)"] },
    { "category": "paths", "kind": "revit_type", "match": ["Autodesk.Revit.DB.ModelPath", "Autodesk.Revit.DB.FilePath", "Autodesk.Revit.DB.ServerPath", "Autodesk.Revit.DB.ModelPathUtils", "Autodesk.Revit.DB.ExternalResourceReference", "Autodesk.Revit.DB.ExternalResourceType", "Autodesk.Revit.DB.ExternalFileReference", "Autodesk.Revit.DB.ExternalFileUtils", "Autodesk.Revit.DB.TransmissionData", "Autodesk.Revit.DB.BasicFileInfo"] },
    { "category": "paths", "kind": "revit_member", "match": ["^(PathName|Path|FileName|FilePath)$", "ModelPath", "FileReference", "SharedParametersFilename"] },
    { "category": "paths", "kind": "path_parameter", "match": ["path", "pathname", "file", "filename", "filepath", "folder", "directory", "dir"] },
    { "category": "ui_interaction", "kind": "revit_member", "match": ["^Pick[A-Z]", "^Prompt[A-Z]", "^PostRequest[A-Z]"] },
    { "category": "ui_interaction", "kind": "revit_setter", "match": ["^ActiveView$", "^ActiveGraphicalView$"] },
