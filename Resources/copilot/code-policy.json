    { "category": "host_internals", "kind": "syntax", "match": ["reserved_identifier"] },
    { "category": "host_internals", "kind": "operation", "match": ["host_member", "this_reference", "dispose_host_object"] },
    { "category": "host_internals", "kind": "revit_member", "match": ["^Dispose$"] },
    { "category": "dynamic", "kind": "operation", "match": ["dynamic"] },
    { "category": "event_hook", "kind": "operation", "match": ["event_reference"] },
    { "category": "unsupported_construct", "kind": "operation", "match": ["unsupported_operation"] },
    { "category": "reflection", "kind": "operation", "match": ["typeof_outside_revit_argument"] },
    { "category": "reflection", "kind": "system_member", "match": ["System.Object.GetType"] },
    { "category": "threading", "kind": "system_member", "match": ["*.BeginInvoke", "*.EndInvoke"] },
    { "category": "reflection", "kind": "system_type", "match": ["System.Type", "System.Activator", "System.AppDomain", "System.Delegate", "System.MulticastDelegate", "System.RuntimeTypeHandle", "System.RuntimeMethodHandle", "System.RuntimeFieldHandle", "System.TypedReference", "System.ArgIterator", "System.TypeCode", "System.IntPtr", "System.UIntPtr"] },
    { "category": "reflection", "kind": "system_namespace", "match": ["System.Reflection", "System.Runtime", "System.Linq.Expressions", "System.Security", "Microsoft.CSharp"] },
    { "category": "file_io", "kind": "system_namespace", "match": ["System.IO"] },
    { "category": "network", "kind": "system_namespace", "match": ["System.Net", "System.Web"] },
    { "category": "process", "kind": "system_type", "match": ["System.Environment", "System.AppContext", "System.GC", "System.Console"] },
    { "category": "process", "kind": "system_namespace", "match": ["System.Diagnostics", "Microsoft.Win32"] },
    { "category": "threading", "kind": "system_namespace", "match": ["System.Threading"] },
