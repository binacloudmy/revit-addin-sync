<UserControl x:Class="BinaVibe.Plan.PlanCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="320" d:DesignWidth="420">
    <!--
        Plan card per PRD §9.1: shows the structured Plan the Planner
        produced before any MUTATE runs. INSPECT/DECIDE/MUTATE/VERIFY
        steps render with type badge + goal + expected outcome.
        Embedded inside the Copilot pane chat thread.
    -->
    <Border Padding="12" CornerRadius="8" BorderThickness="1"
            BorderBrush="#3D414B" Background="#1B1E27">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="Plan" FontWeight="Bold" Foreground="#E1E5EE" FontSize="13"/>
                <TextBlock x:Name="IntentText" Margin="8,0,0,0"
                           Foreground="#A4ACBE" FontSize="12"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <ItemsControl x:Name="StepsList" Grid.Row="1">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                            <Border Padding="4,1" CornerRadius="3" Background="#2A2F3B" Margin="0,0,6,0">
                                <TextBlock Text="{Binding Type}" FontSize="10" Foreground="#9AA3B8"/>
                            </Border>
                            <TextBlock Text="{Binding Goal}" Foreground="#D6DAE6" FontSize="12"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,8,0,0">
                <Button x:Name="ApproveButton" Content="Approve &amp; Run" Padding="10,4"/>
                <Button x:Name="EditButton" Content="Edit Plan" Margin="8,0,0,0" Padding="10,4"/>
                <Button x:Name="CancelButton" Content="Cancel" Margin="8,0,0,0" Padding="10,4"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
