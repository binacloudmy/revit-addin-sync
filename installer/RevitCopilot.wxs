<?xml version="1.0" encoding="UTF-8"?>
<!--
  Revit Copilot add-in — MSI installer (WiX v4/v5 syntax).

  OTA layout (one-time install; afterwards the addin self-updates):
    %APPDATA%\Autodesk\Revit\Addins\<year>\
        BinaSync.addin + BinaLoader.dll          <- loader shim, never changes
    %LocalAppData%\Bina\RevitSync\versions\<ver>\
        RevitWebAppSync.dll + deps + manifest.json + .complete
                                                 <- seed build; UpdateService
                                                    stages newer ones here

  Versions staged by the updater AFTER install are unknown to the MSI and are
  left behind on uninstall (delete %LocalAppData%\Bina\RevitSync manually for
  a full purge).

  Supported Revit versions: 2025, 2026, 2027 (net8 hosts only; <=2024 is
  .NET Framework 4.8 and cannot load these assemblies).

  Build via installer\build-installer.ps1 or CI (.github/workflows/release.yml).
  Required preprocessor vars:
    -d LoaderDir=<dir with BinaLoader.dll + BinaSync.addin>
    -d PluginDir=<dotnet publish output + manifest.json + .complete>
    -d SeedVersion=<MAJOR.MINOR.PATCH, must match PluginDir build>
    -d ProductVersion=<MAJOR.MINOR.PATCH>

  IMPORTANT: UpgradeCode is permanent per product. DO NOT regenerate it after
  the first public release or in-place upgrades will break.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Revit Copilot"
           Manufacturer="Bina Cloudtech Sdn Bhd"
           Version="$(var.ProductVersion)"
           UpgradeCode="66179CD4-87C4-41EF-8CAF-81308C5047E2"
           Compressed="yes"
           Scope="perUser">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Revit Copilot is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- %APPDATA%\Autodesk\Revit\Addins\<year>\  (per-user) -->
    <StandardDirectory Id="AppDataFolder">
      <Directory Id="AutodeskFolder" Name="Autodesk">
        <Directory Id="RevitFolder" Name="Revit">
          <Directory Id="AddinsFolder" Name="Addins">
            <Directory Id="Addins2025" Name="2025" />
            <Directory Id="Addins2026" Name="2026" />
            <Directory Id="Addins2027" Name="2027" />
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <!-- %LocalAppData%\Bina\RevitSync\versions\<SeedVersion>\ -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="BinaFolder" Name="Bina">
        <Directory Id="RevitSyncFolder" Name="RevitSync">
          <Directory Id="VersionsFolder" Name="versions">
            <Directory Id="SeedVersionFolder" Name="$(var.SeedVersion)" />
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="RevitCopilotFeature" Title="Revit Copilot Add-in" Level="1">
      <ComponentGroupRef Id="Loader2025" />
      <ComponentGroupRef Id="Loader2026" />
      <ComponentGroupRef Id="Loader2027" />
      <ComponentGroupRef Id="SeedPayload" />
    </Feature>

    <!-- Loader shim per Revit year — the only files Revit locks in place. -->
    <ComponentGroup Id="Loader2025" Directory="Addins2025">
      <Files Include="$(var.LoaderDir)\**">
        <Exclude Files="$(var.LoaderDir)\*.pdb" />
      </Files>
    </ComponentGroup>

    <ComponentGroup Id="Loader2026" Directory="Addins2026">
      <Files Include="$(var.LoaderDir)\**">
        <Exclude Files="$(var.LoaderDir)\*.pdb" />
      </Files>
    </ComponentGroup>

    <ComponentGroup Id="Loader2027" Directory="Addins2027">
      <Files Include="$(var.LoaderDir)\**">
        <Exclude Files="$(var.LoaderDir)\*.pdb" />
      </Files>
    </ComponentGroup>

    <!-- First plugin build, seeded so the loader has something to boot before
         the updater ever runs. One shared copy for all Revit years. -->
    <ComponentGroup Id="SeedPayload" Directory="SeedVersionFolder">
      <Files Include="$(var.PluginDir)\**">
        <Exclude Files="$(var.PluginDir)\*.pdb" />
      </Files>
    </ComponentGroup>

    <ui:WixUI Id="WixUI_Minimal" />

  </Package>
</Wix>
