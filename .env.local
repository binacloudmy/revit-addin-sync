# BINA Sync — LOCAL dev links (Debug builds embed this).
# BASE_URL serves API + AI + login (same host); login hits BASE_URL/api/auth/user/sign-in.
# Point at your local tunnel (ngrok) when running the backend on your machine.
BASE_URL=https://michelina-extrajudicial-logily.ngrok-free.dev
# Colocated-engine gateway: where the engine sends inference and where the
# device token is minted. SEPARATE from BASE_URL on purpose - staging
# authenticates against prod (accounts live there) but must run inference on
# the staging gateway (GATEWAY_INFERENCE_ENABLED=1 + gateway routers deployed).
# Blank = falls back to BASE_URL.
GATEWAY_URL=

# OTA update feed. Empty in dev = updater disabled (no "update ready" noise on every start).
UPDATE_FEED_URL=

# Web origin for the desktop OAuth browser flow. The plugin opens
# LOGIN_WEB_URL/signup/?redirect_uri=... — set the ORIGIN only (no path).
LOGIN_WEB_URL=https://plugins.jkrbinaxone.com

# Sign-in path, appended to BASE_URL → final login URL.
LOGIN_PATH=/api/auth/user/sign-in

# Optional full sign-in URL override. Set only if auth lives on a different
# host; when empty the URL derives from BASE_URL + LOGIN_PATH above.
LOGIN_URL=
# --- BINA Cloud (bina-be) -------------------------------------------------
# bina-be is a DIFFERENT service from bina-ai (BASE_URL above): it serves
# /api/cloud-docs/* and /api/system/*, which bina-ai does not implement.
# For local work point this at a tunnel to your machine's bina-be and set
# "AllowNgrokApiBaseUrl": true in %APPDATA%\RevitWebAppSync\config.json —
# an ngrok value is ignored without that opt-in (stale tunnels 502).
API_BASE_URL=
# Web origin hosting the desktop-OAuth bridge page (/login). Its own
# NEXT_PUBLIC_API_URL must point at the same bina-be as API_BASE_URL.
CLOUD_WEB_URL=http://localhost:3001
