<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Reference only the source files we need — avoids pulling in Revit SDK.
      Pure logic classes with no Revit dependency.
    -->
    <Compile Include="..\UI\Jkr\ViewModels\JkrTierMap.cs" Link="JkrTierMap.cs" />
    <Compile Include="..\UI\Jkr\ViewModels\IssueVm.cs" Link="IssueVm.cs" />
    <Compile Include="..\UI\Jkr\ViewModels\SpecDoc.cs" Link="SpecDoc.cs" />
    <Compile Include="..\UI\Jkr\JkrTheme.cs" Link="JkrTheme.cs" />
    <Compile Include="..\Services\JkrCodeParser.cs" Link="JkrCodeParser.cs" />
    <Compile Include="..\Services\AiUrl.cs" Link="AiUrl.cs" />
    <Compile Include="..\Services\AIServiceStreamParser.cs" Link="AIServiceStreamParser.cs" />
    <!-- ToolLabels: single tool-name -> readable-label map, used by the parser's
         tool-event fallback (and ToolLoopRunner). Pure (Dictionary + System.Text.Json). -->
    <Compile Include="..\Services\ToolLabels.cs" Link="ToolLabels.cs" />
    <Compile Include="..\Models\AIResponse.cs" Link="AIResponse.cs" />
    <Compile Include="..\Services\VettedToolCode.cs" Link="VettedToolCode.cs" />
    <Compile Include="..\UI\Copilot\Model\CopilotModels.cs" Link="CopilotModels.cs" />
    <!-- ToolCatalog defines SlashTool, referenced by ChatMessage.SlashCommand in
         CopilotModels. Pure (WPF Geometry only, no Revit). -->
    <Compile Include="..\UI\Copilot\Model\ToolCatalog.cs" Link="ToolCatalog.cs" />
    <Compile Include="..\UI\Copilot\Model\CopilotContext.cs" Link="CopilotContext.cs" />
    <Compile Include="..\UI\Copilot\Model\UsageState.cs" Link="UsageState.cs" />
    <Compile Include="..\UI\Copilot\Model\FriendlyStep.cs" Link="FriendlyStep.cs" />
    <Compile Include="..\UI\Copilot\Model\CopilotCatalog.cs" Link="CopilotCatalog.cs" />
    <Compile Include="..\UI\Copilot\Model\ProgressStep.cs" Link="ProgressStep.cs" />
    <Compile Include="..\BinaVibe\Mcp\Tools\BatchRefResolver.cs" Link="BatchRefResolver.cs" />
    <!--
      DocumentChangedIndexer: included for BuildBulkPayload / SnapshotDoc /
      SnapshotPayload (pure logic, no Revit refs). BulkIndexAsync and the
      constructor reference Autodesk.Revit.DB — this source link therefore
      requires Revit SDK assemblies to compile. Build succeeds on Windows
      with Revit installed; expected to fail on macOS (no Revit DLLs).
    -->
    <Compile Include="..\BinaVibe\Indexer\DEPRECATED_DocumentChangedIndexer.cs" Link="DocumentChangedIndexer.cs" />
  </ItemGroup>

</Project>
