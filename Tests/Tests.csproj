  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!--
      Reference-only Revit API, version-matched to this project's TFM the same
      way RevitWebAppSync.csproj matches its own (2027.* -> net10). Needed by
      the DocumentChangedIndexer source link below, which pulls in
      Autodesk.Revit.DB. From NuGet, so it builds with no local Revit install.
    -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2027.*" Condition="'$(SkipRevitSources)' != 'true' and '$(TargetFramework)' == 'net10.0-windows'" />
    <!-- PdfPig: needed by the linked PdfReader source below, and used by the
         tests themselves (PdfDocumentBuilder) to generate fixture PDFs — no
         checked-in binaries, no SkiaSharp/native dependency in the test host. -->
    <PackageReference Include="PdfPig" Version="0.1.*" />
    <!-- QuestPDF: renders the Borang BIM 010 PDF (BorangBim010Exporter). Same
         "2024.*" resolver the add-in uses, so the exporter compiles identically
         in both hosts; runs cross-platform for the render smoke test. -->
    <PackageReference Include="QuestPDF" Version="2024.*" />
    <!-- ClosedXML: ReportExporter.cs (linked below for BorangBim010Exporter's
         mandatory EnsureQuestPdfReady dependency) also exposes the xlsx writer. -->
    <PackageReference Include="ClosedXML" Version="0.102.2" />
  </ItemGroup>

