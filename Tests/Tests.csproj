<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!--
      Reference-only Revit API, version-matched to this project's TFM the same
      way RevitWebAppSync.csproj matches its own (2027.* -> net10). Needed by
      the DocumentChangedIndexer source link below, which pulls in
      Autodesk.Revit.DB. From NuGet, so it builds with no local Revit install.
    -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2027.*" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Reference only the source files we need — avoids pulling in Revit SDK.
      Pure logic classes with no Revit dependency.
    -->
    <Compile Include="..\UI\Jkr\ViewModels\JkrTierMap.cs" Link="JkrTierMap.cs" />
    <Compile Include="..\UI\Jkr\ViewModels\IssueVm.cs" Link="IssueVm.cs" />
    <Compile Include="..\UI\Jkr\ViewModels\SpecDoc.cs" Link="SpecDoc.cs" />
    <Compile Include="..\UI\Jkr\JkrTheme.cs" Link="JkrTheme.cs" />
    <Compile Include="..\Services\JkrCodeParser.cs" Link="JkrCodeParser.cs" />
    <!-- TableCsv: pure CSV serializer + filename slug for the Download-CSV
         button under AI tables (System + Regex only, no WPF/Revit). -->
    <Compile Include="..\Helpers\TableCsv.cs" Link="TableCsv.cs" />
    <Compile Include="..\Services\AiUrl.cs" Link="AiUrl.cs" />
    <Compile Include="..\Services\UrlResolution.cs" Link="UrlResolution.cs" />
    <Compile Include="..\Services\DirectLoadCleanup.cs" Link="DirectLoadCleanup.cs" />
    <Compile Include="..\Services\TelemetryEvent.cs" Link="TelemetryEvent.cs" />
    <Compile Include="..\Services\AIServiceStreamParser.cs" Link="AIServiceStreamParser.cs" />
    <!-- SelfHeal: pure retry policy (using System only). ExecutionResult is its
         return type — a dependency-free DTO split out of CodeExecutor.cs, which
         can't be linked here because it references Revit + Roslyn. -->
    <Compile Include="..\Services\SelfHeal.cs" Link="SelfHeal.cs" />
    <Compile Include="..\Services\ExecutionResult.cs" Link="ExecutionResult.cs" />
    <!-- ToolLabels: single tool-name -> readable-label map, used by the parser's
         tool-event fallback (and ToolLoopRunner). Pure (Dictionary + System.Text.Json). -->
    <Compile Include="..\Services\ToolLabels.cs" Link="ToolLabels.cs" />
    <!-- Tool-loop wire DTOs + the mutate-confirmation gate: pure shapes split
         out of ToolLoopService.cs precisely so they compile here. -->
    <Compile Include="..\Services\ToolLoopDtos.cs" Link="ToolLoopDtos.cs" />
    <Compile Include="..\Services\ConfirmGate.cs" Link="ConfirmGate.cs" />
    <Compile Include="..\Models\AIResponse.cs" Link="AIResponse.cs" />
    <Compile Include="..\Services\VettedToolCode.cs" Link="VettedToolCode.cs" />
    <Compile Include="..\UI\Copilot\Model\CopilotModels.cs" Link="CopilotModels.cs" />
    <!-- RouteText: the attachment wire format the backend parses ([Attached:] /
         [Attached DWG:] blocks). Pure StringBuilder logic, split out of
         CopilotViewModel precisely so it compiles here. -->
    <Compile Include="..\UI\Copilot\Model\RouteText.cs" Link="RouteText.cs" />
    <!-- MentionToken: pure @-mention token parsing/matching (System only) split
         out of MentionInput so the picker rules are testable without WPF. -->
    <Compile Include="..\UI\Copilot\Model\MentionToken.cs" Link="MentionToken.cs" />
    <!-- ToolCatalog defines SlashTool, referenced by ChatMessage.SlashCommand in
         CopilotModels. Pure (WPF Geometry only, no Revit). -->
    <Compile Include="..\UI\Copilot\Model\ToolCatalog.cs" Link="ToolCatalog.cs" />
    <Compile Include="..\AppInfo.cs" Link="AppInfo.cs" />
    <Compile Include="..\UI\Copilot\Model\CopilotContext.cs" Link="CopilotContext.cs" />
    <Compile Include="..\UI\Copilot\Model\UsageState.cs" Link="UsageState.cs" />
    <Compile Include="..\UI\Copilot\Model\FriendlyStep.cs" Link="FriendlyStep.cs" />
    <Compile Include="..\UI\Copilot\Model\CopilotCatalog.cs" Link="CopilotCatalog.cs" />
    <Compile Include="..\UI\Copilot\Model\ProgressStep.cs" Link="ProgressStep.cs" />
    <Compile Include="..\BinaVibe\Mcp\Tools\BatchRefResolver.cs" Link="BatchRefResolver.cs" />
    <!-- Lean-context wire contract: AIRequest/ModelContext (pure Newtonsoft
         DTOs). No Revit refs. -->
    <Compile Include="..\Models\AIRequest.cs" Link="AIRequest.cs" />
    <!--
      DocumentChangedIndexer: included for BuildBulkPayload / SnapshotDoc /
      SnapshotPayload (pure logic, no Revit refs). BulkIndexAsync and the
      constructor reference Autodesk.Revit.DB — this source link therefore
      requires Revit SDK assemblies to compile. Build succeeds on Windows
      with Revit installed; expected to fail on macOS (no Revit DLLs).
      On a machine without the Revit assemblies, skip it (and its tests) with:
        dotnet test -p:SkipRevitSources=true
    -->
    <Compile Include="..\BinaVibe\Indexer\DEPRECATED_DocumentChangedIndexer.cs" Link="DocumentChangedIndexer.cs" Condition="'$(SkipRevitSources)' != 'true'" />
  </ItemGroup>

  <ItemGroup Condition="'$(SkipRevitSources)' == 'true'">
    <Compile Remove="DocumentChangedIndexerTests.cs" />
  </ItemGroup>

</Project>
