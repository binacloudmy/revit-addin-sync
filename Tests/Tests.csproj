<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Two targets. On Windows `dotnet test` runs BOTH: net10.0 runs the
         cross-platform suite (pure logic + Borang BIM 010, no WPF) and
         net10.0-windows runs the full WindowsDesktop suite. On macOS/Linux CI only
         net10.0 is selected, so the pure + Borang BIM 010 tests actually EXECUTE
         here instead of compiling-then-skipping on the WindowsDesktop runtime. -->
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net10.0;net10.0-windows</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' != 'Windows_NT'">net10.0</TargetFrameworks>
    <!-- UseWPF + x64 only on the WindowsDesktop target; the plain net10.0 target is
         WPF-free so it runs on arm64 macOS. -->
    <UseWPF Condition="'$(TargetFramework)' == 'net10.0-windows'">true</UseWPF>
    <PlatformTarget Condition="'$(TargetFramework)' == 'net10.0-windows'">x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Build the net10.0-windows test TFM headlessly on macOS/Linux CI so the
         suite at least compiles-and-milestones here; real execution happens on
         the Windows runner where the WindowsDesktop runtime exists. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

