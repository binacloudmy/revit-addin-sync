<Window x:Class="Cad2Bim.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Cad2Bim.Views.Controls"
        xmlns:rendering="clr-namespace:Cad2Bim.Views.Rendering"
        Title="Cad2Bim Debug Viewer" Width="1100" Height="700"
        Background="#FF2E2E2E">
    <Window.Resources>
        <!-- Autodesk-style dark palette (matches the cad2bim Viewer) -->
        <SolidColorBrush x:Key="PanelBrush" Color="#FF333333"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#FF252525"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FFE0E0E0"/>
        <SolidColorBrush x:Key="TextDimBrush" Color="#FF9A9A9A"/>
        <SolidColorBrush x:Key="SeparatorBrush" Color="#FF4A4A4A"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF0696D7"/>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,2"/>
        </Style>

        <Style x:Key="SectionRule" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource SeparatorBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#FF3B3B3B"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#FF525252"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF474747"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>

        <!-- Top bar: file + layer toggles -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
            <DockPanel>
                <Button Content="Open…" Command="{Binding OpenFileCommand}"
                        Style="{StaticResource DarkButton}" DockPanel.Dock="Left"/>
                <CheckBox x:Name="LightSheet" Content="Light sheet" DockPanel.Dock="Right"
                          VerticalAlignment="Center" Margin="16,0,0,0"/>
                <ItemsControl ItemsSource="{Binding Layers}" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsVisible}" Margin="12,0,0,0"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding StatusText}" Margin="12,0" VerticalAlignment="Center"
                           Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- Right: live classification settings -->
        <Border DockPanel.Dock="Right" Width="270" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1,0,0,0">
            <StackPanel Margin="10">
                <TextBlock Text="Classification settings" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                <TextBlock Text="Drag a field to scrub, click to type." Foreground="{StaticResource TextDimBrush}"
                           FontSize="11" Margin="0,0,0,2" TextWrapping="Wrap"/>

                <TextBlock Text="WALL THICKNESS (MM)" Style="{StaticResource SectionHeader}"/>
                <Border Style="{StaticResource SectionRule}"/>
                <controls:NumericScrubBox Label="SMin (mm)"
                                          Value="{Binding Settings.SMin}"
                                          Minimum="1" Maximum="600" Step="1" Format="0"/>
                <controls:NumericScrubBox Label="SMax (mm)"
                                          Value="{Binding Settings.SMax}"
                                          Minimum="1" Maximum="1200" Step="2" Format="0"/>
            </StackPanel>
        </Border>

        <!-- Center: CAD viewport -->
        <rendering:CadViewport LayersSource="{Binding Layers}" ContentBounds="{Binding Bounds}">
            <rendering:CadViewport.Style>
                <Style TargetType="{x:Type rendering:CadViewport}">
                    <Setter Property="Backdrop" Value="Black"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=LightSheet}" Value="True">
                            <Setter Property="Backdrop" Value="White"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </rendering:CadViewport.Style>
        </rendering:CadViewport>

    </DockPanel>
</Window>
