<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Cad2Bim.Headless</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ACadSharp" Version="3.6.51" />
  </ItemGroup>

  <!-- The WPF app is net8.0-windows and cannot build off Windows. These sources carry no
       WPF dependency, so they are linked in here to be compiled and measured anywhere. -->
  <ItemGroup>
    <Compile Include="..\cad2bim\*.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\cad2bim\Services\CadRenderSource.cs" Link="Shared\CadRenderSource.cs" />
    <Compile Include="..\cad2bim\Services\ClassificationService.cs" Link="Shared\ClassificationService.cs" />
    <Compile Include="..\cad2bim\ViewModels\Shapes\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- WPF-only sources that live at the project root next to the model. -->
  <ItemGroup>
    <Compile Remove="..\cad2bim\App.xaml.cs" />
    <Compile Remove="..\cad2bim\AssemblyInfo.cs" />
  </ItemGroup>
</Project>
