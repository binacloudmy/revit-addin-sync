<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Cad2Bim.Headless</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ACadSharp" Version="3.6.51" />
  </ItemGroup>

  <!-- The WPF app is net8.0-windows and cannot build off Windows. These sources carry no
       WPF dependency, so they are linked in here to be compiled and measured anywhere. -->
  <ItemGroup>
    <Compile Include="..\cad2bim\*.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\cad2bim\Services\CadRenderSource.cs" Link="Shared\CadRenderSource.cs" />
    <Compile Include="..\cad2bim\Services\ClassificationService.cs" Link="Shared\ClassificationService.cs" />
    <Compile Include="..\cad2bim\ViewModels\Shapes\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The electrical census (the census option): Revit-free sources from the add-in, linked so the
       CLI measures with exactly the code the add-in runs. -->
  <ItemGroup>
    <Compile Include="..\..\BinaVibe\Mcp\Tools\Electrical\ElectricalCensus.cs" Link="Shared\ElectricalCensus.cs" />
    <Compile Include="..\..\BinaVibe\Mcp\Tools\Electrical\ElectricalCensusSummary.cs" Link="Shared\ElectricalCensusSummary.cs" />
    <Compile Include="..\..\Services\CadToBim\CadSourceVerdict.cs" Link="Shared\CadSourceVerdict.cs" />
  </ItemGroup>

  <!-- The phase 1 exit check (the fit and compare-devices options): the pure fit and
       placement comparison, with the plan and resolve types they read. -->
  <ItemGroup>
    <Compile Include="..\..\BinaVibe\Mcp\Tools\Electrical\CadModelFit.cs" Link="Shared\CadModelFit.cs" />
    <Compile Include="..\..\BinaVibe\Mcp\Tools\Electrical\PlacementCompare.cs" Link="Shared\PlacementCompare.cs" />
    <Compile Include="..\..\BinaVibe\Mcp\Tools\Electrical\SocketPlanCache.cs" Link="Shared\SocketPlanCache.cs" />
    <Compile Include="..\..\BinaVibe\Mcp\Tools\Electrical\CadSymbolResolve.cs" Link="Shared\CadSymbolResolve.cs" />
    <Compile Include="..\..\BinaVibe\Mcp\Tools\Electrical\SocketLayout.cs" Link="Shared\SocketLayout.cs" />
  </ItemGroup>

  <!-- WPF-only sources that live at the project root next to the model. -->
  <ItemGroup>
    <Compile Remove="..\cad2bim\App.xaml.cs" />
    <Compile Remove="..\cad2bim\AssemblyInfo.cs" />
  </ItemGroup>
</Project>
