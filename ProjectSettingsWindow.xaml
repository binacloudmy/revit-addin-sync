<Window x:Class="BinaConnector.ProjectSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BINA — Project Settings"
        Height="380" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Active Project" FontWeight="SemiBold" FontSize="13"/>

        <Grid Grid.Row="1" Margin="0,8,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="1" Padding="8,6"
                    Background="#FAFAFA" VerticalAlignment="Center">
                <TextBlock x:Name="ProjectNameText" Text="(no project selected)" TextTrimming="CharacterEllipsis"/>
            </Border>
            <Button Grid.Column="1" x:Name="ChangeProjectButton" Content="Change Project…"
                    Width="130" Height="28" Margin="8,0,0,0"
                    Click="ChangeProjectButton_Click"/>
        </Grid>

        <TextBlock Grid.Row="2" Text="Upload Preferences" FontWeight="SemiBold" FontSize="13" Margin="0,8,0,8"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,4,0,8">
            <TextBlock Text="Default discipline:" Width="140" VerticalAlignment="Center"/>
            <ComboBox x:Name="DisciplineComboBox" Width="240" Height="26">
                <ComboBoxItem Content="Ask every time" Tag="Ask"/>
                <ComboBoxItem Content="MainFile (general model)" Tag="MainFile"/>
                <ComboBoxItem Content="Architecture" Tag="Architecture"/>
                <ComboBoxItem Content="Structure" Tag="Structure"/>
                <ComboBoxItem Content="HVAC" Tag="HVAC"/>
                <ComboBoxItem Content="Electrical" Tag="Electrical"/>
            </ComboBox>
        </StackPanel>

        <CheckBox Grid.Row="4" x:Name="ConfirmCheckBox"
                  Content="Show a confirmation dialog before each upload"
                  Margin="0,8,0,0"/>

        <TextBlock Grid.Row="5" x:Name="MessageText" Foreground="#B00020" Margin="0,12,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Width="90" Height="28"
                    Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button x:Name="SaveButton" Content="Save" Width="90" Height="28"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
