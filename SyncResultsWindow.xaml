<Window x:Class="BinaConnector.SyncResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sync to BINA - Upload Results"
        Height="500"
        Width="700"
        MinHeight="400"
        MinWidth="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock x:Name="HeaderText" 
                       Text="Upload Completed Successfully!" 
                       FontSize="18" 
                       FontWeight="Bold" 
                       Foreground="#2E7D32"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>
            
            <TextBlock x:Name="SummaryText"
                       Text="Your files have been uploaded to BINA Cloud"
                       FontSize="12"
                       Foreground="#666"
                       HorizontalAlignment="Center"/>
        </StackPanel>
        
        <!-- Results Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Upload Summary -->
                <Border Background="#F5F5F5" 
                        CornerRadius="5" 
                        Padding="15" 
                        Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" 
                                   Text="Upload Summary" 
                                   FontSize="14" 
                                   FontWeight="Bold" 
                                   Margin="0,0,0,10"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="File Name:" FontWeight="Bold" Margin="0,2"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="FileNameText" Text="" Margin="10,2,0,2"/>
                        
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Discipline Type:" FontWeight="Bold" Margin="0,2"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DisciplineText" Text="" Margin="10,2,0,2"/>
                        
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="File Size:" FontWeight="Bold" Margin="0,2"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="FileSizeText" Text="" Margin="10,2,0,2"/>
                        
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Version:" FontWeight="Bold" Margin="0,2"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="VersionText" Text="" Margin="10,2,0,2"/>
                    </Grid>
                </Border>
                
                <!-- Upload Status -->
                <Border Background="White" 
                        BorderBrush="#E0E0E0" 
                        BorderThickness="1" 
                        CornerRadius="5" 
                        Padding="15" 
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Upload Status" 
                                   FontSize="14" 
                                   FontWeight="Bold" 
                                   Margin="0,0,0,15"/>
                        
                        <!-- BINA OBS Status -->
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="🗂️" FontSize="16" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="BINA OBS Storage" FontWeight="Bold" FontSize="12"/>
                                <TextBlock x:Name="BinaLocationText" Text="" FontSize="10" Foreground="#666"/>
                            </StackPanel>
                            <TextBlock x:Name="BinaStatusText" Grid.Column="2" Text="✅ Uploaded" Foreground="#2E7D32" FontWeight="Bold"/>
                        </Grid>
                        
                        <!-- Autodesk OSS Status -->
                        <Grid Margin="0,15,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="🏢" FontSize="16" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Autodesk OSS &amp; Viewer" FontWeight="Bold" FontSize="12"/>
                                <TextBlock x:Name="AutodeskUrnText" Text="" FontSize="10" Foreground="#666"/>
                            </StackPanel>
                            <TextBlock x:Name="AutodeskStatusText" Grid.Column="2" Text="✅ Ready" Foreground="#2E7D32" FontWeight="Bold"/>
                        </Grid>
                        
                        <!-- Backend Registration Status -->
                        <Grid Margin="0,15,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="💾" FontSize="16" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="BINA Cloud Registration" FontWeight="Bold" FontSize="12"/>
                                <TextBlock Text="File metadata saved to database" FontSize="10" Foreground="#666"/>
                            </StackPanel>
                            <TextBlock x:Name="RegistrationStatusText" Grid.Column="2" Text="✅ Saved" Foreground="#2E7D32" FontWeight="Bold"/>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- Linked Files Section -->
                <Border Background="White" 
                        BorderBrush="#E0E0E0" 
                        BorderThickness="1" 
                        CornerRadius="5" 
                        Padding="15"
                        x:Name="LinkedFilesSection"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Linked Files Detected" 
                                   FontSize="14" 
                                   FontWeight="Bold" 
                                   Margin="0,0,0,10"/>
                        
                        <DataGrid x:Name="LinkedFilesGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeRows="False"
                                  CanUserSortColumns="True"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  AlternatingRowBackground="#F9F9F9"
                                  MaxHeight="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="File Name" 
                                                    Binding="{Binding FileName}" 
                                                    Width="*"/>
                                <DataGridTextColumn Header="Discipline" 
                                                    Binding="{Binding DisciplineType}" 
                                                    Width="120"/>
                                <DataGridTextColumn Header="Path" 
                                                    Binding="{Binding RelativePath}" 
                                                    Width="200"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        
                        <TextBlock Text="💡 Tip: Use 'Download Disciplines' to sync these linked files to your local project." 
                                   FontSize="10" 
                                   Foreground="#666" 
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                
                <!-- Error Messages (if any) -->
                <Border x:Name="ErrorSection"
                        Background="#FFEBEE" 
                        BorderBrush="#F44336" 
                        BorderThickness="1" 
                        CornerRadius="5" 
                        Padding="15"
                        Margin="0,20,0,0"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="⚠️ Issues Detected" 
                                   FontSize="14" 
                                   FontWeight="Bold" 
                                   Foreground="#D32F2F"
                                   Margin="0,0,0,10"/>
                        
                        <TextBlock x:Name="ErrorMessageText"
                                   Text=""
                                   FontSize="11"
                                   Foreground="#D32F2F"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        
        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,0,0,0">
            
            <Button x:Name="ViewInBinaButton" 
                    Content="🌐 View in BINA Cloud" 
                    Width="150" 
                    Height="35" 
                    Margin="0,0,10,0"
                    Background="#1976D2" 
                    Foreground="White" 
                    BorderThickness="0" 
                    Cursor="Hand"
                    Click="ViewInBinaButton_Click"/>
            
            <Button x:Name="CloseButton" 
                    Content="Close" 
                    Width="80" 
                    Height="35" 
                    Background="#424242" 
                    Foreground="White" 
                    BorderThickness="0" 
                    IsDefault="True"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>