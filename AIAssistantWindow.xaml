<Window x:Class="RevitWebAppSync.AIAssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Assistant - BINA"
        Height="600"
        Width="800"
        MinHeight="500"
        MinWidth="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🤖 AI Assistant"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#1976D2"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,5"/>

            <TextBlock Text="Ask me anything about your Revit project, BINA sync operations, or BIM workflows"
                       FontSize="12"
                       Foreground="#666"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Chat Area -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="8"
                Padding="0"
                Margin="0,0,0,20">
            <ScrollViewer x:Name="ChatScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="15">
                <StackPanel x:Name="ChatHistory">
                    <!-- Welcome Message -->
                    <Border Background="#F8F9FA"
                            BorderBrush="#E9ECEF"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="15"
                            Margin="0,0,0,15"
                            HorizontalAlignment="Left"
                            MaxWidth="500">
                        <StackPanel>
                            <TextBlock Text="🤖 AI Assistant"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       Foreground="#1976D2"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="Hello! I'm here to help you with your Revit projects and BINA workflows. You can ask me about:"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="• Uploading and syncing files to BINA Cloud"
                                       FontSize="10"
                                       Foreground="#555"
                                       Margin="15,0,0,2"/>
                            <TextBlock Text="• Downloading discipline files"
                                       FontSize="10"
                                       Foreground="#555"
                                       Margin="15,0,0,2"/>
                            <TextBlock Text="• Managing linked files and coordination"
                                       FontSize="10"
                                       Foreground="#555"
                                       Margin="15,0,0,2"/>
                            <TextBlock Text="• BIM workflows and best practices"
                                       FontSize="10"
                                       Foreground="#555"
                                       Margin="15,0,0,2"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Input Area -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="MessageInputBox"
                         Grid.Column="0"
                         Height="40"
                         Padding="12,8"
                         FontSize="12"
                         BorderBrush="Transparent"
                         BorderThickness="0"
                         VerticalContentAlignment="Center"
                         Text="Type your question here..."
                         Foreground="Gray"
                         GotFocus="MessageInputBox_GotFocus"
                         LostFocus="MessageInputBox_LostFocus"
                         KeyDown="MessageInputBox_KeyDown"
                         AcceptsReturn="False"/>

                <Button x:Name="SendButton"
                        Grid.Column="1"
                        Content="Send"
                        Width="80"
                        Height="40"
                        Margin="10,0,0,0"
                        Background="#1976D2"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="12"
                        Cursor="Hand"
                        Click="SendButton_Click"/>
            </Grid>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <TextBlock Text="Powered by BINA AI"
                       FontSize="10"
                       Foreground="#999"
                       VerticalAlignment="Center"
                       Margin="0,0,15,0"/>

            <Button x:Name="CloseButton"
                    Content="Close"
                    Width="80"
                    Height="30"
                    Background="#424242"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="11"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>