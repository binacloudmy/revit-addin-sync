<Window x:Class="RevitWebAppSync.AIAssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revit AI Assistant"
        Width="600" Height="700"
        MinWidth="500" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Window.Resources>
        <!-- Dark theme styles -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#3F3F46"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1084D9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QuickActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E42"/>
                    <Setter Property="BorderBrush" Value="#0078D4"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DrawerButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E42"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ApproveButton" TargetType="Button" BasedOn="{StaticResource DrawerButton}">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="BorderBrush" Value="#0078D4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1084D9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource DrawerButton}">
            <Setter Property="Background" Value="#D32F2F"/>
            <Setter Property="BorderBrush" Value="#D32F2F"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E53935"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Mention Autocomplete Styles -->
        <Style x:Key="MentionListItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3E3E42"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#0078D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Storyboards for drawer animation -->
        <Storyboard x:Key="OpenDrawer">
            <DoubleAnimation Storyboard.TargetName="DrawerPanel"
                             Storyboard.TargetProperty="Width"
                             To="320" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="CloseDrawer">
            <DoubleAnimation Storyboard.TargetName="DrawerPanel"
                             Storyboard.TargetProperty="Width"
                             To="0" Duration="0:0:0.15">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Main Content -->
        <Grid Grid.Column="0" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Revit AI Assistant"
                           FontSize="20" FontWeight="Bold"
                           Foreground="#FFFFFF"/>
                <TextBlock x:Name="StatusText"
                           Text="Ready"
                           FontSize="12"
                           Foreground="#888888"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Command Library -->
            <Border Grid.Row="1"
                    Background="#252526"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,12"
                    MaxHeight="200">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Command Library"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#888888"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="CommandCountText"
                                   Text=""
                                   FontSize="10"
                                   Foreground="#666666"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Category Filter -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="FilterAllBtn" Content="All"
                                Style="{StaticResource QuickActionButton}"
                                Margin="0,0,4,0" Padding="8,4"
                                Click="FilterCategory_Click" Tag="All"/>
                        <Button Content="Export" Style="{StaticResource QuickActionButton}"
                                Margin="0,0,4,0" Padding="8,4"
                                Click="FilterCategory_Click" Tag="Export"/>
                        <Button Content="Selection" Style="{StaticResource QuickActionButton}"
                                Margin="0,0,4,0" Padding="8,4"
                                Click="FilterCategory_Click" Tag="Selection"/>
                        <Button Content="Audit" Style="{StaticResource QuickActionButton}"
                                Margin="0,0,4,0" Padding="8,4"
                                Click="FilterCategory_Click" Tag="Audit"/>
                        <Button Content="My Commands" Style="{StaticResource QuickActionButton}"
                                Margin="0,0,4,0" Padding="8,4"
                                Click="FilterCategory_Click" Tag="General"/>
                    </StackPanel>

                    <!-- Commands List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="CommandsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#2D2D30"
                                            BorderBrush="#3F3F46"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10,8"
                                            Margin="0,0,0,4"
                                            Cursor="Hand"
                                            MouseLeftButtonUp="Command_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Icon -->
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Icon}"
                                                       FontSize="16"
                                                       Margin="0,0,10,0"
                                                       VerticalAlignment="Center"/>

                                            <!-- Name & Description -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="#FFFFFF"/>
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="10"
                                                           Foreground="#888888"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="280"/>
                                            </StackPanel>

                                            <!-- Use Count -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding UseCount}"
                                                           FontSize="10"
                                                           Foreground="#666666"
                                                           Margin="0,0,2,0"/>
                                                <TextBlock Text="runs"
                                                           FontSize="10"
                                                           Foreground="#666666"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Chat History -->
            <Border Grid.Row="2"
                    Background="#252526"
                    CornerRadius="8"
                    Margin="0,0,0,12">
                <ScrollViewer x:Name="ChatScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              Padding="12">
                    <StackPanel x:Name="ChatHistory"/>
                </ScrollViewer>
            </Border>

            <!-- Input Area -->
            <Grid Grid.Row="3" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox x:Name="PromptInput"
                             Style="{StaticResource DarkTextBox}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MaxHeight="100"
                             VerticalScrollBarVisibility="Auto"
                             KeyDown="PromptInput_KeyDown"
                             TextChanged="PromptInput_TextChanged"
                             PreviewKeyDown="PromptInput_PreviewKeyDown"
                             Text=""
                             ToolTip="Type @ to mention categories, levels, or views (Ctrl+Enter to send)"/>

                    <!-- Mention Autocomplete Popup -->
                    <Popup x:Name="MentionPopup"
                           PlacementTarget="{Binding ElementName=PromptInput}"
                           Placement="Top"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Background="#2D2D30"
                                BorderBrush="#0078D4"
                                BorderThickness="1"
                                CornerRadius="6"
                                MaxHeight="250"
                                MinWidth="250">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <Border Grid.Row="0"
                                        Background="#252526"
                                        Padding="10,6"
                                        CornerRadius="6,6,0,0">
                                    <TextBlock Text="Mention an element"
                                               FontSize="11"
                                               Foreground="#888888"/>
                                </Border>

                                <!-- Items List -->
                                <ListBox x:Name="MentionListBox"
                                         Grid.Row="1"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ItemContainerStyle="{StaticResource MentionListItem}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionChanged="MentionListBox_SelectionChanged"
                                         MouseDoubleClick="MentionListBox_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Icon -->
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Icon}"
                                                           FontSize="14"
                                                           Margin="0,0,8,0"
                                                           VerticalAlignment="Center"/>

                                                <!-- Name -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="#FFFFFF"/>
                                                    <TextBlock Text="{Binding Group}"
                                                               FontSize="10"
                                                               Foreground="#888888"/>
                                                </StackPanel>

                                                <!-- Info -->
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Info}"
                                                           FontSize="10"
                                                           Foreground="#888888"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>

                <Button x:Name="SendButton"
                        Grid.Column="1"
                        Content="Send"
                        Style="{StaticResource DarkButton}"
                        Margin="8,0,0,0"
                        Click="SendButton_Click"/>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Powered by BINA AI"
                               FontSize="10"
                               Foreground="#666666"/>
                    <TextBlock x:Name="TokensText"
                               Text=""
                               FontSize="10"
                               Foreground="#666666"
                               Margin="16,0,0,0"/>
                </StackPanel>

                <!-- Save Command Button (appears after successful execution) -->
                <Button x:Name="SaveCommandBtn"
                        Grid.Column="1"
                        Content="Save Command"
                        Style="{StaticResource QuickActionButton}"
                        Padding="10,4"
                        Margin="0"
                        Visibility="Collapsed"
                        Click="SaveCommand_Click"/>
            </Grid>
        </Grid>

        <!-- Side Drawer Panel -->
        <Border x:Name="DrawerPanel"
                Grid.Column="1"
                Width="0"
                Background="#252526"
                BorderBrush="#3F3F46"
                BorderThickness="1,0,0,0">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Drawer Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Review Changes"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"/>
                        <Border x:Name="RiskBadge"
                                CornerRadius="4"
                                Padding="8,3"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Background="#4CAF50">
                            <TextBlock x:Name="RiskText"
                                       Text="SAFE"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="DrawerExplanation"
                               Text=""
                               FontSize="12"
                               Foreground="#AAAAAA"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Summary -->
                <Border Grid.Row="1"
                        Background="#1E1E1E"
                        CornerRadius="6"
                        Padding="12"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="DrawerSummary"
                                   Text="No changes detected"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"/>
                        <StackPanel x:Name="SummaryBadges"
                                    Orientation="Horizontal"
                                    Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Changes List -->
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              Margin="0,0,0,12">
                    <StackPanel x:Name="DrawerChangesList"/>
                </ScrollViewer>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="3">
                    <Button x:Name="HighlightBtn"
                            Content="Highlight in View"
                            Style="{StaticResource DrawerButton}"
                            Click="HighlightButton_Click"
                            Visibility="Collapsed"/>

                    <Button x:Name="ApproveBtn"
                            Content="Apply Changes"
                            Style="{StaticResource ApproveButton}"
                            Click="ApproveButton_Click"/>

                    <Button x:Name="CancelBtn"
                            Content="Cancel"
                            Style="{StaticResource DrawerButton}"
                            Click="CancelButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
