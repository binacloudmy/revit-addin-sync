<Window x:Class="RevitWebAppSync.AIAssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revit AI Assistant"
        Width="550" Height="700"
        MinWidth="450" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Window.Resources>
        <!-- Dark theme styles -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#3F3F46"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1084D9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QuickActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E42"/>
                    <Setter Property="BorderBrush" Value="#0078D4"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Revit AI Assistant"
                       FontSize="20" FontWeight="Bold"
                       Foreground="#FFFFFF"/>
            <TextBlock x:Name="StatusText"
                       Text="Ready"
                       FontSize="12"
                       Foreground="#888888"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Quick Actions -->
        <Border Grid.Row="1"
                Background="#252526"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Quick Actions"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#888888"
                           Margin="0,0,0,8"/>
                <WrapPanel x:Name="QuickActionsPanel">
                    <Button Style="{StaticResource QuickActionButton}"
                            Content="Export Rooms to CSV"
                            Tag="Export all rooms with their names, numbers, areas, and levels to a CSV file on the desktop"
                            Click="QuickAction_Click"/>
                    <Button Style="{StaticResource QuickActionButton}"
                            Content="Find Untagged Doors"
                            Tag="Select all doors in the current view that don't have a door tag"
                            Click="QuickAction_Click"/>
                    <Button Style="{StaticResource QuickActionButton}"
                            Content="Audit Room Areas"
                            Tag="Find all rooms with zero area (unenclosed or not properly bounded) and list them"
                            Click="QuickAction_Click"/>
                    <Button Style="{StaticResource QuickActionButton}"
                            Content="Walls by Fire Rating"
                            Tag="Color all walls by their fire rating parameter - 2 Hour=Red, 1 Hour=Orange, None=Gray"
                            Click="QuickAction_Click"/>
                    <Button Style="{StaticResource QuickActionButton}"
                            Content="Count by Category"
                            Tag="Count all doors, windows, rooms, and walls in the model and show a summary"
                            Click="QuickAction_Click"/>
                    <Button Style="{StaticResource QuickActionButton}"
                            Content="Select Short Walls"
                            Tag="Select all walls shorter than 1 meter in length"
                            Click="QuickAction_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Chat History -->
        <Border Grid.Row="2"
                Background="#252526"
                CornerRadius="8"
                Margin="0,0,0,12">
            <ScrollViewer x:Name="ChatScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          Padding="12">
                <StackPanel x:Name="ChatHistory"/>
            </ScrollViewer>
        </Border>

        <!-- Input Area -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="PromptInput"
                     Grid.Column="0"
                     Style="{StaticResource DarkTextBox}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MaxHeight="100"
                     VerticalScrollBarVisibility="Auto"
                     KeyDown="PromptInput_KeyDown"
                     Text=""
                     ToolTip="Enter your prompt (Ctrl+Enter to send)"/>

            <Button x:Name="SendButton"
                    Grid.Column="1"
                    Content="Send"
                    Style="{StaticResource DarkButton}"
                    Margin="8,0,0,0"
                    Click="SendButton_Click"/>
        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <TextBlock Text="Powered by BINA AI"
                       FontSize="10"
                       Foreground="#666666"/>
            <TextBlock x:Name="TokensText"
                       Text=""
                       FontSize="10"
                       Foreground="#666666"
                       Margin="16,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
