<Window x:Class="RevitWebAppSync.AIAssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revit AI Assistant"
        Width="780" Height="700"
        MinWidth="440" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Window.Resources>
        <!-- Plain setter-based styles only — no custom ControlTemplates beyond
             DarkTabItem (which has shipped before). -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#0E7AD1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#3F3F46"/>
                    <Setter Property="Foreground" Value="#8A8A8A"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A8AE0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#777777"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3F3F46"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="#C0433A"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D65045"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Tab header style (shipped previously) -->
        <Style x:Key="DarkTabItem" TargetType="TabItem">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                Cursor="Hand">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#0078D4"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="#3F3F46"/>
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Revit AI Assistant" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
            <TextBlock x:Name="StatusText" Text="Ready" FontSize="12" Foreground="#888888" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Copilot chat area -->
        <Border Grid.Row="1" Background="#252526" CornerRadius="8" Margin="0,0,0,12">
            <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Saved Commands (default Expander styling) -->
                        <Expander x:Name="CommandsExpander" Grid.Row="0"
                                  Header="📚 Saved Commands" Foreground="#CCCCCC"
                                  Margin="8,8,8,0" IsExpanded="False">
                            <Grid Margin="0,6,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="CommandSearchBox" Grid.Column="0"
                                             Style="{StaticResource DarkTextBox}"
                                             ToolTip="Filter by name, category or description"
                                             TextChanged="CommandSearchBox_TextChanged"/>
                                    <Button x:Name="SaveAsCommandButton" Grid.Column="1"
                                            Content="Save prompt" Style="{StaticResource GhostButton}"
                                            Margin="8,0,0,0" IsEnabled="False"
                                            ToolTip="Save your last prompt as a reusable command"
                                            Click="SaveAsCommandButton_Click"/>
                                    <Button x:Name="ExportCommandsButton" Grid.Column="2"
                                            Content="Export" Style="{StaticResource GhostButton}"
                                            Margin="6,0,0,0"
                                            ToolTip="Export every command you can see as a JSON file"
                                            Click="ExportCommandsButton_Click"/>
                                    <Button x:Name="ImportCommandsButton" Grid.Column="3"
                                            Content="Import" Style="{StaticResource GhostButton}"
                                            Margin="6,0,0,0"
                                            ToolTip="Import commands from a JSON file"
                                            Click="ImportCommandsButton_Click"/>
                                </Grid>

                                <ListBox x:Name="CommandsList" Grid.Row="1"
                                         Background="#1E1E1E" Foreground="#DDDDDD"
                                         BorderBrush="#3F3F46" BorderThickness="1"
                                         MaxHeight="190" Margin="0,6,0,0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="False"
                                         ToolTip="Double-click to run · right-click for more"
                                         MouseDoubleClick="CommandsList_MouseDoubleClick">
                                    <ListBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Run" Click="RunCommandMenuItem_Click"/>
                                            <Separator/>
                                            <MenuItem Header="Edit..." Click="EditCommandMenuItem_Click"/>
                                            <MenuItem Header="Delete" Click="DeleteCommandMenuItem_Click"/>
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,3,2,3">
                                                <TextBlock Text="{Binding NameWithMarker}" FontWeight="SemiBold" Foreground="#FFFFFF" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding ScopeAndCategory}" Foreground="#7AB8FF" FontSize="10"/>
                                                <TextBlock Text="{Binding Description}" Foreground="#999999" FontSize="10" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock x:Name="CommandsHint" Grid.Row="2" Text=""
                                           Foreground="#888888" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </Grid>
                        </Expander>

                        <!-- Split view: chat on the left, preview on the right (FR-031).
                             Use a plain Grid + GridSplitter — no custom ControlTemplates,
                             the Revit-hosted host has been twitchy about those. -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="220"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition x:Name="PreviewColumn" Width="300" MinWidth="0"/>
                            </Grid.ColumnDefinitions>

                            <!-- Chat history (left) -->
                            <ScrollViewer x:Name="CopilotScrollViewer" Grid.Column="0"
                                          VerticalScrollBarVisibility="Auto" Padding="12">
                                <StackPanel x:Name="CopilotChatHistory"/>
                            </ScrollViewer>

                            <!-- Resizable splitter -->
                            <GridSplitter x:Name="PreviewSplitter" Grid.Column="1"
                                          Width="4" HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          Background="#3F3F46" ShowsPreview="True"
                                          ResizeBehavior="PreviousAndNext"/>

                            <!-- Preview panel (right) -->
                            <Border x:Name="PreviewPanel" Grid.Column="2"
                                    Background="#1E1E1E"
                                    BorderBrush="#3F3F46" BorderThickness="1,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Background="#252526">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="PreviewHeader" Grid.Column="0"
                                                   Text="Preview" FontWeight="SemiBold"
                                                   Foreground="#CCCCCC" Padding="10,6"/>
                                        <Button x:Name="TogglePreviewButton" Grid.Column="1"
                                                Content="×" Width="28" Height="24" Margin="0,2,4,2"
                                                Background="Transparent" Foreground="#AAAAAA"
                                                BorderThickness="0" Cursor="Hand"
                                                ToolTip="Hide preview panel"
                                                Click="TogglePreviewButton_Click"/>
                                    </Grid>
                                    <ScrollViewer x:Name="PreviewScrollViewer" Grid.Row="1"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  Padding="12">
                                        <StackPanel x:Name="PreviewContent">
                                            <TextBlock x:Name="PreviewEmptyHint"
                                                       Text="The latest code, result or dashboard link will appear here as you work."
                                                       Foreground="#888888" FontSize="11"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- Floating &quot;show preview&quot; button — only visible when the
                                 panel is hidden. -->
                            <Button x:Name="ShowPreviewButton" Grid.Column="0"
                                    Content="◀ Preview" Padding="8,4"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,8,12,0" FontSize="10"
                                    Background="#2D2D30" Foreground="#CCCCCC"
                                    BorderBrush="#3F3F46" BorderThickness="1"
                                    Cursor="Hand" Visibility="Collapsed"
                                    ToolTip="Show the preview panel"
                                    Click="ShowPreviewButton_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Input Area -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="PromptInput" Grid.Column="0"
                     Style="{StaticResource DarkTextBox}"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     MaxHeight="110" MinHeight="36"
                     VerticalScrollBarVisibility="Auto"
                     KeyDown="PromptInput_KeyDown"
                     PreviewKeyDown="PromptInput_PreviewKeyDown"
                     TextChanged="PromptInput_TextChanged"
                     Text=""
                     ToolTip="Type @ to reference a level / view / grid / room / category (Ctrl+Enter to send)"/>

            <!-- @mention autocomplete -->
            <Popup x:Name="MentionPopup" PlacementTarget="{Binding ElementName=PromptInput}"
                   Placement="Top" StaysOpen="False" AllowsTransparency="True"
                   Width="320" MaxHeight="200" IsOpen="False">
                <Border Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="6" Padding="2">
                    <ListBox x:Name="MentionList" Background="Transparent" Foreground="#DDDDDD"
                             BorderThickness="0" MaxHeight="190"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="False"
                             MouseUp="MentionList_MouseUp">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                    <TextBlock Text="{Binding Display}" Foreground="#F2F2F2"/>
                                    <TextBlock Text="{Binding TypeLabel}" Foreground="#888888" FontSize="10" Margin="8,1,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Popup>

            <Button x:Name="SendButton" Grid.Column="1" Content="Send"
                    Style="{StaticResource DarkButton}" Margin="8,0,0,0"
                    Click="SendButton_Click"/>

            <Button x:Name="CancelButton" Grid.Column="2" Content="Cancel"
                    Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                    Visibility="Collapsed" Click="CancelButton_Click"/>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="Powered by BINA AI" FontSize="10" Foreground="#666666" VerticalAlignment="Center"/>
                <TextBlock x:Name="TokensText" Text="" FontSize="10" Foreground="#666666" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <Button x:Name="CopyTranscriptButton" Content="Copy transcript" HorizontalAlignment="Right"
                    Style="{StaticResource GhostButton}" Padding="10,3" FontSize="10"
                    ToolTip="Copy the whole conversation to the clipboard"
                    Click="CopyTranscriptButton_Click"/>
        </Grid>
    </Grid>
</Window>
