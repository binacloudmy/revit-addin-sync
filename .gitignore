packages/
*.nupkg

# Test / coverage outputs
TestResults/
*.trx
coverage*

# Backup / scratch files
*.bak
*.cache
*.orig
*.rej

# OS noise
.DS_Store
Thumbs.db

# Local secrets / config
.env
.env.local
*.secret

# Claude Code local settings (per-machine)
.claude/settings.local.json
