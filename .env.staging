# BINA Sync — STAGING links (Staging-configuration builds embed this).
# UAT builds that must talk to the staging backend: build with
#   dotnet build -c Staging   (or -Configuration Staging in the scripts).
# Same shape as .env.production; see that file for key docs.
BASE_URL=https://bina-ai-staging.azurewebsites.net

# OTA update feed (version.json). Empty = updater disabled — staging UAT
# builds must never self-update onto the fleet Release channel.
UPDATE_FEED_URL=

# Web origin for the desktop OAuth browser flow.
LOGIN_WEB_URL=https://plugins.jkrbinaxone.com

# Sign-in path, appended to BASE_URL → final login URL.
LOGIN_PATH=/api/auth/user/sign-in

# Optional full sign-in URL override.
LOGIN_URL=
