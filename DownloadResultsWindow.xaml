<Window x:Class="RevitWebAppSync.DownloadResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shared Download - Results"
        Height="500"
        Width="700"
        MinHeight="400"
        MinWidth="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock x:Name="HeaderText"
                       Text="Download Completed Successfully!"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#2E7D32"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

            <TextBlock x:Name="SummaryText"
                       Text="BIM discipline files have been downloaded from BINA Cloud"
                       FontSize="12"
                       Foreground="#666"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Results Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Download Summary -->
                <Border Background="#F5F5F5"
                        CornerRadius="5"
                        Padding="15"
                        Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                   Text="Download Summary"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Project:" FontWeight="Bold" Margin="0,2"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ProjectNameText" Text="" Margin="10,2,0,2"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Total Files:" FontWeight="Bold" Margin="0,2"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TotalFilesText" Text="" Margin="10,2,0,2"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Download Location:" FontWeight="Bold" Margin="0,2"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DownloadLocationText" Text="" Margin="10,2,0,2" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <!-- Downloaded Files List -->
                <Border Background="White"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="15"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Downloaded Files"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>

                        <ItemsControl x:Name="DownloadedFilesPanel">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="16" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DisciplineName}" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Text="{Binding FileName}" FontSize="10" Foreground="#666"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontWeight="Bold"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- No Files Message -->
                        <TextBlock x:Name="NoFilesMessage"
                                   Text="No discipline files were available for download from this project."
                                   FontSize="12"
                                   Foreground="#666"
                                   HorizontalAlignment="Center"
                                   Margin="0,10"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Usage Tip -->
                <Border Background="#E3F2FD"
                        BorderBrush="#1976D2"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="15"
                        x:Name="TipSection">
                    <StackPanel>
                        <TextBlock Text="Next Steps"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#1976D2"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="You can link these downloaded files to your current Revit project:"
                                   FontSize="11"
                                   Foreground="#333"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,5"/>

                        <TextBlock Text="1. Go to Insert tab > Link Revit"
                                   FontSize="11"
                                   Foreground="#666"
                                   Margin="10,2"/>

                        <TextBlock Text="2. Navigate to the downloaded folder on your Desktop"
                                   FontSize="11"
                                   Foreground="#666"
                                   Margin="10,2"/>

                        <TextBlock Text="3. Select the discipline file(s) you want to link"
                                   FontSize="11"
                                   Foreground="#666"
                                   Margin="10,2"/>
                    </StackPanel>
                </Border>

                <!-- Error Messages (if any) -->
                <Border x:Name="ErrorSection"
                        Background="#FFEBEE"
                        BorderBrush="#F44336"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="15"
                        Margin="0,20,0,0"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Issues Detected"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#D32F2F"
                                   Margin="0,0,0,10"/>

                        <TextBlock x:Name="ErrorMessageText"
                                   Text=""
                                   FontSize="11"
                                   Foreground="#D32F2F"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button x:Name="OpenFolderButton"
                    Content="Open Download Folder"
                    Width="160"
                    Height="35"
                    Margin="0,0,10,0"
                    Background="#1976D2"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="OpenFolderButton_Click"/>

            <Button x:Name="CloseButton"
                    Content="Close"
                    Width="80"
                    Height="35"
                    Background="#424242"
                    Foreground="White"
                    BorderThickness="0"
                    IsDefault="True"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
